{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "validate:imports": "node scripts/validate-out-of-tree-imports.mjs",
    "build": "npm run validate:imports && tsc -b && vite build",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:report": "eslint .",
    "lint:baseline": "node scripts/lint-baseline.mjs --update",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit && tsc -p src/i18n/tsconfig.guard.json --noEmit",
    "test:crypto": "vitest run src/lib/vaultCrypto.test.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test:chat-interactions": "tsc -p e2e/chat-interactions/tsconfig.json --noEmit && playwright test --config playwright.chat-interactions.config.ts",
    "test:chat-paging": "tsc -p e2e/chat-paging/tsconfig.json --noEmit && playwright test --config playwright.chat-paging.config.ts",
    "test:citations": "tsc -p e2e/citations/tsconfig.json --noEmit && playwright test --config playwright.citations.config.ts",
    "test:chat-selection": "tsc -p e2e/chat-selection/tsconfig.json --noEmit && playwright test --config playwright.chat-selection.config.ts",
    "test:inbox-return": "tsc -p e2e/inbox-return/tsconfig.json --noEmit && playwright test --config playwright.inbox-return.config.ts",
    "test:badge-triggers": "tsc -p e2e/badge-triggers/tsconfig.json --noEmit && playwright test --config playwright.badge-triggers.config.ts",
    "test:project-order": "tsc -p e2e/project-order/tsconfig.json --noEmit && playwright test --config playwright.project-order.config.ts",
    "test:session-dot": "tsc -p e2e/session-dot/tsconfig.json --noEmit && playwright test --config playwright.session-dot.config.ts",
    "test:queue-attachments": "tsc -p e2e/queue-attachments/tsconfig.json --noEmit && playwright test --config playwright.queue-attachments.config.ts",
    "test:model-catalog": "tsc -p e2e/model-catalog/tsconfig.json --noEmit && playwright test --config playwright.model-catalog.config.ts",
    "test:model-provider": "tsc -p e2e/model-provider/tsconfig.json --noEmit && playwright test --config playwright.model-provider.config.ts",
    "test:onboarding-fidelity": "tsc -p e2e/onboarding-fidelity/tsconfig.json --noEmit && playwright test --config playwright.onboarding-fidelity.config.ts",
    "test:workbench-general": "tsc -p e2e/workbench-general/tsconfig.json --noEmit && playwright test --config playwright.workbench-general.config.ts",
    "test:workbench-general-build": "tsc -p e2e/workbench-general/tsconfig.json --noEmit && playwright test --config playwright.workbench-general-build.config.ts",
    "test:voice-shortcut": "tsc -p e2e/voice-shortcut/tsconfig.json --noEmit && playwright test --config playwright.voice-shortcut.config.ts",
    "test:pet-mini": "playwright test --config playwright.pet-mini.config.ts",
    "validate:catalog": "node scripts/validate-scenario-catalog.mjs",
    "validate:theme": "node scripts/validate-theme.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@lexical/react": "^0.52.0",
    "@monaco-editor/react": "^4.7.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@uiw/react-json-view": "^2.0.0-alpha.43",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "agentation": "^3.1.2",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.4.1",
    "dompurify": "3.4.17",
    "framer-motion": "^12.26.2",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lexical": "^0.52.0",
    "lexical-beautiful-mentions": "^0.1.48",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "pptxviewjs": "^1.1.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
