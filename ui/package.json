{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "design": "vite --open /design.html",
    "design:shot": "node scripts/design-shot.mjs",
    "design:build": "node scripts/design-build.mjs",
    "design:export": "node scripts/design-export.mjs",
    "typecheck:design": "tsc -p design/tsconfig.json --noEmit",
    "validate:imports": "node scripts/validate-out-of-tree-imports.mjs",
    "build": "npm run validate:imports && tsc -b && vite build",
    "build:mobile": "npm run validate:imports && tsc -b && vite build --config vite.mobile.config.ts",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:report": "node scripts/lint-baseline.mjs --report",
    "lint:baseline": "node scripts/lint-baseline.mjs --update",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:e2e": "node scripts/typecheck-e2e.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit && tsc -p src/i18n/tsconfig.guard.json --noEmit",
    "test:crypto": "vitest run src/lib/vaultCrypto.test.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test:chat-interactions": "node scripts/e2e-suite.mjs e2e/chat-interactions/tsconfig.json playwright.chat-interactions.config.ts",
    "test:chat-paging": "node scripts/e2e-suite.mjs e2e/chat-paging/tsconfig.json playwright.chat-paging.config.ts",
    "test:chat-scroll": "node scripts/e2e-suite.mjs e2e/chat-scroll/tsconfig.json playwright.chat-scroll.config.ts",
    "test:citations": "node scripts/e2e-suite.mjs e2e/citations/tsconfig.json playwright.citations.config.ts",
    "test:chat-selection": "node scripts/e2e-suite.mjs e2e/chat-selection/tsconfig.json playwright.chat-selection.config.ts",
    "test:inbox-return": "node scripts/e2e-suite.mjs e2e/inbox-return/tsconfig.json playwright.inbox-return.config.ts",
    "test:motion": "node scripts/e2e-suite.mjs e2e/motion/tsconfig.json playwright.motion.config.ts",
    "test:home-media": "node scripts/e2e-suite.mjs e2e/home-media/tsconfig.json playwright.home-media.config.ts",
    "test:badge-triggers": "node scripts/e2e-suite.mjs e2e/badge-triggers/tsconfig.json playwright.badge-triggers.config.ts",
    "test:project-order": "node scripts/e2e-suite.mjs e2e/project-order/tsconfig.json playwright.project-order.config.ts",
    "test:session-dot": "node scripts/e2e-suite.mjs e2e/session-dot/tsconfig.json playwright.session-dot.config.ts",
    "test:queue-attachments": "node scripts/e2e-suite.mjs e2e/queue-attachments/tsconfig.json playwright.queue-attachments.config.ts",
    "test:pdf-preview": "node scripts/e2e-suite.mjs e2e/pdf-preview/tsconfig.json playwright.pdf-preview.config.ts",
    "test:model-catalog": "node scripts/e2e-suite.mjs e2e/model-catalog/tsconfig.json playwright.model-catalog.config.ts",
    "test:model-provider": "node scripts/e2e-suite.mjs e2e/model-provider/tsconfig.json playwright.model-provider.config.ts",
    "test:onboarding-fidelity": "node scripts/e2e-suite.mjs e2e/onboarding-fidelity/tsconfig.json playwright.onboarding-fidelity.config.ts",
    "test:web-fetch": "node scripts/e2e-suite.mjs e2e/web-fetch/tsconfig.json playwright.web-fetch.config.ts",
    "test:workbench-general": "node scripts/e2e-suite.mjs e2e/workbench-general/tsconfig.json playwright.workbench-general.config.ts",
    "test:workbench-general-build": "node scripts/e2e-suite.mjs e2e/workbench-general/tsconfig.json playwright.workbench-general-build.config.ts",
    "test:vault-integrity": "node scripts/e2e-suite.mjs e2e/vault-integrity/tsconfig.json playwright.vault-integrity.config.ts",
    "test:voice-shortcut": "node scripts/e2e-suite.mjs e2e/voice-shortcut/tsconfig.json playwright.voice-shortcut.config.ts",
    "test:pet-mini": "playwright test --config playwright.pet-mini.config.ts",
    "validate:catalog": "node scripts/validate-scenario-catalog.mjs",
    "validate:theme": "node scripts/validate-theme.mjs",
    "check:first-load": "node scripts/check-first-load-budget.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hpke/core": "^1.10.1",
    "@hpke/dhkem-x25519": "^1.8.1",
    "@lexical/react": "^0.53.0",
    "@monaco-editor/react": "^4.7.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@uiw/react-json-view": "^2.0.0-alpha.44",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "agentation": "^3.1.2",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.4.1",
    "dompurify": "3.4.17",
    "framer-motion": "^14.10.1",
    "frimousse": "^0.4.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lexical": "^0.53.0",
    "lexical-beautiful-mentions": "^0.1.48",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "pptxviewjs": "^1.1.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "^6.2.7",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "oxc-parser": "0.157.0",
    "oxlint": "1.92.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.18",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
