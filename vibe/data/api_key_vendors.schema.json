{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/api-key-vendors.schema.json",
  "title": "Model Hub API-key vendor catalog",
  "type": "array",
  "definitions": {
    "statuses": {"type": "array", "items": {"type": "integer", "minimum": 400, "maximum": 499}, "uniqueItems": true}
  },
  "items": {
    "type": "object",
    "required": ["id", "label", "official_base_url", "protocol"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
      "label": {"type": "string", "minLength": 1},
      "official_base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "protocol": {"enum": ["anthropic", "openai_responses", "openai_chat", "google", "search"]},
      "built_in": {"type": "boolean"},
      "models_dev_provider": {"type": ["string", "null"]},
      "search": {
        "type": ["object", "null"],
        "required": ["service_id", "endpoint", "auth", "request", "result", "limits", "price", "free_check", "service_refused_statuses", "outcomes", "billing", "tool_only"],
        "allOf": [
          {
            "if": {"type": "object", "required": ["tool_only"], "properties": {"tool_only": {"const": false}}},
            "then": {"required": ["auto_enroll"]}
          },
          {
            "if": {"type": "object", "required": ["tool_only"], "properties": {"tool_only": {"const": true}}},
            "then": {"not": {"required": ["auto_enroll"]}}
          }
        ],
        "additionalProperties": false,
        "properties": {
          "service_id": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
          "auth": {"enum": ["bearer", "x-api-key", "none"]},
          "request": {"type": "object"},
          "result": {
            "type": "object",
            "properties": {
              "reported_cost": {
                "type": "object",
                "required": ["path", "estimate"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "estimate": {"type": "boolean"}
                }
              }
            }
          },
          "limits": {
            "type": "object",
            "required": ["results_max"],
            "properties": {
              "results_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Version-independent per-request results ceiling."
              }
            }
          },
          "price": {
            "type": "object",
            "required": ["unit", "usd_per_1k", "extra", "as_of", "url"],
            "additionalProperties": false,
            "properties": {
              "unit": {"const": "search"},
              "usd_per_1k": {"type": "number", "minimum": 0},
              "extra": {
                "type": "array",
                "maxItems": 0,
                "description": "Search services have no additional charges beyond the search price. Exa highlights are included."
              },
              "as_of": {"type": "string", "format": "date"},
              "url": {"type": "string", "format": "uri", "pattern": "^https://"}
            }
          },
          "free_check": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "method": {"enum": ["GET", "POST"]},
              "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
              "pass": {"type": ["object", "null"]},
              "balance": {"type": ["object", "null"]},
              "limit": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "pairs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["usage", "limit"],
                      "additionalProperties": false,
                      "properties": {
                        "usage": {"type": "string", "minLength": 1},
                        "limit": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              },
              "invalid_statuses": {
                "type": "array",
                "items": {"type": "integer", "minimum": 400, "maximum": 499},
                "uniqueItems": true
              }
            }
          },
          "outcomes": {
            "type": "object", "required": ["credential", "balance", "limit"], "additionalProperties": false,
            "properties": {
              "credential": {"$ref": "#/definitions/statuses"},
              "balance": {"$ref": "#/definitions/statuses"},
              "limit": {"$ref": "#/definitions/statuses"},
              "tag_overrides": {
                "type": "array", "items": {
                  "type": "object", "required": ["status", "tag", "code"], "additionalProperties": false,
                  "properties": {
                    "status": {"type": "integer", "minimum": 400, "maximum": 499},
                    "tag": {"type": "string", "minLength": 1},
                    "code": {"enum": ["service_limit", "service_refused"]}
                  }
                }
              }
            }
          },
          "billing": {
            "type": "object", "required": ["nonempty_only", "unbilled_errors"], "additionalProperties": false,
            "properties": {
              "nonempty_only": {"type": "boolean"},
              "unbilled_errors": {"type": "array", "items": {"enum": ["timeout"]}, "uniqueItems": true}
            }
          },
          "service_refused_statuses": {
            "type": "array",
            "items": {"type": "integer", "minimum": 400, "maximum": 499},
            "uniqueItems": true
          },
          "tool_only": {"type": "boolean"},
          "auto_enroll": {
            "type": "boolean",
            "description": "Whether an official model Source joins search automatically; tool-only Sources do not use this field."
          }
        }
      }
    }
  }
}
