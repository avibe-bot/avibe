{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/apply-transition-algebra.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "axes",
    "stable_writer",
    "precondition_rules",
    "idempotency",
    "share_binding_allocator",
    "binding_semantics",
    "email_semantics",
    "transition_effects",
    "normalization"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "owner": { "const": "LocalApplyTransitionAlgebra" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "source_mode",
        "target_mode",
        "source_binding",
        "share_intent",
        "binding_relation",
        "share_candidate_status",
        "email_relation",
        "expected_revision",
        "mutation_status"
      ],
      "properties": {
        "availability": { "const": ["active", "offline"] },
        "source_mode": { "const": ["private", "limited", "public"] },
        "target_mode": { "const": ["private", "limited", "public"] },
        "source_binding": { "const": ["none", "bound"] },
        "share_intent": { "const": ["preserve_or_allocate", "rotate", "custom"] },
        "binding_relation": { "const": ["same", "different"] },
        "share_candidate_status": { "const": ["not_required", "available", "owned_by_other_page"] },
        "email_relation": { "const": ["same", "different", "invalid_for_target"] },
        "expected_revision": { "const": ["current", "stale"] },
        "mutation_status": { "const": ["new", "same_payload", "different_payload"] }
      }
    },
    "stable_writer": {
      "const": {
        "owner": "controller_process.ShowAccessService under ShowAccessService.stable_writer_lease",
        "scope": "page_id",
        "serialized_operations": ["apply", "durable_availability_transition"],
        "direct_availability_writer_allowed": false,
        "transaction_fields": ["availability", "access_mode", "share_binding", "emails", "audience_revision", "last_mutation", "apply_receipt"],
        "availability_transition": {
          "input": ["page_id", "target_availability", "expected_audience_revision"],
          "apply_may_change_availability": false,
          "effective_change_preserves": ["access_mode", "share_binding", "emails"],
          "effective_change_revision_delta": 1,
          "canonical_no_op_revision_delta": 0,
          "stale_revision_outcome": "revision_conflict_without_write"
        },
        "race_linearization": "lease_order_then_expected_audience_revision_cas",
        "lost_effect_allowed": false
      }
    },
    "precondition_rules": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/precondition_rule" }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_owner", "key_fields", "value_fields", "lookup_order", "same_payload_action", "different_payload_action", "survives_later_apply", "atomic_with_effective_or_no_change_apply", "exposed_by_owner_settings_read", "canonical_request_sha256", "retention"],
      "properties": {
        "store_owner": { "const": "controller_process.ShowAccessStore" },
        "key_fields": { "const": ["page_id", "mutation_id"] },
        "value_fields": { "const": ["canonical_request_sha256", "terminal_result"] },
        "lookup_order": { "const": "before_expected_revision_cas" },
        "same_payload_action": { "const": "return_stored_terminal_result" },
        "different_payload_action": { "const": "reject_without_write" },
        "survives_later_apply": { "const": true },
        "atomic_with_effective_or_no_change_apply": { "const": true },
        "exposed_by_owner_settings_read": { "const": false },
        "canonical_request_sha256": {
          "const": {
            "owner": "CanonicalApplyReceipt",
            "input": "fully_normalized_apply_request",
            "included_fields": ["schema_version", "message_type", "page_id", "mutation_id", "expected_audience_revision", "target"],
            "excluded_context": ["route_authority", "actor_context"],
            "canonical_json": "RFC8785_JSON_Canonicalization_Scheme_recursive",
            "object_key_order": "lexicographic_recursive",
            "array_order": "preserved_after_field_normalization",
            "number_domain": "nonnegative_base10_integers_only",
            "text_encoding": "UTF-8",
            "digest": "SHA-256",
            "output_encoding": "lowercase_hex_64"
          }
        },
        "retention": {
          "const": {
            "lifetime": "page_lifetime",
            "time_eviction_allowed": false,
            "count_eviction_allowed": false,
            "cascade_delete_with_page": true
          }
        }
      }
    },
    "share_binding_allocator": {
      "const": {
        "owner": "controller_process.ShowAccessStore",
        "uniqueness_scope": "all_show_pages",
        "check_and_binding_write": "same_stable_writer_transaction",
        "same_page_existing_binding_allowed": true,
        "collision_outcome": "share_id_taken",
        "collision_store_write": false,
        "concurrent_collision_winners": 1
      }
    },
    "binding_semantics": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/binding_rule" }
    },
    "email_semantics": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/email_rule" }
    },
    "transition_effects": { "type": "object" },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "provider_specific_alias_normalization", "canonical_set_comparison", "reject_noncanonical_persisted_or_result"],
      "properties": {
        "steps": {
          "const": ["trim_ascii_surrounding_whitespace", "lowercase", "deduplicate", "unicode_codepoint_lexicographic_sort"]
        },
        "provider_specific_alias_normalization": { "const": false },
        "canonical_set_comparison": { "const": "exact" },
        "reject_noncanonical_persisted_or_result": { "const": true }
      }
    }
  },
  "$defs": {
    "selector_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      ]
    },
    "precondition_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "decision"],
      "properties": {
        "id": { "type": "string", "pattern": "^PRECONDITION-[A-Z0-9-]+$" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_status", "expected_revision", "email_relation"],
          "properties": {
            "mutation_status": { "$ref": "#/$defs/selector_value" },
            "expected_revision": { "$ref": "#/$defs/selector_value" },
            "email_relation": { "$ref": "#/$defs/selector_value" }
          }
        },
        "decision": {
          "enum": [
            "idempotent_replay",
            "mutation_conflict",
            "revision_conflict",
            "invalid_target",
            "evaluate_local_transition"
          ]
        }
      }
    },
    "binding_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "allowed_relation", "candidate_required", "outcome"],
      "properties": {
        "id": { "type": "string", "pattern": "^BINDING-[A-Z0-9-]+$" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_binding", "target_mode", "share_intent"],
          "properties": {
            "source_binding": { "$ref": "#/$defs/selector_value" },
            "target_mode": { "$ref": "#/$defs/selector_value" },
            "share_intent": { "$ref": "#/$defs/selector_value" }
          }
        },
        "allowed_relation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["same", "different"] }
        },
        "candidate_required": { "type": "boolean" },
        "outcome": { "enum": ["preserved", "none", "allocated", "rotated", "custom"] }
      }
    },
    "email_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "allowed_relation"],
      "properties": {
        "id": { "type": "string", "pattern": "^EMAIL-[A-Z0-9-]+$" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_mode", "target_mode"],
          "properties": {
            "source_mode": { "$ref": "#/$defs/selector_value" },
            "target_mode": { "$ref": "#/$defs/selector_value" }
          }
        },
        "allowed_relation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["same", "different"] }
        }
      }
    }
  }
}
