{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/local-legacy-mapping.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "scope", "initial_audience_revision", "email_initialization", "hosted_import_allowed", "dual_write_allowed", "mapping_rules", "malformed_source_policy", "invalid_source_vectors", "cases"],
  "properties": {
    "schema_version": { "const": 2 },
    "owner": { "const": "LocalLegacyShowAccessMapper" },
    "scope": { "const": "local_sqlite_schema_migration_only" },
    "initial_audience_revision": { "const": 0 },
    "email_initialization": { "const": "empty" },
    "hosted_import_allowed": { "const": false },
    "dual_write_allowed": { "const": false },
    "mapping_rules": {
      "const": {
        "private": { "availability": "active", "access_mode": "private" },
        "public": { "availability": "active", "access_mode": "public" },
        "offline": { "availability": "offline", "access_mode": "private" },
        "share_binding": {
          "non_null_valid_v2_share_id": "retain_as_stable_binding_even_when_inactive",
          "null_share_id": "map_to_null_binding"
        }
      }
    },
    "malformed_source_policy": {
      "const": {
        "input_boundary": "released_unconstrained_legacy_strings",
        "known_visibility_values": ["private", "public", "offline"],
        "valid_share_id_contract": "show-access.schema.json#/$defs/share_id",
        "trigger": "unknown_visibility_or_non_null_invalid_v2_share_id",
        "result": {
          "schema_version": 2,
          "availability": "offline",
          "access_mode": "private",
          "share_binding": null,
          "audience_revision": 0,
          "emails": [],
          "last_mutation": null
        },
        "shared_route_admitted": false,
        "startup_aborted": false,
        "warning_code": "legacy_show_access_source_degraded_fail_closed"
      }
    },
    "invalid_source_vectors": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^LOCAL-LEGACY-INVALID-[A-Z0-9-]+$" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "cases": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "legacy_visibility", "share_id"],
      "properties": {
        "page_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id" },
        "legacy_visibility": { "type": "string" },
        "share_id": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "result", "shared_route_admitted"],
      "properties": {
        "id": { "type": "string", "pattern": "^LOCAL-LEGACY-[A-Z0-9-]+$" },
        "source": { "$ref": "#/$defs/source" },
        "result": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json" },
        "shared_route_admitted": { "type": "boolean" }
      }
    }
  }
}
