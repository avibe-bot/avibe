{
  "schema_version": 2,
  "owner": "LocalApplyTransitionAlgebra",
  "axes": {
    "availability": ["active", "offline"],
    "source_mode": ["private", "limited", "public"],
    "target_mode": ["private", "limited", "public"],
    "source_binding": ["none", "bound"],
    "share_intent": ["preserve_or_allocate", "rotate", "custom"],
    "binding_relation": ["same", "different"],
    "share_candidate_status": ["not_required", "available", "owned_by_other_page"],
    "email_relation": ["same", "different", "invalid_for_target"],
    "expected_revision": ["current", "stale"],
    "mutation_status": ["new", "same_payload", "different_payload"]
  },
  "precondition_rules": [
    {
      "id": "PRECONDITION-IDEMPOTENT-REPLAY",
      "selector": { "mutation_status": "same_payload", "expected_revision": "*", "email_relation": "*" },
      "decision": "idempotent_replay"
    },
    {
      "id": "PRECONDITION-MUTATION-CONFLICT",
      "selector": { "mutation_status": "different_payload", "expected_revision": "*", "email_relation": "*" },
      "decision": "mutation_conflict"
    },
    {
      "id": "PRECONDITION-REVISION-CONFLICT",
      "selector": { "mutation_status": "new", "expected_revision": "stale", "email_relation": "*" },
      "decision": "revision_conflict"
    },
    {
      "id": "PRECONDITION-INVALID-TARGET",
      "selector": {
        "mutation_status": "new",
        "expected_revision": "current",
        "email_relation": "invalid_for_target"
      },
      "decision": "invalid_target"
    },
    {
      "id": "PRECONDITION-EVALUATE-LOCAL-TRANSITION",
      "selector": {
        "mutation_status": "new",
        "expected_revision": "current",
        "email_relation": ["same", "different"]
      },
      "decision": "evaluate_local_transition"
    }
  ],
  "idempotency": {
    "store_owner": "controller_process.ShowAccessStore",
    "key_fields": ["page_id", "mutation_id"],
    "value_fields": ["canonical_request_sha256", "terminal_result"],
    "lookup_order": "before_expected_revision_cas",
    "same_payload_action": "return_stored_terminal_result",
    "different_payload_action": "reject_without_write",
    "survives_later_apply": true,
    "atomic_with_effective_or_no_change_apply": true,
    "exposed_by_owner_settings_read": false,
    "canonical_request_sha256": {
      "owner": "CanonicalApplyReceipt",
      "input": "fully_normalized_apply_request",
      "included_fields": ["schema_version", "message_type", "page_id", "mutation_id", "expected_audience_revision", "target"],
      "excluded_context": ["route_authority", "actor_context"],
      "canonical_json": "RFC8785_JSON_Canonicalization_Scheme_recursive",
      "object_key_order": "lexicographic_recursive",
      "array_order": "preserved_after_field_normalization",
      "number_domain": "nonnegative_base10_integers_only",
      "text_encoding": "UTF-8",
      "digest": "SHA-256",
      "output_encoding": "lowercase_hex_64"
    },
    "retention": {
      "lifetime": "page_lifetime",
      "time_eviction_allowed": false,
      "count_eviction_allowed": false,
      "cascade_delete_with_page": true
    }
  },
  "share_binding_allocator": {
    "owner": "controller_process.ShowAccessStore",
    "uniqueness_scope": "all_show_pages",
    "check_and_binding_write": "same_stable_writer_transaction",
    "same_page_existing_binding_allowed": true,
    "collision_outcome": "share_id_taken",
    "collision_store_write": false,
    "concurrent_collision_winners": 1
  },
  "binding_semantics": [
    {
      "id": "BINDING-PRESERVE-BOUND",
      "selector": {
        "source_binding": "bound",
        "target_mode": "*",
        "share_intent": "preserve_or_allocate"
      },
      "allowed_relation": ["same"],
      "candidate_required": false,
      "outcome": "preserved"
    },
    {
      "id": "BINDING-PRIVATE-NONE-STAYS-NONE",
      "selector": {
        "source_binding": "none",
        "target_mode": "private",
        "share_intent": "preserve_or_allocate"
      },
      "allowed_relation": ["same"],
      "candidate_required": false,
      "outcome": "none"
    },
    {
      "id": "BINDING-FIRST-SHARE-ALLOCATES",
      "selector": {
        "source_binding": "none",
        "target_mode": ["limited", "public"],
        "share_intent": "preserve_or_allocate"
      },
      "allowed_relation": ["different"],
      "candidate_required": true,
      "outcome": "allocated"
    },
    {
      "id": "BINDING-ROTATE-REPLACES",
      "selector": {
        "source_binding": "*",
        "target_mode": "*",
        "share_intent": "rotate"
      },
      "allowed_relation": ["different"],
      "candidate_required": true,
      "outcome": "rotated"
    },
    {
      "id": "BINDING-CUSTOM-NONE-ALLOCATES",
      "selector": {
        "source_binding": "none",
        "target_mode": "*",
        "share_intent": "custom"
      },
      "allowed_relation": ["different"],
      "candidate_required": true,
      "outcome": "custom"
    },
    {
      "id": "BINDING-CUSTOM-BOUND-CAN-MATCH-OR-REPLACE",
      "selector": {
        "source_binding": "bound",
        "target_mode": "*",
        "share_intent": "custom"
      },
      "allowed_relation": ["same", "different"],
      "candidate_required": true,
      "outcome": "custom"
    }
  ],
  "email_semantics": [
    {
      "id": "EMAIL-LIMITED-TO-LIMITED",
      "selector": { "source_mode": "limited", "target_mode": "limited" },
      "allowed_relation": ["same", "different"]
    },
    {
      "id": "EMAIL-LIMITED-TO-NONLIMITED-CLEARS",
      "selector": { "source_mode": "limited", "target_mode": ["private", "public"] },
      "allowed_relation": ["different"]
    },
    {
      "id": "EMAIL-NONLIMITED-TO-LIMITED-INSTALLS",
      "selector": { "source_mode": ["private", "public"], "target_mode": "limited" },
      "allowed_relation": ["different"]
    },
    {
      "id": "EMAIL-NONLIMITED-TO-NONLIMITED-STAYS-EMPTY",
      "selector": { "source_mode": ["private", "public"], "target_mode": ["private", "public"] },
      "allowed_relation": ["same"]
    }
  ],
  "transition_effects": {
    "effective_change_when_any": [
      "source_mode != target_mode",
      "binding_relation == different",
      "email_relation == different"
    ],
    "changed": {
      "outcome": "applied",
      "audience_revision_delta": 1,
      "atomic_fields": ["access_mode", "share_binding", "emails", "audience_revision", "last_mutation", "apply_receipt"]
    },
    "unchanged": {
      "outcome": "no_change",
      "audience_revision_delta": 0,
      "atomic_fields": ["last_mutation", "apply_receipt"]
    },
    "all_terminal_or_rejected": {
      "availability": "preserved",
      "external_service_calls": 0,
      "partially_authoritative_state_allowed": false
    }
  },
  "normalization": {
    "steps": ["trim_ascii_surrounding_whitespace", "lowercase", "deduplicate", "unicode_codepoint_lexicographic_sort"],
    "provider_specific_alias_normalization": false,
    "canonical_set_comparison": "exact",
    "reject_noncanonical_persisted_or_result": true
  }
}
