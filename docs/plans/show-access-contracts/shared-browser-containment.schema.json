{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/shared-browser-containment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "canonical_public_url", "trusted_shell", "service_worker_policy", "admission_rule", "runtime_capture_admission", "share_browsing_credential", "protected_request_validation", "browser_request_shapes", "credentialless_cors", "api_mutation_cases", "vendor_assets", "cross_share_isolation", "expiry_reclamation", "failure_responses", "dependency_cases", "residual_evidence", "cases"],
  "properties": {
    "schema_version": { "const": 2 },
    "owner": { "const": "SharedViewerBrowserContainment" },
    "canonical_public_url": { "const": "/p/<share_id>/" },
    "trusted_shell": {
      "const": {
        "implementation_owner": "avibe",
        "arbitrary_page_code_location": "sandboxed_opaque_origin_iframe",
        "iframe_sandbox_tokens": ["allow-scripts"],
        "allow_same_origin": false,
        "frame_ancestor": "trusted_platform_shell_only",
        "bootstrap_forbidden_fields": ["identity", "session_id", "workspace_path", "source_path", "annotations", "hmr", "runtime_context"],
        "page_code_access": {
          "other_share_dom": false,
          "platform_cookies": false,
          "cross_share_cors": false,
          "platform_service_worker": false,
          "opener": false,
          "ambient_identity_credential": false
        }
      }
    },
    "service_worker_policy": {
      "const": {
        "execution_context": "sandboxed_opaque_origin_iframe_without_allow_same_origin",
        "registration_supported": false,
        "registration_outcome": "security_error",
        "service_worker_allowed_header_emitted": false,
        "controls_public_show": false,
        "controls_canonical_show": false,
        "private_bytes_exposed": false,
        "ordinary_web_worker_support_is_separate": true,
        "residual_browser_evidence": "future_local_incus_real_browser"
      }
    },
    "admission_rule": {
      "const": {
        "owner": "avibe.SharedViewerBrowserContainment",
        "inputs": ["availability", "access_mode", "verified_identity", "current_local_membership"],
        "capability_issued_when": [
          { "availability": "active", "access_mode": "public", "verified_identity": "not_required", "current_local_membership": "not_required" },
          { "availability": "active", "access_mode": "limited", "verified_identity": "required", "current_local_membership": "required" }
        ],
        "default_outcome": "generic_deny_without_capability_or_page_bytes",
        "authorization_precedes_capture": true
      }
    },
    "runtime_capture_admission": {
      "const": {
        "request_trust": "internal_avibe_server_only",
        "request_fields": ["session_id", "instance_id", "page_id", "share_id", "audience_revision", "validated_shared_context"],
        "authorization_precedes_capture": true,
        "result_fields": ["namespace_handle", "document_handle", "expires_at"],
        "result_values_opaque": true,
        "browser_supplied_context_allowed": false,
        "browser_visible_session_or_path_fields": false
      }
    },
    "share_browsing_credential": {
      "const": {
        "issuer": "local_avibe_after_admission_rule",
        "binding_fields": ["instance_id", "page_id", "share_id", "audience_revision", "namespace_handle", "document_handle"],
        "server_record_fields": ["instance_id", "page_id", "share_id", "audience_revision", "namespace_handle", "document_handle", "admitted_normalized_email_if_limited", "expires_at"],
        "entropy_bits": 256,
        "derived_from_binding_or_path": false,
        "lifetime": "short_lived_nonrenewable",
        "storage": "ephemeral_trusted_shell_bootstrap_only",
        "browser_cookie": false,
        "backend_identity_assertion": false,
        "instance_access_context": false,
        "instance_role": false,
        "editor_capability": false,
        "transport": {
          "location": "opaque_protected_route_namespace_segment",
          "header_allowed": false,
          "query_allowed": false,
          "fragment_allowed": false,
          "ambient_cookie_allowed": false,
          "request_credentials": "omit",
          "referrer_policy": "no-referrer"
        },
        "required_surfaces": ["document", "module", "css", "raw", "worker", "spa_fallback", "api_handler"],
        "revision_mismatch_outcome": "reresolve_share_and_membership_before_new_credential"
      }
    },
    "protected_request_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "invoked_for_surfaces", "invoked_for_methods", "local_linearization", "runtime_linearization", "audience_revision_policy", "input_space", "valid_point_constraints", "decision_semantics", "decision_rules", "post_mint_transition_cases", "loaded_guest_document_policy", "instance_resource_acl_revision_is_orthogonal"],
      "properties": {
        "owner": {"const": "SharedViewerBrowserContainment.protected_request_validation"},
        "invoked_for_surfaces": {"const": ["document", "module", "css", "raw", "worker", "spa_fallback", "api_handler"]},
        "invoked_for_methods": {"const": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]},
        "local_linearization": {
          "const": {
            "transaction": "one_authoritative_ShowAccess_snapshot",
            "checks": ["page_exists", "availability_is_active", "access_mode_is_limited_or_public", "exact_share_binding_matches", "audience_revision_matches_capability", "limited_admitted_email_is_current_member", "capability_not_expired"],
            "runtime_audience_decision_allowed": false
          }
        },
        "runtime_linearization": {
          "const": {
            "after_local_validation": true,
            "operation": "atomically_pin_live_namespace_and_document_handle",
            "checks": ["capability_namespace_document_binding_matches", "namespace_is_live"],
            "in_flight_pin": "request_linearized_before_change_may_finish",
            "later_request": "must_repeat_full_validation"
          }
        },
        "audience_revision_policy": {
          "const": {
            "request_admission_revision_field": "ShowAccess.audience_revision",
            "durable_availability_transition_advances_once": true,
            "audience_or_binding_change_advances_once": true,
            "no_op_advances": false,
            "apply_may_mutate_availability": false,
            "separate_capability_revision_allowed": false
          }
        },
        "input_space": {
          "const": {
            "capability_integrity": ["valid", "invalid"],
            "page_state": ["present", "missing"],
            "availability": ["active", "offline"],
            "access_mode": ["limited", "public", "private"],
            "share_binding": ["match", "mismatch"],
            "audience_revision": ["match", "mismatch"],
            "capability_lifetime": ["live", "expired"],
            "namespace_binding": ["match", "mismatch"],
            "namespace_liveness": ["live", "idle_expired", "absolute_expired", "reclaimed"],
            "limited_membership": ["current", "absent", "not_applicable"]
          }
        },
        "valid_point_constraints": {"const": ["limited_requires_membership_current_or_absent", "public_or_private_requires_membership_not_applicable"]},
        "decision_semantics": {"const": "ordered_first_match_then_runtime_pin"},
        "decision_rules": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "stage", "field", "equals", "outcome"],
            "properties": {
              "id": {"type": "string", "pattern": "^PROTECTED-[A-Z0-9-]+$"},
              "stage": {"enum": ["local", "runtime"]},
              "field": {"enum": ["capability_integrity", "page_state", "capability_lifetime", "share_binding", "availability", "access_mode", "audience_revision", "limited_membership", "namespace_binding", "namespace_liveness", "all_prior_checks"]},
              "equals": {"type": "string"},
              "outcome": {"enum": ["fixed_sanitized_expired", "fixed_sanitized_not_found", "fixed_stale_document_reload_required", "serve_pinned_shared_response"]}
            }
          }
        },
        "post_mint_transition_cases": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision_advance", "later_request_outcome", "in_flight_outcome"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
              "revision_advance": {"type": "integer", "minimum": 0, "maximum": 2},
              "later_request_outcome": {"enum": ["serve_pinned_shared_response", "fixed_sanitized_not_found", "fixed_sanitized_expired", "fixed_stale_document_reload_required"]},
              "in_flight_outcome": {"const": "finish_pinned_response"}
            }
          }
        },
        "loaded_guest_document_policy": {"const": "never_actively_close_dom_or_javascript"},
        "instance_resource_acl_revision_is_orthogonal": {"const": true}
      }
    },
    "browser_request_shapes": {
      "const": [
        {
          "id": "SHARED-BROWSER-SHELL",
          "route": "/p/<share_id>/",
          "required_inputs": ["share_id"],
          "forbidden_inputs": ["session_id", "workspace_path", "source_path", "runtime_context"]
        },
        {
          "id": "SHARED-BROWSER-DOCUMENT",
          "route": "/p/<share_id>/__shared/<capability>/document/<namespace_handle>/<document_handle>",
          "required_inputs": ["share_id", "namespace_handle", "document_handle", "capability"],
          "forbidden_inputs": ["session_id", "workspace_path", "source_path", "runtime_context"]
        },
        {
          "id": "SHARED-BROWSER-RESOURCE",
          "route": "/p/<share_id>/__shared/<capability>/resource/<namespace_handle>/<document_handle>/<resource_key>",
          "required_inputs": ["share_id", "namespace_handle", "document_handle", "resource_key", "capability"],
          "forbidden_inputs": ["session_id", "workspace_path", "source_path", "runtime_context"]
        },
        {
          "id": "SHARED-BROWSER-API",
          "route": "/p/<share_id>/__shared/<capability>/api/<namespace_handle>/<document_handle>/<api_route>",
          "required_inputs": ["share_id", "namespace_handle", "document_handle", "api_route", "capability"],
          "forbidden_inputs": ["session_id", "workspace_path", "source_path", "runtime_context"]
        }
      ]
    },
    "credentialless_cors": {
      "const": {
        "surfaces": ["document", "module", "css", "raw", "worker", "spa_fallback", "api_handler"],
        "request_credentials": "omit",
        "access_control_allow_origin": "*",
        "access_control_allow_credentials": false,
        "set_cookie_allowed": false,
        "referrer_policy": "no-referrer",
        "options": {
          "allowed_methods": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"],
          "allowed_headers": ["Content-Type"],
          "access_control_allow_origin": "*",
          "access_control_allow_credentials": false,
          "set_cookie_allowed": false,
          "cache_control": "private, no-store",
          "capability_source": "opaque_route_namespace_segment",
          "valid_capability_requires": [
            "capability_integrity_and_entropy",
            "protected_request_validation"
          ],
          "admission_proof": "capability_minted_only_after_admission_rule",
          "ambient_identity_or_cookie_recheck": false,
          "valid_capability_outcome": "credentialless_preflight_allowed",
          "invalid_capability_outcome": "fixed_sanitized_not_found"
        }
      }
    },
    "api_mutation_cases": {
      "const": [
        { "method": "POST", "content_type": "application/json", "capability": "valid_matching_binding", "actor": "admitted_shared_document", "outcome": "serve_shared_api" },
        { "method": "PUT", "content_type": "application/json", "capability": "valid_matching_binding", "actor": "admitted_shared_document", "outcome": "serve_shared_api" },
        { "method": "PATCH", "content_type": "application/json", "capability": "valid_matching_binding", "actor": "admitted_shared_document", "outcome": "serve_shared_api" },
        { "method": "DELETE", "content_type": "application/json", "capability": "valid_matching_binding", "actor": "admitted_shared_document", "outcome": "serve_shared_api" },
        { "method": "DELETE", "content_type": "application/json", "capability": "unavailable", "actor": "public_sibling_page_code", "outcome": "fixed_sanitized_not_found" }
      ]
    },
    "vendor_assets": {
      "const": {
        "representation": "namespace_scoped",
        "global_hashed_public_assets_allowed": false,
        "capability_required": true,
        "cross_namespace_reuse": false
      }
    },
    "cross_share_isolation": {
      "const": {
        "public_sibling_can_obtain_limited_shell_bootstrap": false,
        "public_sibling_can_obtain_namespace_handle": false,
        "public_sibling_can_obtain_capability": false,
        "public_sibling_can_read_platform_cookies": false,
        "public_sibling_can_read_limited_dom": false,
        "public_sibling_can_read_protected_cors_response": false,
        "public_sibling_can_register_service_worker": false,
        "public_sibling_can_retain_readable_opener": false,
        "public_sibling_can_read_protected_bytes": false,
        "trusted_shell_current_member_can_load": true,
        "trusted_shell_public_anonymous_can_load": true
      }
    },
    "expiry_reclamation": {
      "const": {
        "lifetime_owner": "runtime-context.json#/namespace_lifetime",
        "capability_expires_no_later_than_namespace": true,
        "reclaim_unit": "namespace_handles_and_capabilities",
        "expired_outcome": "fixed_sanitized_expired"
      }
    },
    "failure_responses": {
      "const": [
        { "condition": "not_found", "outcome": "fixed_sanitized_not_found", "page_bytes": false, "path_bytes": false },
        { "condition": "invalid_capability", "outcome": "fixed_sanitized_not_found", "page_bytes": false, "path_bytes": false },
        { "condition": "overload", "outcome": "bounded_sanitized_retryable_unavailable", "page_bytes": false, "path_bytes": false },
        { "condition": "expired", "outcome": "fixed_sanitized_expired", "page_bytes": false, "path_bytes": false }
      ]
    },
    "dependency_cases": {
      "const": [
        { "kind": "history_navigation", "surface": "document", "capability_required": true, "same_namespace": true },
        { "kind": "worker_import", "surface": "module", "capability_required": true, "same_namespace": true },
        { "kind": "api_request", "surface": "api_handler", "capability_required": true, "same_namespace": true },
        { "kind": "css_import", "surface": "module", "capability_required": true, "same_namespace": true },
        { "kind": "raw_import", "surface": "module", "capability_required": true, "same_namespace": true }
      ]
    },
    "residual_evidence": {
      "const": {
        "browser_sandbox_cors": "future_local_incus_real_browser",
        "contract_proof_is_browser_conformance": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "scenario_ids", "actor", "attempt", "access_mode", "identity", "credential", "membership", "outcome"],
        "properties": {
          "id": { "type": "string", "pattern": "^CONTAINMENT-[A-Z0-9-]+$" },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
          },
          "actor": { "enum": ["trusted_platform_shell", "public_sibling_page_code"] },
          "attempt": { "enum": ["load_protected_shared_document", "fetch_limited_share", "frame_limited_share", "open_and_read_limited_share"] },
          "access_mode": { "enum": ["limited", "public"] },
          "identity": { "enum": ["anonymous", "verified"] },
          "credential": { "enum": ["valid_matching_binding", "unavailable", "stale_audience_revision"] },
          "membership": { "enum": ["current", "removed", "not_required", "not_evaluated"] },
          "outcome": { "enum": ["serve_shared", "generic_deny_without_page_bytes"] }
        }
      }
    }
  }
}
