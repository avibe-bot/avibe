{
  "schema_version": 2,
  "owner": "ApplyInvocationAuthorization",
  "boundary": "local_http_before_controller_ipc",
  "allowed_authorities": ["owner", "sharing_control"],
  "cases": [
    {
      "authority": "owner",
      "outcome": "allow",
      "controller_called": true,
      "store_read": true,
      "store_write": "depends_on_transition"
    },
    {
      "authority": "sharing_control",
      "outcome": "allow",
      "controller_called": true,
      "store_read": true,
      "store_write": "depends_on_transition"
    },
    {
      "authority": "resource_viewer",
      "outcome": "deny",
      "controller_called": false,
      "store_read": false,
      "store_write": false
    },
    {
      "authority": "page_member_only",
      "outcome": "deny",
      "controller_called": false,
      "store_read": false,
      "store_write": false
    },
    {
      "authority": "anonymous",
      "outcome": "deny",
      "controller_called": false,
      "store_read": false,
      "store_write": false
    }
  ]
}
