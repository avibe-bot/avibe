{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json",
  "title": "Local Show access Apply v2",
  "oneOf": [
    { "$ref": "#/$defs/apply_request" },
    { "$ref": "#/$defs/terminal_result" },
    { "$ref": "#/$defs/rejected_result" }
  ],
  "$defs": {
    "email_input": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^.*@.*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_mode", "share_intent", "custom_share_id", "emails"],
      "properties": {
        "access_mode": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/access_mode"
        },
        "share_intent": { "enum": ["preserve_or_allocate", "rotate", "custom"] },
        "custom_share_id": {
          "oneOf": [
            { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id" },
            { "type": "null" }
          ]
        },
        "emails": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/email_input" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "access_mode": { "const": "limited" } }, "required": ["access_mode"] },
          "then": { "properties": { "emails": { "minItems": 1 } } },
          "else": { "properties": { "emails": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "share_intent": { "const": "custom" } }, "required": ["share_intent"] },
          "then": {
            "properties": {
              "custom_share_id": {
                "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id"
              }
            }
          },
          "else": { "properties": { "custom_share_id": { "type": "null" } } }
        }
      ]
    },
    "apply_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "page_id",
        "mutation_id",
        "expected_audience_revision",
        "target"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "message_type": { "const": "apply_request" },
        "page_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id"
        },
        "mutation_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id"
        },
        "expected_audience_revision": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/revision"
        },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "terminal_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "outcome", "page_id", "mutation_id", "show_access"],
      "properties": {
        "schema_version": { "const": 2 },
        "message_type": { "const": "apply_result" },
        "outcome": { "enum": ["applied", "no_change", "idempotent_replay"] },
        "page_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id"
        },
        "mutation_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id"
        },
        "show_access": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json"
        }
      }
    },
    "rejected_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "outcome", "page_id", "mutation_id", "effects"],
      "properties": {
        "schema_version": { "const": 2 },
        "message_type": { "const": "apply_rejected" },
        "outcome": {
          "enum": ["revision_conflict", "mutation_conflict", "invalid_target", "share_id_taken", "page_mismatch", "unauthorized"]
        },
        "page_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id"
        },
        "mutation_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id"
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controller_called", "store_write", "external_service_call"],
          "properties": {
            "controller_called": { "type": "boolean" },
            "store_write": { "const": false },
            "external_service_call": { "const": false }
          }
        }
      }
    }
  }
}
