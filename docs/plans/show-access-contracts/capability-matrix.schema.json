{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/capability-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "axes", "authority_axes", "global_invariants", "rules"],
  "properties": {
    "schema_version": { "const": 2 },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "availability", "access_mode", "request_kind", "resource_authority", "identity_state", "page_membership", "keyed_context"],
      "properties": {
        "surface": { "const": ["/p", "/show"] },
        "availability": { "const": ["active", "offline"] },
        "access_mode": { "const": ["private", "limited", "public"] },
        "request_kind": { "const": ["trusted_top_level_navigation", "other"] },
        "resource_authority": { "const": ["none", "viewer", "editor"] },
        "identity_state": { "const": ["unverified", "verified"] },
        "page_membership": { "const": ["absent", "current"] },
        "keyed_context": { "const": ["supported", "unsupported", "transient-unknown"] }
      }
    },
    "authority_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_authority_source", "page_membership_source", "independent", "page_membership_creates_instance_access_context", "page_membership_creates_instance_role", "editor_capability_source"],
      "properties": {
        "resource_authority_source": { "const": "existing_instance_and_resource_authorization" },
        "page_membership_source": { "const": "fresh_local_show_access_email_lookup" },
        "independent": { "const": true },
        "page_membership_creates_instance_access_context": { "const": false },
        "page_membership_creates_instance_role": { "const": false },
        "editor_capability_source": { "const": "resource_editor_only" }
      }
    },
    "global_invariants": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "rules": {
      "type": "array",
      "minItems": 17,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
    },
    "selector_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      ]
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertion", "scenario_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^INVARIANT-[A-Z0-9-]+$" },
        "assertion": { "type": "string", "minLength": 3 },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_decision", "runtime_context", "show_editor_capability", "hmr", "annotations", "top_level_redirect", "redirect_role"],
      "properties": {
        "read_decision": { "enum": ["deny", "login_required", "serve_shared", "redirect_private", "serve_private"] },
        "runtime_context": { "oneOf": [{ "enum": ["private", "shared"] }, { "type": "null" }] },
        "show_editor_capability": { "type": "boolean" },
        "hmr": { "type": "boolean" },
        "annotations": { "type": "boolean" },
        "top_level_redirect": { "type": "boolean" },
        "redirect_role": { "oneOf": [{ "enum": ["viewer", "editor"] }, { "type": "null" }] }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "decision", "scenario_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^MATRIX-[A-Z0-9-]+$" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "availability", "access_mode", "request_kind", "resource_authority", "identity_state", "page_membership", "keyed_context"],
          "properties": {
            "surface": { "$ref": "#/$defs/selector_value" },
            "availability": { "$ref": "#/$defs/selector_value" },
            "access_mode": { "$ref": "#/$defs/selector_value" },
            "request_kind": { "$ref": "#/$defs/selector_value" },
            "resource_authority": { "$ref": "#/$defs/selector_value" },
            "identity_state": { "$ref": "#/$defs/selector_value" },
            "page_membership": { "$ref": "#/$defs/selector_value" },
            "keyed_context": { "$ref": "#/$defs/selector_value" }
          }
        },
        "decision": { "$ref": "#/$defs/decision" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" }
      }
    }
  }
}
