{
  "schema_version": 1,
  "protocol": {
    "version": 1,
    "protocol_header": "X-Avibe-Show-Protocol",
    "context_header": "X-Avibe-Show-Context",
    "keyed_context_feature": "show-context-key-v1",
    "contexts": ["private", "shared"]
  },
  "request_protocol_cases": [
    {
      "id": "released_headerless",
      "protocol_header": "absent",
      "context_header": "ignored",
      "outcome": "legacy_singleton",
      "legacy_base_header": "x-vibe-show-base",
      "legacy_base_propagation": [
        "entry_http",
        "module_http",
        "spa_fallback_http",
        "startup_reconciliation_prewarm",
        "show_update_prewarm"
      ],
      "keyed_context_enabled": false
    },
    {
      "id": "declared_v1",
      "protocol_header": "1",
      "context_header": "required_private_or_shared",
      "outcome": "keyed_context"
    },
    {
      "id": "unknown_protocol",
      "protocol_header": "unsupported_value",
      "context_header": "ignored",
      "outcome": "reject"
    }
  ],
  "negotiation_cases": [
    {
      "id": "supported",
      "evidence": "protocol_1_with_feature",
      "outcome": "supported",
      "process_cache": "permanent",
      "redirect_eligible": true,
      "request_before_next_probe": "shared"
    },
    {
      "id": "unsupported",
      "evidence": "definitive_legacy",
      "outcome": "unsupported",
      "process_cache": "permanent",
      "redirect_eligible": true,
      "request_before_next_probe": "shared"
    },
    {
      "id": "transient_unknown",
      "evidence": "transient_or_malformed",
      "outcome": "transient-unknown",
      "process_cache": "retry_deadline",
      "redirect_eligible": true,
      "request_before_next_probe": "shared"
    }
  ],
  "app_graph_operations": [
    "entry_http",
    "module_http",
    "spa_fallback_http",
    "api_handler_http",
    "shared_capture_admission",
    "private_hmr_websocket",
    "startup_reconciliation_prewarm",
    "show_update_prewarm"
  ],
  "loopback_request_boundary": {
    "id": "RUNTIME-TRUSTED-LOOPBACK-ENVELOPE",
    "browser_supplied_headers_removed": [
      "X-Avibe-Show-Protocol",
      "X-Avibe-Show-Context"
    ],
    "server_owned_envelope_count": 1,
    "server_owned_envelope_source": "show_capability_decision",
    "applies_to_operations": [
      "entry_http",
      "module_http",
      "spa_fallback_http",
      "api_handler_http",
      "shared_capture_admission",
      "private_hmr_websocket",
      "startup_reconciliation_prewarm",
      "show_update_prewarm"
    ]
  },
  "protocol1_validation": {
    "id": "RUNTIME-PROTOCOL1-PRE-MUTATION-VALIDATION",
    "valid_protocol": "1",
    "required_contexts": ["private", "shared"],
    "applies_to_operations": [
      "entry_http",
      "module_http",
      "spa_fallback_http",
      "api_handler_http",
      "shared_capture_admission",
      "private_hmr_websocket",
      "startup_reconciliation_prewarm",
      "show_update_prewarm"
    ],
    "validation_precedes": [
      "session_resolution",
      "graph_lookup",
      "graph_create",
      "graph_rebase",
      "graph_ownership_mutation",
      "hmr_connection"
    ],
    "invalid_context_outcome": "reject_without_graph_side_effects",
    "unknown_protocol_outcome": "reject_without_graph_side_effects"
  },
  "runtime_graph_ownership": {
    "id": "RUNTIME-SESSION-CONTEXT-GRAPH-OWNERSHIP",
    "graph_key": ["session_id", "context"],
    "context_values": ["private", "shared"],
    "maximum_contexts_per_session": 2,
    "private_lifecycle_independent_of": [
      "same_session_shared_startup",
      "same_session_shared_failure",
      "same_session_shared_traffic",
      "same_session_shared_rotation",
      "other_session_activity"
    ],
    "shared_rebase_scope": "same_session_shared_graph_only",
    "shared_activity_closes_private_hmr": false
  },
  "shared_capture_admission": {
    "id": "RUNTIME-INTERNAL-SHARED-CAPTURE-ADMISSION",
    "request_source": "trusted_avibe_server_envelope_only",
    "request_fields": ["session_id", "instance_id", "page_id", "share_id", "audience_revision", "context"],
    "required_context": "shared",
    "authorization_precedes_request": true,
    "browser_request_allowed": false,
    "browser_supplied_context_allowed": false,
    "result_fields": ["namespace_handle", "document_handle", "expires_at"],
    "result_reveals_session_or_path": false,
    "lifetime_owner": "namespace_lifetime",
    "failure_outcomes": ["fixed_sanitized_not_found", "bounded_sanitized_retryable_unavailable", "fixed_sanitized_expired"]
  },
  "operation_context_eligibility": {
    "id": "RUNTIME-EXPLICIT-OPERATION-CONTEXT-ELIGIBILITY",
    "ordinary_editor_file_edit": {
      "private_hmr_identity": "stable",
      "shared_graph_create": false,
      "shared_graph_rebase": false,
      "shared_background_build": false,
      "edit_count_input": "arbitrary_nonnegative_integer",
      "resource_bound": "resource_governance"
    },
    "shared_demand_operations": [
      "entry_http",
      "module_http",
      "spa_fallback_http",
      "api_handler_http"
    ],
    "explicit_shared_prewarm_operations": [
      "startup_reconciliation_prewarm",
      "show_update_prewarm"
    ],
    "shared_prewarm_requires": [
      "explicit_operation",
      "shared_context_envelope",
      "protocol1_validation",
      "resource_budget_admission"
    ],
    "implicit_shared_work_from_private_edit": false
  },
  "capability_cache": {
    "id": "RUNTIME-PROCESS-CAPABILITY-CACHE",
    "permanent_outcomes": ["supported", "unsupported"],
    "transient_outcome": "transient-unknown",
    "transient_retry": "jittered_exponential_backoff",
    "maximum_retry_delay_seconds": 5,
    "identity_inputs": ["runtime_process_identity", "runtime_base_url"],
    "identity_change_clears": ["all_outcomes", "retry_deadline"]
  },
  "shared_namespace_confinement": {
    "id": "RUNTIME-IMMUTABLE-OPAQUE-NAMESPACE",
    "capture": {
      "root_descriptor_confined": true,
      "descriptor_verified_before_and_after_copy": true,
      "snapshot_bytes_immutable": true,
      "transform_identity_fields": [
        "resolved_pathname",
        "query_loader_mode",
        "importer_identity",
        "representation_type"
      ]
    },
    "recursive_dependency_closure": {
      "dependency_kinds": ["tsx", "css", "raw_loader", "worker"],
      "namespace_relation": "same_opaque_namespace",
      "provenance": "immutable_captured",
      "nested_fs_path_allowed": false,
      "mutable_source_fallback_allowed": false,
      "cross_namespace_escape_allowed": false
    },
    "handle": {
      "opaque": true,
      "reveals_path_bytes": false,
      "source_path_reopen": "forbidden",
      "path_swap_existing_handle": "serve_captured_response_only",
      "new_admission_after_unsafe_path_swap": "deny_before_allocation"
    }
  },
  "namespace_lifetime": {
    "id": "RUNTIME-NON-RENEWABLE-NAMESPACE-LIFETIME",
    "idle_deadline_seconds": 1800,
    "absolute_lifetime_seconds": 7200,
    "successful_read_refreshes": "idle_deadline_only",
    "absolute_lifetime_renewable": false,
    "reclaim_unit": "whole_namespace",
    "expired_read_outcome": "fixed_stale_document_reload_required"
  },
  "resource_governance": {
    "id": "RUNTIME-PROCESS-WIDE-WEIGHTED-BUDGET",
    "budget_scope": "one_per_runtime_process",
    "weighted_resources": [
      "private_vite_contexts",
      "shared_vite_contexts",
      "opaque_namespaces",
      "opaque_handles",
      "snapshot_bytes"
    ],
    "hard_limit_dimensions": ["context_count", "weighted_memory_cost"],
    "runtime_and_per_session_limits": "finite",
    "per_session_bounds": true,
    "private_editor_reserve": "finite_nonzero",
    "private_editor_reserve_relation": "0 < reserve < process_wide_budget",
    "shared_may_consume_private_reserve": false,
    "reclaim_order": [
      "expired_namespaces",
      "oldest_shared_bundle_without_in_flight_request"
    ],
    "private_admission_reclaim": "any_shared_bundle_without_in_flight_request",
    "in_flight_pinning": "until_response_finishes_only",
    "shared_overload_outcome": "bounded_sanitized_retryable_unavailable"
  },
  "shared_proxy_policy": {
    "id": "AVIBE-SHARED-PROXY-CONFINEMENT",
    "service_worker_allowed_header": "strip",
    "maximum_service_worker_scope": "/p/<share_id>/",
    "editor_redirect_cache_control": "private, no-store",
    "response_policy_matrix": {
      "axes": {
        "audience_mode": ["public", "limited"],
        "surface": ["shell", "entry", "document", "module", "css", "raw", "worker", "spa_fallback", "api_handler", "redirect", "error"]
      },
      "rules": [
        {
          "audience_mode": "public",
          "surface": "*",
          "cache_control": "private, no-store",
          "vary": null
        },
        {
          "audience_mode": "limited",
          "surface": "*",
          "cache_control": "private, no-store",
          "vary": "Cookie"
        }
      ]
    },
    "cross_principal_response_reuse": false
  },
  "avibe_private_hmr_monitor": {
    "id": "AVIBE-PRIVATE-HMR-AUTHORITY",
    "owner": "PrivateHmrAuthority",
    "implementation_owner": "avibe",
    "runtime_implementation_owner": false,
    "websocket_admission": {
      "route": "/show/<page_id>/__vite_hmr",
      "authorization_checks": ["server_validated_origin_source", "resource_editor_authority"],
      "request_trust_classifier": {
        "reuse_functions": ["vibe.ui_server._websocket_is_local_request", "vibe.ui_server._websocket_trusted_public_origin_local_request", "vibe.ui_server._websocket_origin_matches_effective_request", "vibe.ui_server._remote_access_public_origin_matches"],
        "local_source_classes": ["direct_loopback", "explicit_setup_host", "wildcard_resolved_interface", "docker_loopback_bridge"],
        "remote_source_classes": ["configured_hosted_instance", "active_custom_hostname", "trusted_public_proxy"],
        "parallel_network_trust_model_allowed": false
      },
      "origin_header_cardinality": "exactly_one",
      "origin_normalization": ["lowercase_scheme", "normalized_dns_or_ip_host", "ipv4_mapped_normalization", "default_or_explicit_effective_port"],
      "origin_match": "exact_normalized_scheme_host_or_ip_and_effective_port",
      "never_authority": ["0.0.0.0", "::", "*", "raw_host_header", "untrusted_forwarded_metadata", "wildcard_match", "suffix_match"],
      "validation_order": "before_any_upstream_websocket_open",
      "rejection": {
        "outcome": "reject_without_upstream_websocket",
        "upstream_websocket_opened": false
      },
      "positive_source_cases": [
        {"id": "HMR-SOURCE-HOSTED-INSTANCE", "source_class": "configured_hosted_instance", "origin_headers": ["https://alice.avibe.bot"], "resolved_trusted_origin": "https://alice.avibe.bot:443", "server_facts": ["paired_active_instance_hostname", "remote_session_authorized"], "peer_or_network_checks": ["remote_access_request_classification"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-CUSTOM-HOST", "source_class": "active_custom_hostname", "origin_headers": ["https://show.example.test"], "resolved_trusted_origin": "https://show.example.test:443", "server_facts": ["active_custom_hostname", "remote_session_authorized"], "peer_or_network_checks": ["remote_access_request_classification"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-LOCALHOST", "source_class": "direct_loopback", "origin_headers": ["http://localhost:5123"], "resolved_trusted_origin": "http://localhost:5123", "server_facts": ["actual_ui_listener_port"], "peer_or_network_checks": ["loopback_peer", "loopback_host"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-IPV4-LOOPBACK", "source_class": "direct_loopback", "origin_headers": ["http://127.0.0.1:5123"], "resolved_trusted_origin": "http://127.0.0.1:5123", "server_facts": ["actual_ui_listener_port"], "peer_or_network_checks": ["loopback_peer", "loopback_host"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-IPV6-LOOPBACK", "source_class": "direct_loopback", "origin_headers": ["http://[::1]:5123"], "resolved_trusted_origin": "http://[::1]:5123", "server_facts": ["actual_ui_listener_port"], "peer_or_network_checks": ["loopback_peer", "loopback_host"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-PRIVATE-SETUP", "source_class": "explicit_setup_host", "origin_headers": ["http://192.168.2.3:5123"], "resolved_trusted_origin": "http://192.168.2.3:5123", "server_facts": ["configured_setup_host", "actual_ui_listener_port"], "peer_or_network_checks": ["private_peer", "same_interface_network"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-CGNAT-SETUP", "source_class": "explicit_setup_host", "origin_headers": ["http://100.64.1.10:5123"], "resolved_trusted_origin": "http://100.64.1.10:5123", "server_facts": ["configured_setup_host", "actual_ui_listener_port"], "peer_or_network_checks": ["private_or_cgnat_peer", "tailscale_peer_if_overlay"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-LINK-LOCAL-SETUP", "source_class": "explicit_setup_host", "origin_headers": ["http://[fe80::10]:5123"], "resolved_trusted_origin": "http://[fe80::10]:5123", "server_facts": ["configured_setup_host", "actual_ui_listener_port"], "peer_or_network_checks": ["link_local_peer", "same_link"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-WILDCARD-LAN", "source_class": "wildcard_resolved_interface", "origin_headers": ["http://192.168.2.3:5123"], "resolved_trusted_origin": "http://192.168.2.3:5123", "server_facts": ["server_enumerated_trusted_lan_interface", "actual_ui_listener_port"], "peer_or_network_checks": ["private_peer", "same_interface_network"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-WILDCARD-TAILSCALE", "source_class": "wildcard_resolved_interface", "origin_headers": ["http://100.100.2.3:5123"], "resolved_trusted_origin": "http://100.100.2.3:5123", "server_facts": ["server_enumerated_tailscale_interface", "actual_ui_listener_port"], "peer_or_network_checks": ["trusted_tailscale_peer"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-DOCKER-LOOPBACK", "source_class": "docker_loopback_bridge", "origin_headers": ["http://127.0.0.1:5123"], "resolved_trusted_origin": "http://127.0.0.1:5123", "server_facts": ["docker_loopback_peers_explicitly_enabled", "loopback_only_port_binding", "actual_ui_listener_port"], "peer_or_network_checks": ["trusted_docker_bridge_peer"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true},
        {"id": "HMR-SOURCE-TRUSTED-PROXY", "source_class": "trusted_public_proxy", "origin_headers": ["https://avibe.example.com"], "resolved_trusted_origin": "https://avibe.example.com:443", "server_facts": ["configured_trusted_public_origin", "safe_forwarded_host_proto_port"], "peer_or_network_checks": ["explicit_trusted_proxy_peer", "trusted_forwarded_client"], "resource_editor_authority": true, "outcome": "open_after_origin_and_editor_authorization", "upstream_websocket_opened": true}
      ],
      "negative_mutations": [
        {"id": "HMR-REJECT-MISSING-ORIGIN", "applies_to": "all_source_classes", "mutation": "origin_cardinality_zero", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-MULTIPLE-ORIGIN", "applies_to": "all_source_classes", "mutation": "origin_cardinality_multiple", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-NULL-ORIGIN", "applies_to": "all_source_classes", "mutation": "origin_null", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-SCHEME-DRIFT", "applies_to": "all_source_classes", "mutation": "origin_scheme_mismatch", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-HOST-DRIFT", "applies_to": "all_source_classes", "mutation": "origin_host_or_ip_mismatch", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-PORT-DRIFT", "applies_to": "all_source_classes", "mutation": "origin_effective_port_mismatch", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-WILDCARD-OR-SUFFIX", "applies_to": "all_source_classes", "mutation": "wildcard_or_suffix_match_only", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-RAW-HOST", "applies_to": "all_source_classes", "mutation": "raw_host_is_only_authority", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-UNTRUSTED-PEER", "applies_to": "peer_validated_source_classes", "mutation": "peer_or_network_check_fails", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-UNTRUSTED-FORWARDED", "applies_to": "all_source_classes", "mutation": "forwarded_metadata_from_untrusted_peer", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-FORWARDED-MISMATCH", "applies_to": "trusted_public_proxy", "mutation": "safe_forwarded_origin_not_configured", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false},
        {"id": "HMR-REJECT-NO-EDITOR", "applies_to": "all_source_classes", "mutation": "resource_editor_authority_false", "outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false}
      ]
    },
    "monitor_scope": "one_coalesced_monitor_per_active_session",
    "authorization_triggers": [
      "editor_capability_loss",
      "resource_access_revocation",
      "authorization_revision_change"
    ],
    "authorization_trigger_action": "reevaluate_and_close_unauthorized_existing_sockets",
    "post_connect_policy": {
      "close_triggers": ["editor_capability_loss", "resource_access_revocation", "remote_authorization_loss", "durable_offline_state"],
      "non_close_triggers_while_active_editor_remains": ["access_mode_change", "share_binding_change", "guest_membership_change", "audience_revision_change"]
    },
    "durable_offline_source": "ShowPageStore",
    "durable_offline_deadline": {
      "measured_from": "durable_offline_transaction_commit",
      "poll_interval_max_seconds": 4,
      "post_detection_close_budget_seconds": 1,
      "total_close_deadline_seconds": 5,
      "sum_of_poll_and_close_budget_must_not_exceed_total": true,
      "worst_case_just_after_poll_trace_ms": {
        "last_poll": 0,
        "durable_offline_commit": 1,
        "next_poll_no_later_than": 4000,
        "all_sockets_closed_no_later_than": 5000,
        "elapsed_from_offline_commit": 4999
      }
    },
    "share_mode_or_binding_change_closes_private_hmr_when_editor_access_remains": false
  },
  "shared_response_cases": [
    {
      "id": "keyed_immutable_graph_success",
      "runtime_mode": "keyed_context",
      "input_class": "proven_application_or_asset",
      "outcome": "complete_transformed_response",
      "body_source": "immutable_snapshot_virtual_graph",
      "url_header_policy": "strip_or_safely_rewrite",
      "raw_source": false,
      "host_path": false,
      "private_session_path": false,
      "development_diagnostic": false
    },
    {
      "id": "keyed_development_diagnostic",
      "runtime_mode": "keyed_context",
      "input_class": "development_diagnostic",
      "outcome": "fixed_shared_error",
      "body_source": "fixed_sanitized_representation",
      "url_header_policy": "strip_or_safely_rewrite",
      "raw_source": false,
      "host_path": false,
      "private_session_path": false,
      "development_diagnostic": false
    },
    {
      "id": "legacy_unclassified_transform_error",
      "runtime_mode": "legacy_singleton",
      "input_class": "unclassified_error_or_missing_provenance",
      "outcome": "fixed_path_free_unavailable",
      "body_source": "fixed_sanitized_representation",
      "url_header_policy": "remove_url_bearing_headers",
      "raw_source": false,
      "host_path": false,
      "private_session_path": false,
      "development_diagnostic": false
    },
    {
      "id": "legacy_raw_or_nested_fs_graph",
      "runtime_mode": "legacy_singleton",
      "input_class": "raw_or_nested_fs_reference",
      "outcome": "fixed_path_free_unavailable",
      "body_source": "fixed_sanitized_representation",
      "url_header_policy": "remove_url_bearing_headers",
      "raw_source": false,
      "host_path": false,
      "private_session_path": false,
      "development_diagnostic": false
    }
  ],
  "route_invariants": {
    "shared_route": {
      "path": "/p/<share_id>/",
      "context": "shared",
      "hmr": false,
      "private_bytes": false,
      "cache_control": "private, no-store",
      "vary": "Cookie"
    },
    "private_route": {
      "path": "/show/<session_id>/",
      "context": "private",
      "hmr_requires": "show_editor_capability"
    },
    "resource_redirect": {
      "source": "top_level_navigation",
      "destination": "/show/<session_id>/",
      "preserve_route_suffix": true,
      "preserve_query": true,
      "cache_control": "private, no-store",
      "vary": "Cookie",
      "requires": [
        "active_share_binding",
        "resource_viewer_or_editor_authority",
        "trusted_fetch_metadata"
      ]
    }
  },
  "release_gate": {
    "reviewed_runtime_sha": "ee3b0b490ad8b4afafb59cf37e2d57a20325208a",
    "reviewed_runtime_pr": "https://github.com/avibe-bot/vibe-show-runtime/pull/59",
    "smoke_tested_runtime_sha": null,
    "bundled_runtime_sha": null,
    "required_property_owners": {
      "runtime_context_isolation": "not_implemented",
      "opaque_shared_capture_admission": "not_implemented"
