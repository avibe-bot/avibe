{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/retirement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_issue",
    "production_exact_email_data_exists",
    "strategy",
    "migration_allowed",
    "compatibility_bridge_allowed",
    "dual_write_allowed",
    "release_dependency",
    "retired_surfaces",
    "forbidden_successor_concepts",
    "obsolete_route_outcome",
    "development_and_regression_rows",
    "scenario_ids"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "authority_issue": { "const": "https://github.com/avibe-bot/avibe/issues/1498" },
    "production_exact_email_data_exists": { "const": false },
    "strategy": { "const": "direct_retirement" },
    "migration_allowed": { "const": false },
    "compatibility_bridge_allowed": { "const": false },
    "dual_write_allowed": { "const": false },
    "release_dependency": {
      "const": {
        "application_deployment": "stop_all_legacy_table_and_show_page_id_column_selects_and_writes",
        "ddl_deployment": "drop_legacy_column_and_table",
        "ddl_requires_application_deployment_complete": true,
        "data_bridge_backfill_or_import": false
      }
    },
    "retired_surfaces": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "component", "future_action"],
        "properties": {
          "repository": { "enum": ["avibe", "avibe-backend"] },
          "component": { "type": "string", "minLength": 3 },
          "future_action": {
            "enum": ["delete_storage", "delete_endpoints", "delete_clients", "delete_authorization_source"]
          }
        }
      }
    },
    "forbidden_successor_concepts": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "obsolete_route_outcome": { "const": "absent_or_terminal_removed" },
    "development_and_regression_rows": { "const": "discard_allowed" },
    "scenario_ids": { "const": ["SHOW-LIVE-020"] }
  }
}
