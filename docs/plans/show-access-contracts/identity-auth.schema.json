{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/identity-auth.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "backend_assertion", "local_handshake", "closed_loop_scenario", "cases"],
  "properties": {
    "schema_version": { "const": 2 },
    "owner": { "const": "ExecutableIdentityHandshake" },
    "backend_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "authorize_endpoint",
        "request_inputs",
        "delivery",
        "callback_uri_policy",
        "wire_protocol",
        "pairing_trust",
        "jwks_verification",
        "required_signed_claims",
        "audience_derivation",
        "ttl_seconds",
        "maximum_lifetime_seconds",
        "verifier_clock_skew_seconds",
        "verified_email_normalization",
        "verified_email_source",
        "signing_keys",
        "terminal_errors",
        "missing_login_session_action",
        "jti_unique",
        "forbidden_claims",
        "instance_access_context_created",
        "instance_role_derived",
        "page_membership_decided",
        "interoperability_vectors"
      ],
      "properties": {
        "format": { "const": "rfc7519_compact_jwt_jws" },
        "authorize_endpoint": {
          "const": {
            "method": "GET",
            "path_template": "/api/v1/instances/{instanceId}/show-identity/authorize"
          }
        },
        "request_inputs": {
          "const": {
            "required": ["state", "nonce", "redirect_uri"],
            "additional_allowed": false,
            "forbidden": ["sub", "email", "aud", "page_id", "share_id", "instance_role", "instance_access_source", "page_membership"]
          }
        },
        "delivery": {
          "const": {
            "response_mode": "form_post",
            "fixed_callback_path": "/auth/show-identity/callback",
            "assertion_parameter": "assertion",
            "state_parameter": "state",
            "form_fields": ["state", "assertion"],
            "additional_form_fields_allowed": false,
            "forbidden_assertion_locations": ["url_query", "url_fragment", "browser_history", "referrer"]
          }
        },
        "callback_uri_policy": {
          "const": {
            "authority_source": "server_owned_active_instance_or_custom_listener",
            "origin_representation": ["scheme", "normalized_host", "effective_port"],
            "default_https_effective_port": 443,
            "explicit_port_requires_server_owned_listener": true,
            "browser_or_request_values_create_authority": false,
            "scheme": "https",
            "query_allowed": false,
            "fragment_allowed": false,
            "path": "/auth/show-identity/callback",
            "equality_boundaries": ["backend_authorize_redirect_uri", "signed_local_state", "actual_callback_request", "identity_session_record", "safe_return_flow"],
            "rejection_order": "before_assertion_cookie_session_store_or_page_use"
          }
        },
        "wire_protocol": {
          "const": {
            "serialization": "compact_jws",
            "segment_count": 3,
            "payload_kind": "jwt_claims",
            "protected_header": {
              "required_and_only_fields": ["alg", "typ", "kid"],
              "alg": "RS256",
              "typ": "JWT",
              "kid": "nonempty_server_key_identifier"
            },
            "forbidden_algorithms": ["none", "HS256", "ES256", "EdDSA"],
            "forbidden_header_parameters": ["jku", "jwk", "x5u", "x5c", "crit", "b64"],
            "unsupported_critical_or_unencoded_payload_outcome": "reject_identity_assertion",
            "payload_claim_set_exact": true,
            "maximum_compact_token_bytes": 16384,
            "strict_json_boundary": {
              "header_string_limits": {"alg": 16, "typ": 16, "kid": 128},
              "payload_string_limits": {"iss": 2048, "aud": 512, "sub": 512, "jti": 256, "nonce": 256, "instance_id": 256, "verified_email": 320},
              "numeric_date_fields": ["iat", "exp"],
              "numeric_date_type": "json_integer_excluding_boolean",
              "numeric_date_relation": "iat <= exp and exp - iat <= maximum_lifetime_seconds",
              "required_string_properties": "nonempty_and_within_named_bound",
              "duplicate_members": "reject_before_lookup_or_store_input",
              "null_number_array_object_or_empty_string": "reject_for_every_string_authority_identifier",
              "extra_or_missing_members": "reject",
              "malformed_signed_input_outcome": "sanitized_reject_identity_assertion_without_raise"
            }
          }
        },
        "pairing_trust": {
          "const": {
            "authority": "local_paired_instance_record",
            "trusted_fields": ["issuer", "oauth_client_id", "instance_id", "jwks_uri"],
            "issuer_requirement": "paired_https_issuer",
            "audience_derivation": "avibe-show-identity:<oauthClientId>",
            "audience_cardinality": "exactly_one_string",
            "jwks_uri_derivation": "<issuer>/oauth/jwks.json",
            "jwks_uri_same_origin_with_issuer": true,
            "oidc_discovery_policy": "optional_but_if_used_must_match_exact_paired_issuer_and_jwks_uri",
            "cross_origin_jwks_redirect_allowed": false,
            "token_or_request_selects_trust": false
          }
        },
        "jwks_verification": {
          "const": {
            "matching_key_count": "exactly_one",
            "key_requirements": {"kty": "RSA", "use": "sig", "alg": "RS256", "minimum_modulus_bits": 2048},
            "duplicate_kid_outcome": "reject_identity_assertion",
            "changed_material_same_kid_outcome": "reject_identity_assertion",
            "unknown_kid_policy": {
              "forced_refresh_scope": "issuer_coalesced",
              "maximum_forced_refreshes": 1,
              "maximum_verification_retries": 1,
              "still_unknown_or_refresh_failure_outcome": "reject_identity_assertion"
            },
            "cache_policy": {
              "scope": "paired_issuer",
              "maximum_age_seconds": 300,
              "revalidation": "must_revalidate_at_expiry_including_known_kid",
              "refresh_coalescing": "one_in_flight_fetch_per_issuer",
              "replacement": "successful_refresh_atomically_replaces_cached_key_set",
              "stale_key_acceptance_after_expiry": false,
              "removed_key_acceptance_after_refresh": false,
              "refresh_failure_outcome": "reject_identity_assertion"
            },
            "malformed_or_unavailable_outcome": "reject_identity_assertion"
          }
        },
        "required_signed_claims": {
          "const": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"]
        },
        "audience_derivation": { "const": "avibe-show-identity:<oauthClientId>" },
        "ttl_seconds": { "const": 300 },
        "maximum_lifetime_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "verifier_clock_skew_seconds": { "const": 60 },
        "verified_email_normalization": {
          "const": ["trim_ascii_surrounding_whitespace", "lowercase"]
        },
        "verified_email_source": {
          "const": {
            "lookup": "fresh_backend_identity_provider_or_user_lookup",
            "explicit_verification_required": true,
            "browser_input_allowed": false,
            "stale_cookie_field_allowed": false
          }
        },
        "signing_keys": {
          "const": {
            "issuer": "current_signing_key_only",
            "jwks_public_keys": ["current", "previous_during_overlap"],
            "minimum_previous_key_availability": {
              "formula": "maximum_assertion_lifetime_seconds + 2 * verifier_clock_skew_seconds",
              "maximum_assertion_lifetime_seconds": 600,
              "verifier_clock_skew_seconds": 60,
              "derived_seconds": 720,
              "measured_from": "last_possible_old_key_signing"
            }
          }
        },
        "terminal_errors": {
          "const": [
            { "code": "identity_not_verified", "cache_control": "no-store", "assertion_returned": false },
            { "code": "identity_unavailable", "cache_control": "no-store", "assertion_returned": false }
          ]
        },
        "missing_login_session_action": { "const": "redirect_to_login_with_safe_next_only" },
        "jti_unique": { "const": true },
        "forbidden_claims": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "instance_access_context_created": { "const": false },
        "instance_role_derived": { "const": false },
        "page_membership_decided": { "const": false },
        "interoperability_vectors": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "token_key", "jwks_state", "refreshes", "outcome"],
            "properties": {
              "id": {"type": "string", "pattern": "^(JWT|JWKS)-[A-Z0-9-]+$"},
              "token_key": {"enum": ["current", "previous", "new_current", "unknown"]},
              "jwks_state": {"enum": ["current_plus_previous", "previous_cache_then_rotated_refresh", "unchanged_after_refresh", "duplicate_kid", "changed_material_same_kid_on_refresh", "cross_origin_uri_or_redirect", "known_key_cache_expired", "old_key_removed_after_overlap", "expired_cache_refresh_unavailable", "issuer_coalesced_concurrent_refresh", "previous_key_available_before_derived_deadline", "previous_key_removed_after_derived_deadline"]},
              "refreshes": {"type": "integer", "minimum": 0, "maximum": 1},
              "outcome": {"enum": ["verified_identity", "reject_identity_assertion"]}
            }
          }
        }
      }
    },
    "local_handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "server_resolved_before_start",
        "signed_state_fields",
        "callback_origin_state_machine",
        "signed_state_lifecycle",
        "correlation_cookie",
        "callback_checks",
        "consumption_store",
        "concurrent_flow_state_machine",
        "identity_session",
        "membership_lookup",
        "identity_session_is_authorization",
        "unlisted_outcome",
        "removed_member_active_tab_policy",
        "reference_harness"
      ],
      "properties": {
        "producer": { "const": "avibe" },
        "server_resolved_before_start": {
          "const": ["instance_id", "page_id", "share_id", "safe_public_return_target", "callback_origin"]
        },
        "signed_state_fields": {
          "const": ["instance_id", "page_id", "share_id", "safe_public_return_target", "callback_origin", "nonce", "correlation_cookie_sha256", "issued_at", "expires_at"]
        },
        "callback_origin_state_machine": {
          "const": {
            "representation": ["scheme", "normalized_host", "effective_port"],
            "default_https_port": 443,
            "fixed_callback_path": "/auth/show-identity/callback",
            "positive_vectors": [
              {"id": "CALLBACK-ORIGIN-DEFAULT-HTTPS", "server_owned_origin": {"scheme": "https", "normalized_host": "show.example.test", "effective_port": 443}, "redirect_uri": "https://show.example.test/auth/show-identity/callback", "outcome": "accept_origin"},
              {"id": "CALLBACK-ORIGIN-EXPLICIT-PORT", "server_owned_origin": {"scheme": "https", "normalized_host": "show.example.test", "effective_port": 7443}, "redirect_uri": "https://show.example.test:7443/auth/show-identity/callback", "outcome": "accept_origin"}
            ],
            "negative_mutations": ["alternate_port", "scheme", "host", "path", "query", "fragment"],
            "failure_outcome": "reject_before_assertion_cookie_session_store_or_page_use"
          }
        },
        "signed_state_lifecycle": {
          "const": {
            "numeric_date_fields": ["issued_at", "expires_at"],
            "numeric_date_type": "integer",
            "maximum_lifetime_seconds": 600,
            "verifier_clock_skew_seconds": 60,
            "renewable": false,
            "validation": "issued_at_minus_skew_not_future_and_now_not_after_expires_at_plus_skew_and_lifetime_within_maximum",
            "vectors": [
              {"id": "STATE-VALID-BOUNDARY", "issued_at_delta_seconds": 60, "lifetime_seconds": 600, "outcome": "accept_state"},
              {"id": "STATE-OVERSIZED", "issued_at_delta_seconds": 0, "lifetime_seconds": 601, "outcome": "reject_without_cookie_selection"},
              {"id": "STATE-EXPIRED", "issued_at_delta_seconds": -661, "lifetime_seconds": 600, "outcome": "reject_and_delete_matching_flow_cookie"},
              {"id": "STATE-FUTURE", "issued_at_delta_seconds": 61, "lifetime_seconds": 300, "outcome": "reject_and_delete_matching_flow_cookie"},
              {"id": "STATE-NONINTEGER", "issued_at_delta_seconds": 0, "lifetime_seconds": 300, "outcome": "reject_without_cookie_selection"}
            ]
          }
        },
        "correlation_cookie": {
          "const": {
            "name_template": "__Secure-avibe_show_identity_c_<base64url_nonce>",
            "name_source": "verified_signed_state_nonce",
            "value": "independent_32_byte_csprng_secret",
            "same_site": "None",
            "secure": true,
            "http_only": true,
            "path": "/auth/show-identity/callback",
            "domain_attribute_allowed": false,
            "single_use": true,
            "expires_no_later_than": "signed_state.expires_at",
            "state_verification_precedes_cookie_selection": true,
            "invalid_state_cookie_deletion": "none",
            "terminal_callback_cookie_action": "consume_and_delete_matching_flow_only"
          }
        },
        "callback_checks": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "membership_lookup": { "const": "fresh_local_page_email_lookup_on_every_limited_request" },
        "identity_session_is_authorization": { "const": false },
        "unlisted_outcome": { "const": "generic_deny_without_page_bytes_or_login_loop" },
        "removed_member_active_tab_policy": { "const": "no_active_closure_future_requests_only" },
        "reference_harness": {
          "const": {
            "scenario_id": "AUTH-SETUP-404",
            "actual_http_boundary": "POST /auth/show-identity/callback",
            "components": ["local_state_signer", "backend_rs256_issuer_and_jwks", "avibe_jwt_verifier", "local_identity_session_store"],
            "content_type": "application/x-www-form-urlencoded",
            "active_custom_callback_origin": {"scheme": "https", "normalized_host": "show.example.test", "effective_port": 443},
            "contract_evidence": "http_form_jwt_jwks_and_atomic_state_machine",
            "browser_cookie_delivery_evidence": "reference_http_same_site_delivery_model",
            "browser_cookie_delivery_rule": "cross_site_form_post_sends_identity_session_only_with_same_site_none_secure_https",
            "real_browser_conformance": "future_local_incus_browser_lane",
            "production_conformance": "future_avibe_and_backend_implementation_lanes"
          }
        },
        "consumption_store": {
          "const": {
            "key_fields": ["nonce", "jti"],
            "consume_operation": "atomic_compare_absent_then_insert",
            "retention_deadline": "max_signed_state_or_assertion_expiry_plus_verifier_clock_skew",
            "same_callback_race_successes": 1
          }
        },
        "concurrent_flow_state_machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flow_identity", "independent_same_host_flows", "terminal_callback_affects_other_flows", "cases"],
          "properties": {
            "flow_identity": {"const": ["verified_signed_nonce", "cookie_name", "cookie_secret_hash", "jti"]},
            "independent_same_host_flows": {"const": true},
            "terminal_callback_affects_other_flows": {"const": false},
            "cases": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sequence", "successes", "remaining_cookies"],
                "properties": {
                  "id": {"type": "string", "pattern": "^FLOW-[A-Z0-9-]+$"},
                  "sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "successes": {"type": "array", "items": {"enum": ["a", "b"]}},
                  "remaining_cookies": {"type": "array", "items": {"enum": ["a", "b"]}}
                }
              }
            }
          }
        },
        "identity_session": {
          "const": {
            "owner": "avibe.ExecutableIdentityHandshake",
            "purpose": "verified_identity_only",
              "cookie": {
              "name": "__Host-avibe_show_identity_session",
              "value": "opaque_32_byte_csprng_secret",
              "host_only": true,
              "domain_attribute_allowed": false,
              "secure": true,
              "http_only": true,
              "same_site": "None",
              "path": "/"
            },
            "server_record_key": "sha256_of_cookie_token",
            "server_record_fields": ["paired_instance_id", "issuer", "subject", "normalized_verified_email", "callback_origin", "lineage_id", "lineage_generation", "store_generation", "issued_at", "expires_at"],
            "maximum_lifetime_seconds": 86400,
            "renewable": false,
              "rotation": {
                "operation": "atomic_lineage_generation_advance_after_all_callback_checks",
                "prior_token_delivery": "cross_site_form_post_includes_same_site_none_session_cookie",
                "login_start_flow_correlation": "server_side_nonce_record_captures_only_a_current_prior_token_hash_lineage_and_generation_and_expires_with_signed_state",
                "callback_prior_token_requirement": "posted_callback_cookie_hash_must_match_the_flow_captured_prior_token_hash",
                "valid_prior_token": "advance_existing_lineage_and_invalidate_every_earlier_generation",
                "concurrent_completion": "flows_that_captured_the_same_valid_prior_generation_advance_the_same_lineage_in_callback_order",
                "no_valid_prior_token_at_login_start": "create_new_lineage",
                "invalid_or_terminal_callback": "no_lineage_change",
              "maximum_valid_records_per_lineage": 1,
              "concurrent_completion_outcome": "one_current_generation_older_response_token_may_be_stale_and_must_restart_login"
            },
            "reset_policy": "key_or_session_store_reset_invalidates_all_existing_cookies",
            "request_validation": ["token_hash_record_exists", "integer_times_and_not_expired", "paired_instance_matches", "issuer_matches_pairing", "exact_callback_origin_matches_record", "lineage_generation_is_current", "local_store_generation_matches"],
            "failure_outcome": "identity_required_without_page_bytes",
            "page_authorization": false,
            "later_limited_request": ["resolve_current_share", "load_current_ShowAccess", "require_active_limited", "match_current_local_membership", "mint_page_bound_browsing_credential"],
            "forbidden_capabilities": ["instance_access", "canonical_show", "hmr", "annotations", "agents", "resource_authority"],
            "vectors": [
              {"id": "SESSION-LATER-REQUEST", "mutation": "none", "outcome": "serve_shared_after_current_membership"},
              {"id": "SESSION-EXPIRED", "mutation": "advance_past_24_hours", "outcome": "identity_required_without_page_bytes"},
              {"id": "SESSION-HOST-MISMATCH", "mutation": "request_from_other_host", "outcome": "identity_required_without_page_bytes"},
              {"id": "SESSION-INSTANCE-MISMATCH", "mutation": "request_other_instance_share", "outcome": "identity_required_without_page_bytes"},
              {"id": "SESSION-MISSING-RECORD", "mutation": "delete_server_record", "outcome": "identity_required_without_page_bytes"},
              {"id": "SESSION-STORE-RESET", "mutation": "rotate_local_session_generation", "outcome": "identity_required_without_page_bytes"},
              {"id": "SESSION-MEMBER-REMOVED", "mutation": "remove_email_from_current_ShowAccess", "outcome": "generic_deny_without_page_bytes_or_login_loop"},
              {"id": "SESSION-SEQUENTIAL-ROTATION", "mutation": "second_cross_site_login_with_prior_cookie", "outcome": "new_generation_only_old_token_rejected"},
              {"id": "SESSION-CONCURRENT-ROTATION", "mutation": "two_valid_callbacks_from_same_prior_generation", "outcome": "one_current_generation_other_response_may_be_stale"},
              {"id": "SESSION-UNRELATED-LINEAGES", "mutation": "separate_browser_without_prior_token", "outcome": "independent_current_lineages"},
              {"id": "SESSION-INVALID-CALLBACK", "mutation": "invalid_state_or_terminal_error", "outcome": "existing_lineage_unchanged"}
            ]
          }
        }
      }
    },
    "closed_loop_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ids", "start", "callback", "protected_request", "negative_callbacks"],
      "properties": {
        "id": { "const": "IDENTITY-CLOSED-LOOP-LISTED" },
        "scenario_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_id", "page_id", "share_id", "safe_public_return_target", "callback_origin", "server_owned_callback_origins", "nonce", "signed_state_valid", "correlation_cookie_name", "correlation_cookie", "correlation_cookie_sha256", "signed_state_expires_at", "correlation_cookie_expires_at"],
          "properties": {
            "instance_id": { "type": "string", "minLength": 3 },
            "page_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id" },
            "share_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id" },
            "safe_public_return_target": { "type": "string", "pattern": "^/p/[A-Za-z0-9_-]+/$" },
            "callback_origin": { "const": {"scheme": "https", "normalized_host": "show.example.test", "effective_port": 443} },
            "server_owned_callback_origins": { "const": [{"scheme": "https", "normalized_host": "show.example.test", "effective_port": 443}, {"scheme": "https", "normalized_host": "show.example.test", "effective_port": 7443}] },
            "nonce": { "type": "string", "minLength": 20 },
            "signed_state_valid": { "const": true },
            "correlation_cookie_name": {"type": "string", "pattern": "^__Secure-avibe_show_identity_c_[A-Za-z0-9_-]+$"},
            "correlation_cookie": { "type": "string", "minLength": 20 },
            "correlation_cookie_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signed_state_expires_at": { "type": "integer", "minimum": 1 },
            "correlation_cookie_expires_at": { "type": "integer", "minimum": 1 }
          }
        },
        "callback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http_method", "delivery", "assertion_location", "callback_url", "content_type", "assertion_format", "assertion_valid", "instance_id", "nonce", "jti", "correlation_cookie_name", "correlation_cookie", "verified_email", "resolved_page_id", "resolved_share_id", "resolved_audience_revision", "current_local_emails", "outcome"],
          "properties": {
            "http_method": { "const": "POST" },
            "delivery": { "const": "form_post" },
            "assertion_location": { "const": "form_body" },
            "callback_url": { "const": "https://show.example.test/auth/show-identity/callback" },
            "content_type": { "const": "application/x-www-form-urlencoded" },
            "assertion_format": { "const": "rfc7519_compact_jwt_jws" },
            "assertion_valid": { "const": true },
            "instance_id": { "type": "string", "minLength": 3 },
            "nonce": { "type": "string", "minLength": 20 },
            "jti": { "type": "string", "minLength": 20 },
            "correlation_cookie_name": {"type": "string", "pattern": "^__Secure-avibe_show_identity_c_[A-Za-z0-9_-]+$"},
            "correlation_cookie": { "type": "string", "minLength": 20 },
            "verified_email": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/normalized_email" },
            "resolved_page_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id" },
            "resolved_share_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id" },
            "resolved_audience_revision": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/revision" },
            "current_local_emails": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/non_empty_canonical_email_set" },
            "outcome": { "const": "issue_identity_session_and_redirect" }
          }
        },
        "protected_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_session_cookie", "identity_session_record_revalidated", "credential_binding", "membership_rechecked", "outcome"],
          "properties": {
            "identity_session_cookie": {"const": "__Host-avibe_show_identity_session"},
            "identity_session_record_revalidated": {"const": true},
            "credential_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instance_id", "page_id", "share_id", "audience_revision"],
              "properties": {
                "instance_id": { "type": "string", "minLength": 3 },
                "page_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id" },
                "share_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id" },
                "audience_revision": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/revision" }
              }
            },
            "membership_rechecked": { "const": true },
            "outcome": { "const": "serve_shared" }
          }
        },
        "negative_callbacks": {
          "type": "array",
          "minItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mutation", "outcome"],
            "properties": {
              "id": { "type": "string", "pattern": "^IDENTITY-CALLBACK-[A-Z0-9-]+$" },
              "mutation": { "enum": ["reuse_consumed_nonce", "replace_assertion_instance_id", "replace_signed_return_share", "replace_correlation_cookie", "add_callback_query", "add_callback_fragment", "place_assertion_in_browser_history", "place_assertion_in_referrer", "replace_callback_host", "replace_callback_port", "replace_callback_scheme", "replace_callback_path", "add_page_authorization_claim", "identity_not_verified", "identity_unavailable"] },
              "outcome": { "enum": ["reject_without_credential_or_page_bytes", "identity_not_verified_no_store_without_assertion", "identity_unavailable_no_store_without_assertion"] }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario_ids",
          "assertion_valid",
          "instance_binding",
          "verified_email",
          "current_local_emails",
          "outcome",
          "instance_access",
          "canonical_show_access",
          "hmr",
          "annotations",
          "agents"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^IDENTITY-[A-Z0-9-]+$" },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
          },
          "assertion_valid": { "type": "boolean" },
          "instance_binding": { "enum": ["match", "mismatch"] },
          "verified_email": {
            "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/normalized_email"
          },
          "current_local_emails": {
            "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/canonical_email_set"
          },
          "outcome": { "enum": ["serve_shared", "generic_deny", "reject_identity_assertion"] },
          "instance_access": { "const": false },
          "canonical_show_access": { "const": false },
          "hmr": { "const": false },
          "annotations": { "const": false },
          "agents": { "const": false }
        }
      }
    }
  }
}
