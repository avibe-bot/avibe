{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avibe.bot/contracts/show-runtime-containment/v1",
  "title": "Show Runtime private and shared containment contract v1",
  "$ref": "#/$defs/RuntimeEnvelope",
  "x-contract": {
    "contract_id": "avibe.show-runtime-containment.v1",
    "version": 1,
    "protocol": {
      "version": 1,
      "version_header": "X-Avibe-Show-Protocol",
      "context_header": "X-Avibe-Show-Context",
      "contexts": ["private", "shared"],
      "keyed_context_feature": "show-context-key-v1",
      "browser_supplied_internal_headers": "strip_all_then_add_exactly_one_server_owned_envelope"
    },
    "interfaces": [
      {
        "id": "runtime_context_envelope",
        "producer": "avibe.local_http.ShowRuntimeProxy",
        "consumer": "vibe-show-runtime.Protocol1Admission",
        "delivery": "trusted_loopback_http_headers",
        "request": "#/$defs/RuntimeEnvelope"
      },
      {
        "id": "shared_document_admission",
        "producer": "avibe.local_http.SharedNavigationAdmission",
        "consumer": "vibe-show-runtime.SharedDocumentCapture",
        "delivery": "trusted_internal_request",
        "request": "#/$defs/SharedAdmission",
        "result": "#/$defs/SharedAdmissionResult"
      },
      {
        "id": "shared_protected_resource",
        "producer": "shared_browser_document",
        "consumer": "vibe-show-runtime.SharedProtectedResource",
        "delivery": "versioned_opaque_path_without_ambient_authority",
        "request": "#/$defs/SharedResourceRequest"
      },
      {
        "id": "private_editor_connection",
        "producer": "avibe.local_http.ShowEditorAdmission",
        "consumer": "vibe-show-runtime.PrivateHmrAdmission",
        "delivery": "trusted_loopback_websocket_upgrade",
        "authorization": "resource_editor_at_connection_admission"
      }
    ],
    "shared_admission": {
      "entry_events": ["new_top_level_navigation", "manual_refresh"],
      "public": "public_show_access_allows_anonymous",
      "limited": "limited_show_access_requires_verified_identity_and_current_local_membership",
      "private": "deny",
      "keyed_context_supported": "required_before_any_shared_runtime_work",
      "keyed_context_unsupported": "shared_runtime_unavailable_without_legacy_graph_access",
      "keyed_context_transient_unknown": "bounded_probe_then_shared_runtime_unavailable_without_upstream",
      "source_session_id_visibility": "trusted_internal_only_never_browser_exposed",
      "result": {
        "success": "SharedDocumentCapability",
        "failures": {
          "shared_runtime_unavailable": {"http_status": 503, "body": "shared runtime unavailable"},
          "snapshot_too_large": {"http_status": 413, "body": "shared page unavailable"},
          "capacity_exhausted": {"http_status": 503, "body": "shared runtime busy"},
          "capture_timeout": {"http_status": 504, "body": "shared page timed out"},
          "reload_required": {"http_status": 409, "body": "reload required"}
        },
        "failure_body_forbidden_data": ["workspace_path", "source_path", "diagnostic", "stack_trace"]
      }
    },
    "top_level_route_decision": {
      "resource_viewer_or_editor": "redirect_to_canonical_show_without_shared_runtime_admission",
      "listed_only_identity": "serve_shared_p_without_editor_capability",
      "public_anonymous": "serve_shared_p_without_editor_capability"
    },
    "context_isolation": {
      "private_graph_key": ["session_id", "private"],
      "shared_graph_key": ["source_session_id", "page_id", "share_id", "admitted_revision", "shared"],
      "lifecycle": "private_and_shared_graphs_are_independent",
      "shared_build_trigger": "successful_new_navigation_or_manual_refresh_admission_only",
      "ordinary_private_editor_edit": "keeps_private_graph_identity_and_never_creates_builds_or_rebases_shared_graph",
      "shared_hmr": false
    },
    "admitted_document_lifetime": {
      "capability_scope": ["instance_id", "page_id", "share_id", "admitted_revision", "namespace_id", "document_id"],
      "valid_while": "runtime_namespace_and_document_handle_exist",
      "subresource_authority": "document_scoped_capability_only",
      "capability_entropy_bits": 256,
      "capability_derivation": "csprng_non_derived",
      "subresource_validation": "opaque_capability_namespace_and_document_binding_only_without_show_access_lookup",
      "permission_recheck_per_subresource": false,
      "permission_polling": false,
      "permission_change_push_refresh": false,
      "permission_change_revokes_loaded_document": false,
      "membership_mode_binding_or_revision_change": "affects_next_navigation_or_manual_refresh_only",
      "time_based_capability_or_namespace_expiry": false,
      "namespace_loss_causes": ["runtime_restart", "explicit_operational_shutdown", "global_resource_budget_pressure"],
      "namespace_loss_outcome": "fixed_reload_required"
    },
    "browser_boundary": {
      "trusted_shell_url": "/p/<share_id>/",
      "user_document_container": "sandboxed_opaque_origin_iframe",
      "iframe_sandbox_tokens_exact": ["allow-scripts"],
      "allow_same_origin": false,
      "csp_required_directives": {"worker-src": "'none'", "object-src": "'none'", "base-uri": "'none'"},
      "unsupported_worker_kinds": ["Worker", "SharedWorker", "ServiceWorker"],
      "worker_attempt_outcome": "shared_worker_unsupported",
      "service_worker_allowed_header_emitted": false,
      "shared_code_forbidden_data": ["avibe_cookies", "avibe_storage", "local_apis", "hmr", "annotations", "session_id", "workspace_path", "source_path"]
    },
    "shared_response_transport": {
      "protected_surfaces": ["document", "module", "style", "raw_asset", "fallback", "page_api"],
      "authorization": "opaque_document_capability",
      "carrier": "versioned_opaque_path_prefix",
      "path_prefix_template": "/__avibe_show_shared/v1/{namespace_id}/{document_id}/{capability}/",
      "suffix_forms": {
        "document_or_fallback": "<prefix>",
        "opaque_asset": "<prefix>asset/{resource_handle}",
        "page_api": "<prefix>api/{normalized_relative_api_path}"
      },
      "document_url_has_trailing_slash": true,
      "relative_page_api_resolution": "fetch(./api/data)_resolves_to_same_prefix_api/data",
      "page_api_namespace_mapping": "captured_page_api_only",
      "page_api_path_segments": "one_or_more_ascii_alnum_underscore_or_hyphen_segments",
      "page_api_forbidden_syntax": ["dot_segments", "empty_segments", "encoded_separator", "encoded_traversal", "query", "raw_source_path"],
      "nested_import_rewrite": "absolute_url_under_same_namespace_document_capability_prefix",
      "resource_handle": "opaque_non_path_source_identifier",
      "query_authority": false,
      "cookie_authority": false,
      "custom_request_header_required": false,
      "capability_path_access_log_policy": "redact_namespace_document_capability_and_resource_handle_segments",
      "access_control_allow_origin": "*",
      "access_control_allow_credentials": false,
      "set_cookie_allowed": false,
      "referrer_policy": "no-referrer",
      "ambient_identity_or_cookie_authority": false
    },
    "private_editor": {
      "surface": "/show/<session_id>/",
      "context": "private",
      "hmr_and_annotations": "resource_editor_only_at_connection_admission",
      "permission_revocation_polling": false,
      "permission_change_forced_close": false,
      "new_connections_reauthorize": true,
      "operational_shutdown_or_runtime_restart": "separate_lifecycle"
    },
    "cache_policy": {
      "limited_all_surfaces": "private, no-store",
      "public_non_versioned_surfaces": {
        "surfaces": ["shell", "document", "module", "style", "raw_asset", "fallback", "page_api", "error", "redirect"],
        "response_headers": {"Cache-Control": "private, no-store"}
      },
      "public_access_dependent_redirects": ["resource_viewer_p_to_canonical_show", "resource_editor_p_to_canonical_show"],
      "public_versioned_asset_exception": "public, max-age=31536000, immutable",
      "public_versioned_asset_constraint": "contains_only_public_bytes_and_no_identity_or_page_private_data"
    },
    "fixed_limits": {
      "shared_request_execution_seconds": 60,
      "request_timeout_outcome": "sanitized_request_timeout",
      "maximum_shared_snapshot_bytes": 67108864,
      "maximum_shared_namespaces_per_process": 64,
      "maximum_shared_process_bytes": 536870912,
      "global_budget_scope": "one_per_runtime_process",
      "resource_pressure_eviction_unit": "whole_shared_namespace",
      "resource_pressure_outcome": "reload_required_without_paths_or_diagnostics",
      "timer_or_permission_driven_eviction": false
    },
    "release_gate": {
      "reviewed_runtime_sha": "ee3b0b490ad8b4afafb59cf37e2d57a20325208a",
      "required_equality": "reviewed_runtime_sha == smoke_tested_runtime_sha == bundled_runtime_sha",
      "feature_advertisement_before_equality": false,
      "dynamic_runtime_main_resolution_after_advertisement": false
    }
  },
  "x-examples": [
    {"name": "private_envelope", "schema_ref": "#/$defs/RuntimeEnvelope", "value": {"protocol": 1, "context": "private"}},
    {"name": "shared_envelope", "schema_ref": "#/$defs/RuntimeEnvelope", "value": {"protocol": 1, "context": "shared"}},
    {"name": "shared_admission", "schema_ref": "#/$defs/SharedAdmission", "value": {"source_session_id": "session-1", "instance_id": "instance-1", "page_id": "page:alpha", "share_id": "stable_alpha", "admitted_revision": 5, "audience": "limited", "identity_subject": "user-1"}},
    {"name": "public_anonymous_admission", "schema_ref": "#/$defs/SharedAdmission", "value": {"source_session_id": "session-1", "instance_id": "instance-1", "page_id": "page:alpha", "share_id": "stable_alpha", "admitted_revision": 6, "audience": "public", "identity_subject": null}},
    {"name": "document_capability", "schema_ref": "#/$defs/SharedDocumentCapability", "value": {"namespace_id": "ns_R4nd0mValue_01", "document_id": "doc_R4nd0mValue_01", "capability": "cap_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-"}},
    {"name": "shared_admission_success", "schema_ref": "#/$defs/SharedAdmissionResult", "value": {"outcome": "success", "capability": {"namespace_id": "ns_R4nd0mValue_01", "document_id": "doc_R4nd0mValue_01", "capability": "cap_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-"}}},
    {"name": "shared_admission_unavailable", "schema_ref": "#/$defs/SharedAdmissionResult", "value": {"outcome": "failure", "code": "shared_runtime_unavailable", "http_status": 503, "body": "shared runtime unavailable"}},
    {"name": "shared_document_request", "schema_ref": "#/$defs/SharedResourceRequest", "value": {"method": "GET", "surface": "document", "path": "/__avibe_show_shared/v1/ns_R4nd0mValue_01/doc_R4nd0mValue_01/cap_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-/"}},
    {"name": "shared_module_request", "schema_ref": "#/$defs/SharedResourceRequest", "value": {"method": "GET", "surface": "module", "path": "/__avibe_show_shared/v1/ns_R4nd0mValue_01/doc_R4nd0mValue_01/cap_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-/asset/res_opaque_01"}},
    {"name": "shared_page_api_request", "schema_ref": "#/$defs/SharedResourceRequest", "value": {"method": "POST", "surface": "page_api", "path": "/__avibe_show_shared/v1/ns_R4nd0mValue_01/doc_R4nd0mValue_01/cap_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-/api/data"}}
  ],
  "$defs": {
    "RuntimeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "context"],
      "properties": {"protocol": {"const": 1}, "context": {"enum": ["private", "shared"]}}
    },
    "SharedAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_session_id", "instance_id", "page_id", "share_id", "admitted_revision", "audience", "identity_subject"],
      "properties": {
        "source_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "page_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "share_id": {"type": "string", "minLength": 3, "maxLength": 64},
        "admitted_revision": {"type": "integer", "minimum": 0},
        "audience": {"enum": ["limited", "public"]},
        "identity_subject": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]}
      }
    },
    "SharedDocumentCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_id", "document_id", "capability"],
      "properties": {
        "namespace_id": {"type": "string", "minLength": 16, "maxLength": 256},
        "document_id": {"type": "string", "minLength": 16, "maxLength": 256},
        "capability": {"type": "string", "minLength": 43, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "SharedAdmissionResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "capability"],
          "properties": {
            "outcome": {"const": "success"},
            "capability": {"$ref": "#/$defs/SharedDocumentCapability"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "code", "http_status", "body"],
          "properties": {
            "outcome": {"const": "failure"},
            "code": {"enum": ["shared_runtime_unavailable", "snapshot_too_large", "capacity_exhausted", "capture_timeout", "reload_required"]},
            "http_status": {"enum": [409, 413, 503, 504]},
            "body": {"enum": ["shared runtime unavailable", "shared page unavailable", "shared runtime busy", "shared page timed out", "reload required"]}
          },
          "allOf": [
            {"if": {"properties": {"code": {"const": "shared_runtime_unavailable"}}}, "then": {"properties": {"http_status": {"const": 503}, "body": {"const": "shared runtime unavailable"}}}},
            {"if": {"properties": {"code": {"const": "snapshot_too_large"}}}, "then": {"properties": {"http_status": {"const": 413}, "body": {"const": "shared page unavailable"}}}},
            {"if": {"properties": {"code": {"const": "capacity_exhausted"}}}, "then": {"properties": {"http_status": {"const": 503}, "body": {"const": "shared runtime busy"}}}},
            {"if": {"properties": {"code": {"const": "capture_timeout"}}}, "then": {"properties": {"http_status": {"const": 504}, "body": {"const": "shared page timed out"}}}},
            {"if": {"properties": {"code": {"const": "reload_required"}}}, "then": {"properties": {"http_status": {"const": 409}, "body": {"const": "reload required"}}}}
          ]
        }
      ]
    },
    "SharedResourceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "surface", "path"],
      "properties": {
        "method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
        "surface": {"enum": ["document", "module", "style", "raw_asset", "fallback", "page_api"]},
        "path": {
          "type": "string",
          "oneOf": [
            {"pattern": "^/__avibe_show_shared/v1/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/$"},
            {"pattern": "^/__avibe_show_shared/v1/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/asset/[A-Za-z0-9_-]+$"},
            {"pattern": "^/__avibe_show_shared/v1/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/api/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"}
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"surface": {"enum": ["document", "fallback"]}}}, "then": {"properties": {"path": {"pattern": "/$"}}}},
        {"if": {"properties": {"surface": {"enum": ["module", "style", "raw_asset"]}}}, "then": {"properties": {"path": {"pattern": "/asset/[A-Za-z0-9_-]+$"}}}},
        {"if": {"properties": {"surface": {"const": "page_api"}}}, "then": {"properties": {"path": {"pattern": "/api/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"}}}}
      ]
    }
  }
}
