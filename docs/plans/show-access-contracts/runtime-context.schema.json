{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v1/runtime-context.schema.json",
  "title": "Show Runtime context negotiation contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "request_protocol_cases",
    "negotiation_cases",
    "app_graph_operations",
    "loopback_request_boundary",
    "protocol1_validation",
    "runtime_graph_ownership",
    "shared_capture_admission",
    "operation_context_eligibility",
    "capability_cache",
    "shared_namespace_confinement",
    "namespace_lifetime",
    "resource_governance",
    "shared_proxy_policy",
    "avibe_private_hmr_monitor",
    "shared_response_cases",
    "route_invariants",
    "release_gate"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocol_header", "context_header", "keyed_context_feature", "contexts"],
      "properties": {
        "version": { "const": 1 },
        "protocol_header": { "const": "X-Avibe-Show-Protocol" },
        "context_header": { "const": "X-Avibe-Show-Context" },
        "keyed_context_feature": { "const": "show-context-key-v1" },
        "contexts": {
          "const": ["private", "shared"]
        }
      }
    },
    "request_protocol_cases": {
      "const": [
        {
          "id": "released_headerless",
          "protocol_header": "absent",
          "context_header": "ignored",
          "outcome": "legacy_singleton",
          "legacy_base_header": "x-vibe-show-base",
          "legacy_base_propagation": [
            "entry_http",
            "module_http",
            "spa_fallback_http",
            "startup_reconciliation_prewarm",
            "show_update_prewarm"
          ],
          "keyed_context_enabled": false
        },
        {
          "id": "declared_v1",
          "protocol_header": "1",
          "context_header": "required_private_or_shared",
          "outcome": "keyed_context"
        },
        {
          "id": "unknown_protocol",
          "protocol_header": "unsupported_value",
          "context_header": "ignored",
          "outcome": "reject"
        }
      ]
    },
    "negotiation_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/negotiation_case" }
    },
    "app_graph_operations": {
      "const": [
        "entry_http",
        "module_http",
        "spa_fallback_http",
        "api_handler_http",
        "shared_capture_admission",
        "private_hmr_websocket",
        "startup_reconciliation_prewarm",
        "show_update_prewarm"
      ]
    },
    "loopback_request_boundary": {
      "const": {
        "id": "RUNTIME-TRUSTED-LOOPBACK-ENVELOPE",
        "browser_supplied_headers_removed": [
          "X-Avibe-Show-Protocol",
          "X-Avibe-Show-Context"
        ],
        "server_owned_envelope_count": 1,
        "server_owned_envelope_source": "show_capability_decision",
        "applies_to_operations": [
          "entry_http",
          "module_http",
          "spa_fallback_http",
          "api_handler_http",
          "shared_capture_admission",
          "private_hmr_websocket",
          "startup_reconciliation_prewarm",
          "show_update_prewarm"
        ]
      }
    },
    "protocol1_validation": {
      "const": {
        "id": "RUNTIME-PROTOCOL1-PRE-MUTATION-VALIDATION",
        "valid_protocol": "1",
        "required_contexts": ["private", "shared"],
        "applies_to_operations": [
          "entry_http",
          "module_http",
          "spa_fallback_http",
          "api_handler_http",
          "shared_capture_admission",
          "private_hmr_websocket",
          "startup_reconciliation_prewarm",
          "show_update_prewarm"
        ],
        "validation_precedes": [
          "session_resolution",
          "graph_lookup",
          "graph_create",
          "graph_rebase",
          "graph_ownership_mutation",
          "hmr_connection"
        ],
        "invalid_context_outcome": "reject_without_graph_side_effects",
        "unknown_protocol_outcome": "reject_without_graph_side_effects"
      }
    },
    "runtime_graph_ownership": {
      "const": {
        "id": "RUNTIME-SESSION-CONTEXT-GRAPH-OWNERSHIP",
        "graph_key": ["session_id", "context"],
        "context_values": ["private", "shared"],
        "maximum_contexts_per_session": 2,
        "private_lifecycle_independent_of": [
          "same_session_shared_startup",
          "same_session_shared_failure",
          "same_session_shared_traffic",
          "same_session_shared_rotation",
          "other_session_activity"
        ],
        "shared_rebase_scope": "same_session_shared_graph_only",
        "shared_activity_closes_private_hmr": false
      }
    },
    "shared_capture_admission": {
      "const": {
        "id": "RUNTIME-INTERNAL-SHARED-CAPTURE-ADMISSION",
        "request_source": "trusted_avibe_server_envelope_only",
        "request_fields": ["session_id", "instance_id", "page_id", "share_id", "audience_revision", "context"],
        "required_context": "shared",
        "authorization_precedes_request": true,
        "browser_request_allowed": false,
        "browser_supplied_context_allowed": false,
        "result_fields": ["namespace_handle", "document_handle", "expires_at"],
        "result_reveals_session_or_path": false,
        "lifetime_owner": "namespace_lifetime",
        "failure_outcomes": ["fixed_sanitized_not_found", "bounded_sanitized_retryable_unavailable", "fixed_sanitized_expired"]
      }
    },
    "operation_context_eligibility": {
      "const": {
        "id": "RUNTIME-EXPLICIT-OPERATION-CONTEXT-ELIGIBILITY",
        "ordinary_editor_file_edit": {
          "private_hmr_identity": "stable",
          "shared_graph_create": false,
          "shared_graph_rebase": false,
          "shared_background_build": false,
          "edit_count_input": "arbitrary_nonnegative_integer",
          "resource_bound": "resource_governance"
        },
        "shared_demand_operations": [
          "entry_http",
          "module_http",
          "spa_fallback_http",
          "api_handler_http"
        ],
        "explicit_shared_prewarm_operations": [
          "startup_reconciliation_prewarm",
          "show_update_prewarm"
        ],
        "shared_prewarm_requires": [
          "explicit_operation",
          "shared_context_envelope",
          "protocol1_validation",
          "resource_budget_admission"
        ],
        "implicit_shared_work_from_private_edit": false
      }
    },
    "capability_cache": {
      "const": {
        "id": "RUNTIME-PROCESS-CAPABILITY-CACHE",
        "permanent_outcomes": ["supported", "unsupported"],
        "transient_outcome": "transient-unknown",
        "transient_retry": "jittered_exponential_backoff",
        "maximum_retry_delay_seconds": 5,
        "identity_inputs": ["runtime_process_identity", "runtime_base_url"],
        "identity_change_clears": ["all_outcomes", "retry_deadline"]
      }
    },
    "shared_namespace_confinement": {
      "const": {
        "id": "RUNTIME-IMMUTABLE-OPAQUE-NAMESPACE",
        "capture": {
          "root_descriptor_confined": true,
          "descriptor_verified_before_and_after_copy": true,
          "snapshot_bytes_immutable": true,
          "transform_identity_fields": [
            "resolved_pathname",
            "query_loader_mode",
            "importer_identity",
            "representation_type"
          ]
        },
        "recursive_dependency_closure": {
          "dependency_kinds": ["tsx", "css", "raw_loader", "worker"],
          "namespace_relation": "same_opaque_namespace",
          "provenance": "immutable_captured",
          "nested_fs_path_allowed": false,
          "mutable_source_fallback_allowed": false,
          "cross_namespace_escape_allowed": false
        },
        "handle": {
          "opaque": true,
          "reveals_path_bytes": false,
          "source_path_reopen": "forbidden",
          "path_swap_existing_handle": "serve_captured_response_only",
          "new_admission_after_unsafe_path_swap": "deny_before_allocation"
        }
      }
    },
    "namespace_lifetime": {
      "const": {
        "id": "RUNTIME-NON-RENEWABLE-NAMESPACE-LIFETIME",
        "idle_deadline_seconds": 1800,
        "absolute_lifetime_seconds": 7200,
        "successful_read_refreshes": "idle_deadline_only",
        "absolute_lifetime_renewable": false,
        "reclaim_unit": "whole_namespace",
        "expired_read_outcome": "fixed_stale_document_reload_required",
        "absolute_expiry_cancels_remaining_pins": true,
        "pre_expiry_admission_extends_absolute_deadline": false
      }
    },
    "resource_governance": {
      "const": {
        "id": "RUNTIME-PROCESS-WIDE-WEIGHTED-BUDGET",
        "budget_scope": "one_per_runtime_process",
        "weighted_resources": [
          "private_vite_contexts",
          "shared_vite_contexts",
          "opaque_namespaces",
          "opaque_handles",
          "snapshot_bytes"
        ],
        "hard_limit_dimensions": ["context_count", "weighted_memory_cost"],
        "runtime_and_per_session_limits": "finite",
        "per_session_bounds": true,
        "private_editor_reserve": "finite_nonzero",
        "private_editor_reserve_relation": "0 < reserve < process_wide_budget",
        "shared_may_consume_private_reserve": false,
        "reclaim_order": [
          "expired_namespaces",
          "oldest_shared_bundle_without_in_flight_request"
        ],
        "private_admission_reclaim": "any_shared_bundle_without_in_flight_request",
        "in_flight_pinning": "until_response_finishes_or_hard_deadline_whichever_is_first",
        "maximum_shared_in_flight_seconds": 60,
        "covered_shared_response_kinds": ["document", "module", "resource", "fallback", "api_handler", "stream"],
        "streaming_policy": {
          "bounded": true,
          "unbounded_streams_supported": false,
          "client_reconnect_allowed": true
        },
        "hard_request_deadline": {
          "formula": "min(request_admitted_at + maximum_shared_in_flight_seconds, namespace_absolute_deadline)",
          "at_deadline": ["cancel_or_terminate_handler_or_stream", "atomically_release_pin", "atomically_release_weighted_budget_charge"],
          "timeout_outcomes": ["fixed_sanitized_shared_timeout", "fixed_stale_document_reload_required"],
          "paths_or_diagnostics_exposed": false,
          "in_flight_work_extends_namespace_or_process_slot": false
        },
        "in_flight_state_machine": {
          "ledger_owner": "resource_governance_process_wide_weighted_budget",
          "release_is_idempotent": true,
          "cases": [
            {"id": "RESOURCE-HUNG-HANDLER", "response_kind": "api_handler", "admitted_at": 1000, "namespace_absolute_deadline": 8000, "observed_at": 1060, "handler_state": "hung", "expected_deadline": 1060, "termination_or_stream_close_at": 1060, "atomic_pin_and_charge_release_at": 1060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"},
            {"id": "RESOURCE-INFINITE-STREAM", "response_kind": "stream", "admitted_at": 2000, "namespace_absolute_deadline": 9000, "observed_at": 2060, "handler_state": "streaming", "expected_deadline": 2060, "termination_or_stream_close_at": 2060, "atomic_pin_and_charge_release_at": 2060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"},
            {"id": "RESOURCE-EXACT-REQUEST-DEADLINE", "response_kind": "module", "admitted_at": 3000, "namespace_absolute_deadline": 9000, "observed_at": 3060, "handler_state": "running", "expected_deadline": 3060, "termination_or_stream_close_at": 3060, "atomic_pin_and_charge_release_at": 3060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"},
            {"id": "RESOURCE-NAMESPACE-EXPIRY-RACE", "response_kind": "document", "admitted_at": 4000, "namespace_absolute_deadline": 4025, "observed_at": 4025, "handler_state": "running", "expected_deadline": 4025, "termination_or_stream_close_at": 4025, "atomic_pin_and_charge_release_at": 4025, "outcome": "fixed_stale_document_reload_required", "pin_released": true, "charge_released": true, "later_admission": "reload"},
            {"id": "RESOURCE-CONCURRENT-RECLAIM", "response_kind": "resource", "admitted_at": 5000, "namespace_absolute_deadline": 9000, "observed_at": 5060, "handler_state": "running_during_reclaim", "expected_deadline": 5060, "termination_or_stream_close_at": 5060, "atomic_pin_and_charge_release_at": 5060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"},
            {"id": "RESOURCE-LEDGER-RECOVERY", "response_kind": "fallback", "admitted_at": 6000, "namespace_absolute_deadline": 9000, "observed_at": 6060, "handler_state": "cancellation_cleanup_failed", "expected_deadline": 6060, "termination_or_stream_close_at": 6060, "atomic_pin_and_charge_release_at": 6060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"},
            {"id": "RESOURCE-ADMISSION-AFTER-RELEASE", "response_kind": "api_handler", "admitted_at": 7000, "namespace_absolute_deadline": 9000, "observed_at": 7061, "handler_state": "cancelled_at_deadline", "expected_deadline": 7060, "termination_or_stream_close_at": 7060, "atomic_pin_and_charge_release_at": 7060, "outcome": "fixed_sanitized_shared_timeout", "pin_released": true, "charge_released": true, "later_admission": "admit"}
          ]
        },
        "shared_overload_outcome": "bounded_sanitized_retryable_unavailable"
      }
    },
    "shared_proxy_policy": {
      "const": {
        "id": "AVIBE-SHARED-PROXY-CONFINEMENT",
        "service_worker_policy": {
          "shared_execution_origin": "opaque_origin_iframe_without_allow_same_origin",
          "registration": "unsupported_and_rejected_with_security_error",
          "service_worker_allowed_header": "absent",
          "controls_public_show": false,
          "controls_canonical_show": false,
          "private_bytes_exposed": false,
          "ordinary_web_worker_support_is_separate": true
        },
        "editor_redirect_cache_control": "private, no-store",
        "response_policy_matrix": {
          "axes": {
            "audience_mode": ["public", "limited"],
            "surface": ["shell", "entry", "document", "module", "css", "raw", "worker", "spa_fallback", "api_handler", "redirect", "error"]
          },
          "rules": [
            { "audience_mode": "public", "surface": "*", "cache_control": "private, no-store", "vary": null },
            { "audience_mode": "limited", "surface": "*", "cache_control": "private, no-store", "vary": "Cookie" }
          ]
        },
        "cross_principal_response_reuse": false
      }
    },
    "avibe_private_hmr_monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "implementation_owner", "runtime_implementation_owner", "websocket_admission", "authority_monitor", "post_connect_policy", "share_mode_or_binding_change_closes_private_hmr_when_editor_access_remains"],
      "properties": {
        "id": {"const": "AVIBE-PRIVATE-HMR-AUTHORITY"},
        "owner": {"const": "PrivateHmrAuthority"},
        "implementation_owner": {"const": "avibe"},
        "runtime_implementation_owner": {"const": false},
        "websocket_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "authorization_checks", "request_trust_classifier", "origin_header_cardinality", "origin_normalization", "origin_match", "never_authority", "validation_order", "rejection", "positive_source_cases", "negative_mutations"],
          "properties": {
            "route": {"const": "/show/<page_id>/__vite_hmr"},
            "authorization_checks": {"const": ["server_validated_origin_source", "resource_editor_authority"]},
            "request_trust_classifier": {
              "const": {
                "reuse_functions": ["vibe.ui_server._websocket_is_local_request", "vibe.ui_server._websocket_trusted_public_origin_local_request", "vibe.ui_server._websocket_origin_matches_effective_request", "vibe.ui_server._remote_access_public_origin_matches"],
                "local_source_classes": ["direct_loopback", "explicit_setup_host", "wildcard_resolved_interface", "docker_loopback_bridge"],
                "remote_source_classes": ["configured_hosted_instance", "active_custom_hostname", "trusted_public_proxy"],
                "parallel_network_trust_model_allowed": false
              }
            },
            "origin_header_cardinality": {"const": "exactly_one"},
            "origin_normalization": {"const": ["lowercase_scheme", "normalized_dns_or_ip_host", "ipv4_mapped_normalization", "default_or_explicit_effective_port"]},
            "origin_match": {"const": "exact_normalized_scheme_host_or_ip_and_effective_port"},
            "never_authority": {"const": ["0.0.0.0", "::", "*", "raw_host_header", "untrusted_forwarded_metadata", "wildcard_match", "suffix_match"]},
            "validation_order": {"const": "before_any_upstream_websocket_open"},
            "rejection": {"const": {"outcome": "reject_without_upstream_websocket", "upstream_websocket_opened": false}},
            "positive_source_cases": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "source_class", "origin_headers", "resolved_trusted_origin", "server_facts", "peer_or_network_checks", "resource_editor_authority", "outcome", "upstream_websocket_opened"],
                "properties": {
                  "id": {"type": "string", "pattern": "^HMR-SOURCE-[A-Z0-9-]+$"},
                  "source_class": {"enum": ["configured_hosted_instance", "active_custom_hostname", "direct_loopback", "explicit_setup_host", "wildcard_resolved_interface", "docker_loopback_bridge", "trusted_public_proxy"]},
                  "origin_headers": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^https?://"}},
                  "resolved_trusted_origin": {"type": "string", "pattern": "^https?://"},
                  "server_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                  "peer_or_network_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                  "resource_editor_authority": {"const": true},
                  "outcome": {"const": "open_after_origin_and_editor_authorization"},
                  "upstream_websocket_opened": {"const": true}
                }
              }
            },
            "negative_mutations": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "applies_to", "mutation", "outcome", "upstream_websocket_opened"],
                "properties": {
                  "id": {"type": "string", "pattern": "^HMR-REJECT-[A-Z0-9-]+$"},
                  "applies_to": {"enum": ["all_source_classes", "peer_validated_source_classes", "trusted_public_proxy"]},
                  "mutation": {"type": "string"},
                  "outcome": {"const": "reject_without_upstream_websocket"},
                  "upstream_websocket_opened": {"const": false}
                }
              }
            }
          }
        },
        "authority_monitor": {
          "const": {
            "scope": "one_coalesced_persistent_monitor_per_active_session",
            "poll_interval_max_seconds": 4,
            "notification_policy": "optional_wakeup_only_not_required_for_correctness",
            "persistence_read_uncertainty_outcome": "close_all_sockets_fail_closed",
            "persistent_sources": [
              {"trigger": "editor_capability_loss", "source": "ResourceAccessStore.editor_capability"},
              {"trigger": "resource_access_revocation", "source": "ResourceAccessStore.resource_authority"},
              {"trigger": "remote_authorization_loss", "source": "RemoteAccessSessionStore.authorization"},
              {"trigger": "authorization_revision_change", "source": "RemoteAccessSessionStore.authorization_revision"},
              {"trigger": "durable_offline_state", "source": "ShowPageStore.availability"}
            ],
            "deadline": {
              "measured_from": "durable_authority_change_commit",
              "post_detection_close_budget_seconds": 1,
              "total_close_deadline_seconds": 5,
              "poll_plus_close_budget_must_not_exceed_total": true
            },
            "trace_matrix_ms": {
              "triggers": ["editor_capability_loss", "resource_access_revocation", "remote_authorization_loss", "authorization_revision_change", "durable_offline_state"],
              "event_delivery": ["just_after_poll", "notification_lost"],
              "last_poll": 0,
              "durable_change_commit": 1,
              "next_poll_no_later_than": 4000,
              "detected_no_later_than": 4000,
              "all_sockets_closed_no_later_than": 5000,
              "elapsed_from_change_commit": 4999,
              "elapsed_after_detection": 1000
            }
          }
        },
        "post_connect_policy": {
          "const": {
            "close_triggers": ["editor_capability_loss", "resource_access_revocation", "remote_authorization_loss", "authorization_revision_change", "durable_offline_state"],
            "non_close_triggers_while_active_editor_remains": ["access_mode_change", "share_binding_change", "guest_membership_change", "audience_revision_change"]
          }
        },
        "share_mode_or_binding_change_closes_private_hmr_when_editor_access_remains": {"const": false}
      }
    },
    "shared_response_cases": {
      "const": [
        {
          "id": "keyed_immutable_graph_success",
          "runtime_mode": "keyed_context",
          "input_class": "proven_application_or_asset",
          "outcome": "complete_transformed_response",
          "body_source": "immutable_snapshot_virtual_graph",
          "url_header_policy": "strip_or_safely_rewrite",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "keyed_development_diagnostic",
          "runtime_mode": "keyed_context",
          "input_class": "development_diagnostic",
          "outcome": "fixed_shared_error",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "strip_or_safely_rewrite",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "legacy_unclassified_transform_error",
          "runtime_mode": "legacy_singleton",
          "input_class": "unclassified_error_or_missing_provenance",
          "outcome": "fixed_path_free_unavailable",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "remove_url_bearing_headers",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "legacy_raw_or_nested_fs_graph",
          "runtime_mode": "legacy_singleton",
          "input_class": "raw_or_nested_fs_reference",
          "outcome": "fixed_path_free_unavailable",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "remove_url_bearing_headers",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        }
      ]
    },
    "route_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_route", "private_route", "resource_redirect"],
      "properties": {
        "shared_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "context", "hmr", "private_bytes", "cache_control", "vary"],
          "properties": {
            "path": { "const": "/p/<share_id>/" },
            "context": { "const": "shared" },
            "hmr": { "const": false },
            "private_bytes": { "const": false },
            "cache_control": { "const": "private, no-store" },
            "vary": { "const": "Cookie" }
          }
        },
        "private_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "context", "hmr_requires"],
          "properties": {
