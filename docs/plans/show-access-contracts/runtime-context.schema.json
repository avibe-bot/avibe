{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v1/runtime-context.schema.json",
  "title": "Show Runtime context negotiation contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "request_protocol_cases",
    "negotiation_cases",
    "app_graph_operations",
    "loopback_request_boundary",
    "protocol1_validation",
    "runtime_graph_ownership",
    "capability_cache",
    "shared_namespace_confinement",
    "namespace_lifetime",
    "resource_governance",
    "shared_proxy_policy",
    "avibe_private_hmr_monitor",
    "shared_response_cases",
    "route_invariants",
    "release_gate"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocol_header", "context_header", "keyed_context_feature", "contexts"],
      "properties": {
        "version": { "const": 1 },
        "protocol_header": { "const": "X-Avibe-Show-Protocol" },
        "context_header": { "const": "X-Avibe-Show-Context" },
        "keyed_context_feature": { "const": "show-context-key-v1" },
        "contexts": {
          "const": ["private", "shared"]
        }
      }
    },
    "request_protocol_cases": {
      "const": [
        {
          "id": "released_headerless",
          "protocol_header": "absent",
          "context_header": "ignored",
          "outcome": "legacy_singleton",
          "legacy_base_header": "x-vibe-show-base",
          "legacy_base_propagation": [
            "entry_http",
            "module_http",
            "spa_fallback_http",
            "startup_reconciliation_prewarm",
            "show_update_prewarm"
          ],
          "keyed_context_enabled": false
        },
        {
          "id": "declared_v1",
          "protocol_header": "1",
          "context_header": "required_private_or_shared",
          "outcome": "keyed_context"
        },
        {
          "id": "unknown_protocol",
          "protocol_header": "unsupported_value",
          "context_header": "ignored",
          "outcome": "reject"
        }
      ]
    },
    "negotiation_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/negotiation_case" }
    },
    "app_graph_operations": {
      "const": [
        "entry_http",
        "module_http",
        "spa_fallback_http",
        "api_handler_http",
        "private_hmr_websocket",
        "startup_reconciliation_prewarm",
        "show_update_prewarm"
      ]
    },
    "loopback_request_boundary": {
      "const": {
        "id": "RUNTIME-TRUSTED-LOOPBACK-ENVELOPE",
        "browser_supplied_headers_removed": [
          "X-Avibe-Show-Protocol",
          "X-Avibe-Show-Context"
        ],
        "server_owned_envelope_count": 1,
        "server_owned_envelope_source": "show_capability_decision",
        "applies_to_operations": [
          "entry_http",
          "module_http",
          "spa_fallback_http",
          "api_handler_http",
          "private_hmr_websocket",
          "startup_reconciliation_prewarm",
          "show_update_prewarm"
        ]
      }
    },
    "protocol1_validation": {
      "const": {
        "id": "RUNTIME-PROTOCOL1-PRE-MUTATION-VALIDATION",
        "valid_protocol": "1",
        "required_contexts": ["private", "shared"],
        "applies_to_operations": [
          "entry_http",
          "module_http",
          "spa_fallback_http",
          "api_handler_http",
          "private_hmr_websocket",
          "startup_reconciliation_prewarm",
          "show_update_prewarm"
        ],
        "validation_precedes": [
          "session_resolution",
          "graph_lookup",
          "graph_create",
          "graph_rebase",
          "graph_ownership_mutation",
          "hmr_connection"
        ],
        "invalid_context_outcome": "reject_without_graph_side_effects",
        "unknown_protocol_outcome": "reject_without_graph_side_effects"
      }
    },
    "runtime_graph_ownership": {
      "const": {
        "id": "RUNTIME-SESSION-CONTEXT-GRAPH-OWNERSHIP",
        "graph_key": ["session_id", "context"],
        "context_values": ["private", "shared"],
        "maximum_contexts_per_session": 2,
        "private_lifecycle_independent_of": [
          "same_session_shared_startup",
          "same_session_shared_failure",
          "same_session_shared_traffic",
          "same_session_shared_rotation",
          "other_session_activity"
        ],
        "shared_rebase_scope": "same_session_shared_graph_only",
        "shared_activity_closes_private_hmr": false
      }
    },
    "capability_cache": {
      "const": {
        "id": "RUNTIME-PROCESS-CAPABILITY-CACHE",
        "permanent_outcomes": ["supported", "unsupported"],
        "transient_outcome": "transient-unknown",
        "transient_retry": "jittered_exponential_backoff",
        "maximum_retry_delay_seconds": 5,
        "identity_inputs": ["runtime_process_identity", "runtime_base_url"],
        "identity_change_clears": ["all_outcomes", "retry_deadline"]
      }
    },
    "shared_namespace_confinement": {
      "const": {
        "id": "RUNTIME-IMMUTABLE-OPAQUE-NAMESPACE",
        "capture": {
          "root_descriptor_confined": true,
          "descriptor_verified_before_and_after_copy": true,
          "snapshot_bytes_immutable": true,
          "transform_identity_fields": [
            "resolved_pathname",
            "query_loader_mode",
            "importer_identity",
            "representation_type"
          ]
        },
        "recursive_dependency_closure": {
          "dependency_kinds": ["tsx", "css", "raw_loader", "worker"],
          "namespace_relation": "same_opaque_namespace",
          "provenance": "immutable_captured",
          "nested_fs_path_allowed": false,
          "mutable_source_fallback_allowed": false,
          "cross_namespace_escape_allowed": false
        },
        "handle": {
          "opaque": true,
          "reveals_path_bytes": false,
          "source_path_reopen": "forbidden",
          "path_swap_existing_handle": "serve_captured_response_only",
          "new_admission_after_unsafe_path_swap": "deny_before_allocation"
        }
      }
    },
    "namespace_lifetime": {
      "const": {
        "id": "RUNTIME-NON-RENEWABLE-NAMESPACE-LIFETIME",
        "idle_deadline_seconds": 1800,
        "absolute_lifetime_seconds": 7200,
        "successful_read_refreshes": "idle_deadline_only",
        "absolute_lifetime_renewable": false,
        "reclaim_unit": "whole_namespace",
        "expired_read_outcome": "fixed_stale_document_reload_required"
      }
    },
    "resource_governance": {
      "const": {
        "id": "RUNTIME-PROCESS-WIDE-WEIGHTED-BUDGET",
        "budget_scope": "one_per_runtime_process",
        "weighted_resources": [
          "private_vite_contexts",
          "shared_vite_contexts",
          "opaque_namespaces",
          "opaque_handles",
          "snapshot_bytes"
        ],
        "hard_limit_dimensions": ["context_count", "weighted_memory_cost"],
        "runtime_and_per_session_limits": "finite",
        "per_session_bounds": true,
        "private_editor_reserve": "finite_nonzero",
        "private_editor_reserve_relation": "0 < reserve < process_wide_budget",
        "shared_may_consume_private_reserve": false,
        "reclaim_order": [
          "expired_namespaces",
          "oldest_shared_bundle_without_in_flight_request"
        ],
        "private_admission_reclaim": "any_shared_bundle_without_in_flight_request",
        "in_flight_pinning": "until_response_finishes_only",
        "shared_overload_outcome": "bounded_sanitized_retryable_unavailable"
      }
    },
    "shared_proxy_policy": {
      "const": {
        "id": "AVIBE-SHARED-PROXY-CONFINEMENT",
        "service_worker_allowed_header": "strip",
        "maximum_service_worker_scope": "/p/<share_id>/",
        "shared_entry_cache_control": "private, no-store",
        "editor_redirect_cache_control": "private, no-store",
        "limited_response_cache_control": "private, no-store",
        "limited_response_surfaces": ["entry", "module", "spa_fallback", "api_handler"],
        "identity_vary_header": "Cookie",
        "cross_principal_response_reuse": false
      }
    },
    "avibe_private_hmr_monitor": {
      "const": {
        "id": "AVIBE-PRIVATE-HMR-REVOCATION-MONITOR",
        "implementation_owner": "avibe",
        "runtime_implementation_owner": false,
        "monitor_scope": "one_coalesced_monitor_per_active_session",
        "authorization_triggers": [
          "editor_capability_loss",
          "resource_access_revocation",
          "authorization_revision_change"
        ],
        "authorization_trigger_action": "reevaluate_and_close_unauthorized_existing_sockets",
        "durable_offline_source": "ShowPageStore",
        "durable_offline_poll_max_seconds": 5,
        "durable_offline_close_all_deadline_seconds": 5,
        "share_mode_or_binding_change_closes_private_hmr_when_editor_access_remains": false
      }
    },
    "shared_response_cases": {
      "const": [
        {
          "id": "keyed_immutable_graph_success",
          "runtime_mode": "keyed_context",
          "input_class": "proven_application_or_asset",
          "outcome": "complete_transformed_response",
          "body_source": "immutable_snapshot_virtual_graph",
          "url_header_policy": "strip_or_safely_rewrite",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "keyed_development_diagnostic",
          "runtime_mode": "keyed_context",
          "input_class": "development_diagnostic",
          "outcome": "fixed_shared_error",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "strip_or_safely_rewrite",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "legacy_unclassified_transform_error",
          "runtime_mode": "legacy_singleton",
          "input_class": "unclassified_error_or_missing_provenance",
          "outcome": "fixed_path_free_unavailable",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "remove_url_bearing_headers",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        },
        {
          "id": "legacy_raw_or_nested_fs_graph",
          "runtime_mode": "legacy_singleton",
          "input_class": "raw_or_nested_fs_reference",
          "outcome": "fixed_path_free_unavailable",
          "body_source": "fixed_sanitized_representation",
          "url_header_policy": "remove_url_bearing_headers",
          "raw_source": false,
          "host_path": false,
          "private_session_path": false,
          "development_diagnostic": false
        }
      ]
    },
    "route_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_route", "private_route", "editor_redirect"],
      "properties": {
        "shared_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "context", "hmr", "private_bytes", "cache_control", "vary"],
          "properties": {
            "path": { "const": "/p/<share_id>/" },
            "context": { "const": "shared" },
            "hmr": { "const": false },
            "private_bytes": { "const": false },
            "cache_control": { "const": "private, no-store" },
            "vary": { "const": "Cookie" }
          }
        },
        "private_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "context", "hmr_requires"],
          "properties": {
            "path": { "const": "/show/<session_id>/" },
            "context": { "const": "private" },
            "hmr_requires": { "const": "show_editor_capability" }
          }
        },
        "editor_redirect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "destination",
            "preserve_route_suffix",
            "preserve_query",
            "cache_control",
            "vary",
            "requires"
          ],
          "properties": {
            "source": { "const": "top_level_navigation" },
            "destination": { "const": "/show/<session_id>/" },
            "preserve_route_suffix": { "const": true },
            "preserve_query": { "const": true },
            "cache_control": { "const": "private, no-store" },
            "vary": { "const": "Cookie" },
            "requires": {
              "const": [
                "active_share_binding",
                "show_editor_capability",
                "keyed_context_supported",
                "trusted_fetch_metadata"
              ]
            }
          }
        }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_runtime_sha",
        "reviewed_runtime_pr",
        "smoke_tested_runtime_sha",
        "bundled_runtime_sha",
        "delivery_item_6",
        "delivery_item_9",
        "smoke_test",
        "feature_advertisement_allowed"
      ],
      "properties": {
        "reviewed_runtime_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "reviewed_runtime_pr": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://github\\.com/avibe-bot/vibe-show-runtime/pull/[1-9][0-9]*$"
            },
            { "type": "null" }
          ]
        },
        "smoke_tested_runtime_sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "bundled_runtime_sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "delivery_item_6": { "enum": ["not_implemented", "implemented"] },
        "delivery_item_9": { "enum": ["not_implemented", "implemented"] },
        "smoke_test": { "enum": ["not_run", "passed"] },
        "feature_advertisement_allowed": { "type": "boolean" }
      },
      "if": { "properties": { "feature_advertisement_allowed": { "const": true } } },
      "then": {
        "required": ["reviewed_runtime_pr"],
        "properties": {
          "reviewed_runtime_sha": {
            "not": { "const": "ee3b0b490ad8b4afafb59cf37e2d57a20325208a" }
          },
          "reviewed_runtime_pr": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/avibe-bot/vibe-show-runtime/pull/[1-9][0-9]*$"
          },
          "smoke_tested_runtime_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "bundled_runtime_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "delivery_item_6": { "const": "implemented" },
          "delivery_item_9": { "const": "implemented" },
          "smoke_test": { "const": "passed" }
        }
      }
    }
  },
  "$defs": {
    "negotiation_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence",
        "outcome",
        "process_cache",
        "redirect_eligible",
        "request_before_next_probe"
      ],
      "properties": {
        "id": { "enum": ["supported", "unsupported", "transient_unknown"] },
        "evidence": {
          "enum": ["protocol_1_with_feature", "definitive_legacy", "transient_or_malformed"]
        },
        "outcome": { "enum": ["supported", "unsupported", "transient-unknown"] },
        "process_cache": { "enum": ["permanent", "retry_deadline"] },
        "redirect_eligible": { "type": "boolean" },
        "request_before_next_probe": { "const": "shared" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "supported" } } },
          "then": {
            "properties": {
              "evidence": { "const": "protocol_1_with_feature" },
              "outcome": { "const": "supported" },
              "process_cache": { "const": "permanent" },
              "redirect_eligible": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "id": { "const": "unsupported" } } },
          "then": {
            "properties": {
              "evidence": { "const": "definitive_legacy" },
              "outcome": { "const": "unsupported" },
              "process_cache": { "const": "permanent" },
              "redirect_eligible": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "id": { "const": "transient_unknown" } } },
          "then": {
            "properties": {
              "evidence": { "const": "transient_or_malformed" },
              "outcome": { "const": "transient-unknown" },
              "process_cache": { "const": "retry_deadline" },
              "redirect_eligible": { "const": false }
            }
          }
        }
      ]
    }
  }
}
