{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json",
  "title": "Local authoritative ShowAccess v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_id",
    "availability",
    "access_mode",
    "share_binding",
    "audience_revision",
    "emails",
    "last_mutation"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "page_id": { "$ref": "#/$defs/page_id" },
    "availability": { "$ref": "#/$defs/availability" },
    "access_mode": { "$ref": "#/$defs/access_mode" },
    "share_binding": { "$ref": "#/$defs/share_binding" },
    "audience_revision": { "$ref": "#/$defs/revision" },
    "emails": { "$ref": "#/$defs/canonical_email_set" },
    "last_mutation": {
      "oneOf": [{ "$ref": "#/$defs/mutation_receipt" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "access_mode": { "const": "limited" } }, "required": ["access_mode"] },
      "then": {
        "properties": {
          "share_binding": { "$ref": "#/$defs/bound_share" },
          "emails": { "$ref": "#/$defs/non_empty_canonical_email_set" }
        }
      }
    },
    {
      "if": { "properties": { "access_mode": { "const": "public" } }, "required": ["access_mode"] },
      "then": {
        "properties": {
          "share_binding": { "$ref": "#/$defs/bound_share" },
          "emails": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "access_mode": { "const": "private" } }, "required": ["access_mode"] },
      "then": { "properties": { "emails": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "page_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "share_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,62}[A-Za-z0-9]$"
    },
    "mutation_id": {
      "type": "string",
      "minLength": 20,
      "maxLength": 132,
      "pattern": "^mut_[A-Za-z0-9_-]{16,128}$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "availability": { "enum": ["active", "offline"] },
    "access_mode": { "enum": ["private", "limited", "public"] },
    "normalized_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^@\\sA-Z]+@[^@\\sA-Z]+$"
    },
    "canonical_email_set": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/normalized_email" }
    },
    "non_empty_canonical_email_set": {
      "allOf": [
        { "$ref": "#/$defs/canonical_email_set" },
        { "minItems": 1 }
      ]
    },
    "bound_share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["share_id"],
      "properties": { "share_id": { "$ref": "#/$defs/share_id" } }
    },
    "share_binding": {
      "oneOf": [{ "$ref": "#/$defs/bound_share" }, { "type": "null" }]
    },
    "mutation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "canonical_request_sha256", "result_audience_revision"],
      "properties": {
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "canonical_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_audience_revision": { "$ref": "#/$defs/revision" }
      }
    }
  }
}
