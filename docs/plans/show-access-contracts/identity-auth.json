{
  "schema_version": 2,
  "owner": "ExecutableIdentityHandshake",
  "backend_assertion": {
    "format": "short_lived_signed_identity_assertion",
    "authorize_endpoint": {
      "method": "GET",
      "path_template": "/api/v1/instances/{instanceId}/show-identity/authorize"
    },
    "request_inputs": {
      "required": ["state", "nonce", "redirect_uri"],
      "additional_allowed": false,
      "forbidden": ["sub", "email", "aud", "page_id", "share_id", "instance_role", "instance_access_source", "page_membership"]
    },
    "delivery": {
      "response_mode": "form_post",
      "fixed_callback_path": "/auth/show-identity/callback",
      "assertion_parameter": "assertion",
      "state_parameter": "state",
      "form_fields": ["state", "assertion"],
      "additional_form_fields_allowed": false,
      "forbidden_assertion_locations": ["url_query", "url_fragment", "browser_history", "referrer"]
    },
    "callback_uri_policy": {
      "scheme": "https",
      "query_allowed": false,
      "fragment_allowed": false,
      "path": "/auth/show-identity/callback",
      "hostname_source": ["active_instance_hostname", "active_custom_hostname"]
    },
    "required_signed_claims": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"],
    "audience_derivation": "avibe-show-identity:<oauthClientId>",
    "ttl_seconds": 300,
    "maximum_lifetime_seconds": 600,
    "verifier_clock_skew_seconds": 60,
    "verified_email_normalization": ["trim_ascii_surrounding_whitespace", "lowercase"],
    "verified_email_source": {
      "lookup": "fresh_backend_identity_provider_or_user_lookup",
      "explicit_verification_required": true,
      "browser_input_allowed": false,
      "stale_cookie_field_allowed": false
    },
    "signing_keys": {
      "issuer": "current_signing_key_only",
      "jwks_public_keys": ["current", "previous_during_overlap"],
      "minimum_overlap_seconds": 660
    },
    "terminal_errors": [
      { "code": "identity_not_verified", "cache_control": "no-store", "assertion_returned": false },
      { "code": "identity_unavailable", "cache_control": "no-store", "assertion_returned": false }
    ],
    "missing_login_session_action": "redirect_to_login_with_safe_next_only",
    "jti_unique": true,
    "forbidden_claims": [
      "page_id",
      "share_id",
      "page_authorization",
      "page_membership",
      "whitelist",
      "audience_revision",
      "grant_revision",
      "grant_commitment",
      "instance_role",
      "instance_access_source",
      "show_page_email"
    ],
    "instance_access_context_created": false,
    "instance_role_derived": false,
    "page_membership_decided": false
  },
  "local_handshake": {
    "producer": "avibe",
    "server_resolved_before_start": ["instance_id", "page_id", "share_id", "safe_public_return_target"],
    "signed_state_fields": ["instance_id", "share_id", "safe_public_return_target", "callback_hostname", "nonce", "correlation_cookie_sha256", "issued_at", "expires_at"],
    "correlation_cookie": {
      "name": "avibe_show_identity_correlation",
      "same_site": "None",
      "secure": true,
      "http_only": true,
      "path": "/auth/show-identity/callback",
      "domain_attribute_allowed": false,
      "single_use": true,
      "expires_no_later_than": "signed_state.expires_at"
    },
    "callback_checks": [
      "assertion_signature_issuer_audience_and_expiry",
      "nonce_and_jti_match_and_are_single_use",
      "assertion_instance_matches_paired_instance",
      "form_post_targets_fixed_https_callback_without_query_or_fragment",
      "correlation_cookie_hash_matches_signed_state_and_cookie_is_consumed_once",
      "return_target_matches_signed_same_share_target",
      "share_reresolves_before_membership_check"
    ],
    "membership_lookup": "fresh_local_page_email_lookup_on_every_limited_request",
    "identity_session_is_authorization": false,
    "unlisted_outcome": "generic_deny_without_page_bytes_or_login_loop",
    "removed_member_active_tab_policy": "no_active_closure_future_requests_only",
    "reference_harness": {
      "scenario_id": "AUTH-SETUP-404",
      "actual_http_boundary": "POST /auth/show-identity/callback",
      "content_type": "application/x-www-form-urlencoded",
      "cross_site_source": "https://avibe.bot",
      "active_custom_callback_origin": "https://show.example.test",
      "production_conformance": "future_avibe_and_backend_implementation_lanes"
    }
  },
  "closed_loop_scenario": {
    "id": "IDENTITY-CLOSED-LOOP-LISTED",
    "scenario_ids": ["SHOW-LIVE-003", "SHOW-LIVE-037"],
    "start": {
      "instance_id": "ins_identity_contract",
      "page_id": "ses_identity_contract",
      "share_id": "identity-contract-share",
      "safe_public_return_target": "/p/identity-contract-share/",
      "callback_hostname": "show.example.test",
      "allowed_callback_hostnames": ["alice.example.test", "show.example.test"],
      "nonce": "nonce_identity_contract_0001",
      "signed_state_valid": true,
      "correlation_cookie": "cookie_identity_contract_0001",
      "correlation_cookie_sha256": "26b27df81b729e14db0da3ad5169d6cfe30b40c655136f441e03be31ff2760ba",
      "signed_state_expires_at": 1800000300,
      "correlation_cookie_expires_at": 1800000300
    },
    "callback": {
      "http_method": "POST",
      "delivery": "form_post",
      "assertion_location": "form_body",
      "callback_url": "https://show.example.test/auth/show-identity/callback",
      "content_type": "application/x-www-form-urlencoded",
      "cross_site_source": "https://avibe.bot",
      "assertion_format": "short_lived_signed_identity_assertion",
      "assertion_valid": true,
      "instance_id": "ins_identity_contract",
      "nonce": "nonce_identity_contract_0001",
      "jti": "jti_identity_contract_0001",
      "correlation_cookie": "cookie_identity_contract_0001",
      "verified_email": "bob@example.com",
      "resolved_page_id": "ses_identity_contract",
      "resolved_share_id": "identity-contract-share",
      "resolved_audience_revision": 12,
      "current_local_emails": ["bob@example.com"],
      "outcome": "issue_share_bound_browsing_credential"
    },
    "protected_request": {
      "credential_binding": {
        "instance_id": "ins_identity_contract",
        "page_id": "ses_identity_contract",
        "share_id": "identity-contract-share",
        "audience_revision": 12
      },
      "membership_rechecked": true,
      "outcome": "serve_shared"
    },
    "negative_callbacks": [
      {
        "id": "IDENTITY-CALLBACK-NONCE-REPLAY",
        "mutation": "reuse_consumed_nonce",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-INSTANCE-MISMATCH",
        "mutation": "replace_assertion_instance_id",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-SHARE-MISMATCH",
        "mutation": "replace_signed_return_share",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-COOKIE-MISMATCH",
        "mutation": "replace_correlation_cookie",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-URL-QUERY",
        "mutation": "add_callback_query",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-URL-FRAGMENT",
        "mutation": "add_callback_fragment",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-HISTORY-LEAK",
        "mutation": "place_assertion_in_browser_history",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-REFERRER-LEAK",
        "mutation": "place_assertion_in_referrer",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-UNTRUSTED-HOST",
        "mutation": "replace_callback_hostname",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-FORBIDDEN-CLAIM",
        "mutation": "add_page_authorization_claim",
        "outcome": "reject_without_credential_or_page_bytes"
      },
      {
        "id": "IDENTITY-CALLBACK-NOT-VERIFIED",
        "mutation": "identity_not_verified",
        "outcome": "identity_not_verified_no_store_without_assertion"
      },
      {
        "id": "IDENTITY-CALLBACK-IDENTITY-UNAVAILABLE",
        "mutation": "identity_unavailable",
        "outcome": "identity_unavailable_no_store_without_assertion"
      }
    ]
  },
  "cases": [
    {
      "id": "IDENTITY-LISTED-CURRENT",
      "scenario_ids": ["SHOW-LIVE-002", "SHOW-LIVE-037", "SHOW-LIVE-038"],
