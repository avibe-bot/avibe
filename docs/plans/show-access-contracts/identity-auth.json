      {"id": "JWKS-UNKNOWN-KID-CONCURRENT", "token_key": "unknown", "jwks_state": "issuer_coalesced_concurrent_refresh", "refreshes": 1, "outcome": "reject_identity_assertion"},
      {"id": "JWKS-PREVIOUS-KEY-BEFORE-720", "token_key": "previous", "jwks_state": "previous_key_available_before_derived_deadline", "refreshes": 1, "outcome": "verified_identity"},
      {"id": "JWKS-PREVIOUS-KEY-AFTER-720", "token_key": "previous", "jwks_state": "previous_key_removed_after_derived_deadline", "refreshes": 1, "outcome": "reject_identity_assertion"}
