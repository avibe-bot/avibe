    }
  ],
  "$defs": {
    "BoundedString": {"type": "string", "minLength": 1, "maxLength": 2048},
    "SafeReturnPath": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2048,
      "pattern": "^/p/[A-Za-z0-9_-]+/(?:((?!\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+)(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+)*)?$"
    },
    "LoginStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_return_path"],
      "properties": {
        "safe_return_path": {"$ref": "#/$defs/SafeReturnPath"}
      }
    },
    "AuthorizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "nonce", "redirect_uri"],
      "properties": {
        "state": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "redirect_uri": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+/auth/show-identity/callback$"}
      }
    },
    "CallbackForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assertion"],
      "properties": {
        "state": {"type": "string", "minLength": 1, "maxLength": 4096},
        "assertion": {"type": "string", "minLength": 16, "maxLength": 16384, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}
      }
    },
    "SignedStateClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "nonce", "callback_origin", "safe_return_path", "pending_flow_cookie_sha256", "iat", "exp"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
        "safe_return_path": {"$ref": "#/$defs/SafeReturnPath"},
        "pending_flow_cookie_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "iat": {"type": "integer"},
        "exp": {"type": "integer"}
      }
    },
    "IdentityAssertionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"],
      "properties": {
        "iss": {"type": "string", "minLength": 1, "maxLength": 2048, "format": "uri"},
        "aud": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^avibe-show-identity:.+$"},
        "sub": {"type": "string", "minLength": 1, "maxLength": 512},
        "iat": {"type": "integer"},
        "exp": {"type": "integer"},
        "jti": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "verified_email": {"type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"}
      }
    },
    "IdentitySessionToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "PendingFlowCookiePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"const": "__Secure-avibe_show_identity_flow"},
        "value": {"$ref": "#/$defs/IdentitySessionToken"}
      }
    },
    "PendingFlowSetCookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "host_only", "domain", "secure", "http_only", "same_site", "path", "maximum_age_seconds"],
      "properties": {
        "name": {"const": "__Secure-avibe_show_identity_flow"},
        "value": {"$ref": "#/$defs/IdentitySessionToken"},
        "host_only": {"const": true},
        "domain": {"type": "null"},
        "secure": {"const": true},
        "http_only": {"const": true},
        "same_site": {"const": "None"},
        "path": {"const": "/auth/show-identity"},
        "maximum_age_seconds": {"const": 300}
      }
    },
    "PendingFlowExpiredSetCookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "host_only", "domain", "secure", "http_only", "same_site", "path", "maximum_age_seconds"],
      "properties": {
        "name": {"const": "__Secure-avibe_show_identity_flow"},
        "value": {"const": ""},
        "host_only": {"const": true},
        "domain": {"type": "null"},
        "secure": {"const": true},
        "http_only": {"const": true},
        "same_site": {"const": "None"},
        "path": {"const": "/auth/show-identity"},
        "maximum_age_seconds": {"const": 0}
      }
    },
    "IdentitySessionCookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "host_only", "domain", "secure", "http_only", "same_site", "path", "maximum_age_seconds"],
      "properties": {
        "name": {"const": "__Host-avibe_show_identity_session"},
        "value": {"$ref": "#/$defs/IdentitySessionToken"},
        "host_only": {"const": true},
        "domain": {"type": "null"},
        "secure": {"const": true},
        "http_only": {"const": true},
        "same_site": {"const": "Lax"},
        "path": {"const": "/"},
        "maximum_age_seconds": {"const": 2592000}
      }
    },
    "IdentitySessionLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_token", "instance_id", "callback_origin"],
      "properties": {
        "session_token": {"$ref": "#/$defs/IdentitySessionToken"},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"}
      }
    },
    "IdentitySessionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_sha256", "instance_id", "callback_origin", "subject", "normalized_verified_email", "created_at", "expires_at"],
      "properties": {
        "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 512},
        "normalized_verified_email": {"type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
        "created_at": {"type": "integer"},
        "expires_at": {"type": "integer"}
      }
    }
  }
}
