{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avibe.bot/contracts/show-identity/v1",
  "title": "Show identity assertion and login contract v1",
  "$ref": "#/$defs/IdentityAssertionClaims",
  "x-contract": {
    "contract_id": "avibe.show-identity.v1",
    "version": 1,
    "purpose": "verified_identity_only",
    "interfaces": [
      {
        "id": "show_identity_login_start",
        "producer": "show_identity_browser",
        "consumer": "avibe.local_http.GET /auth/show-identity/start",
        "delivery": "browser_navigation_with_optional_cookie_pair",
        "request": "#/$defs/LoginStartRequest",
        "request_cookie": "#/$defs/PendingFlowCookiePair",
        "request_cookie_optional_on_first_start": true,
        "result_cookie": "#/$defs/PendingFlowSetCookie"
      },
      {
        "id": "show_identity_authorize",
        "producer": "avibe.local_http.ShowIdentityLogin",
        "consumer": "avibe-backend.GET /api/v1/instances/{instanceId}/show-identity/authorize",
        "delivery": "browser_navigation",
        "request": "#/$defs/AuthorizeRequest"
      },
      {
        "id": "show_identity_form_post",
        "producer": "avibe-backend.ShowIdentityAssertionIssuer",
        "consumer": "avibe.local_http.POST /auth/show-identity/callback",
        "delivery": "form_post",
        "request": "#/$defs/CallbackForm",
        "request_cookie": "#/$defs/PendingFlowCookiePair",
        "correlation_cookie_expiry": "#/$defs/PendingFlowExpiredSetCookie"
      },
      {
        "id": "show_identity_session_cookie",
        "producer": "avibe.local_http.ShowIdentityCallback",
        "consumer": "show_identity_browser",
        "delivery": "http_set_cookie",
        "result": "#/$defs/IdentitySessionCookie",
        "authority": "identity_only"
      },
      {
        "id": "show_identity_session_lookup",
        "producer": "avibe.local_http.SharedNavigationAdmission",
        "consumer": "avibe.local.IdentitySessionStore",
        "delivery": "local_sha256_digest_lookup",
        "request": "#/$defs/IdentitySessionLookup",
        "result": "#/$defs/IdentitySessionRecord",
        "authority": "identity_only"
      }
    ],
    "authorize": {
      "method": "GET",
      "path": "/api/v1/instances/{instanceId}/show-identity/authorize",
      "request_fields_exact": ["state", "nonce", "redirect_uri"],
      "callback_method": "POST",
      "callback_path": "/auth/show-identity/callback",
      "response_mode": "form_post",
      "assertion_in_url": false,
      "callback_origin": "one_server_configured_paired_https_origin",
      "callback_query_or_fragment_allowed": false
    },
    "assertion": {
      "format": "rfc7519_compact_jwt_jws",
      "algorithm": "RS256",
      "protected_header_fields_exact": ["alg", "typ", "kid"],
      "protected_header_values": {"alg": "RS256", "typ": "JWT"},
      "claims_exact": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"],
      "audience": "avibe-show-identity:<paired_oauth_client_id>",
      "issuer_and_jwks_authority": "local_paired_instance_record",
      "jwks_uri": "<paired_issuer>/oauth/jwks.json",
      "ttl_seconds": 300,
      "clock_skew_seconds": 0,
      "jti": "unique_per_issuer_assertion",
      "verified_email_normalization": ["trim_ascii_surrounding_whitespace", "ascii_lowercase"],
      "verified_email_source": "fresh_verified_backend_identity_record",
      "forbidden_claims": ["page_id", "share_id", "page_membership", "whitelist", "instance_role", "instance_access_source", "show_page_email"]
    },
    "key_lookup": {
      "current_rs256_key_only_required": true,
      "known_key_cache_ttl_seconds": 300,
      "known_kid_at_or_before_cache_ttl": "validate_with_cached_paired_issuer_key",
      "known_kid_older_than_cache_ttl": "refetch_paired_issuer_jwks_once_before_validation",
      "known_key_refetch_failure": "identity_retry_required",
      "unknown_kid_forced_refresh_scope": "paired_issuer_per_login_attempt",
      "maximum_forced_refreshes_per_login_attempt": 1,
      "refresh_is_coalesced_by_issuer": true,
      "refresh_is_not_keyed_by_untrusted_kid": true,
      "failure": "identity_retry_required",
      "seamless_rotation_or_previous_key_overlap_required": false
    },
    "local_flow": {
      "active_flow_cardinality": "one_browser_correlation_cookie_per_configured_callback_origin",
      "latest_login_start_replaces_previous": true,
      "start_path": "/auth/show-identity/start",
      "shared_cookie_path": "/auth/show-identity",
      "state_and_pending_flow_cookie_lifetime_seconds": 300,
      "post_expiry_grace_seconds": 0,
      "stale_or_cookie_less_callback": "identity_retry_required",
      "pending_flow_server_ledger": false,
      "successful_callback_consumption": {
        "fingerprint": "sha256_utf8(verified_assertion.iss + ascii_nul + verified_assertion.jti)",
        "storage": "local_durable_unique_record",
        "atomic_order": "insert_if_absent_after_complete_verification_and_before_identity_session_creation",
        "duplicate": "identity_retry_required_without_session_creation_or_session_expiry_extension",
        "expires_at": "verified_assertion.exp",
        "cleanup": "delete_after_expiry",
        "failed_or_cookie_less_callback_allocates_record": false
      },
      "signed_state": "#/$defs/SignedStateClaims",
      "pending_flow_cookie": {
        "name": "__Secure-avibe_show_identity_flow",
        "value": "base64url_without_padding_of_32_csprng_bytes",
        "host_only": true,
        "domain_attribute_allowed": false,
        "secure": true,
        "http_only": true,
        "same_site": "None",
        "path": "/auth/show-identity",
        "maximum_age_seconds": 300,
        "visible_to": ["login_start", "form_post_callback"]
      },
      "request_cookie_wire": "#/$defs/PendingFlowCookiePair",
      "set_cookie_wire": "#/$defs/PendingFlowSetCookie",
      "callback_expiry_wire": "#/$defs/PendingFlowExpiredSetCookie",
      "correlation": "signed_state.pending_flow_cookie_sha256 == sha256_utf8(request_cookie.value)",
      "server_pending_flow_records": 0,
      "start": "mint_and_overwrite_browser_cookie_then_sign_its_digest_into_state",
      "return_path": "validate_the_requested_root_or_nested_p_route_then_copy_it_unchanged_into_signed_state",
      "repeated_cookie_less_starts": "allocate_zero_durable_or_in_memory_pending_flow_records",
      "different_browsers": "independent_browser_cookie_jars",
      "matching_callback_consumption": "expire_only_the_matching_browser_cookie",
      "callback_checks_in_order": [
        "exact_configured_origin_and_fixed_path",
        "signed_state_signature_and_fixed_expiry",
        "request_cookie_name_and_value_digest_match_signed_state",
        "assertion_rs256_signature_and_complete_closed_claims_shape",
        "assertion_issuer_audience_instance_nonce_and_fixed_expiry",
        "atomically_consume_successful_callback_fingerprint_once",
        "expire_matching_browser_correlation_cookie",
        "create_or_replace_identity_only_session",
        "reresolve_safe_return_share"
      ],
      "session_purpose": "identity_only",
      "page_authorization": "new_limited_navigation_reresolves_local_show_access_and_current_membership_once"
    },
    "identity_session": {
      "cookie_name": "__Host-avibe_show_identity_session",
      "cookie_value": "base64url_without_padding_of_32_csprng_bytes",
      "cookie_entropy_bytes": 32,
      "cookie_attributes": {
        "host_only": true,
        "domain_attribute_allowed": false,
        "secure": true,
        "http_only": true,
        "same_site": "Lax",
        "path": "/",
        "maximum_age_seconds": 2592000
      },
      "server_record": "#/$defs/IdentitySessionRecord",
      "server_storage": "sha256_of_cookie_value_utf8_only_never_plain_bearer",
      "lookup_invariant": "sha256_utf8(request.session_token) == record.token_sha256 && request.instance_id == record.instance_id && request.callback_origin == record.callback_origin && now < record.expires_at",
      "fixed_lifetime_seconds": 2592000,
      "expiry_invariant": "expires_at == created_at + fixed_lifetime_seconds",
      "sliding_refresh": false,
      "session_family": false,
      "cross_session_revocation": false,
      "successful_callback": "overwrite_browser_cookie_with_new_session_token",
      "older_bearer_records": "may_remain_valid_until_their_fixed_expiry",
      "logout": "delete_presented_record_and_expire_presented_cookie",
      "later_limited_navigation": "validate_identity_session_then_reresolve_current_local_show_access_and_membership_once",
      "session_forbidden_authority": ["page_id", "share_id", "page_membership", "instance_role", "resource_authority"]
    },
    "reference_evidence": {
      "scenario": "AUTH-SETUP-401",
      "harness": "tests/scenario_harness/show_identity_callback.py",
      "closed_loop": ["login_start_pending_flow_set_cookie", "authorize_request", "backend_form_post", "local_callback_cookie_pair", "stateless_signed_state_check", "cookie_digest_check_and_expiry", "complete_assertion_shape_and_binding_check", "atomic_successful_callback_consumption", "digest_only_identity_session", "later_limited_navigation"],
      "production_crypto_browser_conformance": "future_backend_avibe_and_browser_lanes"
    },
    "backend_forbidden_behavior": ["receive_local_whitelist", "decide_page_membership", "derive_instance_role", "create_instance_access_context"],
    "privileged_surfaces_never_granted_by_identity_session": ["show", "workbench", "resource_api", "hmr", "annotations", "agents"]
  },
  "x-examples": [
    {
      "name": "login_start_request",
