{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avibe.bot/contracts/show-identity/v1",
  "title": "Show identity assertion and login contract v1",
  "$ref": "#/$defs/IdentityAssertionClaims",
  "x-contract": {
    "contract_id": "avibe.show-identity.v1",
    "version": 1,
    "purpose": "verified_identity_only",
    "interfaces": [
      {
        "id": "show_identity_authorize",
        "producer": "avibe.local_http.ShowIdentityLogin",
        "consumer": "avibe-backend.GET /api/v1/instances/{instanceId}/show-identity/authorize",
        "delivery": "browser_navigation",
        "request": "#/$defs/AuthorizeRequest"
      },
      {
        "id": "show_identity_form_post",
        "producer": "avibe-backend.ShowIdentityAssertionIssuer",
        "consumer": "avibe.local_http.POST /auth/show-identity/callback",
        "delivery": "form_post",
        "request": "#/$defs/CallbackForm"
      },
      {
        "id": "show_identity_session_cookie",
        "producer": "avibe.local_http.ShowIdentityCallback",
        "consumer": "show_identity_browser",
        "delivery": "http_set_cookie",
        "result": "#/$defs/IdentitySessionCookie",
        "authority": "identity_only"
      },
      {
        "id": "show_identity_session_lookup",
        "producer": "avibe.local_http.SharedNavigationAdmission",
        "consumer": "avibe.local.IdentitySessionStore",
        "delivery": "local_sha256_digest_lookup",
        "request": "#/$defs/IdentitySessionLookup",
        "result": "#/$defs/IdentitySessionRecord",
        "authority": "identity_only"
      }
    ],
    "authorize": {
      "method": "GET",
      "path": "/api/v1/instances/{instanceId}/show-identity/authorize",
      "request_fields_exact": ["state", "nonce", "redirect_uri"],
      "callback_method": "POST",
      "callback_path": "/auth/show-identity/callback",
      "response_mode": "form_post",
      "assertion_in_url": false,
      "callback_origin": "one_server_configured_paired_https_origin",
      "callback_query_or_fragment_allowed": false
    },
    "assertion": {
      "format": "rfc7519_compact_jwt_jws",
      "algorithm": "RS256",
      "protected_header_fields_exact": ["alg", "typ", "kid"],
      "protected_header_values": {"alg": "RS256", "typ": "JWT"},
      "claims_exact": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"],
      "audience": "avibe-show-identity:<paired_oauth_client_id>",
      "issuer_and_jwks_authority": "local_paired_instance_record",
      "jwks_uri": "<paired_issuer>/oauth/jwks.json",
      "ttl_seconds": 300,
      "clock_skew_seconds": 0,
      "verified_email_normalization": ["trim_ascii_surrounding_whitespace", "ascii_lowercase"],
      "verified_email_source": "fresh_verified_backend_identity_record",
      "forbidden_claims": ["page_id", "share_id", "page_membership", "whitelist", "instance_role", "instance_access_source", "show_page_email"]
    },
    "key_lookup": {
      "current_rs256_key_only_required": true,
      "unknown_kid_forced_refresh_scope": "paired_issuer_per_login_attempt",
      "maximum_forced_refreshes_per_login_attempt": 1,
      "refresh_is_coalesced_by_issuer": true,
      "refresh_is_not_keyed_by_untrusted_kid": true,
      "failure": "identity_retry_required",
      "seamless_rotation_or_previous_key_overlap_required": false
    },
    "local_flow": {
      "active_flow_cardinality": "one_per_browser_and_configured_callback_origin",
      "latest_login_start_replaces_previous": true,
      "state_and_correlation_cookie_lifetime_seconds": 300,
      "post_expiry_grace_seconds": 0,
      "stale_or_replayed_callback": "identity_retry_required",
      "expired_flow_cleanup": "replace_or_delete_single_active_flow",
      "signed_state": "#/$defs/SignedStateClaims",
      "correlation_cookie": {
        "name": "__Secure-avibe_show_identity_flow",
        "value": "independent_32_byte_random_secret",
        "host_only": true,
        "domain_attribute_allowed": false,
        "secure": true,
        "http_only": true,
        "same_site": "None",
        "path": "/auth/show-identity/callback",
        "maximum_age_seconds": 300
      },
      "callback_checks_in_order": [
        "exact_configured_origin_and_fixed_path",
        "signed_state_valid_and_is_current_active_flow",
        "correlation_cookie_secret_matches_current_flow",
        "assertion_rs256_signature_issuer_audience_instance_nonce_and_expiry",
        "consume_current_flow_once",
        "create_or_replace_identity_only_session",
        "reresolve_safe_return_share"
      ],
      "session_purpose": "identity_only",
      "page_authorization": "new_limited_navigation_reresolves_local_show_access_and_current_membership_once"
    },
    "identity_session": {
      "cookie_name": "__Host-avibe_show_identity_session",
      "cookie_value": "base64url_without_padding_of_32_csprng_bytes",
      "cookie_entropy_bytes": 32,
      "cookie_attributes": {
        "host_only": true,
        "domain_attribute_allowed": false,
        "secure": true,
        "http_only": true,
        "same_site": "Lax",
        "path": "/",
        "maximum_age_seconds": 2592000
      },
      "server_record": "#/$defs/IdentitySessionRecord",
      "server_storage": "sha256_of_cookie_value_utf8_only_never_plain_bearer",
      "lookup_invariant": "sha256_utf8(request.session_token) == record.token_sha256 && request.instance_id == record.instance_id && request.callback_origin == record.callback_origin && now < record.expires_at",
      "fixed_lifetime_seconds": 2592000,
      "expiry_invariant": "expires_at == created_at + fixed_lifetime_seconds",
      "sliding_refresh": false,
      "session_family": false,
      "cross_session_revocation": false,
      "successful_callback": "overwrite_browser_cookie_with_new_session_token",
      "older_bearer_records": "may_remain_valid_until_their_fixed_expiry",
      "logout": "delete_presented_record_and_expire_presented_cookie",
      "later_limited_navigation": "validate_identity_session_then_reresolve_current_local_show_access_and_membership_once",
      "session_forbidden_authority": ["page_id", "share_id", "page_membership", "instance_role", "resource_authority"]
    },
    "backend_forbidden_behavior": ["receive_local_whitelist", "decide_page_membership", "derive_instance_role", "create_instance_access_context"],
    "privileged_surfaces_never_granted_by_identity_session": ["show", "workbench", "resource_api", "hmr", "annotations", "agents"]
  },
  "x-examples": [
    {
      "name": "authorize_request",
      "schema_ref": "#/$defs/AuthorizeRequest",
      "value": {"state": "signed-state-value", "nonce": "nonce-value", "redirect_uri": "https://show.example.test/auth/show-identity/callback"}
    },
    {
      "name": "identity_assertion_claims",
      "schema_ref": "#/$defs/IdentityAssertionClaims",
      "value": {"iss": "https://avibe.example.test", "aud": "avibe-show-identity:oauth-client-1", "sub": "user-1", "iat": 1786935600, "exp": 1786935900, "jti": "jti-1", "nonce": "nonce-value", "instance_id": "instance-1", "verified_email": "alice@example.com"}
    },
    {
      "name": "callback_form",
      "schema_ref": "#/$defs/CallbackForm",
      "value": {"state": "signed-state-value", "assertion": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImsxIn0.eyJpc3MiOiJodHRwczovL2F2aWJlLmV4YW1wbGUudGVzdCJ9.signature"}
    },
    {
      "name": "signed_state_claims",
      "schema_ref": "#/$defs/SignedStateClaims",
      "value": {"flow_id": "flow-1", "instance_id": "instance-1", "nonce": "nonce-value", "callback_origin": "https://show.example.test", "safe_return_path": "/p/stable_alpha/", "iat": 1786935600, "exp": 1786935900}
    },
    {
      "name": "identity_session_cookie",
      "schema_ref": "#/$defs/IdentitySessionCookie",
      "value": {"name": "__Host-avibe_show_identity_session", "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "host_only": true, "domain": null, "secure": true, "http_only": true, "same_site": "Lax", "path": "/", "maximum_age_seconds": 2592000}
    },
    {
      "name": "identity_session_lookup",
      "schema_ref": "#/$defs/IdentitySessionLookup",
      "value": {"session_token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "instance_id": "instance-1", "callback_origin": "https://show.example.test"}
    },
    {
      "name": "identity_session_record",
      "schema_ref": "#/$defs/IdentitySessionRecord",
      "value": {"token_sha256": "0f007385b6f9d4b7eeb2748605afe1a984a0a3bfa3f014d09e2a784ce9e5cd1a", "instance_id": "instance-1", "callback_origin": "https://show.example.test", "subject": "user-1", "normalized_verified_email": "alice@example.com", "created_at": 1786935600, "expires_at": 1789527600}
    }
  ],
  "$defs": {
    "BoundedString": {"type": "string", "minLength": 1, "maxLength": 2048},
    "AuthorizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "nonce", "redirect_uri"],
      "properties": {
        "state": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "redirect_uri": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+/auth/show-identity/callback$"}
      }
    },
    "CallbackForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assertion"],
      "properties": {
        "state": {"type": "string", "minLength": 1, "maxLength": 4096},
        "assertion": {"type": "string", "minLength": 16, "maxLength": 16384, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}
      }
    },
    "SignedStateClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "instance_id", "nonce", "callback_origin", "safe_return_path", "iat", "exp"],
      "properties": {
        "flow_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
        "safe_return_path": {"type": "string", "minLength": 4, "maxLength": 2048, "pattern": "^/p/[A-Za-z0-9_-]+/$"},
        "iat": {"type": "integer"},
        "exp": {"type": "integer"}
      }
    },
    "IdentityAssertionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "aud", "sub", "iat", "exp", "jti", "nonce", "instance_id", "verified_email"],
      "properties": {
        "iss": {"type": "string", "minLength": 1, "maxLength": 2048, "format": "uri"},
        "aud": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^avibe-show-identity:.+$"},
        "sub": {"type": "string", "minLength": 1, "maxLength": 512},
        "iat": {"type": "integer"},
        "exp": {"type": "integer"},
        "jti": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "verified_email": {"type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9.-]+$"}
      }
    },
    "IdentitySessionToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "IdentitySessionCookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "host_only", "domain", "secure", "http_only", "same_site", "path", "maximum_age_seconds"],
      "properties": {
        "name": {"const": "__Host-avibe_show_identity_session"},
        "value": {"$ref": "#/$defs/IdentitySessionToken"},
        "host_only": {"const": true},
        "domain": {"type": "null"},
        "secure": {"const": true},
        "http_only": {"const": true},
        "same_site": {"const": "Lax"},
        "path": {"const": "/"},
        "maximum_age_seconds": {"const": 2592000}
      }
    },
    "IdentitySessionLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_token", "instance_id", "callback_origin"],
      "properties": {
        "session_token": {"$ref": "#/$defs/IdentitySessionToken"},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"}
      }
    },
    "IdentitySessionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_sha256", "instance_id", "callback_origin", "subject", "normalized_verified_email", "created_at", "expires_at"],
      "properties": {
        "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "callback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 512},
        "normalized_verified_email": {"type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9.-]+$"},
        "created_at": {"type": "integer"},
        "expires_at": {"type": "integer"}
      }
    }
  }
}
