{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v1/hosted-operation.schema.json",
  "title": "Hosted Show Page grant operation v1",
  "x-temporal-invariants": [
    {
      "id": "PREPARED-OPERATION-NON-RENEWABLE-LIFETIME",
      "applies_to": ["prepare_result:prepared", "operation_status_result:prepared"],
      "server_issued_fields": ["prepared_at", "expires_at"],
      "relation": "0 < expires_at - prepared_at <= 24 hours",
      "renewable": false,
      "pii_cleanup_deadline": "expires_at or earlier acknowledgement"
    }
  ],
  "oneOf": [
    { "$ref": "#/$defs/prepare_request" },
    { "$ref": "#/$defs/prepare_no_change" },
    { "$ref": "#/$defs/prepare_prepared" },
    { "$ref": "#/$defs/prepare_revision_conflict" },
    { "$ref": "#/$defs/commit_request" },
    { "$ref": "#/$defs/commit_result" },
    { "$ref": "#/$defs/commit_expired_uncommitted" },
    { "$ref": "#/$defs/commit_revision_conflict" },
    { "$ref": "#/$defs/operation_status_request" },
    { "$ref": "#/$defs/operation_status_prepared" },
    { "$ref": "#/$defs/operation_status_committed" },
    { "$ref": "#/$defs/operation_status_expired_uncommitted" },
    { "$ref": "#/$defs/operation_status_result_expired" },
    { "$ref": "#/$defs/current_grant_request" },
    { "$ref": "#/$defs/current_grant_result" },
    { "$ref": "#/$defs/acknowledgement_request" },
    { "$ref": "#/$defs/acknowledgement_result" }
  ],
  "$defs": {
    "page_id": {
      "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json#/$defs/page_id"
    },
    "mutation_id": {
      "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json#/$defs/mutation_id"
    },
    "operation_id": {
      "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json#/$defs/operation_id"
    },
    "revision": {
      "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json#/$defs/revision"
    },
    "commitment": {
      "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json#/$defs/grant_commitment"
    },
    "email_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "email",
        "maxLength": 320,
        "pattern": "^[^A-Z\\s]+$"
      }
    },
    "prepare_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "page_id",
        "mutation_id",
        "expected_grant_revision",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "prepare_request" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "expected_grant_revision": { "$ref": "#/$defs/revision" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "prepare_no_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "authenticated_result",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "prepare_result" },
        "outcome": { "const": "no_change" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "authenticated_result": { "const": true },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "prepare_prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "expected_grant_revision",
        "target_grant_commitment",
        "prepared_at",
        "expires_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "prepare_result" },
        "outcome": { "const": "prepared" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "expected_grant_revision": { "$ref": "#/$defs/revision" },
        "target_grant_commitment": { "$ref": "#/$defs/commitment" },
        "prepared_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "prepare_revision_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "authenticated_result",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "prepare_result" },
        "outcome": { "const": "revision_conflict" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "authenticated_result": { "const": true },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "commit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "page_id", "mutation_id", "operation_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "commit_request" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" }
      }
    },
    "commit_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "authenticated_result",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "commit_result" },
        "outcome": { "enum": ["committed", "already_committed"] },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "authenticated_result": { "const": true },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "commit_expired_uncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "authenticated_result",
        "source_grant_revision",
        "source_grant_commitment",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "commit_result" },
        "outcome": { "const": "expired_uncommitted" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "authenticated_result": { "const": true },
        "source_grant_revision": { "$ref": "#/$defs/revision" },
        "source_grant_commitment": { "$ref": "#/$defs/commitment" },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "commit_revision_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "authenticated_result",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "commit_result" },
        "outcome": { "const": "revision_conflict" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "authenticated_result": { "const": true },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "operation_status_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "page_id", "operation_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "operation_status_request" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" }
      }
    },
    "operation_status_prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "source_grant_revision",
        "target_grant_commitment",
        "prepared_at",
        "expires_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "operation_status_result" },
        "outcome": { "const": "prepared" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "source_grant_revision": { "$ref": "#/$defs/revision" },
        "target_grant_commitment": { "$ref": "#/$defs/commitment" },
        "prepared_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "operation_status_committed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "authenticated_result",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "operation_status_result" },
        "outcome": { "const": "committed" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "authenticated_result": { "const": true },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "operation_status_expired_uncommitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "authenticated_result",
        "source_grant_revision",
        "source_grant_commitment",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "operation_status_result" },
        "outcome": { "const": "expired_uncommitted" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "authenticated_result": { "const": true },
        "source_grant_revision": { "$ref": "#/$defs/revision" },
        "source_grant_commitment": { "$ref": "#/$defs/commitment" },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "operation_status_result_expired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id",
        "source_grant_revision",
        "target_grant_commitment"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "operation_status_result" },
        "outcome": { "const": "result_expired" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "source_grant_revision": { "$ref": "#/$defs/revision" },
        "target_grant_commitment": { "$ref": "#/$defs/commitment" }
      }
    },
    "current_grant_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "page_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "current_grant_request" },
        "page_id": { "$ref": "#/$defs/page_id" }
      }
    },
    "current_grant_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "page_id",
        "authenticated_result",
        "legacy_write_policy",
        "grant_revision",
        "grant_commitment",
        "emails"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "current_grant_result" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "authenticated_result": { "const": true },
        "legacy_write_policy": { "enum": ["temporarily_allowed", "disabled"] },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" },
        "emails": { "$ref": "#/$defs/email_set" }
      }
    },
    "acknowledgement_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "page_id",
        "mutation_id",
        "operation_id",
        "grant_revision",
        "grant_commitment"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "acknowledgement_request" },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "grant_revision": { "$ref": "#/$defs/revision" },
        "grant_commitment": { "$ref": "#/$defs/commitment" }
      }
    },
    "acknowledgement_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "outcome",
        "page_id",
        "mutation_id",
        "operation_id"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "message_type": { "const": "acknowledgement_result" },
        "outcome": { "enum": ["acknowledged", "already_acknowledged", "operation_expired"] },
        "page_id": { "$ref": "#/$defs/page_id" },
        "mutation_id": { "$ref": "#/$defs/mutation_id" },
        "operation_id": { "$ref": "#/$defs/operation_id" }
      }
    }
  }
}
