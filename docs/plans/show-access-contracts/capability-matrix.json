{
  "schema_version": 1,
  "axes": {
    "surface": ["/p", "/show"],
    "availability": ["active", "offline"],
    "access_mode": ["private", "limited", "public"],
    "share_admission_gate": ["open", "closed_pending"],
    "request_kind": ["trusted_top_level_navigation", "other"],
    "limited_reauthorization_state": [
      "not_attempted",
      "attempted_without_current_page_grant"
    ],
    "principal": ["anonymous", "page_email_viewer", "resource_viewer", "owner_editor"],
    "keyed_context": ["supported", "unsupported", "transient-unknown"]
  },
  "limited_read_authorization": {
    "id": "LIMITED-READ-PAGE-BOUND-AUTHORIZATION",
    "server_resolved_binding": [
      "page_id",
      "share_id",
      "active_limited_mode",
      "open_admission_gate"
    ],
    "handshake_correlation": {
      "required_carriers": [
        "signed_oauth_state",
        "browser_bound_cookie",
        "single_use_server_side_fallback"
      ],
      "bound_fields": ["page_id", "share_id", "safe_public_return_target"]
    },
    "generic_session_behavior": "one_page_specific_reauthorization",
    "callback_requires": [
      "signed_state_and_cookie_or_fallback_match",
      "server_binding_reresolves_to_same_active_limited_page",
      "claim_page_matches_resolved_page",
      "claim_source_is_show_page_email",
      "claim_grant_revision_equals_authenticated_local_current_grant_revision"
    ],
    "local_grant_revision_sources": [
      "authenticated_current_grant_result",
      "authenticated_committed_operation_result"
    ],
    "claim_revision_cases": [
      {
        "id": "current_page_grant",
        "claim_grant_revision": 22,
        "authenticated_local_grant_revision": 22,
        "outcome": "page_email_viewer"
      },
      {
        "id": "stale_page_grant",
        "claim_grant_revision": 21,
        "authenticated_local_grant_revision": 22,
        "outcome": "generic_deny"
      }
    ],
    "failure_outcome": "generic_deny_without_page_bytes",
    "attempt_marker": {
      "authority": "negative_only",
      "maximum_uses": 1,
      "effect": "suppress_repeat_reauthorization",
      "removed_from_safe_return_url": true,
      "positive_authority": false
    }
  },
  "rules": [
    {
      "id": "MATRIX-OFFLINE-DENY",
      "selector": {
        "surface": "*",
        "availability": "offline",
        "access_mode": "*",
        "share_admission_gate": "*",
        "request_kind": "*",
        "limited_reauthorization_state": "*",
        "principal": "*",
        "keyed_context": "*"
      },
      "decision": {
        "read_decision": "deny",
        "show_editor_capability": false,
        "runtime_context": null,
        "annotations": false,
        "hmr": false,
        "top_level_editor_redirect": false
      },
      "scenario_ids": ["SHOW-LIVE-018", "SHOW-LIVE-032"]
    },
