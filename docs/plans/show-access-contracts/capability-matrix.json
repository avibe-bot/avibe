    "matrix_input_stage": "after_valid_share_bound_request_proof",
    "raw_browser_requests_evaluated_directly": false
  },
  "global_invariants": [
    {
      "id": "INVARIANT-P-ALWAYS-SHARED-OR-NO-BYTES",
      "assertion": "served_p_never_selects_private_context_hmr_or_annotations",
      "scenario_ids": ["SHOW-LIVE-002", "SHOW-LIVE-009", "SHOW-LIVE-011", "SHOW-LIVE-038"]
    },
    {
