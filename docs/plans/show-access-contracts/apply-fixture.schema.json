{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/apply-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures", "boundary_cases", "concurrency_cases", "receipt_digest_vectors", "receipt_sequences", "sequences"],
  "properties": {
    "schema_version": { "const": 2 },
    "fixtures": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "boundary_cases": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/boundary_case" }
    },
    "concurrency_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concurrency_case" }
    },
    "receipt_digest_vectors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/receipt_digest_vector" }
    },
    "receipt_sequences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/receipt_sequence" }
    },
    "sequences": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sequence" }
    }
  },
  "$defs": {
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario_ids",
        "route_page_id",
        "source_show_access",
        "request",
        "result",
        "external_service_calls"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^APPLY-[A-Z0-9-]+$" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" },
        "route_page_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id"
        },
        "source_show_access": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json"
        },
        "request": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/apply_request"
        },
        "result": {
          "oneOf": [
            { "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/terminal_result" },
            { "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/rejected_result" }
          ]
        },
        "external_service_calls": { "const": 0 }
      }
    },
    "boundary_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ids", "route_page_id", "request", "authority", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^BOUNDARY-[A-Z0-9-]+$" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" },
        "route_page_id": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id"
        },
        "request": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/apply_request"
        },
        "authority": {
          "enum": ["owner", "sharing_control", "resource_viewer", "page_member_only", "anonymous"]
        },
        "result": {
          "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/rejected_result"
        }
      }
    },
    "concurrency_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ids", "custom_share_id", "contenders", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^CONCURRENCY-[A-Z0-9-]+$" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" },
        "custom_share_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/share_id" },
        "contenders": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_id", "mutation_id", "outcome", "store_write"],
            "properties": {
              "page_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/page_id" },
              "mutation_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id" },
              "outcome": { "enum": ["applied", "share_id_taken"] },
              "store_write": { "type": "boolean" }
            }
          }
        },
        "assertions": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "receipt_digest_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "normalized_request", "canonical_json_utf8", "canonical_request_sha256"],
      "properties": {
        "id": { "enum": ["RECEIPT-DIGEST-APPLY-A", "RECEIPT-DIGEST-APPLY-B"] },
        "normalized_request": { "$ref": "https://contracts.avibe.bot/show-access/v2/apply-mutation.schema.json#/$defs/apply_request" },
        "canonical_json_utf8": { "type": "string", "minLength": 20 },
        "canonical_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "receipt_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ids", "steps", "assertions"],
      "properties": {
        "id": { "const": "RECEIPT-SEQUENCE-A-B-REPLAY-A" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "mutation_id", "canonical_request_sha256", "outcome", "current_audience_revision", "returned_audience_revision", "returned_mutation_id", "store_write"],
            "properties": {
              "event": { "enum": ["apply_a", "apply_b", "replay_a_after_b"] },
              "mutation_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id" },
              "canonical_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "outcome": { "enum": ["applied", "idempotent_replay"] },
              "current_audience_revision": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/revision" },
              "returned_audience_revision": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/revision" },
              "returned_mutation_id": { "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json#/$defs/mutation_id" },
              "store_write": { "type": "boolean" }
            }
          }
        },
        "assertions": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_ids", "steps", "assertions"],
      "properties": {
        "id": { "type": "string", "pattern": "^SEQUENCE-[A-Z0-9-]+$" },
        "scenario_ids": { "$ref": "#/$defs/scenario_ids" },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "state", "request_outcome", "backend_available", "active_guest_tab_closed"],
            "properties": {
              "event": { "type": "string" },
              "state": {
                "$ref": "https://contracts.avibe.bot/show-access/v2/show-access.schema.json"
              },
              "request_outcome": { "enum": ["not_checked", "serve_shared", "deny"] },
              "backend_available": { "type": "boolean" },
              "active_guest_tab_closed": { "type": "boolean" }
            }
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
