{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/mirror-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "authority", "repositories", "process_ownership", "interfaces", "release_gates"],
  "properties": {
    "contract_version": { "const": 2 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_issue", "source_issue_updated_at", "source_design_path", "source_ref_kind", "source_sha", "source_design_blob_sha"],
      "properties": {
        "source_issue": { "const": "https://github.com/avibe-bot/avibe/issues/1498" },
        "source_issue_updated_at": { "type": "string", "format": "date-time" },
        "source_design_path": { "const": "docs/plans/public-show-live-update.md" },
        "source_ref_kind": { "const": "git_blob" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_design_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "contract_location"],
        "properties": {
          "id": { "enum": ["avibe", "avibe-backend", "vibe-show-runtime"] },
          "repository": { "type": "string", "format": "uri" },
          "contract_location": { "type": "string" }
        }
      }
    },
    "process_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_writer_lease", "serialization_owner", "store_write_owner", "apply_receipt_store", "ui_process_coordinator_allowed", "atomic_fields", "serialized_operations"],
      "properties": {
        "stable_writer_lease": { "type": "string" },
        "serialization_owner": { "type": "string" },
        "store_write_owner": { "type": "string" },
        "apply_receipt_store": { "type": "string" },
        "ui_process_coordinator_allowed": { "const": false },
        "atomic_fields": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "serialized_operations": { "const": ["apply"] }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/interface" }
    },
    "release_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_access_contract", "runtime_feature_advertisement"],
      "properties": {
        "local_access_contract": { "type": "string" },
        "runtime_feature_advertisement": { "const": "runtime-context.json#/release_gate" }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "symbol"],
      "properties": {
        "repository": { "enum": ["avibe", "avibe-backend", "vibe-show-runtime"] },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer", "consumers", "signature", "delivery"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{2}$" },
        "producer": { "$ref": "#/$defs/endpoint" },
        "consumers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpoint" } },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "request", "result", "covered_fields"],
          "properties": {
            "schema": { "type": "string", "minLength": 3 },
            "request": { "type": "string", "minLength": 3 },
            "result": { "type": "string", "minLength": 3 },
            "covered_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "route_or_channel", "authentication", "serialization_owner", "version"],
          "properties": {
            "mechanism": { "type": "string", "minLength": 3 },
            "route_or_channel": { "type": "string", "minLength": 3 },
            "authentication": { "type": "string", "minLength": 3 },
            "serialization_owner": { "type": "string", "minLength": 3 },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
