{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v2/apply-invocation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "boundary", "allowed_authorities", "cases"],
  "properties": {
    "schema_version": { "const": 2 },
    "owner": { "const": "ApplyInvocationAuthorization" },
    "boundary": { "const": "local_http_before_controller_ipc" },
    "allowed_authorities": {
      "const": ["owner", "sharing_control"]
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "outcome", "controller_called", "store_read", "store_write"],
        "properties": {
          "authority": {
            "enum": ["owner", "sharing_control", "resource_viewer", "page_member_only", "anonymous"]
          },
          "outcome": { "enum": ["allow", "deny"] },
          "controller_called": { "type": "boolean" },
          "store_read": { "type": "boolean" },
          "store_write": {
            "oneOf": [{ "type": "boolean" }, { "const": "depends_on_transition" }]
          }
        }
      }
    }
  }
}
