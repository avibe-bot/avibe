{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v1/show-access-fixture.schema.json",
  "title": "ShowAccess state examples v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario_ids", "show_access", "shared_route_admitted"],
        "properties": {
          "id": { "type": "string", "pattern": "^STATE-[A-Z0-9-]+$" },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
          },
          "show_access": {
            "$ref": "https://contracts.avibe.bot/show-access/v1/show-access.schema.json"
          },
          "shared_route_admitted": { "type": "boolean" }
        }
      }
    }
  }
}
