    "url_revocation_triggers": ["worker_termination", "namespace_idle_expiry", "namespace_absolute_expiry", "namespace_budget_reclaim"],
    "unrecognized_or_dynamic_constructor_outcome": "fixed_sanitized_worker_unsupported",
    "contract_evidence": "mutation_sensitive_transform_and_transport_fixture",
    "real_browser_conformance": "future_local_incus_browser_lane",
    "cases": [
      {"id": "WORKER-CANONICAL-ENTRY", "mutation": "none", "outcome": "start_opaque_origin_dedicated_module_worker", "urls_revoked": false, "path_bytes": false},
      {"id": "WORKER-NESTED-IMPORTS", "mutation": "nested_static_imports", "outcome": "start_closed_recursive_opaque_origin_worker_graph", "urls_revoked": false, "path_bytes": false},
      {"id": "WORKER-CROSS-NAMESPACE", "mutation": "cross_namespace_import", "outcome": "fixed_sanitized_not_found", "urls_revoked": false, "path_bytes": false},
      {"id": "WORKER-PATH-ATTEMPT", "mutation": "source_path_or_nested_fs_import", "outcome": "fixed_sanitized_not_found", "urls_revoked": false, "path_bytes": false},
      {"id": "WORKER-NAMESPACE-EXPIRY", "mutation": "namespace_absolute_expiry", "outcome": "fixed_stale_document_reload_required", "urls_revoked": true, "path_bytes": false},
      {"id": "WORKER-BUDGET-RECLAIM", "mutation": "namespace_budget_reclaim", "outcome": "fixed_stale_document_reload_required", "urls_revoked": true, "path_bytes": false},
      {"id": "WORKER-TERMINATION-REVOKE", "mutation": "worker_termination", "outcome": "worker_terminated_and_urls_revoked", "urls_revoked": true, "path_bytes": false},
      {"id": "WORKER-DYNAMIC-UNRECOGNIZED", "mutation": "dynamic_or_unrecognized_constructor", "outcome": "fixed_sanitized_worker_unsupported", "urls_revoked": false, "path_bytes": false}
    ]
  },
  "admission_rule": {
    "owner": "avibe.SharedViewerBrowserContainment",
    "inputs": ["availability", "access_mode", "verified_identity", "current_local_membership"],
    "capability_issued_when": [
      {
        "availability": "active",
        "access_mode": "public",
        "verified_identity": "not_required",
        "current_local_membership": "not_required"
      },
      {
        "availability": "active",
        "access_mode": "limited",
        "verified_identity": "required",
        "current_local_membership": "required"
      }
    ],
    "default_outcome": "generic_deny_without_capability_or_page_bytes",
    "authorization_precedes_capture": true
  },
  "runtime_capture_admission": {
    "request_trust": "internal_avibe_server_only",
    "request_fields": ["session_id", "instance_id", "page_id", "share_id", "audience_revision", "validated_shared_context"],
    "authorization_precedes_capture": true,
    "result_fields": ["namespace_handle", "document_handle", "expires_at"],
    "result_values_opaque": true,
    "browser_supplied_context_allowed": false,
    "browser_visible_session_or_path_fields": false
  },
  "share_browsing_credential": {
    "issuer": "local_avibe_after_admission_rule",
    "binding_fields": ["instance_id", "page_id", "share_id", "audience_revision", "namespace_handle", "document_handle"],
    "server_record_fields": ["instance_id", "page_id", "share_id", "audience_revision", "namespace_handle", "document_handle", "admitted_normalized_email_if_limited", "expires_at"],
    "entropy_bits": 256,
    "derived_from_binding_or_path": false,
    "lifetime": "short_lived_nonrenewable",
    "storage": "ephemeral_trusted_shell_bootstrap_only",
    "browser_cookie": false,
    "backend_identity_assertion": false,
    "instance_access_context": false,
    "instance_role": false,
    "editor_capability": false,
    "transport": {
      "location": "opaque_protected_route_namespace_segment",
      "header_allowed": false,
      "query_allowed": false,
      "fragment_allowed": false,
      "ambient_cookie_allowed": false,
      "request_credentials": "omit",
      "referrer_policy": "no-referrer"
    },
    "required_surfaces": ["document", "module", "css", "raw", "worker", "spa_fallback", "api_handler"],
    "revision_mismatch_outcome": "reresolve_share_and_membership_before_new_credential"
  },
  "protected_request_validation": {
    "owner": "SharedViewerBrowserContainment.protected_request_validation",
    "invoked_for_surfaces": ["document", "module", "css", "raw", "worker", "spa_fallback", "api_handler"],
    "invoked_for_methods": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"],
    "local_linearization": {
      "transaction": "one_authoritative_ShowAccess_snapshot",
      "checks": ["page_exists", "availability_is_active", "access_mode_is_limited_or_public", "exact_share_binding_matches", "audience_revision_matches_capability", "limited_admitted_email_is_current_member", "capability_not_expired"],
      "runtime_audience_decision_allowed": false
    },
    "runtime_linearization": {
      "after_local_validation": true,
      "operation": "atomically_pin_live_namespace_and_document_handle",
      "checks": ["capability_namespace_document_binding_matches", "namespace_is_live"],
      "in_flight_pin": "request_linearized_before_change_may_finish",
      "later_request": "must_repeat_full_validation"
    },
    "audience_revision_policy": {
      "request_admission_revision_field": "ShowAccess.audience_revision",
      "durable_availability_transition_advances_once": true,
      "audience_or_binding_change_advances_once": true,
      "no_op_advances": false,
      "apply_may_mutate_availability": false,
      "separate_capability_revision_allowed": false
    },
    "input_space": {
      "capability_integrity": ["valid", "invalid"],
      "page_state": ["present", "missing"],
      "availability": ["active", "offline"],
      "access_mode": ["limited", "public", "private"],
      "share_binding": ["match", "mismatch"],
      "audience_revision": ["match", "mismatch"],
      "capability_lifetime": ["live", "expired"],
      "namespace_binding": ["match", "mismatch"],
      "namespace_liveness": ["live", "idle_expired", "absolute_expired", "reclaimed"],
      "limited_membership": ["current", "absent", "not_applicable"]
    },
    "valid_point_constraints": ["limited_requires_membership_current_or_absent", "public_or_private_requires_membership_not_applicable"],
    "decision_semantics": "ordered_first_match_then_runtime_pin",
    "decision_rules": [
      {"id": "PROTECTED-CAPABILITY-INVALID", "stage": "local", "field": "capability_integrity", "equals": "invalid", "outcome": "fixed_sanitized_not_found"},
      {"id": "PROTECTED-PAGE-MISSING", "stage": "local", "field": "page_state", "equals": "missing", "outcome": "fixed_sanitized_not_found"},
      {"id": "PROTECTED-CAPABILITY-EXPIRED", "stage": "local", "field": "capability_lifetime", "equals": "expired", "outcome": "fixed_sanitized_expired"},
      {"id": "PROTECTED-SHARE-MISMATCH", "stage": "local", "field": "share_binding", "equals": "mismatch", "outcome": "fixed_sanitized_not_found"},
      {"id": "PROTECTED-OFFLINE", "stage": "local", "field": "availability", "equals": "offline", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-PRIVATE", "stage": "local", "field": "access_mode", "equals": "private", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-REVISION-MISMATCH", "stage": "local", "field": "audience_revision", "equals": "mismatch", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-MEMBER-ABSENT", "stage": "local", "field": "limited_membership", "equals": "absent", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-NAMESPACE-BINDING-MISMATCH", "stage": "runtime", "field": "namespace_binding", "equals": "mismatch", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-NAMESPACE-IDLE-EXPIRED", "stage": "runtime", "field": "namespace_liveness", "equals": "idle_expired", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-NAMESPACE-ABSOLUTE-EXPIRED", "stage": "runtime", "field": "namespace_liveness", "equals": "absolute_expired", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-NAMESPACE-RECLAIMED", "stage": "runtime", "field": "namespace_liveness", "equals": "reclaimed", "outcome": "fixed_stale_document_reload_required"},
      {"id": "PROTECTED-CURRENT", "stage": "runtime", "field": "all_prior_checks", "equals": "pass", "outcome": "serve_pinned_shared_response"}
    ],
    "post_mint_transition_cases": [
      {"id": "UNCHANGED", "revision_advance": 0, "later_request_outcome": "serve_pinned_shared_response", "in_flight_outcome": "finish_pinned_response"},
      {"id": "AUDIENCE-NO-OP", "revision_advance": 0, "later_request_outcome": "serve_pinned_shared_response", "in_flight_outcome": "finish_pinned_response"},
      {"id": "ACTIVE-TO-OFFLINE", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "OFFLINE-TO-ACTIVE-OLD-CAPABILITY", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "SHARED-TO-PRIVATE", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "PUBLIC-TO-LIMITED", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "LIMITED-TO-PUBLIC", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "SHARE-BINDING-CHANGE", "revision_advance": 1, "later_request_outcome": "fixed_sanitized_not_found", "in_flight_outcome": "finish_pinned_response"},
      {"id": "AUDIENCE-REVISION-CHANGE", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "LIMITED-MEMBER-REMOVE", "revision_advance": 1, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "LIMITED-MEMBER-REMOVE-READD-OLD-CAPABILITY", "revision_advance": 2, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "CAPABILITY-EXPIRY", "revision_advance": 0, "later_request_outcome": "fixed_sanitized_expired", "in_flight_outcome": "finish_pinned_response"},
      {"id": "NAMESPACE-IDLE-EXPIRY", "revision_advance": 0, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "NAMESPACE-ABSOLUTE-EXPIRY", "revision_advance": 0, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"},
      {"id": "BUDGET-RECLAIM-DURING-REQUEST", "revision_advance": 0, "later_request_outcome": "fixed_stale_document_reload_required", "in_flight_outcome": "finish_pinned_response"}
    ],
