    "transform_result": "opaque_origin_worker_broker_call",
    "entry_fetch": {
      "transport": "existing_share_bound_capability_route",
      "required_validation": ["protected_request_validation", "same_namespace_handle", "same_document_handle"]
    },
    "recursive_module_graph": {
      "closure": "all_static_worker_imports",
      "rewrite_target": "same_opaque_origin_blob_or_object_urls",
