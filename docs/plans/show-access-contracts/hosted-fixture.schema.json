{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.avibe.bot/show-access/v1/hosted-fixture.schema.json",
  "title": "Hosted grant-operation examples v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario_ids", "messages", "assertions"],
        "properties": {
          "id": { "type": "string", "pattern": "^HOSTED-[A-Z0-9-]+$" },
          "scenario_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SHOW-LIVE-[0-9]{3}$" }
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://contracts.avibe.bot/show-access/v1/hosted-operation.schema.json"
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "same_mutation_same_result",
                "same_set_no_operation",
                "prepare_changes_no_authority",
                "prepare_retry_returns_same_operation",
                "prepared_lifetime_non_renewable_max_24h",
                "revision_advances_once",
                "lost_response_reconciles",
                "expired_commit_is_terminal",
                "expired_uncommitted_proves_source",
                "result_expiry_uses_current_grant",
                "acknowledgement_removes_pii_copy"
              ]
            }
          }
        }
      }
    }
  }
}
