      "type": "object", "additionalProperties": false,
      "description": "WF-1: tool_name discriminates this record. Ordinary content equals frame(record), whose UTF-8 surrogatepass encoding is at most 48000 bytes. size_bytes equals the retained content bytes. These cross-field/byte invariants are validated by the Python reader.",
      "required": ["status", "requested_url", "final_url", "canonical_url", "title", "content_type", "source_content_type", "content", "size_bytes", "source_size_bytes", "truncated", "truncation_reason", "retrieved_at", "attempts", "budget_method"],
