        "content": {"type": "string", "maxLength": 48000},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 48000},
        "source_size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "truncated": {"type": "boolean"},
        "truncation_reason": {"enum": ["budget", "provider_limit", null]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "budget_method": {"const": "utf8_bytes_div4_v1"},
        "attempts": {"type": "array", "items": {"$ref": "#/definitions/HostedAttempt"}},
        "error": {"type": "string", "minLength": 1, "maxLength": 1000},
        "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "transport_degraded": {"type": "boolean"},
        "transport_degraded_reason": {"type": "string", "maxLength": 400},
        "charset_fallback": {"type": "boolean"}
      },
      "dependencies": {"error_code": ["error"]},
      "allOf": [
        {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["error"]}, "else": {"not": {"required": ["error"]}}},
        {"if": {"properties": {"truncated": {"const": true}}}, "then": {"properties": {"truncation_reason": {"enum": ["budget", "provider_limit"]}}}, "else": {"properties": {"truncation_reason": {"type": "null"}}}},
        {"if": {"required": ["transport_degraded_reason"]}, "then": {"required": ["transport_degraded"], "properties": {"transport_degraded": {"const": true}}}}
      ]
    },
