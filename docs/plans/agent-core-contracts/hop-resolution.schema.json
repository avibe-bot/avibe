{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-core/hop-resolution.schema.json",
  "title": "HopResolution",
  "description": "C-6 answer to 'how should the vibey backend call model M now'. Produced by Model Hub; consumed by the adapter, which builds C-2 ModelEndpoint from it. The token is in-memory only.",
  "type": "object",
  "required": [
    "backend",
    "requested_model",
    "protocol",
    "base_url",
    "token",
    "runtime_model",
    "source_id",
    "provider",
    "capabilities",
    "request_headers",
    "hosted_tools"
  ],
  "additionalProperties": false,
  "properties": {
    "backend": {
      "const": "vibey"
    },
    "requested_model": {
      "type": "string",
      "description": "Caller-facing model id from the Vibey Agent's settings."
    },
    "protocol": {
      "$ref": "message.schema.json#/definitions/Protocol",
      "description": "Native protocol of the primary hop."
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "description": "Gateway frontend for `protocol`."
    },
    "token": {
      "type": "string"
    },
    "runtime_model": {
      "type": "string",
      "description": "Model id to put in the request."
    },
    "source_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "Vendor identity of the primary hop; becomes `origin.provider` unless the served-hop report differs."
    },
    "request_headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Correlation metadata the gateway needs; always present, empty when there is none."
    },
    "capabilities": {
      "type": "object",
      "required": [
        "context_window",
        "input_limit",
        "max_output_tokens",
        "supports_tools",
        "supports_images",
        "supports_reasoning",
        "reasoning_efforts"
      ],
      "additionalProperties": false,
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "input_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "When the provider caps input separately from the window."
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "supports_tools": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_images": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supports_reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoning_efforts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Null means Model Hub does not know the value; it never guesses. supports_images is null when the model declares no input modalities."
    },
    "hosted_tools": {
      "type": "object",
      "description": "One entry per hosted tool the user enabled (vibey-hosted-tools.md §3.5). `mode` is the primary hop's; `declaration` and `include` are the overlay's wire declaration, present exactly for native; `executor` is the proxy executor bound for this turn, present for every entry because a native request answered pin_unavailable is re-rendered with the proxy in the same turn; `replay` is true only for the primary hop Source's positive replay evidence taken on the current engine and probe shape. A request carrying native content is pinned with x-avibe-pin-source: source_id.",
      "propertyNames": {
        "enum": [
          "web_search",
          "x_search",
          "image_generation"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "executor",
          "replay"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "native",
              "proxy"
            ]
          },
          "declaration": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "executor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "source_id",
                  "model_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^src_[a-z0-9]{8,}$"
                  },
                  "model_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "replay": {
            "type": "boolean"
          }
        },
        "if": {
          "properties": {
            "mode": {
              "const": "native"
            }
          }
        },
        "then": {
          "required": [
            "declaration",
            "include"
          ]
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "declaration"
                ]
              },
              {
                "required": [
                  "include"
                ]
              }
            ]
          }
        }
      },
      "properties": {
        "image_generation": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "mode",
                "executor",
                "replay"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "native",
                    "proxy"
                  ]
                },
                "declaration": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "source_id",
                        "model_id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "pattern": "^src_[a-z0-9]{8,}$"
                        },
                        "model_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "replay": {
                  "type": "boolean"
                }
              },
              "if": {
                "properties": {
                  "mode": {
                    "const": "native"
                  }
                }
              },
              "then": {
                "required": [
                  "declaration",
                  "include"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "declaration"
                      ]
                    },
                    {
                      "required": [
                        "include"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "replay": {
                  "const": false
                }
              }
            }
          ]
        }
      }
    }
  },
  "examples": [
    {
      "backend": "vibey",
      "requested_model": "claude-opus-5-5",
      "protocol": "anthropic",
      "base_url": "http://127.0.0.1:47311/vibey/v1",
      "token": "<in-memory>",
      "runtime_model": "claude-opus-5-5",
      "source_id": "src_anthropic_main",
      "provider": "anthropic",
      "request_headers": {},
      "capabilities": {
        "context_window": 1000000,
        "input_limit": null,
        "max_output_tokens": 128000,
        "supports_tools": true,
        "supports_images": true,
        "supports_reasoning": true,
        "reasoning_efforts": [
          "low",
          "medium",
          "high",
          "xhigh"
        ]
      },
      "hosted_tools": {
        "web_search": {
          "mode": "proxy",
          "executor": {
            "source_id": "src_xai00001",
            "model_id": "grok-4.6"
          },
          "replay": false
        }
      }
    }
  ]
}
