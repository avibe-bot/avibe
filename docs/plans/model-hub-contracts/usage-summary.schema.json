{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/usage-summary.schema.json",
  "title": "Model Hub usage summary",
  "description": "Metered token usage over a trailing local-day window, aggregated from the turns the gateway proxied. A report only: no consumer of this document may feed it back into resolution, admission, or cooldown.",
  "type": "object",
  "required": [
    "window_days",
    "from_day",
    "to_day",
    "totals",
    "sources",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "window_days": {
      "description": "Requested window after clamping to the retained range.",
      "type": "integer",
      "minimum": 1,
      "maximum": 62
    },
    "from_day": {
      "$ref": "#/definitions/LocalDay",
      "description": "First local day of the window, present even when it carries no turn."
    },
    "to_day": {
      "$ref": "#/definitions/LocalDay",
      "description": "Last local day of the window, which is the host's today."
    },
    "totals": {
      "$ref": "#/definitions/Counters"
    },
    "sources": {
      "description": "One entry per Source with at least one metered turn in the window, busiest first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SourceUsage"
      }
    },
    "days": {
      "description": "One entry per local day carrying a metered turn, oldest first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/DayUsage"
      }
    }
  },
  "definitions": {
    "LocalDay": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "Counters": {
      "type": "object",
      "required": [
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/Count",
          "description": "Self-measured served turns. Always available."
        },
        "token_reports": {
          "$ref": "#/definitions/Count",
          "description": "Served turns whose upstream response carried a token report. Never greater than requests; a shortfall means missing reports, not zero usage."
        },
        "input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Vendor-reported input tokens composed per protocol, including tokens served from cache."
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Subset of input_tokens served from cache."
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        }
      }
    },
    "SourceUsage": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "last_served_at",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "Joined from current Source config; null once the Source is gone.",
          "type": ["string", "null"]
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "last_served_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ModelUsage"
          }
        }
      }
    },
    "ModelUsage": {
      "type": "object",
      "required": [
        "model_id",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        }
      }
    },
    "DayUsage": {
      "type": "object",
      "required": [
        "day",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "$ref": "#/definitions/LocalDay"
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        }
      }
    }
  },
  "examples": [
    {
      "window_days": 30,
      "from_day": "2026-07-20",
      "to_day": "2026-08-18",
      "totals": {
        "requests": 12,
        "token_reports": 9,
        "input_tokens": 148230,
        "cached_input_tokens": 96010,
        "output_tokens": 4120
      },
      "sources": [
        {
          "source_id": "src_conform001",
          "label": "Contract source",
          "requests": 12,
          "token_reports": 9,
          "input_tokens": 148230,
          "cached_input_tokens": 96010,
          "output_tokens": 4120,
          "last_served_at": "2026-08-18T03:14:00+00:00",
          "models": [
            {
              "model_id": "claude-opus-4-6",
              "requests": 12,
              "token_reports": 9,
              "input_tokens": 148230,
              "cached_input_tokens": 96010,
              "output_tokens": 4120
            }
          ]
        }
      ],
      "days": [
        {
          "day": "2026-08-18",
          "requests": 12,
          "token_reports": 9,
          "input_tokens": 148230,
          "cached_input_tokens": 96010,
          "output_tokens": 4120
        }
      ]
    }
  ]
}
