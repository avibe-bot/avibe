{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/usage-summary.schema.json",
  "title": "Model Hub usage summary",
  "description": "Metered token usage over a trailing local-day or recent-hour window, aggregated from the turns the gateway proxied. A report only: no consumer of this document may feed it back into resolution, admission, or cooldown.",
  "type": "object",
  "required": [
    "window_days",
    "from_day",
    "to_day",
    "totals",
    "sources",
    "days"
  ],
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "window_key"
            ]
          },
          {
            "required": [
              "granularity"
            ]
          },
          {
            "required": [
              "from_at"
            ]
          },
          {
            "required": [
              "to_at"
            ]
          },
          {
            "required": [
              "buckets"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "window_key",
        "granularity",
        "from_at",
        "to_at",
        "buckets"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "window_days": {
      "description": "Daily window after clamping to the retained range, or the number of local dates touched by an hourly report, including its current report date.",
      "type": "integer",
      "minimum": 1,
      "maximum": 62
    },
    "from_day": {
      "$ref": "#/definitions/LocalDay",
      "description": "First local day of the window, present even when it carries no turn."
    },
    "to_day": {
      "$ref": "#/definitions/LocalDay",
      "description": "Last local day of the window, which is the host's today."
    },
    "totals": {
      "$ref": "#/definitions/Counters"
    },
    "sources": {
      "description": "One entry per Source with at least one metered turn in the window, busiest first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SourceUsage"
      }
    },
    "days": {
      "description": "One entry per local day carrying a metered turn, oldest first. Hourly reports group the published bucket rows by bucket start date; daily reports retain local-calendar accounting.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/DayUsage"
      }
    },
    "window_key": {
      "description": "Modern report selector served by the API.",
      "enum": [
        "24h",
        "7d",
        "30d",
        "60d"
      ]
    },
    "granularity": {
      "description": "Temporal granularity of the dense bucket matrix.",
      "enum": [
        "hour",
        "day"
      ]
    },
    "from_at": {
      "description": "RFC3339 start of the first dense bucket, with the server-local UTC offset.",
      "type": "string",
      "format": "date-time"
    },
    "to_at": {
      "description": "RFC3339 report time, with the server-local UTC offset.",
      "type": "string",
      "format": "date-time"
    },
    "buckets": {
      "description": "Dense chronological buckets: 24 for 24h, or one per local calendar day for the daily windows.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/UsageBucket"
      }
    },
    "pricing": {
      "$ref": "#/definitions/Pricing"
    }
  },
  "definitions": {
    "LocalDay": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Count": {
      "description": "One metered count: the exact sum of the per-call reports inside the window, each already bounded where it entered the wire. Never clamped to keep it small — a truncated total is indistinguishable from a real one, and clamping a subset and its superset together forces a ratio such as a cached-input share to exactly 100%. The maximum is derived from the producer rather than imposed on the user, and caps nobody's spending: a count is a sum over at most 400 rows (USAGE_MAX_ROWS), each carrying counters of at most 2^53 - 1 (USAGE_COUNTER_CEILING). Both limits are applied when the store is read as well as when it is written, so the bound holds for a corrupt or hand-edited store too and not only for one this producer wrote. A consumer reading this document into IEEE-754 doubles holds every value up to 2^53 - 1 exactly and every larger one as a finite double, rounded in its last places; a window spans at most 62 days of real calls, so only a corrupt or hand-edited store can publish a count in that rounding range.",
      "type": "integer",
      "minimum": 0,
      "maximum": 3602879701896396400
    },
    "Counters": {
      "type": "object",
      "required": [
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/Count",
          "description": "Self-measured upstream calls that reached the model. One turn contributes more than one when it failed over. Always available."
        },
        "token_reports": {
          "$ref": "#/definitions/Count",
          "description": "Metered calls whose upstream response carried a token report. Never greater than requests; a shortfall means missing reports, not zero usage."
        },
        "input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Vendor-reported input tokens composed per protocol, including tokens served from cache."
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Subset of input_tokens served from cache."
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cache_write_input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Subset of input_tokens written to the prompt cache (Anthropic `cache_creation_input_tokens`), disjoint from cached_input_tokens. Zero for protocols that report no cache writes. Absent from documents produced before cache writes were metered; read absence as zero."
        },
        "cache_write_1h_input_tokens": {
          "$ref": "#/definitions/Count",
          "description": "Subset of cache_write_input_tokens written with the one-hour cache lifetime (Anthropic `cache_creation.ephemeral_1h_input_tokens`); the rest used the five-minute lifetime."
        },
        "cache_write_uncaptured_reports": {
          "$ref": "#/definitions/Count",
          "description": "Subset of token_reports metered before cache writes were captured. Their cache writes, if any, are inside input_tokens but not in cache_write_input_tokens."
        },
        "api_cost_usd": {
          "description": "What this usage would cost at the vendor's list API price, in `pricing.currency`, at the current price table — never the price in force when the call ran. A valuation for comparison, never an amount charged. Present exactly when `pricing` is. Usage whose model has no price is left out and counted in excluded_tokens, never priced as zero.",
          "type": "number",
          "minimum": 0
        },
        "excluded_tokens": {
          "$ref": "#/definitions/Count",
          "description": "input_tokens + output_tokens of the usage whose model has no known price, which api_cost_usd therefore leaves out. Present exactly when `pricing` is."
        },
        "api_cost_lower_bound": {
          "description": "True when some priced usage here was metered before cache writes were captured on a model that charges for them: those writes were priced as ordinary input, so api_cost_usd understates. Present exactly when `pricing` is.",
          "type": "boolean"
        }
      }
    },
    "UsageBucketRow": {
      "type": "object",
      "required": [
        "source_id",
        "model_id",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cache_write_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_input_tokens"
        },
        "cache_write_1h_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_1h_input_tokens"
        },
        "cache_write_uncaptured_reports": {
          "$ref": "#/definitions/Counters/properties/cache_write_uncaptured_reports"
        },
        "api_cost_usd": {
          "$ref": "#/definitions/Counters/properties/api_cost_usd"
        },
        "excluded_tokens": {
          "$ref": "#/definitions/Counters/properties/excluded_tokens"
        },
        "api_cost_lower_bound": {
          "$ref": "#/definitions/Counters/properties/api_cost_lower_bound"
        }
      }
    },
    "UsageBucket": {
      "type": "object",
      "required": [
        "key",
        "start_at",
        "end_at",
        "history_complete",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Server-local rendering of the canonical UTC hour boundary, with an explicit offset; fractional-offset zones may show :30 or :45.",
          "type": "string",
          "minLength": 1
        },
        "start_at": {
          "description": "Inclusive server-local rendering of the canonical UTC hour boundary.",
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "description": "Exclusive server-local rendering of the next canonical UTC hour boundary; the final bucket ends at report time.",
          "type": "string",
          "format": "date-time"
        },
        "history_complete": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UsageBucketRow"
          }
        }
      }
    },
    "SourceUsage": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "last_metered_at",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "Joined from current Source config; null once the Source is gone.",
          "type": [
            "string",
            "null"
          ]
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "last_metered_at": {
          "description": "When this Source last had a call metered, served or billed-and-failed.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ModelUsage"
          }
        },
        "cache_write_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_input_tokens"
        },
        "cache_write_1h_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_1h_input_tokens"
        },
        "cache_write_uncaptured_reports": {
          "$ref": "#/definitions/Counters/properties/cache_write_uncaptured_reports"
        },
        "api_cost_usd": {
          "$ref": "#/definitions/Counters/properties/api_cost_usd"
        },
        "excluded_tokens": {
          "$ref": "#/definitions/Counters/properties/excluded_tokens"
        },
        "api_cost_lower_bound": {
          "$ref": "#/definitions/Counters/properties/api_cost_lower_bound"
        }
      }
    },
    "ModelUsage": {
      "type": "object",
      "required": [
        "model_id",
        "label",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "description": "Ledger key, which for a long identifier is a head plus a digest rather than the identifier itself. Display label, never model_id.",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "The model identity this row was metered under, joined from current Source config; null once the model is gone.",
          "type": [
            "string",
            "null"
          ]
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cache_write_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_input_tokens"
        },
        "cache_write_1h_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_1h_input_tokens"
        },
        "cache_write_uncaptured_reports": {
          "$ref": "#/definitions/Counters/properties/cache_write_uncaptured_reports"
        },
        "api_cost_usd": {
          "$ref": "#/definitions/Counters/properties/api_cost_usd"
        },
        "excluded_tokens": {
          "$ref": "#/definitions/Counters/properties/excluded_tokens"
        },
        "api_cost_lower_bound": {
          "$ref": "#/definitions/Counters/properties/api_cost_lower_bound"
        },
        "priced": {
          "description": "Whether a price was found for this model. Present exactly when `pricing` is; false means the UI shows no price for it and its tokens are in excluded_tokens.",
          "type": "boolean"
        }
      }
    },
    "DayUsage": {
      "type": "object",
      "required": [
        "day",
        "requests",
        "token_reports",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "$ref": "#/definitions/LocalDay"
        },
        "requests": {
          "$ref": "#/definitions/Count"
        },
        "token_reports": {
          "$ref": "#/definitions/Count"
        },
        "input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cached_input_tokens": {
          "$ref": "#/definitions/Count"
        },
        "output_tokens": {
          "$ref": "#/definitions/Count"
        },
        "cache_write_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_input_tokens"
        },
        "cache_write_1h_input_tokens": {
          "$ref": "#/definitions/Counters/properties/cache_write_1h_input_tokens"
        },
        "cache_write_uncaptured_reports": {
          "$ref": "#/definitions/Counters/properties/cache_write_uncaptured_reports"
        },
        "api_cost_usd": {
          "$ref": "#/definitions/Counters/properties/api_cost_usd"
        },
        "excluded_tokens": {
          "$ref": "#/definitions/Counters/properties/excluded_tokens"
        },
        "api_cost_lower_bound": {
          "$ref": "#/definitions/Counters/properties/api_cost_lower_bound"
        }
      }
    },
    "Pricing": {
      "description": "The price table the cost fields were computed from: models.dev list prices under the local override file. Absent from documents produced before API-price valuation existed, and whenever no price table could be read; the cost fields are then absent too.",
      "type": "object",
      "required": [
        "currency",
        "price_table_date"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD"
        },
        "price_table_date": {
          "description": "Local date the models.dev price table was last fetched; null when none has been fetched and only local overrides priced anything.",
          "oneOf": [
            {
              "$ref": "#/definitions/LocalDay"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "examples": [
    {
      "window_days": 30,
      "from_day": "2026-07-20",
      "to_day": "2026-08-18",
      "totals": {
