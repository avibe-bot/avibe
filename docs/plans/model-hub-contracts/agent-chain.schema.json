{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/agent-chain.schema.json",
  "title": "AgentChain",
  "description": "Read projection of one stored per-model Route chain. Items preserve exact configured Source/model pairs and order; runtime adds only live health, runnability, blocker, retry annotations, and the current execution position. Runtime never derives membership, resolves aliases, or substitutes a model.",
  "type": "object",
  "required": ["contract_version", "backend", "model_id", "chain", "current", "supply_state"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": 7 },
    "backend": { "enum": ["claude", "codex", "opencode"] },
    "model_id": { "type": "string" },
    "current": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["source_id", "model_id"],
          "additionalProperties": false,
          "properties": {
            "source_id": { "type": "string", "pattern": "^src_[a-z0-9]{8,}$" },
            "model_id": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "description": "The live execution position, identified by one exact stored hop. It is null when no hop is current. Recovery may change this projection on the next turn without changing the stored chain."
    },
    "chain": {
      "type": "array",
      "description": "Exact stored hops in configured order. Empty is a first-class unconfigured route.",
      "items": {
        "type": "object",
        "required": ["source_id", "model_id", "channel", "health", "runnable", "reason", "retry_at"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^src_[a-z0-9]{8,}$" },
          "model_id": { "type": "string", "minLength": 1 },
          "channel": { "enum": ["hub", "native_cli"] },
          "health": {
            "enum": ["healthy", "cooldown", "backoff", "needs_action", "error"],
            "description": "Source-global health mapped to this hop, plus live backoff. backoff is an in-memory connection throttle before the first user-visible model-output byte and is never persisted on Source or configuration. It is projected only over an otherwise healthy hop whose exact Source/model capability is present; every durable Source/capability blocker suppresses it."
          },
          "runnable": { "type": "boolean" },
          "reason": {
            "anyOf": [
              { "const": "native_cli_unavailable" },
              { "const": "models.source.backoff.connection_failed" },
              {
                "enum": [
                  "source_missing",
                  "model_unsupported",
                  "models.source.needs_action.oauth_expired",
                  "models.source.needs_action.balance_exhausted",
                  "models.source.needs_action.credential_revoked",
                  "models.source.needs_action.account_banned",
                  "models.source.error.unclassified"
                ]
              },
              { "type": "null" }
            ]
          },
          "retry_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When health is backoff, this live deadline is strictly later than the read assembler's captured assembly time. The API normalizes an expired overlay to its underlying non-backoff health before validation and serialization; JSON Schema enforces only the date-time shape, not the relation to a moving clock."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "health": { "enum": ["needs_action", "error"] } }, "required": ["health"] },
            "then": { "properties": { "runnable": { "const": false }, "retry_at": { "type": "null" } } }
          },
          {
            "if": { "properties": { "channel": { "const": "hub" }, "reason": { "type": "string" } }, "required": ["channel", "reason"] },
            "then": { "properties": { "runnable": { "const": false } } }
          },
          {
            "if": { "properties": { "reason": { "const": "native_cli_unavailable" } }, "required": ["reason"] },
            "then": { "properties": { "channel": { "const": "native_cli" }, "runnable": { "const": false } } }
          },
          {
            "if": { "properties": { "health": { "const": "cooldown" } }, "required": ["health"] },
            "then": { "required": ["retry_at"], "properties": { "retry_at": { "type": "string" } } }
          },
          {
            "if": { "properties": { "health": { "const": "backoff" } }, "required": ["health"] },
            "then": {
              "required": ["reason", "retry_at"],
              "properties": {
                "runnable": { "const": false },
                "reason": {
                  "enum": ["models.source.backoff.connection_failed", "native_cli_unavailable"],
                  "description": "Connection backoff is the reason unless an unavailable native CLI is the simultaneous actionable process blocker; in that combined state native_cli_unavailable takes the single reason slot while health and retry_at retain the backoff facts."
                },
                "retry_at": { "type": "string" }
              }
            }
          },
          {
            "if": { "properties": { "health": { "enum": ["healthy", "cooldown", "needs_action", "error"] } }, "required": ["health"] },
            "then": { "properties": { "reason": { "not": { "const": "models.source.backoff.connection_failed" } } } }
          }
        ]
      }
    },
    "supply_state": {
      "enum": ["ok", "waiting", "interrupted"],
      "description": "ok has a runnable hop; waiting is a non-empty chain whose only blockers are Source cooldown or live connection backoff and which has no process blocker; interrupted covers an empty chain or an action/process blocker. A durable blocker cannot be hidden by a simultaneous live backoff."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "supply_state": { "const": "ok" } }, "required": ["supply_state"] },
      "then": { "properties": { "chain": { "contains": { "properties": { "runnable": { "const": true } }, "required": ["runnable"] } } } }
    },
    {
      "if": { "properties": { "supply_state": { "enum": ["waiting", "interrupted"] } }, "required": ["supply_state"] },
      "then": { "properties": { "chain": { "not": { "contains": { "properties": { "runnable": { "const": true } }, "required": ["runnable"] } } } } }
    },
    {
      "if": { "properties": { "supply_state": { "const": "waiting" } }, "required": ["supply_state"] },
      "then": {
        "properties": {
          "chain": {
            "minItems": 1,
            "items": {
              "properties": {
                "health": { "enum": ["cooldown", "backoff"] },
                "runnable": { "const": false },
                "reason": { "enum": [null, "models.source.backoff.connection_failed"] }
              },
              "required": ["health", "runnable", "reason"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chain": {
            "minItems": 1,
            "items": {
              "properties": {
                "health": { "enum": ["cooldown", "backoff"] },
                "runnable": { "const": false },
                "reason": { "enum": [null, "models.source.backoff.connection_failed"] }
              },
              "required": ["health", "runnable", "reason"]
            }
          }
        },
        "required": ["chain"]
      },
      "then": {
        "properties": {
          "supply_state": { "const": "waiting" }
        }
      }
    }
  ],
  "examples": [
    {
      "contract_version": 7,
      "backend": "claude",
      "model_id": "claude-opus-4-6",
      "chain": [{ "source_id": "src_claudepro1", "model_id": "claude-opus-4-6", "channel": "native_cli", "health": "cooldown", "runnable": false, "reason": null, "retry_at": "2026-07-29T04:00:00Z" }],
      "current": null,
      "supply_state": "waiting"
    },
    {
      "contract_version": 7,
      "backend": "opencode",
      "model_id": "custom/glm-5.2",
      "chain": [{ "source_id": "src_relay9c1x", "model_id": "glm-5.2", "channel": "hub", "health": "backoff", "runnable": false, "reason": "models.source.backoff.connection_failed", "retry_at": "2026-08-11T11:55:08Z" }],
      "current": null,
      "supply_state": "waiting"
    },
    {
      "contract_version": 7,
      "backend": "codex",
      "model_id": "gpt-5.6",
      "chain": [{ "source_id": "src_chatgptplus", "model_id": "gpt-5.6", "channel": "native_cli", "health": "healthy", "runnable": false, "reason": "native_cli_unavailable", "retry_at": null }],
      "current": null,
      "supply_state": "interrupted"
    },
    {
      "contract_version": 7,
      "backend": "codex",
      "model_id": "gpt-5.6",
      "chain": [{ "source_id": "src_chatgptplus", "model_id": "gpt-5.6", "channel": "native_cli", "health": "backoff", "runnable": false, "reason": "native_cli_unavailable", "retry_at": "2026-08-11T11:55:08Z" }],
      "current": null,
      "supply_state": "interrupted"
    },
    {
      "contract_version": 7,
      "backend": "claude",
      "model_id": "claude-haiku-4-5",
      "chain": [],
      "current": null,
      "supply_state": "interrupted"
    }
  ]
}
