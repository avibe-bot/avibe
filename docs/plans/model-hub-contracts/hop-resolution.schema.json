{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/hop-resolution.schema.json",
  "title": "HopResolution",
  "description": "C-6 runtime consumer projection of ModelHubLaunch. Unknown planning metadata remains null; credentials are in-memory only.",
  "type": "object",
  "required": ["backend", "requested_model", "protocol", "base_url", "token", "runtime_model", "source_id", "source_identity", "provider", "request_headers", "capabilities", "hosted_tools"],
  "additionalProperties": false,
  "properties": {
    "backend": { "const": "vibey" },
    "requested_model": { "type": "string" },
    "protocol": { "$ref": "source-probe-result.schema.json#/properties/protocol" },
    "base_url": { "type": "string", "format": "uri" },
    "token": { "type": "string" },
    "runtime_model": { "type": "string" },
    "source_id": { "type": "string" },
    "source_identity": {
      "type": "string",
      "minLength": 1,
      "description": "The primary hop Source's credential-free identity (identity_digest), from the snapshot its origin came from. The consumer replays opaque payloads only to a hop of the identity that served them."
    },
    "provider": { "type": "string" },
    "cache_ttl": {
      "enum": ["5m", "30m", "1h", "12h", null],
      "description": "Validated Model Hub route-local cache lifetime override; unset uses the built-in C-9 estimate. Confirmed official OpenAI Responses GPT-5.6+ routes may explicitly request 30m or 12h; relays do not receive OpenAI-specific cache options."
    },
    "cache_ttl_wire": {
      "type": "boolean",
      "description": "True only when the adapter may send cache_ttl as a provider-specific request option."
    },
    "request_headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "required": ["context_window", "input_limit", "max_output_tokens", "supports_tools", "supports_images", "supports_reasoning", "reasoning_efforts", "context_price_steps"],
      "additionalProperties": false,
      "properties": {
        "context_window": { "type": ["integer", "null"], "minimum": 1 },
        "input_limit": { "type": ["integer", "null"], "minimum": 1 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "supports_tools": { "type": ["boolean", "null"] },
        "supports_images": { "type": ["boolean", "null"] },
        "supports_reasoning": { "type": ["boolean", "null"] },
        "reasoning_efforts": { "type": "array", "items": { "type": "string" } },
        "context_price_steps": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Where the target model's list price rises with its context, ascending, from the price table the usage writer holds; empty when flat or unknown."
        }
      }
    },
    "hosted_tools": {
      "type": "object",
      "description": "One entry per hosted tool the turn declares (vibey-hosted-tools.md §3.4). A search tool's entry is the primary hop's facts: `native` is `assumed` when the tool runs on the hop (`runs_on`) and no current negative `call` evidence exists, else `unsupported`; `refused` is `true` exactly when that negative `call` evidence, not `runs_on`, is why; `declaration` and `include` (the overlay's wire declaration and Responses include values) are present exactly when `native` is `assumed`; `replay` is `assumed` when `native` is, the protocol replays natively and no current negative `replay` evidence exists. `image_generate` lists the image models the user's Sources make available, default first, and is absent when the tool is off or no model is available. The turn's first resolution freezes the tool set and the image models; later hops change only `native`, `replay` and `refused`. A request carrying native content is pinned with x-avibe-pin-source: source_id.",
      "additionalProperties": false,
      "properties": {
        "web_fetch": {
          "type": "object", "required": ["native", "replay"], "additionalProperties": false,
          "description": "Function-only fetch; absent while WEB_FETCH_ACTIVE is false.",
          "properties": {"native": {"const": "unsupported"}, "replay": {"const": "unsupported"}}
        },
        "web_search": {
          "type": "object",
          "required": [
            "native",
            "replay"
          ],
          "additionalProperties": false,
          "properties": {
            "native": {
              "enum": [
                "assumed",
                "unsupported"
              ]
            },
            "declaration": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "replay": {
              "enum": [
                "assumed",
                "unsupported"
              ]
            },
            "refused": {
              "const": true,
              "description": "Present exactly when the tool runs on the hop but current negative `call` evidence for the hop's (Source, model) makes `native` `unsupported`: this Source refused it, so a proxied call is a fallback from it."
            }
          },
          "if": {
            "properties": {
              "native": {
                "const": "assumed"
              }
            }
          },
          "then": {
            "required": [
              "declaration",
              "include"
            ],
            "not": {
              "required": [
                "refused"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "declaration"
                  ]
                },
                {
                  "required": [
                    "include"
                  ]
                }
              ]
            }
          }
        },
        "x_search": {
          "type": "object",
          "required": [
            "native",
            "replay"
          ],
          "additionalProperties": false,
          "properties": {
            "native": {
              "enum": [
                "assumed",
                "unsupported"
              ]
            },
            "declaration": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "replay": {
              "enum": [
                "assumed",
                "unsupported"
              ]
            },
            "refused": {
              "const": true,
              "description": "Present exactly when the tool runs on the hop but current negative `call` evidence for the hop's (Source, model) makes `native` `unsupported`: this Source refused it, so a proxied call is a fallback from it."
            }
          },
          "if": {
            "properties": {
              "native": {
                "const": "assumed"
              }
            }
          },
          "then": {
            "required": [
              "declaration",
              "include"
            ],
            "not": {
              "required": [
                "refused"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "declaration"
                  ]
                },
                {
                  "required": [
                    "include"
                  ]
                }
              ]
            }
          }
        },
        "image_generate": {
          "type": "object",
          "required": [
            "models",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "source_id",
                  "model_id",
                  "description",
                  "params",
                  "size_forms"
                ],
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^src_[a-z0-9]{8,}$"
                  },
                  "model_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "size",
                        "images",
                        "n"
                      ]
                    }
                  },
                  "size_forms": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "pixels",
                        "ratio"
                      ]
                    }
                  }
                }
              }
            },
            "default": {
              "type": "object",
              "required": [
                "source_id",
                "model_id"
              ],
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^src_[a-z0-9]{8,}$"
                },
                "model_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
