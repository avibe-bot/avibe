{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/hop-resolution.schema.json",
  "title": "HopResolution",
  "description": "C-6 runtime consumer projection of ModelHubLaunch. Unknown planning metadata remains null; credentials are in-memory only.",
  "type": "object",
  "required": ["backend", "requested_model", "protocol", "base_url", "token", "runtime_model", "source_id", "provider", "request_headers", "capabilities", "hosted_tools"],
  "additionalProperties": false,
  "properties": {
    "backend": { "const": "vibey" },
    "requested_model": { "type": "string" },
    "protocol": { "$ref": "source.schema.json#/properties/protocol" },
    "base_url": { "type": "string", "format": "uri" },
    "token": { "type": "string" },
    "runtime_model": { "type": "string" },
    "source_id": { "type": "string" },
    "provider": { "type": "string" },
    "request_headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "required": ["context_window", "input_limit", "max_output_tokens", "supports_tools", "supports_images", "supports_reasoning", "reasoning_efforts"],
      "additionalProperties": false,
      "properties": {
        "context_window": { "type": ["integer", "null"], "minimum": 1 },
        "input_limit": { "type": ["integer", "null"], "minimum": 1 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "supports_tools": { "type": ["boolean", "null"] },
        "supports_images": { "type": ["boolean", "null"] },
        "supports_reasoning": { "type": ["boolean", "null"] },
        "reasoning_efforts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hosted_tools": {
      "type": "object",
      "description": "One entry per hosted tool the user enabled (vibey-hosted-tools.md §3.5). `mode` is the primary hop's; `declaration` and `include` are the overlay's wire declaration, present exactly for native; `executor` is the proxy executor bound for this turn, present for every entry because a native request answered pin_unavailable is re-rendered with the proxy in the same turn; `replay` is true only for the primary hop Source's positive replay evidence taken on the current engine and probe shape. A request carrying native content is pinned with x-avibe-pin-source: source_id.",
      "propertyNames": {
        "enum": [
          "web_search",
          "x_search",
          "image_generation"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "executor",
          "replay"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "native",
              "proxy"
            ]
          },
          "declaration": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "executor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "source_id",
                  "model_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^src_[a-z0-9]{8,}$"
                  },
                  "model_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "replay": {
            "type": "boolean"
          }
        },
        "if": {
          "properties": {
            "mode": {
              "const": "native"
            }
          }
        },
        "then": {
          "required": [
            "declaration",
            "include"
          ]
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "declaration"
                ]
              },
              {
                "required": [
                  "include"
                ]
              }
            ]
          }
        }
      },
      "properties": {
        "image_generation": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "mode",
                "executor",
                "replay"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "native",
                    "proxy"
                  ]
                },
                "declaration": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "source_id",
                        "model_id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "pattern": "^src_[a-z0-9]{8,}$"
                        },
                        "model_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "replay": {
                  "type": "boolean"
                }
              },
              "if": {
                "properties": {
                  "mode": {
                    "const": "native"
                  }
                }
              },
              "then": {
                "required": [
                  "declaration",
                  "include"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "declaration"
                      ]
                    },
                    {
                      "required": [
                        "include"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "replay": {
                  "const": false
                }
              }
            }
          ]
        }
      }
    }
  }
}
