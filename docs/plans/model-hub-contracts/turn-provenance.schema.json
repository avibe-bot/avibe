{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-hub/turn-provenance.schema.json",
  "title": "TurnProvenance",
  "description": "Persisted debug record for one exactly attributed Gateway turn. It records exact configured Source/model attempts in stored order and one terminal outcome. No route-policy or runtime-mapping discriminator exists; ambiguous attempts produce no record.",
  "type": "object",
  "definitions": {
    "strippedReasoningEfforts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Effort values removed from this exact attempt because they were absent from the hop's declared tiers. String values are preserved exactly, including an empty string; invalid non-string values use fixed type markers. Present only when a strip occurred."
    },
    "declaredReasoningEfforts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "The exact hop tier declaration consulted when stripped_reasoning_efforts was produced."
    }
  },
  "required": [
    "contract_version",
    "turn_id",
    "ts",
    "agent",
    "requested_model_id",
    "outcome",
    "failed_attempts",
    "served",
    "terminal_error",
    "canceled_attempt",
    "model_supply_state",
    "blockers"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "enum": [5, 6, 7, 8],
      "$comment": "The only versioned object that is written to disk instead of exchanged inside one request, so its released values are a set rather than a constant. A record a v5 build persisted keeps validating -- tests/fixtures/model_hub/released_v5_permission_denied.json is the evidence -- while new records carry the terminal value, which is the last member. Every other versioned object is an in-process envelope and stays pinned to that value alone.",
      "description": "Generation that wrote this record. Nothing branches on it: readers accept every released value and the shape is identical across them."
    },
    "turn_id": {
      "type": "string",
      "description": "Opaque id in the existing turn/session id space."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the FSM settled the turn."
    },
    "agent": {
      "enum": ["claude", "codex", "opencode"],
      "description": "Backend identifier. Mirrors AgentSupply.backend exactly."
    },
    "requested_model_id": {
      "type": "string",
      "description": "Caller-facing menu identifier from the turn request."
    },
    "outcome": {
      "enum": [
        "served",
        "exhausted",
        "failed_terminal",
        "no_candidate",
        "canceled"
      ],
      "description": "FSM terminal classification. canceled is emitted only from explicit Stop/cancel truth, never inferred from a dropped transport."
    },
    "failed_attempts": {
      "type": "array",
      "description": "Candidates tried and left behind through fallback, in order. Skipped candidates are not attempts.",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "configured_model_id",
          "channel",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src_[a-z0-9]{8,}$"
          },
          "configured_model_id": { "type": "string" },
          "channel": { "enum": ["native_cli", "hub"] },
          "stripped_reasoning_efforts": { "$ref": "#/definitions/strippedReasoningEfforts" },
          "declared_reasoning_efforts": { "$ref": "#/definitions/declaredReasoningEfforts" },
          "reason": {
            "enum": [
              "quota_exhausted",
              "rate_limited",
              "server_error",
              "network",
              "credential_expired",
              "credential_revoked",
              "balance_exhausted",
              "account_banned",
              "unclassified_error"
            ],
            "description": "The attempt-failure partition of ResolutionEvent.reason. The mirror registry enforces totality."
          }
        },
        "dependencies": {
          "stripped_reasoning_efforts": ["declared_reasoning_efforts"],
          "declared_reasoning_efforts": ["stripped_reasoning_efforts"]
        }
      }
    },
    "served": {
      "type": ["object", "null"],
      "description": "The attempt that completed the turn; non-null only for outcome served.",
      "required": ["source_id", "configured_model_id", "channel"],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[a-z0-9]{8,}$"
        },
        "configured_model_id": { "type": "string" },
        "channel": { "enum": ["native_cli", "hub"] },
        "stripped_reasoning_efforts": { "$ref": "#/definitions/strippedReasoningEfforts" },
        "declared_reasoning_efforts": { "$ref": "#/definitions/declaredReasoningEfforts" }
      },
      "dependencies": {
        "stripped_reasoning_efforts": ["declared_reasoning_efforts"],
        "declared_reasoning_efforts": ["stripped_reasoning_efforts"]
      }
    },
    "terminal_error": {
      "type": ["object", "null"],
      "description": "The attempt that stopped the turn with a non-fallback failure.",
      "required": [
        "source_id",
        "configured_model_id",
        "channel",
        "reason",
        "stream_started"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "anyOf": [
            { "type": "string", "pattern": "^src_[a-z0-9]{8,}$" },
            { "type": "null" }
          ]
        },
        "configured_model_id": { "type": ["string", "null"] },
        "channel": { "enum": ["native_cli", "hub", null] },
        "stripped_reasoning_efforts": { "$ref": "#/definitions/strippedReasoningEfforts" },
        "declared_reasoning_efforts": { "$ref": "#/definitions/declaredReasoningEfforts" },
        "reason": {
          "enum": [
            "invalid_parameter",
            "protocol_error",
            "tool_incompatible",
            "stream_interrupted",
            "engine_down"
          ]
        },
        "stream_started": { "type": "boolean" }
      },
      "dependencies": {
        "stripped_reasoning_efforts": ["declared_reasoning_efforts"],
        "declared_reasoning_efforts": ["stripped_reasoning_efforts"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "stream_interrupted" } },
            "required": ["reason"]
          },
          "then": {
            "required": ["stream_started"],
            "properties": { "stream_started": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "reason": { "const": "engine_down" } },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "source_id": { "type": "null" },
              "configured_model_id": { "type": "null" },
              "channel": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "source_id": { "type": "string" },
              "configured_model_id": { "type": "string" },
              "channel": { "enum": ["native_cli", "hub"] }
            }
          }
        }
      ]
    },
    "canceled_attempt": {
      "type": ["object", "null"],
      "description": "The in-flight attempt interrupted by explicit Stop/cancel. It carries identity but no failure reason because the source did not fail. null is honest when cancellation settled before any source attempt started.",
      "required": ["source_id", "configured_model_id", "channel"],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[a-z0-9]{8,}$"
        },
        "configured_model_id": { "type": "string" },
        "channel": { "enum": ["native_cli", "hub"] },
        "stripped_reasoning_efforts": { "$ref": "#/definitions/strippedReasoningEfforts" },
        "declared_reasoning_efforts": { "$ref": "#/definitions/declaredReasoningEfforts" }
      },
      "dependencies": {
        "stripped_reasoning_efforts": ["declared_reasoning_efforts"],
        "declared_reasoning_efforts": ["stripped_reasoning_efforts"]
      }
    },
    "model_supply_state": {
      "type": ["string", "null"],
      "enum": ["waiting", "interrupted", null],
      "description": "Model-scoped state for no_candidate. null for every other outcome."
    },
    "blockers": {
      "type": "array",
      "description": "Exact-hop blockers used to render a blocked no_candidate outcome. Empty for an unconfigured route and for outcomes other than no_candidate.",
      "items": {
        "type": "object",
        "required": ["source_id", "model_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^src_[a-z0-9]{8,}$" },
          "model_id": { "type": "string" },
          "reason": {
            "enum": [
              "source_missing",
              "model_unsupported",
              "native_cli_unavailable",
              "cooldown",
              "credential_expired",
              "credential_revoked",
              "balance_exhausted",
              "account_banned",
              "unclassified_error"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "served" } },
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "served",
          "terminal_error",
          "canceled_attempt",
          "model_supply_state"
        ],
        "properties": {
          "served": { "type": "object" },
          "terminal_error": { "type": "null" },
          "canceled_attempt": { "type": "null" },
          "model_supply_state": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "exhausted" } },
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "served",
          "terminal_error",
          "canceled_attempt",
          "model_supply_state"
        ],
        "properties": {
          "served": { "type": "null" },
          "terminal_error": { "type": "null" },
          "canceled_attempt": { "type": "null" },
          "failed_attempts": { "minItems": 1 },
          "model_supply_state": { "type": "null" }
        }
      }
    },
    {
      "$comment": "failed_attempts deliberately has no minItems: the first candidate can be terminal.",
      "if": {
        "properties": { "outcome": { "const": "failed_terminal" } },
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "served",
          "terminal_error",
          "canceled_attempt",
          "model_supply_state"
        ],
        "properties": {
          "served": { "type": "null" },
          "terminal_error": { "type": "object" },
          "canceled_attempt": { "type": "null" },
          "model_supply_state": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "no_candidate" } },
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "served",
          "terminal_error",
          "canceled_attempt",
          "model_supply_state"
        ],
        "properties": {
          "served": { "type": "null" },
          "terminal_error": { "type": "null" },
          "canceled_attempt": { "type": "null" },
          "failed_attempts": { "maxItems": 0 },
          "model_supply_state": { "type": "string" }
        }
      }
    },
    {
      "$comment": "canceled_attempt is deliberately nullable: Stop can settle before an upstream attempt starts. When an attempt was in flight, the producer fills this slot without a reason.",
      "if": {
        "properties": { "outcome": { "const": "canceled" } },
        "required": ["outcome"]
      },
      "then": {
        "required": [
          "served",
          "terminal_error",
          "canceled_attempt",
          "model_supply_state"
        ],
        "properties": {
          "served": { "type": "null" },
          "terminal_error": { "type": "null" },
          "canceled_attempt": { "type": ["object", "null"] },
          "model_supply_state": { "type": "null" }
        }
      }
    }
  ],
  "examples": [
    {
      "contract_version": 8,
      "turn_id": "turn_01k9x2m4",
      "ts": "2026-07-29T06:32:11Z",
      "agent": "claude",
      "requested_model_id": "claude-opus-4-6",
      "outcome": "served",
      "failed_attempts": [
        {
          "source_id": "src_claudepro1",
          "configured_model_id": "claude-opus-4-6",
          "channel": "native_cli",
          "reason": "quota_exhausted"
        }
      ],
      "served": {
        "source_id": "src_anthkey01",
        "configured_model_id": "claude-opus-4-6",
        "channel": "hub"
      },
      "terminal_error": null,
      "canceled_attempt": null,
      "model_supply_state": null,
      "blockers": []
    },
    {
      "contract_version": 8,
      "turn_id": "turn_01k9x33p",
      "ts": "2026-07-29T06:41:02Z",
      "agent": "opencode",
      "requested_model_id": "zhipuai/glm-5.2",
      "outcome": "exhausted",
      "failed_attempts": [
        {
          "source_id": "src_relay9c1x",
          "configured_model_id": "glm-5.2",
          "channel": "hub",
          "reason": "balance_exhausted"
        }
      ],
      "served": null,
      "terminal_error": null,
      "canceled_attempt": null,
      "model_supply_state": null,
      "blockers": []
    },
    {
      "contract_version": 8,
      "turn_id": "turn_01k9x3zq",
      "ts": "2026-07-29T06:48:20Z",
      "agent": "codex",
      "requested_model_id": "gpt-5.3-codex",
      "outcome": "no_candidate",
      "failed_attempts": [],
      "served": null,
      "terminal_error": null,
      "canceled_attempt": null,
      "model_supply_state": "waiting",
      "blockers": [
        {
          "source_id": "src_codexplus1",
          "model_id": "gpt-5.3-codex",
          "reason": "cooldown"
        }
      ]
    },
    {
      "contract_version": 8,
      "turn_id": "turn_01k9x4b7",
      "ts": "2026-07-29T07:02:44Z",
      "agent": "claude",
      "requested_model_id": "claude-opus-4-6",
      "outcome": "failed_terminal",
      "failed_attempts": [],
      "served": null,
      "terminal_error": {
        "source_id": "src_anthkey01",
        "configured_model_id": "claude-opus-4-6",
        "channel": "hub",
        "reason": "stream_interrupted",
        "stream_started": true
      },
      "canceled_attempt": null,
      "model_supply_state": null,
      "blockers": []
    },
    {
      "contract_version": 8,
      "turn_id": "turn_01k9x5ca",
      "ts": "2026-07-29T07:08:00Z",
      "agent": "codex",
      "requested_model_id": "gpt-5.3-codex",
      "outcome": "canceled",
      "failed_attempts": [],
      "served": null,
      "terminal_error": null,
      "canceled_attempt": {
        "source_id": "src_codexplus1",
        "configured_model_id": "gpt-5.3-codex",
        "channel": "native_cli"
      },
      "model_supply_state": null,
      "blockers": []
    }
  ]
}
