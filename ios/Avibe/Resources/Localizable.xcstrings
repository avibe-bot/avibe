    "google.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the email code for the same account. Google blocks sign-in inside embedded browsers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请改用同一账号的邮箱验证码。Google 不允许在内嵌浏览器中登录。"
