{
  "sourceLanguage" : "en",
  "strings" : {
    "AVIBE_LIVE_ACTIVITY_NEEDS_YOU_TITLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你处理"
          }
        }
      }
    },
    "AVIBE_LIVE_ACTIVITY_NEEDS_YOU_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Avibe to respond"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Avibe 回应"
          }
        }
      }
    },
    "health.title" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple 健康"
          }
        }
      }
    },
    "health.sync_to" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步到"
          }
        }
      }
    },
    "health.metrics" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps, activity, workouts, and sleep"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步数、活动、锻炼和睡眠"
          }
        }
      }
    },
    "health.explanation" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avibe reads only the data you allow, syncs it to this personal instance, and keeps the last 30 days for your daily and weekly status. It never writes to Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Avibe 只读取你允许的数据，同步到这个个人实例并保留最近 30 天，用来了解你每天和每周的状态。Avibe 不会向 Apple 健康写入数据。"
          }
        }
      }
    },
    "health.ai_disclosure" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Agents on this instance can read synced data. Your data may be sent to the AI model services used by those Agents and saved in conversation history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此实例内的所有 Agent 都可读取同步数据。数据可能发送给这些 Agent 使用的 AI 模型服务，并保存在会话记录中。"
          }
        }
      }
    },
    "health.stop" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To stop, ask an Agent to disconnect Health and delete the data on this instance, or turn off access in iOS Health settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止，可以在会话里让 Agent 断开健康连接并删除实例上的数据，也可以在 iOS 健康设置里关闭读取权限。"
          }
        }
      }
    },
    "health.single_instance" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone syncs health data to one instance at a time. Connecting replaces its previous connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 一次只向一个实例同步健康数据，连接后会替换原来的连接。"
          }
        }
      }
    },
    "health.allow" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow and Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许并继续"
          }
        }
      }
    },
    "health.not_now" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不连接"
          }
        }
      }
    },
    "health.ok" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "health.update_required" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Avibe can't keep syncing Apple Health. Update Avibe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Avibe 版本无法继续同步 Apple 健康，请更新 Avibe。"
          }
        }
      }
    },
    "health.connection_failed" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to finish connecting Apple Health. Try again from the conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成 Apple 健康连接，请从会话中重试。"
          }
        }
      }
    },
    "health.cleanup_failed" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't clear Health sync data on this iPhone. Reopen Avibe and sign out again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能清除这台 iPhone 上的健康同步信息。请重新打开 Avibe 后再退出一次。"
          }
        }
      }
    },
