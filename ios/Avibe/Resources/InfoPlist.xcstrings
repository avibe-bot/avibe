    "NSCameraUsageDescription" : {
      "comment" : "Explains the system camera permission prompt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avibe uses the camera when you choose to capture an attachment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择拍摄附件时，Avibe 会使用相机。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Explains the system microphone permission prompt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avibe uses the microphone for hold-to-talk and voice transcription."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avibe 使用麦克风进行按住说话和语音转写。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Explains the system add-only photo library permission prompt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avibe saves images to your photo library when you choose Save Image."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择“存储图像”时，Avibe 会将图像保存到照片图库。"
          }
        }
      }
    }
  },
  "version" : "1.0"
