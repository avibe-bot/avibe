diff --git a/internal/thinking/native_intent_test.go b/internal/thinking/native_intent_test.go
new file mode 100644
index 0000000..ed8c7d2
--- /dev/null
+++ b/internal/thinking/native_intent_test.go
@@ -0,0 +1,191 @@
+package thinking_test
+
+import (
+	"bytes"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/modelconfig"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/thinking"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/thinking/provider/claude"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/thinking/provider/codex"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/thinking/provider/kimi"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/thinking/provider/openai"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/thinking/provider/xai"
+	"github.com/tidwall/gjson"
+)
+
+func TestNativeIntentPreservesPreparedPayloadWithoutCapabilityClaims(t *testing.T) {
+	models := map[string]*registry.ModelInfo{
+		"unresolved":             nil,
+		"user-defined":           {ID: "custom", UserDefined: true},
+		"configured-unknown":     modelconfig.ResolveModelInfo("native-intent-custom", "codex", nil),
+		"known-without-thinking": modelconfig.ResolveModelInfo("claude-3-5-haiku-20241022", "claude", nil),
+		"known":                  modelconfig.ResolveModelInfo("gpt-5.4", "codex", nil),
+		"narrow":                 modelconfig.ResolveModelInfo("custom", "codex", &registry.ThinkingSupport{Levels: []string{"high", "low"}}),
+		"empty":                  modelconfig.ResolveModelInfo("custom", "claude", &registry.ThinkingSupport{}),
+	}
+	for _, route := range [][2]string{
+		{"claude", "claude"}, {"openai", "openai"},
+		{"openai-response", "codex"}, {"codex", "openai-response"},
+		{"openai-response", "xai"}, {"codex", "codex"},
+	} {
+		for name, model := range models {
+			t.Run(route[0]+"/"+route[1]+"/"+name, func(t *testing.T) {
+				// Source differs deliberately: a normalizer already owns target.
+				source := []byte(`{"reasoning":{"effort":"high","summary":"auto"}}`)
+				for _, raw := range []string{
+					`{"model":"resolved","messages":[{"role":"user","content":"中文"}]}`,
+					`{"reasoning":{"effort":"xhigh","summary":"auto","future_option":true}}`,
+					`{"reasoning":{"effort":"none","summary":null}}`,
+					`{"reasoning_effort":"ultra","reasoning":{"exclude":true}}`,
+					`{"thinking":{"type":"adaptive","display":"omitted"},"output_config":{"effort":"max","other":7}}`,
+					`{"thinking":{"type":"enabled","budget_tokens":256},"max_tokens":8192}`,
+					`{"thinking":{"type":"enabled"},"max_tokens":8192}`,
+					`{"thinking":{"type":"disabled"}}`,
+				} {
+					body := []byte(raw)
+					before := cloneIntentModel(model)
+					out, err := thinking.ApplyThinkingWithModelInfo(body, source, "resolved", route[0], route[1], route[1], model)
+					if err != nil || !bytes.Equal(out, body) {
+						t.Fatalf("native intent changed: err=%v input=%s output=%s", err, body, out)
+					}
+					if !reflect.DeepEqual(model, before) {
+						t.Fatal("selected model snapshot was changed")
+					}
+				}
+			})
+		}
+	}
+}
+
+func cloneIntentModel(model *registry.ModelInfo) *registry.ModelInfo {
+	if model == nil {
+		return nil
+	}
+	out := *model
+	if model.Thinking != nil {
+		support := *model.Thinking
+		support.Levels = append([]string(nil), support.Levels...)
+		out.Thinking = &support
+	}
+	return &out
+}
+
+func TestNativeIntentDisablePrecedesCapabilitiesAndSummary(t *testing.T) {
+	for _, target := range []string{"claude", "codex", "openai", "xai", "kimi"} {
+		for _, support := range []*registry.ThinkingSupport{nil, {}, {Levels: []string{"high", "low"}}} {
+			model := modelconfig.ResolveModelInfo("intent-disable-custom", target, support)
+			for _, suffix := range []string{"", "(none)", "(0)"} {
+				t.Run(target+"/"+suffix, func(t *testing.T) {
+					body := []byte(`{"thinking":{"type":"adaptive","display":"summarized"},"output_config":{"effort":"high"},"reasoning":{"effort":"high","summary":"auto"},"reasoning_effort":"high"}`)
+					source := []byte(`{"reasoning_effort":"none"}`)
+					out, err := thinking.ApplyThinkingWithModelInfoAndSummary(body, source, "intent-disable-custom"+suffix,
+						"openai", target, target, model, thinking.SummaryConfig{Mode: thinking.SummaryEnabled})
+					if target == "openai" && suffix == "" {
+						// Native target normalization is authoritative; tested above.
+						if err != nil || !bytes.Equal(out, body) {
+							t.Fatalf("native prepared target changed: err=%v body=%s", err, out)
+						}
+						return
+					}
+					if err != nil {
+						t.Fatal(err)
+					}
+					field, want := "reasoning.effort", "none"
+					if target == "claude" || target == "kimi" {
+						field, want = "thinking.type", "disabled"
+					} else if target == "openai" {
+						field = "reasoning_effort"
+					}
+					if got := gjson.GetBytes(out, field).String(); got != want {
+						t.Fatalf("%s=%q, want %q; body=%s", field, got, want, out)
+					}
+					if target == "claude" && (gjson.GetBytes(out, "thinking.display").Exists() || gjson.GetBytes(out, "output_config.effort").Exists()) {
+						t.Fatalf("disabled Claude retained activation fields: %s", out)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestNativeIntentMissingMetadataUsesOriginalSource(t *testing.T) {
+	for _, model := range []*registry.ModelInfo{
+		nil, {ID: "user", UserDefined: true}, modelconfig.ResolveModelInfo("unknown", "claude", nil),
+	} {
+		out, err := thinking.ApplyThinkingWithModelInfo(
+			[]byte(`{"thinking":{"type":"enabled","budget_tokens":1024}}`),
+			[]byte(`{"reasoning":{"effort":"xhigh"}}`),
+			"unknown", "openai-response", "claude", "claude", model,
+		)
+		if err != nil || gjson.GetBytes(out, "output_config.effort").String() != "xhigh" {
+			t.Fatalf("original source intent lost: err=%v body=%s", err, out)
+		}
+		if gjson.GetBytes(out, "thinking.budget_tokens").Exists() {
+			t.Fatalf("inferred translated budget retained: %s", out)
+		}
+	}
+}
+
+func TestNativeIntentKeepsConversionAndSuffixAuthority(t *testing.T) {
+	model := modelconfig.ResolveModelInfo("claude-opus-4-6", "claude", nil)
+	body := []byte(`{"thinking":{"type":"enabled","budget_tokens":1024}}`)
+	source := []byte(`{"reasoning":{"effort":"xhigh"}}`)
+	out, err := thinking.ApplyThinkingWithModelInfo(body, source, model.ID, "openai-response", "claude", "claude", model)
+	if err != nil || gjson.GetBytes(out, "output_config.effort").String() != "max" {
+		t.Fatalf("known cross-protocol conversion changed: err=%v body=%s", err, out)
+	}
+	out, err = thinking.ApplyThinkingWithModelInfo(body, source, model.ID+"(low)", "claude", "claude", "claude", model)
+	if err != nil || gjson.GetBytes(out, "output_config.effort").String() != "low" {
+		t.Fatalf("suffix precedence lost: err=%v body=%s", err, out)
+	}
+}
+
+func TestNativeIntentKimiNativeDisableWinsOverLegacyChatEffort(t *testing.T) {
+	body := []byte(`{"thinking":{"type":"disabled"},"reasoning_effort":"high"}`)
+	model := modelconfig.ResolveModelInfo("kimi-intent-custom", "kimi", &registry.ThinkingSupport{Levels: []string{"high", "low"}})
+	out, err := thinking.ApplyThinkingWithModelInfo(body, body, model.ID, "openai", "kimi", "kimi", model)
+	if err != nil || gjson.GetBytes(out, "thinking.type").String() != "disabled" || gjson.GetBytes(out, "reasoning_effort").Exists() {
+		t.Fatalf("Kimi disable lost: err=%v body=%s", err, out)
+	}
+}
+
+func TestNativeIntentKimiRepresentationUsesOriginalAndKeepsPreparedTarget(t *testing.T) {
+	model := modelconfig.ResolveModelInfo("kimi-k2.5", "kimi", nil)
+	for _, original := range []string{
+		`{"thinking":{"type":"enabled"}}`,
+		`{"thinking":{"type":"future-type","effort":"ULTRA","keep":"all"}}`,
+		`{"thinking":{"type":"disabled"},"reasoning_effort":"high"}`,
+		`{"thinking":{"effort":"ultra"}}`,
+	} {
+		// Target normalization may replace/remove the native object. Native
+		// detection uses original source, preservation uses prepared target.
+		for _, prepared := range []string{
+			`{"model":"resolved","thinking":{"type":"future","effort":"target-only","keep":"all"},"reasoning_effort":"high"}`,
+			`{"model":"resolved","reasoning_effort":"high"}`,
+		} {
+			out, err := thinking.ApplyThinkingWithModelInfo([]byte(prepared), []byte(original), model.ID, "openai", "kimi", "kimi", model)
+			want := strings.Replace(prepared, `,"reasoning_effort":"high"`, "", 1)
+			if err != nil || string(out) != want {
+				t.Fatalf("Kimi original/prepared authority lost: err=%v body=%s want=%s", err, out, want)
+			}
+		}
+	}
+	for _, source := range []string{
+		`{"reasoning_effort":"high"}`,
+		`{"thinking":{"keep":"all"},"reasoning_effort":"high"}`,
+	} {
+		out, err := thinking.ApplyThinkingWithModelInfo([]byte(source), []byte(source), model.ID, "openai", "kimi", "kimi", model)
+		if err != nil || gjson.GetBytes(out, "thinking.type").String() != "enabled" || gjson.GetBytes(out, "thinking.effort").String() != "high" {
+			t.Fatalf("Kimi legacy conversion lost: err=%v body=%s", err, out)
+		}
+	}
+	source := []byte(`{"thinking":{"type":"enabled","effort":"ultra"},"reasoning_effort":"high"}`)
+	out, err := thinking.ApplyThinkingWithModelInfo(source, source, model.ID+"(none)", "openai", "kimi", "kimi", model)
+	if err != nil || gjson.GetBytes(out, "thinking.type").String() != "disabled" || gjson.GetBytes(out, "thinking.effort").Exists() {
+		t.Fatalf("Kimi suffix did not override native object: err=%v body=%s", err, out)
+	}
+}
