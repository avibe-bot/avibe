+func TestNativeIntentCancellationAndForcedToolChoice(t *testing.T) {
+	captures := make(chan intentCapture, 1)
+	canceled := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		captures <- intentCapture{r.URL.Path, r.Header.Clone(), body}
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = fmt.Fprintf(w, "event: message_start\ndata: {\"type\":\"message_start\",\"message\":%s}\n\n", intentClaudeJSON)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+		close(canceled)
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(intentContext(t, server, false), 5*time.Second)
+	defer cancel()
+	raw := []byte(`{"model":"intent-custom","max_tokens":1000,"messages":[{"role":"user","content":"hello"}],"thinking":{"type":"adaptive"},"output_config":{"effort":"max"},"tools":[{"name":"lookup","input_schema":{"type":"object"}}],"tool_choice":{"type":"tool","name":"lookup"}}`)
+	executor := NewClaudeExecutor(&config.Config{DisableClaudeCloakMode: true})
+	result, err := executor.ExecuteStream(ctx, &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "fake-intent", "base_url": server.URL}},
+		cliproxyexecutor.Request{Model: "intent-custom", Payload: raw},
+		cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, OriginalRequest: raw})
+	if err != nil {
+		t.Fatal(err)
+	}
+	capture := intentReceive(t, captures)
+	if gjson.GetBytes(capture.body, "thinking").Exists() || gjson.GetBytes(capture.body, "output_config.effort").Exists() {
+		t.Fatalf("forced tool-choice protocol constraint lost: %s", capture.body)
+	}
+	cancel()
+	select {
+	case <-canceled:
+	case <-time.After(2 * time.Second):
+		t.Fatal("upstream cancellation did not propagate")
+	}
+	for range result.Chunks {
+	}
+}
