+func TestNativeIntentCodexOAuthWebSocket(t *testing.T) {
+	captures := make(chan intentCapture, 2)
+	upgrader := websocket.Upgrader{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		_, body, err := conn.ReadMessage()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		captures <- intentCapture{r.URL.Path, r.Header.Clone(), bytes.Clone(body)}
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(intentResponsesJSON))
+	}))
+	defer server.Close()
+	for _, stream := range []bool{false, true} {
+		executor := NewCodexWebsocketsExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}})
+		auth := &cliproxyauth.Auth{ID: "intent-ws", Provider: "codex",
+			Attributes: map[string]string{"auth_kind": "oauth", "base_url": server.URL},
+			Metadata:   map[string]any{"access_token": "fake-ws-subscription", "account_id": "fake-ws-account"}}
+		raw := []byte(`{"model":"gpt-5.4","input":"hello","reasoning":{"effort":"none","summary":"auto"}}`)
+		req := cliproxyexecutor.Request{Model: "gpt-5.4", Payload: raw}
+		opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, OriginalRequest: raw}
+		ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+		if stream {
+			result, err := executor.ExecuteStream(ctx, auth, req, opts)
+			if err != nil {
+				cancel()
+				t.Fatal(err)
+			}
+			for chunk := range result.Chunks {
+				if chunk.Err != nil {
+					cancel()
+					t.Fatal(chunk.Err)
+				}
+			}
+		} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+			cancel()
+			t.Fatal(err)
+		}
+		cancel()
+		capture := intentReceive(t, captures)
+		if capture.header.Get("Authorization") != "Bearer fake-ws-subscription" ||
+			capture.header.Get("Chatgpt-Account-Id") != "fake-ws-account" ||
+			capture.path != "/responses" ||
+			gjson.GetBytes(capture.body, "type").String() != "response.create" ||
+			gjson.GetBytes(capture.body, "reasoning.effort").String() != "none" {
+			t.Fatalf("WebSocket native intent or OAuth identity changed: body=%s", capture.body)
+		}
+	}
+}
