+func TestNativeIntentKimiNativeAndLegacyWireMatrix(t *testing.T) {
+	for _, model := range []string{"kimi-k2.5", "intent-unknown-kimi"} {
+		for _, stream := range []bool{false, true} {
+			for _, tc := range []struct {
+				name, object, legacy, suffix, want string
+			}{
+				{"future", `{"type":"enabled","effort":"ULTRA","keep":"all"}`, "high", "", `{"type":"enabled","effort":"ULTRA","keep":"all"}`},
+				{"future-type", `{"type":"future-native","other":7}`, "high", "", `{"type":"future-native","other":7}`},
+				{"effort-only", `{"effort":"ultra"}`, "high", "", `{"effort":"ultra"}`},
+				{"type-only", `{"type":"enabled"}`, "high", "", `{"type":"enabled"}`},
+				{"disable", `{"type":"disabled"}`, "high", "", `{"type":"disabled"}`},
+				{"keep-conversion", `{"keep":"all"}`, "high", "", `{"keep":"all","type":"enabled","effort":"high"}`},
+				{"keep-only", `{"keep":"all"}`, "", "", `{"keep":"all"}`},
+				{"suffix", `{"type":"enabled","effort":"ultra"}`, "high", "(none)", `{"type":"disabled"}`},
+				{"override", `{"type":"enabled","effort":"ultra"}`, "high", "", `{"type":"disabled"}`},
+				{"filter", `{"type":"enabled","effort":"ultra"}`, "high", "", ""},
+			} {
+				t.Run(fmt.Sprintf("%s/%v/%s", model, stream, tc.name), func(t *testing.T) {
+					captures := make(chan intentCapture, 1)
+					server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						body, _ := io.ReadAll(r.Body)
+						captures <- intentCapture{r.URL.Path, r.Header.Clone(), bytes.Clone(body)}
+						intentReply(w, r.URL.Path, body)
+					}))
+					defer server.Close()
+					cfg := &config.Config{}
+					if tc.name == "override" {
+						cfg.Payload.Override = []config.PayloadRule{{Models: []config.PayloadModelRule{{Name: model}}, Params: map[string]any{"thinking": map[string]any{"type": "disabled"}}}}
+					}
+					if tc.name == "filter" {
+						cfg.Payload.Filter = []config.PayloadFilterRule{{Models: []config.PayloadModelRule{{Name: model}}, Params: []string{"thinking"}}}
+					}
+					legacy := ""
+					if tc.legacy != "" {
+						legacy = `,"reasoning_effort":"` + tc.legacy + `"`
+					}
+					raw := []byte(fmt.Sprintf(`{"model":%q,"stream":%v,"messages":[{"role":"user","content":"hello"}],"thinking":%s%s}`, model+tc.suffix, stream, tc.object, legacy))
+					auth := &cliproxyauth.Auth{Provider: "kimi", Attributes: map[string]string{"auth_kind": "oauth"},
+						Metadata: map[string]any{"access_token": "fake-kimi-native"}}
+					executor := NewKimiExecutor(cfg)
+					req := cliproxyexecutor.Request{Model: model + tc.suffix, Payload: raw}
+					opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI, OriginalRequest: raw}
+					ctx := intentContext(t, server, true)
+					if stream {
+						result, err := executor.ExecuteStream(ctx, auth, req, opts)
+						if err != nil {
+							t.Fatal(err)
+						}
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								t.Fatal(chunk.Err)
+							}
+						}
+					} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+						t.Fatal(err)
+					}
+					capture := intentReceive(t, captures)
+					got := gjson.GetBytes(capture.body, "thinking")
+					if !reflect.DeepEqual(got.Value(), gjson.Parse(tc.want).Value()) {
+						t.Fatalf("native/legacy boundary changed: want=%s body=%s", tc.want, capture.body)
+					}
+					if gjson.GetBytes(capture.body, "reasoning_effort").Exists() || capture.path != "/coding/v1/chat/completions" ||
+						capture.header.Get("Authorization") != "Bearer fake-kimi-native" ||
+						gjson.GetBytes(capture.body, "model").String() != normalizeKimiUpstreamModel(model) {
+						t.Fatalf("Kimi wire or identity changed: %s", capture.body)
+					}
+				})
+			}
+		}
+	}
+}
