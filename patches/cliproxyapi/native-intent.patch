+func TestNativeIntentOAuthHTTPAndDialects(t *testing.T) {
+	for _, tc := range []struct {
+		name, provider, from, model, controls, path, field, want string
+	}{
+		{"claude-oauth", "claude", "claude", "claude-3-5-haiku-20241022", `"thinking":{"type":"adaptive"},"output_config":{"effort":"max"}`, "/v1/messages", "output_config.effort", "max"},
+		{"codex-oauth", "codex", "openai-response", "gpt-5.4", `"reasoning":{"effort":"none","summary":"auto"}`, "/responses", "reasoning.effort", "none"},
+		{"codex-oauth-unknown-conversion", "codex", "claude", "unknown-oauth", `"thinking":{"type":"adaptive"},"output_config":{"effort":"max"}`, "/responses", "reasoning.effort", "max"},
+		{"kimi-messages", "kimi", "claude", "kimi-k2.5", `"thinking":{"type":"adaptive"},"output_config":{"effort":"max"}`, "/coding/v1/messages", "output_config.effort", "max"},
+		{"kimi-chat-negative", "kimi", "openai", "kimi-k2.5", `"thinking":{"type":"disabled"},"reasoning_effort":"high"`, "/coding/v1/chat/completions", "thinking.type", "disabled"},
+		{"kimi-chat-conversion", "kimi", "openai", "kimi-k2.5", `"reasoning_effort":"high"`, "/coding/v1/chat/completions", "thinking.effort", "high"},
+		{"kimi-native-positive", "kimi", "openai", "kimi-k2.5", `"thinking":{"type":"enabled","effort":"ultra","keep":"all"},"reasoning_effort":"high"`, "/coding/v1/chat/completions", "thinking.effort", "ultra"},
+		{"xai-responses", "xai", "openai-response", "grok-4", `"reasoning":{"effort":"ultra"}`, "/responses", "reasoning.effort", "ultra"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			captures := make(chan intentCapture, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				captures <- intentCapture{r.URL.Path, r.Header.Clone(), bytes.Clone(body)}
+				intentReply(w, r.URL.Path, body)
+			}))
+			defer server.Close()
+			cfg := &config.Config{DisableClaudeCloakMode: true, SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}}
+			var executor cliproxyauth.ProviderExecutor
+			switch tc.provider {
+			case "claude":
+				executor = NewClaudeExecutor(cfg)
+			case "codex":
+				executor = NewCodexExecutor(cfg)
+			case "kimi":
+				executor = NewKimiExecutor(cfg)
+			case "xai":
+				executor = NewXAIExecutor(cfg)
+			}
+			token := "fake-oauth-intent"
+			auth := &cliproxyauth.Auth{ID: tc.name, Provider: tc.provider,
+				Attributes: map[string]string{"auth_kind": "oauth", "base_url": server.URL},
+				Metadata:   map[string]any{"access_token": token, "account_id": "fake-account"}}
+			if tc.provider == "claude" {
+				token = "sk-ant-oat-fake-intent"
+				auth.Attributes["api_key"] = token
+				auth.Metadata["account_uuid"] = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
+				auth.Metadata[claudeauth.ClaudeDeviceIDsMetadataKey] = []string{strings.Repeat("0", 64)}
+			}
+			if tc.provider == "xai" || tc.provider == "kimi" {
+				auth.Attributes["api_key"] = token
+			}
+			raw := []byte(`{"model":"` + tc.model + `","max_tokens":1000,"messages":[{"role":"user","content":"hello"}],"input":"hello",` + tc.controls + `}`)
+			from := sdktranslator.FromString(tc.from)
+			ctx := intentContext(t, server, tc.provider == "kimi")
+			if _, err := executor.Execute(ctx, auth, cliproxyexecutor.Request{Model: tc.model, Payload: raw},
+				cliproxyexecutor.Options{SourceFormat: from, OriginalRequest: raw}); err != nil {
+				t.Fatal(err)
+			}
+			capture := intentReceive(t, captures)
+			if capture.path != tc.path || gjson.GetBytes(capture.body, tc.field).String() != tc.want {
+				t.Fatalf("dialect changed: path=%s body=%s", capture.path, capture.body)
+			}
+			if capture.header.Get("Authorization") != "Bearer "+token && capture.header.Get("X-Api-Key") != token {
+				t.Fatal("selected fake subscription credential was not used")
+			}
+			if tc.provider == "codex" && capture.header.Get("Chatgpt-Account-Id") != "fake-account" {
+				t.Fatal("Codex OAuth account identity lost")
+			}
+			if tc.from == "openai" && tc.provider == "kimi" && gjson.GetBytes(capture.body, "reasoning_effort").Exists() {
+				t.Fatal("Kimi dialect was conflated with Chat reasoning_effort")
+			}
+		})
+	}
+}
