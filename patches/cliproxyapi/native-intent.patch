+func TestNativeIntentManagerExactSnapshotAndReplacement(t *testing.T) {
+	captures := make(chan intentCapture, 8)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		captures <- intentCapture{r.URL.Path, r.Header.Clone(), bytes.Clone(body)}
+		intentReply(w, r.URL.Path, body)
+	}))
+	defer server.Close()
+	ctx := intentContext(t, server, false)
+	cfg := &config.Config{SDKConfig: config.SDKConfig{ForceModelPrefix: true}, DisableClaudeCloakMode: true}
+	manager := cliproxyauth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(NewClaudeExecutor(cfg))
+	auths := make([]*cliproxyauth.Auth, 2)
+	reg := registry.GetGlobalRegistry()
+	for i, level := range []string{"high", "max"} {
+		prefix, key := fmt.Sprintf("intent-source-%d", i), fmt.Sprintf("fake-intent-key-%d", i)
+		cfg.ClaudeKey = append(cfg.ClaudeKey, config.ClaudeKey{
+			APIKey: key, Prefix: prefix, BaseURL: server.URL,
+			Models: []config.ClaudeModel{{Name: "shared-intent-upstream", Alias: "public-alias",
+				Thinking: &registry.ThinkingSupport{Levels: []string{level}}}},
+		})
+		auth := &cliproxyauth.Auth{ID: prefix, Provider: "claude", Prefix: prefix, Attributes: map[string]string{
+			"auth_kind": "api_key", "api_key": key, "base_url": server.URL,
+			"source": fmt.Sprintf("config:claude[%d]", i),
+		}}
+		auths[i] = auth
+		reg.RegisterClient(auth.ID, "claude", []*registry.ModelInfo{{
+			ID: prefix + "/public-alias", Type: "claude",
+		}})
+		t.Cleanup(func() { reg.UnregisterClient(auth.ID) })
+	}
+	manager.SetConfig(cfg)
+	for _, auth := range auths {
+		if _, err := manager.Register(ctx, auth); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// An unrelated aggregate must not replace the selected private snapshot.
+	reg.RegisterClient("intent-unrelated", "claude", []*registry.ModelInfo{{
+		ID: "shared-intent-upstream", Type: "claude", Thinking: &registry.ThinkingSupport{Levels: []string{"low"}},
+	}})
+	t.Cleanup(func() { reg.UnregisterClient("intent-unrelated") })
+	check := func(index int, native, stream bool, want string) {
+		t.Helper()
+		auth := auths[index]
+		model := auth.Prefix + "/public-alias"
+		raw := []byte(`{"model":"` + model + `","input":"hello","reasoning":{"effort":"xhigh"}}`)
+		from := sdktranslator.FormatOpenAIResponse
+		if native {
+			raw = []byte(`{"model":"` + model + `","messages":[{"role":"user","content":"hello"}],"max_tokens":1000,"thinking":{"type":"adaptive"},"output_config":{"effort":"ultra"}}`)
+			from = sdktranslator.FormatClaude
+		}
+		req := cliproxyexecutor.Request{Model: model, Payload: raw, Format: from}
+		opts := cliproxyexecutor.Options{SourceFormat: from, OriginalRequest: raw, Headers: http.Header{"Authorization": {"Bearer fake-inbound"}}}
+		if stream {
+			result, err := manager.ExecuteStream(ctx, []string{"claude"}, req, opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for chunk := range result.Chunks {
+				if chunk.Err != nil {
+					t.Fatal(chunk.Err)
+				}
+			}
+		} else if _, err := manager.Execute(ctx, []string{"claude"}, req, opts); err != nil {
+			t.Fatal(err)
+		}
+		capture := intentReceive(t, captures)
+		correctKey := capture.header.Get("X-Api-Key") == auth.Attributes["api_key"] ||
+			capture.header.Get("Authorization") == "Bearer "+auth.Attributes["api_key"]
+		if capture.path != "/v1/messages" || !correctKey ||
+			capture.header.Get("Authorization") == "Bearer fake-inbound" ||
+			gjson.GetBytes(capture.body, "model").String() != "shared-intent-upstream" ||
+			gjson.GetBytes(capture.body, "output_config.effort").String() != want {
+			t.Fatalf("selected snapshot, alias, or credential lost: %+v body=%s", capture, capture.body)
+		}
+	}
+	for _, stream := range []bool{false, true} {
+		check(0, false, stream, "high")
+		check(1, false, stream, "max")
+		check(0, true, stream, "ultra")
+	}
+	replacement := *cfg
+	replacement.ClaudeKey = append([]config.ClaudeKey(nil), cfg.ClaudeKey...)
+	replacement.ClaudeKey[0].APIKey = "fake-intent-replacement"
+	replacement.ClaudeKey[0].Models = []config.ClaudeModel{{
+		Name: "shared-intent-upstream", Alias: "public-alias", Thinking: &registry.ThinkingSupport{Levels: []string{"max"}},
+	}}
+	manager.SetConfig(&replacement)
+	auths[0] = auths[0].Clone()
+	auths[0].Attributes["api_key"] = "fake-intent-replacement"
+	if _, err := manager.Update(ctx, auths[0]); err != nil {
+		t.Fatal(err)
+	}
+	for _, stream := range []bool{false, true} {
+		check(0, false, stream, "max")
+		check(1, false, stream, "max")
+	}
+}
