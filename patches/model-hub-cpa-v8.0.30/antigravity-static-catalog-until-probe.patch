 func TestAntigravityModelRegistration_AsyncNonBlocking(t *testing.T) {
+	static := registry.GetAntigravityModels()
+	if len(static) < 2 {
+		t.Fatalf("static Antigravity catalog has %d models, want at least 2", len(static))
+	}
+	entitled := static[0].ID
+	release := make(chan struct{})
 	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		select {
 		case <-r.Context().Done():
 			return
-		case <-time.After(10 * time.Second):
+		case <-release:
 		}
+		_, _ = w.Write([]byte(`{"models":{"` + entitled + `":{}}}`))
 	}))
 	t.Cleanup(func() {
 		server.CloseClientConnections()
@@ -101,9 +110,21 @@ func TestAntigravityModelRegistration_AsyncNonBlocking(t *testing.T) {
 		t.Fatalf("registerModelsForAuth took %v, want non-blocking < 500ms", elapsed)
 	}
 
-	models := GlobalModelRegistry().GetModelsForClient(auth.ID)
-	if len(models) != 0 {
-		t.Fatal("unverified models registered before probe completed")
+	if got := len(GlobalModelRegistry().GetModelsForClient(auth.ID)); got != len(static) {
+		t.Fatalf("registered %d models before the probe answered, want the static %d", got, len(static))
+	}
+
+	close(release)
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		models := GlobalModelRegistry().GetModelsForClient(auth.ID)
+		if len(models) == 1 && models[0].ID == entitled {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("probe did not narrow the static catalog: %d models registered", len(models))
+		}
+		time.Sleep(20 * time.Millisecond)
 	}
 }
 
