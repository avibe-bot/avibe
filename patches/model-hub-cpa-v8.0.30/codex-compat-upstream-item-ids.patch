+
+// xAI issues input item IDs over the Codex limit: in a real X search turn the tool-call
+// reasoning (tco_) and custom tool call (ctc_) are 84 runes and share a <turn>_<call> suffix,
+// and a web search call (ws_) is 83. A compat model gets every such ID back verbatim; other
+// item types are covered too, since the rule is the ID's length, not its type.
+var overlongUpstreamItems = []struct {
+	name string
+	item string
+	id   string
+}{
+	{"reasoning", `{"type":"reasoning","id":"%s","summary":[],"encrypted_content":"xai-opaque"}`,
+		"tco_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789ab"},
+	{"custom_tool_call", `{"type":"custom_tool_call","id":"%s","call_id":"xs_call-1","name":"x_keyword_search","input":"{}"}`,
+		"ctc_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789ab"},
+	{"web_search_call", `{"type":"web_search_call","id":"%s","status":"completed"}`,
+		"ws_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789abc"},
+	{"function_call", `{"type":"function_call","id":"%s","call_id":"call_1","name":"read","arguments":"{}"}`,
+		"fc_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789abc"},
+	{"message", `{"type":"message","id":"%s","role":"assistant"}`,
+		"msg_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789ab"},
+}
+
+func overlongUpstreamBody(item, id string) []byte {
+	return []byte(`{"input":[` + fmt.Sprintf(item, id) +
+		`,{"type":"function_call","id":"call_2","call_id":"call_2","name":"read","arguments":"{}"}]}`)
+}
+
+func TestSanitizeCodexInputItemIDsWithCompatKeepsUpstreamIDsOverTheLimitVerbatim(t *testing.T) {
+	for _, tc := range overlongUpstreamItems {
+		t.Run(tc.name, func(t *testing.T) {
+			if len([]rune(tc.id)) <= codexInputItemIDLimit {
+				t.Fatalf("fixture ID is %d runes, want over %d", len([]rune(tc.id)), codexInputItemIDLimit)
+			}
+			body := overlongUpstreamBody(tc.item, tc.id)
+
+			got := SanitizeCodexInputItemIDsWithCompat(body, true)
+
+			items := gjson.GetBytes(got, "input").Array()
+			if len(items) != 2 || items[0].Raw != gjson.GetBytes(body, "input.0").Raw {
+				t.Fatalf("upstream item not kept verbatim: %s", got)
+			}
+			// IDs within the limit are normalized as before.
+			if actual := items[1].Get("id").String(); actual != "fc_call_2" {
+				t.Fatalf("short function_call ID = %q, want fc_call_2", actual)
+			}
+		})
+	}
+}
+
+func TestSanitizeCodexInputItemIDsWithoutCompatIsUnchanged(t *testing.T) {
+	for _, tc := range overlongUpstreamItems {
+		t.Run(tc.name, func(t *testing.T) {
+			body := overlongUpstreamBody(tc.item, tc.id)
+
+			got := SanitizeCodexInputItemIDsWithCompat(body, false)
+
+			if string(got) != string(SanitizeCodexInputItemIDs(body)) {
+				t.Fatalf("without compat the result differs from SanitizeCodexInputItemIDs:\n%s\n%s", got, SanitizeCodexInputItemIDs(body))
+			}
+			items := gjson.GetBytes(got, "input").Array()
+			if tc.name == "reasoning" {
+				if len(items) != 1 {
+					t.Fatalf("overlong encrypted reasoning not removed: %s", got)
+				}
+				return
+			}
+			actual := items[0].Get("id").String()
+			if len([]rune(actual)) != codexInputItemIDLimit || actual == tc.id {
+				t.Fatalf("ID = %q, want %q shortened to %d runes", actual, tc.id, codexInputItemIDLimit)
+			}
+		})
+	}
+}
