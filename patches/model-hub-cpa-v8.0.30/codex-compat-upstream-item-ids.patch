+func TestCodexExecutorExecuteStreamKeepsUpstreamIDsOverTheLimitForCompatModel(t *testing.T) {
+	// A real xAI X search turn: the tool-call reasoning and its custom tool call share a
+	// <turn>_<call> suffix and are 84 runes each, over the Codex ID limit.
+	const (
+		toolReasoningID = "tco_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789ab"
+		customToolID    = "ctc_6b0014d0-e12f-9b38-ac33-4df9412f3045_call-fbb80085-357f-4d3e-b850-0123456789ab"
+	)
+	for _, isCompat := range []bool{true, false} {
+		var gotBody []byte
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			body, errRead := io.ReadAll(r.Body)
+			if errRead != nil {
+				t.Fatalf("read body: %v", errRead)
+			}
+			gotBody = body
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = w.Write([]byte("data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_1\",\"object\":\"response\",\"created_at\":0,\"status\":\"completed\",\"background\":false,\"error\":null}}\n\n"))
+		}))
+
+		cfg := &config.Config{
+			CodexKey: []config.CodexKey{{
+				APIKey:  "test-api-key",
+				BaseURL: server.URL,
+				Models:  []config.CodexModel{{Name: "grok-4.6", Alias: "grok-4.6", IsCompat: isCompat}},
+			}},
+		}
+		executor := NewCodexExecutor(cfg)
+		auth := &cliproxyauth.Auth{
+			Provider:   "codex",
+			Attributes: map[string]string{"base_url": server.URL, "api_key": "test-api-key"},
+		}
+		payload := []byte(`{"model":"grok-4.6","stream":true,"store":false,"input":[` +
+			`{"type":"reasoning","id":"` + toolReasoningID + `","summary":[],"encrypted_content":"xai-opaque-ciphertext"},` +
+			`{"type":"custom_tool_call","id":"` + customToolID + `","call_id":"xs_call-1","name":"x_keyword_search","input":"{}"},` +
+			`{"role":"user","content":[{"type":"input_text","text":"again"}]}` +
+			`]}`)
+
+		streamResult, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+			Model:   "grok-4.6",
+			Payload: payload,
+		}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), Stream: true})
+		if err != nil {
+			t.Fatalf("isCompat=%v: ExecuteStream error: %v", isCompat, err)
+		}
+		for range streamResult.Chunks {
+		}
+		server.Close()
+
+		input := gjson.GetBytes(gotBody, "input").Array()
+		if isCompat {
+			if len(input) != 3 || input[0].Get("id").String() != toolReasoningID ||
+				input[0].Get("encrypted_content").String() != "xai-opaque-ciphertext" ||
+				input[1].Get("id").String() != customToolID {
+				t.Fatalf("compat model: xAI-issued IDs not replayed verbatim: %s", gotBody)
+			}
+			continue
+		}
+		// Without compat: the foreign ciphertext and the overlong reasoning ID go, and the
+		// custom tool call's ID is shortened to the Codex limit, as before.
+		if len(input) != 3 || input[0].Get("encrypted_content").Exists() || input[0].Get("id").Exists() {
+			t.Fatalf("non-compat model: reasoning not stripped as before: %s", gotBody)
+		}
+		if id := input[1].Get("id").String(); len([]rune(id)) != 64 || id == customToolID {
+			t.Fatalf("non-compat model: custom tool call ID = %q, want it shortened to 64 runes", id)
+		}
+	}
+}
