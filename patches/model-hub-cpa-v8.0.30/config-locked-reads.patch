diff --git a/internal/config/config_write.go b/internal/config/config_write.go
new file mode 100644
index 000000000..ea6f7315f
--- /dev/null
+++ b/internal/config/config_write.go
@@ -0,0 +1,37 @@
+package config
+
+import (
+	"os"
+	"sync"
+)
+
+// configFileMu orders config file writes against reads within this process, so
+// a reader such as the config watcher never sees a truncated or half-written file.
+var configFileMu sync.RWMutex
+
+// ReadConfigFile reads a config file. It never overlaps a WriteConfigFile call,
+// so it returns either the previous or the new content of a concurrent write.
+func ReadConfigFile(path string) ([]byte, error) {
+	configFileMu.RLock()
+	defer configFileMu.RUnlock()
+	return os.ReadFile(path)
+}
+
+// WriteConfigFile rewrites a config file and syncs it to disk. The file is
+// written in place to keep the inode of a mounted configuration file.
+func WriteConfigFile(path string, data []byte, perm os.FileMode) error {
+	configFileMu.Lock()
+	defer configFileMu.Unlock()
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, perm)
+	if err != nil {
+		return err
+	}
+	_, err = f.Write(data)
+	if err == nil {
+		err = f.Sync()
+	}
+	if errClose := f.Close(); err == nil {
+		err = errClose
+	}
+	return err
+}
diff --git a/internal/config/config_write_test.go b/internal/config/config_write_test.go
new file mode 100644
index 000000000..dba45497b
--- /dev/null
+++ b/internal/config/config_write_test.go
@@ -0,0 +1,37 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestWriteConfigFileKeepsInode(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte("port: 8001\n"), 0o640); err != nil {
+		t.Fatalf("write config: %v", err)
+	}
+	before, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("stat config: %v", err)
+	}
+
+	if err = WriteConfigFile(path, []byte("port: 8002\n"), 0o600); err != nil {
+		t.Fatalf("WriteConfigFile: %v", err)
+	}
+
+	after, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("stat config: %v", err)
+	}
+	if !os.SameFile(before, after) {
+		t.Fatal("WriteConfigFile replaced the config file")
+	}
+	data, err := ReadConfigFile(path)
+	if err != nil {
+		t.Fatalf("read config: %v", err)
+	}
+	if string(data) != "port: 8002\n" {
+		t.Fatalf("config = %q, want the new content", data)
+	}
+}
diff --git a/internal/config/config_write_unix_test.go b/internal/config/config_write_unix_test.go
new file mode 100644
index 000000000..4dc438b71
--- /dev/null
+++ b/internal/config/config_write_unix_test.go
@@ -0,0 +1,74 @@
+//go:build unix
+
+package config
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+// A named pipe parks a read or a write inside the file I/O, so the test can check,
+// without timing, that the other side cannot start until it finishes.
+func TestConfigFileReadsAndWritesExcludeEachOther(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := syscall.Mkfifo(path, 0o600); err != nil {
+		t.Fatalf("mkfifo: %v", err)
+	}
+
+	read := make(chan error, 1)
+	go func() {
+		_, err := ReadConfigFile(path)
+		read <- err
+	}()
+	// Opening the write end returns once the reader has opened the pipe, and the
+	// reader then waits for data inside ReadConfigFile.
+	pipe, err := os.OpenFile(path, os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatalf("open pipe for writing: %v", err)
+	}
+	if configFileMu.TryLock() {
+		configFileMu.Unlock()
+		t.Error("a write could start while a read was in progress")
+	}
+	if _, err = pipe.Write([]byte("port: 8001\n")); err != nil {
+		t.Fatalf("write pipe: %v", err)
+	}
+	if err = pipe.Close(); err != nil {
+		t.Fatalf("close pipe: %v", err)
+	}
+	if err = <-read; err != nil {
+		t.Fatalf("ReadConfigFile: %v", err)
+	}
+
+	written := make(chan error, 1)
+	// More than a pipe buffer holds, so the writer stays inside WriteConfigFile
+	// until the test drains the pipe.
+	data := bytes.Repeat([]byte("# padding\n"), 1<<17)
+	go func() {
+		written <- WriteConfigFile(path, data, 0o600)
+	}()
+	pipe, err = os.Open(path)
+	if err != nil {
+		t.Fatalf("open pipe for reading: %v", err)
+	}
+	if configFileMu.TryRLock() {
+		configFileMu.RUnlock()
+		t.Error("a read could start while a write was in progress")
+	}
+	got, err := io.ReadAll(pipe)
+	if err != nil {
+		t.Fatalf("read pipe: %v", err)
+	}
+	if err = pipe.Close(); err != nil {
+		t.Fatalf("close pipe: %v", err)
+	}
+	if !bytes.Equal(got, data) {
+		t.Fatalf("pipe carried %d bytes, want %d", len(got), len(data))
+	}
+	// A pipe cannot be synced, so the write reports an error after writing.
+	<-written
+}
