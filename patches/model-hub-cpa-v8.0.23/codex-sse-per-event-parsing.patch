diff --git a/internal/runtime/executor/codex_sse_events.go b/internal/runtime/executor/codex_sse_events.go
new file mode 100644
index 00000000..48bb5e49
--- /dev/null
+++ b/internal/runtime/executor/codex_sse_events.go
@@ -0,0 +1,212 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strconv"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+)
+
+// codexSSEDiagnosticLines caps how many data lines one invalid-event diagnostic describes.
+const codexSSEDiagnosticLines = 8
+
+// codexSSEScanner reads an upstream Responses SSE stream line by line, as bufio.Scanner does, but
+// delivers an event whose data an upstream split across several "data:" lines as one "data:" line.
+// In SSE an event's data may span several data lines, joined with "\n". Taking each data line as a
+// whole event instead cuts such an event: on a split response.completed the stream ends at the
+// first fragment and the rest is never read.
+//
+// Every event this path carries is one JSON value, so a data line that is complete JSON on its own,
+// or cannot start JSON at all (an empty value, [DONE]), is delivered byte-for-byte as read with no
+// lookahead; this also keeps upstreams that omit the blank line between events working as before.
+// A data line that starts a JSON object or array but is not yet complete JSON starts an event that
+// collects the following data lines until their joined value closes its outermost object or array,
+// a blank line ends the event, the stream ends, a data line that is a complete JSON object on its own starts the next
+// event, or the collected bytes would exceed the scanner's line limit. A completed event is
+// delivered compacted onto one line. One that never becomes valid JSON is delivered as the same
+// multi-line data field, so it still fails downstream, and one warning describes its framing
+// without any of its bytes. Other lines pass through in order.
+type codexSSEScanner struct {
+	ctx      context.Context
+	lines    *bufio.Scanner
+	maxBytes int
+	queue    [][]byte
+	current  []byte
+}
+
+func newCodexSSEScanner(ctx context.Context, r io.Reader, maxBytes int) *codexSSEScanner {
+	lines := bufio.NewScanner(r)
+	lines.Buffer(nil, maxBytes)
+	return &codexSSEScanner{ctx: ctx, lines: lines, maxBytes: maxBytes}
+}
+
+// Scan advances to the next line, or to the next assembled event data line.
+func (s *codexSSEScanner) Scan() bool {
+	if len(s.queue) > 0 {
+		s.current, s.queue = s.queue[0], s.queue[1:]
+		return true
+	}
+	if !s.lines.Scan() {
+		return false
+	}
+	line := s.lines.Bytes()
+	if !bytes.HasPrefix(line, dataTag) || !codexSSEIncompleteJSON(bytes.TrimSpace(line[len(dataTag):])) {
+		s.current = line
+		return true
+	}
+	// An incomplete event: collect its continuation. The underlying scanner reuses its buffer, so keep copies.
+	data := [][]byte{bytes.Clone(line)}
+	joined := bytes.Clone(codexSSEValue(line))
+	var nesting codexJSONNesting
+	closed := nesting.feed(joined)
+	var rest [][]byte
+	size := len(line)
+	for !closed && s.lines.Scan() {
+		next := s.lines.Bytes()
+		if len(next) == 0 {
+			rest = append(rest, []byte{})
+			break
+		}
+		if size+len(next) > s.maxBytes {
+			// Bounded like a single line: stop collecting and let the next line be read on its own.
+			rest = append(rest, bytes.Clone(next))
+			break
+		}
+		size += len(next)
+		if !bytes.HasPrefix(next, dataTag) {
+			rest = append(rest, bytes.Clone(next))
+			continue
+		}
+		if value := bytes.TrimSpace(next[len(dataTag):]); bytes.HasPrefix(value, []byte("{")) && json.Valid(value) {
+			// A complete object of its own is the next event of an upstream that sends no blank lines.
+			rest = append(rest, bytes.Clone(next))
+			break
+		}
+		data = append(data, bytes.Clone(next))
+		value := codexSSEValue(next)
+		joined = append(append(joined, '\n'), value...)
+		closed = nesting.feed([]byte{'\n'}) || nesting.feed(value)
+	}
+	s.current = s.assemble(data, joined)
+	s.queue = rest
+	return true
+}
+
+// codexSSEValue is one data line's value: the text after "data:" without the one leading space.
+func codexSSEValue(line []byte) []byte {
+	return bytes.TrimPrefix(line[len(dataTag):], []byte(" "))
+}
+
+// codexSSEClosed reports whether joined event data is complete JSON. Only a value that now ends
+// with a closing bracket can have become complete, so other values are not re-validated.
+func codexSSEClosed(joined []byte) bool {
+	trimmed := bytes.TrimRight(joined, " \t\r\n")
+	if len(trimmed) == 0 || (trimmed[len(trimmed)-1] != '}' && trimmed[len(trimmed)-1] != ']') {
+		return false
+	}
+	return json.Valid(joined)
+}
+
+// codexSSEIncompleteJSON reports whether one data line's value starts a JSON object or array that
+// it does not complete. Values that cannot start JSON, such as an empty value or [DONE], are not.
+func codexSSEIncompleteJSON(value []byte) bool {
+	if len(value) == 0 || (value[0] != '{' && value[0] != '[') || bytes.Equal(value, []byte("[DONE]")) {
+		return false
+	}
+	return !codexSSEClosed(value)
+}
+
+// codexJSONNesting follows the nesting of a JSON text fed in pieces, so an event split across many
+// data lines is validated once, when its outermost object or array closes, not after every piece.
+type codexJSONNesting struct {
+	depth    int
+	inString bool
+	escaped  bool
+}
+
+// feed consumes p and reports whether the outermost object or array closed within it.
+func (n *codexJSONNesting) feed(p []byte) bool {
+	for _, c := range p {
+		switch {
+		case n.inString:
+			switch {
+			case n.escaped:
+				n.escaped = false
+			case c == '\\':
+				n.escaped = true
+			case c == '"':
+				n.inString = false
+			}
+		case c == '"':
+			n.inString = true
+		case c == '{' || c == '[':
+			n.depth++
+		case c == '}' || c == ']':
+			n.depth--
+			if n.depth <= 0 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// Bytes returns the current line. It stays valid until the next call to Scan.
+func (s *codexSSEScanner) Bytes() []byte { return s.current }
+
+// Err returns the error that stopped the scan, as bufio.Scanner does.
+func (s *codexSSEScanner) Err() error { return s.lines.Err() }
+
+func (s *codexSSEScanner) assemble(lines [][]byte, joined []byte) []byte {
+	if len(lines) == 1 {
+		s.diagnose(lines, bytes.TrimSpace(joined))
+		return lines[0]
+	}
+	if json.Valid(joined) {
+		var compacted bytes.Buffer
+		compacted.Grow(len(dataTag) + 1 + len(joined))
+		compacted.Write(dataTag)
+		compacted.WriteByte(' ')
+		if errCompact := json.Compact(&compacted, joined); errCompact == nil {
+			return compacted.Bytes()
+		}
+	}
+	s.diagnose(lines, joined)
+	return bytes.Join(lines, []byte("\n"))
+}
+
+// diagnose logs one bounded warning when an event's data is not valid JSON: how many data lines
+// carried it, each line's length and whether it is valid on its own, and where the joined data
+// fails to parse. It never logs data bytes.
+func (s *codexSSEScanner) diagnose(lines [][]byte, data []byte) {
+	if len(data) == 0 || bytes.Equal(data, []byte("[DONE]")) || json.Valid(data) {
+		return
+	}
+	offset := int64(-1)
+	var syntaxErr *json.SyntaxError
+	if errors.As(json.Unmarshal(data, new(json.RawMessage)), &syntaxErr) {
+		offset = syntaxErr.Offset
+	}
+	shown := min(len(lines), codexSSEDiagnosticLines)
+	lengths := make([]string, shown)
+	valid := make([]string, shown)
+	for i := range shown {
+		value := bytes.TrimSpace(lines[i][len(dataTag):])
+		lengths[i] = strconv.Itoa(len(value))
+		valid[i] = strconv.FormatBool(json.Valid(value))
+	}
+	more := ""
+	if len(lines) > shown {
+		more = ",+" + strconv.Itoa(len(lines)-shown)
+	}
+	helps.LogWithRequestID(s.ctx).Warnf(
+		"codex executor: upstream SSE event data is not valid JSON: data_lines=%d line_bytes=[%s%s] lines_valid=[%s%s] data_bytes=%d json_error_offset=%d",
+		len(lines), strings.Join(lengths, ","), more, strings.Join(valid, ","), more, len(data), offset,
+	)
+}
diff --git a/internal/runtime/executor/codex_sse_events_test.go b/internal/runtime/executor/codex_sse_events_test.go
new file mode 100644
index 00000000..47711d2b
--- /dev/null
+++ b/internal/runtime/executor/codex_sse_events_test.go
@@ -0,0 +1,330 @@
+package executor
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+	logtest "github.com/sirupsen/logrus/hooks/test"
+)
+
+func captureCodexSSEWarnings(t *testing.T) *logtest.Hook {
+	t.Helper()
+	hook := new(logtest.Hook)
+	log.StandardLogger().AddHook(hook)
+	t.Cleanup(func() { log.StandardLogger().ReplaceHooks(make(log.LevelHooks)) })
+	return hook
+}
+
+func scanCodexSSE(t *testing.T, stream string) []string {
+	t.Helper()
+	scanner := newCodexSSEScanner(context.Background(), strings.NewReader(stream), 1<<20)
+	var lines []string
+	for scanner.Scan() {
+		lines = append(lines, string(scanner.Bytes()))
+	}
+	if errScan := scanner.Err(); errScan != nil {
+		t.Fatalf("scan error: %v", errScan)
+	}
+	return lines
+}
+
+func TestCodexSSEScannerAssemblesEventData(t *testing.T) {
+	const marker = "body-bytes-must-not-be-logged"
+	cases := []struct {
+		name     string
+		stream   string
+		want     []string
+		warnings int
+	}{
+		{
+			name:   "one-line events pass through as read",
+			stream: "event: response.created\ndata: {\"type\":\"response.created\"}\n\n: keep-alive\n\ndata: {\"type\":\"x\",\"v\":\"a b\"}\n\n",
+			want:   []string{"event: response.created", `data: {"type":"response.created"}`, "", ": keep-alive", "", `data: {"type":"x","v":"a b"}`, ""},
+		},
+		{
+			name:   "CRLF line endings",
+			stream: "event: a\r\ndata: {\"type\":\"a\"}\r\n\r\n",
+			want:   []string{"event: a", `data: {"type":"a"}`, ""},
+		},
+		{
+			name:   "data lines of one event are joined and compacted",
+			stream: "event: response.completed\ndata: {\"type\":\"response.completed\",\ndata: \"response\":{\"id\":\"r\",\"output\":[]}}\n\n",
+			want:   []string{"event: response.completed", `data: {"type":"response.completed","response":{"id":"r","output":[]}}`, ""},
+		},
+		{
+			name:   "joined CRLF event",
+			stream: "data: {\"a\":\r\ndata: [1,\r\ndata: 2]}\r\n\r\n",
+			want:   []string{`data: {"a":[1,2]}`, ""},
+		},
+		{
+			name:   "comment and field lines inside an event follow its data",
+			stream: "data: {\"a\":\n: keep-alive\nid: 7\ndata: 1}\n\n",
+			want:   []string{`data: {"a":1}`, ": keep-alive", "id: 7", ""},
+		},
+		{
+			name:   "unterminated one-line event at end of stream",
+			stream: "data: {\"type\":\"response.completed\"}",
+			want:   []string{`data: {"type":"response.completed"}`},
+		},
+		{
+			name:   "unterminated multi-line event at end of stream",
+			stream: "data: {\"type\":\ndata: \"response.completed\"}\n",
+			want:   []string{`data: {"type":"response.completed"}`},
+		},
+		{
+			name:   "complete events without blank separators stay separate",
+			stream: "data: {\"a\":1}\ndata: {\"b\":2}\n",
+			want:   []string{`data: {"a":1}`, `data: {"b":2}`},
+		},
+		{
+			name:   "split event followed by an event without a blank separator",
+			stream: "data: {\"a\":\ndata: 1}\ndata: {\"b\":2}\n",
+			want:   []string{`data: {"a":1}`, `data: {"b":2}`},
+		},
+		{
+			name:     "invalid fragment followed by a complete event without a blank separator",
+			stream:   "data: {\"a\":\"" + marker + "\ndata: {\"b\":2}\n\n",
+			want:     []string{`data: {"a":"` + marker, `data: {"b":2}`, ""},
+			warnings: 1,
+		},
+		{
+			name:     "unterminated incomplete event at end of stream is still delivered",
+			stream:   "data: {\"type\":\"response.completed\",\"t\":\"" + marker + "\",",
+			want:     []string{`data: {"type":"response.completed","t":"` + marker + `",`},
+			warnings: 1,
+		},
+		{
+			name:   "empty and non-JSON data lines take the stock path",
+			stream: "data:\n\ndata: \n\ndata: ping\n\n",
+			want:   []string{"data:", "", "data: ", "", "data: ping", ""},
+		},
+		{
+			name:   "done sentinel",
+			stream: "data: [DONE]\n\n",
+			want:   []string{"data: [DONE]", ""},
+		},
+		{
+			name:     "invalid one-line event passes through with one warning",
+			stream:   "data: {\"type\":\"response.completed\",\"t\":\"" + marker + "\",\n\n",
+			want:     []string{`data: {"type":"response.completed","t":"` + marker + `",`, ""},
+			warnings: 1,
+		},
+		{
+			name:     "event split inside a string stays invalid and keeps its data lines",
+			stream:   "data: {\"t\":\"" + marker + "\ndata: " + marker + "\"}\n\n",
+			want:     []string{`data: {"t":"` + marker + "\ndata: " + marker + `"}`, ""},
+			warnings: 1,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			hook := captureCodexSSEWarnings(t)
+			got := scanCodexSSE(t, tc.stream)
+			if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", tc.want) {
+				t.Fatalf("lines = %q\nwant    %q", got, tc.want)
+			}
+			if len(hook.AllEntries()) != tc.warnings {
+				t.Fatalf("warnings = %d, want %d", len(hook.AllEntries()), tc.warnings)
+			}
+			for _, entry := range hook.AllEntries() {
+				message, errMessage := entry.String()
+				if errMessage != nil {
+					t.Fatal(errMessage)
+				}
+				if entry.Level != log.WarnLevel || strings.Contains(message, marker) || !strings.Contains(message, "data_lines=") || !strings.Contains(message, "json_error_offset=") {
+					t.Fatalf("diagnostic = %q, want a bounded warning without data bytes", message)
+				}
+			}
+		})
+	}
+}
+
+func TestCodexSSEScannerBoundsAnEventToTheLineLimit(t *testing.T) {
+	hook := captureCodexSSEWarnings(t)
+	// Each fragment fits the 64-byte limit; together they do not.
+	stream := "data: {\"a\":\"" + strings.Repeat("x", 40) + "\ndata: " + strings.Repeat("y", 40) + "\ndata: " + strings.Repeat("z", 40) + "\"}\n\ndata: {\"b\":2}\n\n"
+	scanner := newCodexSSEScanner(context.Background(), strings.NewReader(stream), 64)
+	var got []string
+	for scanner.Scan() {
+		got = append(got, string(scanner.Bytes()))
+	}
+	if errScan := scanner.Err(); errScan != nil {
+		t.Fatalf("scan error: %v", errScan)
+	}
+	// The collected fragment is flushed as an invalid event; the lines after it are read as stock reads them.
+	want := []string{
+		"data: {\"a\":\"" + strings.Repeat("x", 40),
+		"data: " + strings.Repeat("y", 40),
+		"data: " + strings.Repeat("z", 40) + "\"}",
+		"",
+		`data: {"b":2}`,
+		"",
+	}
+	if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+		t.Fatalf("lines = %q\nwant    %q", got, want)
+	}
+	if len(hook.AllEntries()) != 1 {
+		t.Fatalf("warnings = %d, want 1 for the flushed invalid event", len(hook.AllEntries()))
+	}
+}
+
+func TestCodexSSEScannerAssemblesAnEventOfThousandsOfLinesQuickly(t *testing.T) {
+	// A 2 MB response.completed whose upstream wrapped it into 2,000 data lines between array
+	// elements. Every line ends with "}", so only nesting, not the last byte, tells the event apart
+	// from a finished one.
+	item := func(i int) string {
+		return fmt.Sprintf(`{"type":"message","content":[{"type":"output_text","text":"%s"}]}`, strings.Repeat(string(rune('a'+i%26)), 960))
+	}
+	head := `{"type":"response.completed","response":{"id":"resp_big","output":[`
+	var payload, stream strings.Builder
+	payload.WriteString(head + item(0))
+	stream.WriteString("data: " + head + item(0) + "\n")
+	for i := 1; i < 2000; i++ {
+		payload.WriteString("," + item(i))
+		stream.WriteString("data: ," + item(i) + "\n")
+	}
+	payload.WriteString("]}}")
+	stream.WriteString("data: ]}}\n\n")
+	started := time.Now()
+	scanner := newCodexSSEScanner(context.Background(), strings.NewReader(stream.String()), 52_428_800)
+	var got []string
+	for scanner.Scan() {
+		got = append(got, string(scanner.Bytes()))
+	}
+	elapsed := time.Since(started)
+	if len(got) != 2 || got[0] != "data: "+payload.String() {
+		t.Fatalf("assembled %d lines, want the event on one line and its blank line", len(got))
+	}
+	if elapsed > 2*time.Second {
+		t.Fatalf("assembling 2,001 data lines took %v; validation must not grow with every line", elapsed)
+	}
+}
+
+func TestCodexSSEScannerDiagnosticDescribesFraming(t *testing.T) {
+	hook := captureCodexSSEWarnings(t)
+	// A split inside a string: each fragment is invalid on its own, and so is their SSE join.
+	scanCodexSSE(t, "data: {\"type\":\"response.completed\",\"t\":\"abc\ndata: def\"}\n\n")
+	entries := hook.AllEntries()
+	if len(entries) != 1 {
+		t.Fatalf("warnings = %d, want 1", len(entries))
+	}
+	message := entries[0].Message
+	for _, want := range []string{"data_lines=2", "line_bytes=[37,5]", "lines_valid=[false,false]", "data_bytes=43", "json_error_offset=38"} {
+		if !strings.Contains(message, want) {
+			t.Fatalf("diagnostic %q lacks %q", message, want)
+		}
+	}
+}
+
+func codexStreamChunks(t *testing.T, stream string, buffered bool) []string {
+	t.Helper()
+	cfg := &config.Config{}
+	cfg.Codex.StreamBootstrapBuffering = buffered
+	executor := NewCodexExecutor(cfg)
+	ctx := context.WithValue(t.Context(), "cliproxy.roundtripper", codexAllocationTransport{stream: stream})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "test"}}
+	result, err := executor.ExecuteStream(ctx, auth, cliproxyexecutor.Request{Model: "gpt-5.4", Payload: []byte(`{"model":"gpt-5.4","input":"hello"}`)},
+		cliproxyexecutor.Options{Stream: true, SourceFormat: sdktranslator.FormatOpenAIResponse})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var chunks []string
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream error: %v", chunk.Err)
+		}
+		if len(chunk.Payload) > 0 {
+			chunks = append(chunks, string(chunk.Payload))
+		}
+	}
+	return chunks
+}
+
+func TestCodexExecuteStreamTreatsAnEventSplitAcrossDataLinesAsOneEvent(t *testing.T) {
+	completed := `{"type":"response.completed","response":{"id":"resp_split","model":"gpt-5.4","status":"completed","output":[{"id":"msg_1","type":"message","role":"assistant","content":[{"type":"output_text","text":"hi"}]}],"usage":{"input_tokens":5,"output_tokens":1,"total_tokens":6}}}`
+	cut := strings.Index(completed, `"output":`)
+	created := "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_split\",\"model\":\"gpt-5.4\"}}\n\n"
+	oneLine := created + "event: response.completed\ndata: " + completed + "\n\n"
+	split := created + "event: response.completed\ndata: " + completed[:cut] + "\ndata: " + completed[cut:] + "\n\n"
+	for _, buffered := range []bool{false, true} {
+		t.Run(fmt.Sprintf("buffered=%t", buffered), func(t *testing.T) {
+			want := codexStreamChunks(t, oneLine, buffered)
+			got := codexStreamChunks(t, split, buffered)
+			if fmt.Sprintf("%q", got) != fmt.Sprintf("%q", want) {
+				t.Fatalf("split event chunks = %q\nwant the one-line chunks %q", got, want)
+			}
+			if terminal := want[len(want)-1]; !strings.Contains(terminal, `"response.completed"`) || !json.Valid([]byte(strings.TrimPrefix(terminal, "data: "))) {
+				t.Fatalf("last chunk = %q, want a valid response.completed", terminal)
+			}
+		})
+	}
+}
