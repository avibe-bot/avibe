{
  "name": "avibe-desktop",
  "description": "Bootstrap UI for the Avibe desktop shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:i18n": "node scripts/verify-i18n.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:updater": "cargo test -p avibe-runtime-host update && cargo test -p avibe-desktop update"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
