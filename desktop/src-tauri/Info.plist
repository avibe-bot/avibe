<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundle's localizations: English stays the system UI language for
	     English users; zh-Hans carries the Services menu title 「问 Vibey」
	     and the Local Network question's sentence. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>Ask Vibey</string></dict>
			<key>NSMessage</key><string>askVibey</string>
			<key>NSPortName</key><string>Avibe</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>public.url</string>
				<string>public.file-url</string>
			</array>
		</dict>
	</array>
	<!-- Merged by the Tauri bundler into the generated Info.plist. The
	     Workbench's voice input calls getUserMedia inside WKWebView; wry
	     grants the WebKit-level media request, but macOS TCC denies
	     microphone access outright (no prompt, NotAllowedError in the page)
	     unless the host app declares why it needs the microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Avibe uses the microphone for voice input in the Workbench.</string>
	<!-- The direct path to another computer's instance reaches it on the
	     same network. macOS asks for Local Network access the first time
	     and shows this sentence; without it the question has no reason.
	     The iPhone App's sentence; zh-Hans is in InfoPlist.strings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lets Avibe connect directly to the computer running Avibe when it's on the same network. If you don't allow it, Avibe still works over the internet.</string>
</dict>
</plist>
