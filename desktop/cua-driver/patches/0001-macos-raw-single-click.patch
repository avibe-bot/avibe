+
+/// Bounded, typed list read. Invalid entries are counted but never cast to AX.
+///
+/// # Safety
+/// `element` must be live; the caller releases every returned reference.
+pub(crate) unsafe fn copy_element_list_diagnosed(
+    element: AXUIElementRef,
+    name: &str,
+    limit: usize,
+) -> (Vec<AXUIElementRef>, AxWindowsDiagnostics) {
+    let attr = CFStr::new(name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    diagnose_element_list(value, error, limit)
+}
+
+/// Consumes the copied CF value, including malformed/error results.
+unsafe fn diagnose_element_list(
+    value: CFTypeRef,
+    error: AXError,
+    limit: usize,
+) -> (Vec<AXUIElementRef>, AxWindowsDiagnostics) {
+    let mut diagnostic = AxWindowsDiagnostics::status("ok");
+    if error != kAXErrorSuccess {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        diagnostic.status = "api_error".into();
+        diagnostic.error = Some(error);
+        return (vec![], diagnostic);
+    }
+    if value.is_null() {
+        diagnostic.status = "null_value".into();
+        return (vec![], diagnostic);
+    }
+    if core_foundation::base::CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        diagnostic.status = "wrong_type".into();
+        return (vec![], diagnostic);
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    diagnostic.raw_count = array.len() as usize;
+    let mut elements = Vec::new();
+    for index in 0..diagnostic.raw_count.min(limit) {
+        if let Some(item) = array.get(index as _) {
+            let item = *item;
+            if !item.is_null() && core_foundation::base::CFGetTypeID(item) == AXUIElementGetTypeID()
+            {
+                CFRetain(item);
+                elements.push(item as AXUIElementRef);
+            }
+        }
+    }
+    diagnostic.accepted_count = elements.len();
+    diagnostic.status = if diagnostic.raw_count == 0 {
+        "empty"
+    } else if diagnostic.raw_count > limit {
+        "truncated"
+    } else if diagnostic.accepted_count != diagnostic.raw_count {
+        "invalid_entries"
+    } else {
+        "ok"
+    }
+    .into();
+    (elements, diagnostic)
+}
