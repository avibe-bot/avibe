+//! Observation-only recovery. Native IDs and explicit AX edges are evidence;
+//! titles, geometry, process identity alone, and remote tokens are not.
+
+use super::bindings::*;
+use core_foundation::{
+    base::{CFEqual, CFRelease, CFRetain, CFTypeRef, TCFType},
+    string::CFString,
+};
+use serde::Serialize;
+use std::{
+    collections::VecDeque,
+    time::{Duration, Instant},
+};
+
+const MAX_NODES: usize = 128;
+const MAX_DEPTH: usize = 8;
+const MAX_QUERIES: usize = 512;
+const MAX_DURATION: Duration = Duration::from_millis(300);
+const CALL_TIMEOUT_SECONDS: f32 = 0.03;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct QueryEvidence {
+    pub attribute: String,
+    pub status: String,
+    pub error: Option<i32>,
+    pub raw_count: usize,
+    pub accepted_count: usize,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+pub struct ResolutionDiagnostics {
+    pub status: String,
+    pub own_window_id: Option<u32>,
+    pub root_window_id: Option<u32>,
+    pub focused_window_id: Option<u32>,
+    pub visited_count: usize,
+    pub mapped_count: usize,
+    pub repeated_nodes: usize,
+    pub pid_mismatches: usize,
+    pub truncated: bool,
+    pub queries: Vec<QueryEvidence>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct WindowObservationDiagnostics {
+    pub owner_pid: i32,
+    pub requested_window_id: u32,
+    /// WindowServer's on-screen list membership, not a proof of modality.
+    pub on_current_space: Option<bool>,
+    pub ax_windows: AxWindowsDiagnostics,
+    pub resolution: Option<ResolutionDiagnostics>,
+}
+
+#[derive(Debug, Clone)]
+struct Facts {
+    pid: i32,
+    role: String,
+    window_id: Option<u32>,
+}
+
+trait Graph {
+    fn facts(&mut self, node: usize) -> Option<Facts>;
+    fn edges(&mut self, node: usize, attribute: &'static str) -> Vec<usize>;
+    fn exhausted(&self) -> bool;
+    fn invalid_relationship(&self) -> bool {
+        false
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct Match {
+    node: usize,
+    own: u32,
+    root: u32,
+}
+
+// Fixtures and the native adapter execute exactly the same resolver. A queued
+// node carries the nearest explicitly traversed window ancestor; a focused
+// sheet additionally has to establish that ancestor through AXParent.
+fn resolve<G: Graph>(
+    graph: &mut G,
+    app: usize,
+    seeds: &[usize],
+    pid: i32,
+    requested: u32,
+) -> (Option<Match>, ResolutionDiagnostics) {
+    let mut report = ResolutionDiagnostics {
+        status: "unresolved".into(),
+        ..Default::default()
+    };
+    let Some(app_facts) = graph.facts(app) else {
+        return (None, report);
+    };
+    if app_facts.pid != pid || app_facts.role != "AXApplication" {
+        report.status = "invalid_application".into();
+        return (None, report);
+    }
+    let mut queue = VecDeque::new();
+    let focused = graph.edges(app, "AXFocusedWindow");
+    for node in focused {
+        if let Some(facts) = graph.facts(node) {
+            if facts.pid == pid && matches!(facts.role.as_str(), "AXWindow" | "AXSheet") {
+                report.focused_window_id = facts.window_id;
+            }
+        }
+        queue.push_back((node, None, 0));
+    }
+    queue.extend(seeds.iter().copied().map(|n| (n, None, 0)));
+    queue.extend(
+        graph
+            .edges(app, "AXChildren")
+            .into_iter()
+            .map(|n| (n, None, 0)),
+    );
+    let mut visited = Vec::new();
+    while let Some((node, ancestor, depth)) = queue.pop_front() {
+        if graph.exhausted() || visited.len() >= MAX_NODES {
+            report.truncated = true;
+            break;
+        }
+        if visited.contains(&(node, ancestor)) {
+            report.repeated_nodes += 1;
+            continue;
+        }
+        visited.push((node, ancestor));
+        report.visited_count += 1;
+        let Some(facts) = graph.facts(node) else {
+            continue;
+        };
+        if facts.pid != pid {
+            report.pid_mismatches += 1;
+            continue;
+        }
+        let is_surface = matches!(facts.role.as_str(), "AXWindow" | "AXSheet");
+        if is_surface && facts.window_id.is_some() {
+            report.mapped_count += 1;
+        }
+        if is_surface && facts.window_id == Some(requested) {
+            let root = if facts.role == "AXSheet" {
+                // Parent IDs are distinct evidence; never substitute the root
+                // for a sheet's own native ID (including an aliased sheet ID).
+                match parent_window(graph, node, pid, &mut report) {
+                    Ok(parent) if parent.is_none() || ancestor.is_none() || parent == ancestor => {
+                        parent.or(ancestor).filter(|root| *root != requested)
+                    }
+                    _ => None,
+                }
+            } else {
+                Some(requested)
+            };
+            if let Some(root) = root {
+                if !graph.exhausted() {
+                    report.status = "exact_relationship_match".into();
+                    report.own_window_id = Some(requested);
+                    report.root_window_id = Some(root);
+                    return (
+                        Some(Match {
+                            node,
+                            own: requested,
+                            root,
+                        }),
+                        report,
+                    );
+                }
+            }
+        }
+        if depth >= MAX_DEPTH {
+            report.truncated = true;
+            continue;
+        }
+        let root = if facts.role == "AXWindow" {
+            facts.window_id.or(ancestor)
+        } else {
+            ancestor
+        };
+        for attribute in ["AXSheets", "AXChildren"] {
+            for child in graph.edges(node, attribute) {
+                // Bound pending work as well as visited nodes; wide lists and
+                // duplicate edges cannot create an unbounded queue.
+                if queue.len() >= MAX_NODES {
+                    report.truncated = true;
+                    break;
+                }
+                queue.push_back((child, root, depth + 1));
+            }
+        }
+    }
+    report.truncated |= graph.exhausted();
+    (None, report)
+}
+
+fn parent_window<G: Graph>(
+    graph: &mut G,
+    node: usize,
+    pid: i32,
+    report: &mut ResolutionDiagnostics,
+) -> Result<Option<u32>, ()> {
+    let mut seen = vec![node];
+    let mut current = node;
+    for _ in 0..MAX_DEPTH {
+        let parents = graph.edges(current, "AXParent");
+        if graph.invalid_relationship() || graph.exhausted() {
+            return Err(());
+        }
+        let Some(parent) = parents.into_iter().next() else {
+            // A directly exposed sheet may omit AXParent. The caller can use
+            // an already traversed AXSheets/AXChildren edge in that case.
+            return if current == node { Ok(None) } else { Err(()) };
+        };
+        if seen.contains(&parent) {
+            report.repeated_nodes += 1;
+            return Err(());
+        }
+        seen.push(parent);
+        let facts = graph.facts(parent).ok_or(())?;
+        if facts.pid != pid {
+            report.pid_mismatches += 1;
+            return Err(());
+        }
+        if facts.role == "AXWindow" {
+            return facts.window_id.map(Some).ok_or(());
+        }
+        if facts.role == "AXApplication" {
+            return Ok(None);
+        }
+        current = parent;
+    }
+    report.truncated = true;
+    Err(())
+}
+
+struct NativeGraph {
+    // Own one retain per canonical AX identity. CFEqual, not pointer equality,
+    // recognizes native proxies returned by different attributes.
+    elements: Vec<AXUIElementRef>,
+    deadline: Instant,
+    queries: Vec<QueryEvidence>,
+    stopped: bool,
+}
+
+impl NativeGraph {
+    unsafe fn intern(&mut self, element: AXUIElementRef) -> Option<usize> {
+        if let Some(index) = self
+            .elements
+            .iter()
+            .position(|&other| CFEqual(other as CFTypeRef, element as CFTypeRef) != 0)
+        {
+            CFRelease(element as CFTypeRef);
+            return Some(index);
+        }
+        if self.elements.len() >= MAX_NODES {
+            self.stopped = true;
+            CFRelease(element as CFTypeRef);
+            return None;
+        }
+        self.elements.push(element);
+        Some(self.elements.len() - 1)
+    }
+
+    fn prepare(&mut self, node: usize) -> bool {
+        if self.exhausted() {
+            self.stopped = true;
+            return false;
+        }
+        unsafe {
+            AXUIElementSetMessagingTimeout(self.elements[node], CALL_TIMEOUT_SECONDS);
+        }
+        true
+    }
+
+    fn record(&mut self, attribute: &str, diagnostic: AxWindowsDiagnostics) {
+        self.queries.push(QueryEvidence {
+            attribute: attribute.into(),
+            status: diagnostic.status,
+            error: diagnostic.error,
+            raw_count: diagnostic.raw_count,
+            accepted_count: diagnostic.accepted_count,
+        });
+    }
+
+    unsafe fn value(&mut self, node: usize, attribute: &str) -> Option<CFTypeRef> {
+        if !self.prepare(node) {
+            return None;
+        }
+        let name = CFString::new(attribute);
+        let mut value = std::ptr::null();
+        let error = AXUIElementCopyAttributeValue(
+            self.elements[node],
+            name.as_concrete_TypeRef(),
+            &mut value,
+        );
+        let mut diagnostic = AxWindowsDiagnostics::status("ok");
+        diagnostic.error = (error != kAXErrorSuccess).then_some(error);
+        diagnostic.status = if error != kAXErrorSuccess {
+            "api_error"
+        } else if value.is_null() {
+            "null_value"
+        } else {
+            "ok"
+        }
+        .into();
+        self.record(attribute, diagnostic);
+        if error != kAXErrorSuccess || value.is_null() {
+            if !value.is_null() {
+                CFRelease(value);
+            }
+            None
+        } else {
+            Some(value)
+        }
+    }
+}
+
+impl Graph for NativeGraph {
+    fn facts(&mut self, node: usize) -> Option<Facts> {
+        unsafe {
+            if !self.prepare(node) {
+                return None;
+            }
+            let mut pid = 0;
+            let error = AXUIElementGetPid(self.elements[node], &mut pid);
+            let mut diagnostic =
+                AxWindowsDiagnostics::status(if error == 0 { "ok" } else { "api_error" });
+            diagnostic.error = (error != 0).then_some(error);
+            self.record("AXUIElementGetPid", diagnostic);
+            if error != 0 {
+                return None;
+            }
+            let role = self.value(node, "AXRole")?;
+            if core_foundation::base::CFGetTypeID(role) != CFString::type_id() {
+                CFRelease(role);
+                self.queries.last_mut().unwrap().status = "wrong_type".into();
+                return None;
+            }
+            let role = CFString::wrap_under_create_rule(role as _).to_string();
+            let window_id = if matches!(role.as_str(), "AXWindow" | "AXSheet") {
+                if !self.prepare(node) {
+                    return None;
+                }
+                let mut id = 0;
+                let error = _AXUIElementGetWindow(self.elements[node], &mut id);
+                let mut diagnostic = AxWindowsDiagnostics::status(if error != 0 {
+                    "api_error"
+                } else if id == 0 {
+                    "no_window_id"
+                } else {
+                    "ok"
+                });
+                diagnostic.error = (error != 0).then_some(error);
+                self.record("_AXUIElementGetWindow", diagnostic);
+                (error == 0 && id != 0).then_some(id)
+            } else {
+                None
+            };
+            Some(Facts {
+                pid,
+                role,
+                window_id,
+            })
+        }
+    }
+
+    fn edges(&mut self, node: usize, attribute: &'static str) -> Vec<usize> {
+        unsafe {
+            if matches!(attribute, "AXParent" | "AXFocusedWindow") {
+                let Some(value) = self.value(node, attribute) else {
+                    return vec![];
+                };
+                if core_foundation::base::CFGetTypeID(value) != AXUIElementGetTypeID() {
+                    CFRelease(value);
+                    self.queries.last_mut().unwrap().status = "wrong_type".into();
+                    return vec![];
+                }
+                let query = self.queries.last_mut().unwrap();
+                query.raw_count = 1;
+                query.accepted_count = 1;
+                self.intern(value as AXUIElementRef).into_iter().collect()
+            } else {
+                if !self.prepare(node) {
+                    return vec![];
+                }
+                let (elements, diagnostic) =
+                    copy_element_list_diagnosed(self.elements[node], attribute, MAX_NODES);
+                self.stopped |= diagnostic.status == "truncated";
+                self.record(attribute, diagnostic);
+                elements
+                    .into_iter()
+                    .filter_map(|element| self.intern(element))
+                    .collect()
+            }
+        }
+    }
+
+    fn exhausted(&self) -> bool {
+        self.stopped || self.queries.len() >= MAX_QUERIES || Instant::now() >= self.deadline
+    }
+
+    fn invalid_relationship(&self) -> bool {
+        self.queries.last().is_some_and(|query| {
+            query.status == "wrong_type"
+                || (query.status == "api_error"
+                    && query.error != Some(kAXErrorAttributeUnsupported)
+                    && query.error != Some(kAXErrorNoValue))
+        })
+    }
+}
+
+impl Drop for NativeGraph {
+    fn drop(&mut self) {
+        unsafe {
+            for &element in &self.elements {
+                // Do not leave the observation's short timeout on cached proxies.
+                AXUIElementSetMessagingTimeout(element, 0.0);
+                CFRelease(element as CFTypeRef);
+            }
+        }
+    }
+}
+
+/// Recover a missing surface using only explicit, bounded AX relationships.
+/// This never grants input eligibility. Caller owns the returned retain.
+///
+/// # Safety
+/// `app` and `seeds` must be valid AX references for the duration of this call.
+pub unsafe fn copy_observation_window(
+    app: AXUIElementRef,
+    seeds: &[AXUIElementRef],
+    pid: i32,
+    requested: u32,
+    timeout: Option<Duration>,
+) -> (Option<AXUIElementRef>, ResolutionDiagnostics) {
+    let mut graph = NativeGraph {
+        elements: Vec::new(),
+        deadline: Instant::now() + timeout.unwrap_or(MAX_DURATION).min(MAX_DURATION),
+        queries: Vec::new(),
+        stopped: false,
+    };
+    CFRetain(app as CFTypeRef);
+    graph.intern(app);
+    let seed_ids: Vec<_> = seeds
+        .iter()
+        .take(MAX_NODES - 1)
+        .filter_map(|&element| {
+            CFRetain(element as CFTypeRef);
+            graph.intern(element)
+        })
+        .collect();
+    let (matched, mut report) = resolve(&mut graph, 0, &seed_ids, pid, requested);
+    report.truncated |= graph.exhausted() || seeds.len() >= MAX_NODES;
+    report.queries = std::mem::take(&mut graph.queries);
+    let element = matched.map(|matched| {
+        let element = graph.elements[matched.node];
+        CFRetain(element as CFTypeRef);
+        element
+    });
+    (element, report)
+}
