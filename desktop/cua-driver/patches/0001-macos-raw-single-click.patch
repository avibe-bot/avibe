+                std::thread::sleep(Duration::from_millis(250));
+                let after_auto = snapshot_elements(driver, harness.pid, wid);
+                assert!(
+                    after_auto.tree_text().contains("raw_ax_presses=1")
+                        && after_auto.tree_text().contains("raw_mouse_downs=0")
+                        && after_auto.tree_text().contains("raw_mouse_ups=0"),
