+    const CHILD_ENV: &str = "CUA_DRIVER_PARENT_LIVENESS_TEST_CHILD";
+    const SOCKET_ENV: &str = "CUA_DRIVER_PARENT_LIVENESS_TEST_SOCKET";
+    const PID_FILE_ENV: &str = "CUA_DRIVER_PARENT_LIVENESS_TEST_PID_FILE";
+    const STARTED_ENV: &str = "CUA_DRIVER_PARENT_LIVENESS_TEST_STARTED";
+    const CURSOR_OVERLAY_ENV: &str = "CUA_DRIVER_PARENT_LIVENESS_TEST_CURSOR_OVERLAY";
+
+    struct BlockingTool;
+
+    static BLOCKING_TOOL_DEF: OnceLock<ToolDef> = OnceLock::new();
+
+    #[async_trait]
+    impl Tool for BlockingTool {
+        fn def(&self) -> &ToolDef {
+            BLOCKING_TOOL_DEF.get_or_init(|| ToolDef {
+                name: "health_report".into(),
+                description: "test-only non-cancellable platform call".into(),
+                input_schema: serde_json::json!({"type": "object"}),
+                read_only: true,
+                destructive: false,
+                idempotent: true,
+                open_world: false,
+            })
+        }
+
+        async fn invoke(&self, _args: Value) -> ToolResult {
+            std::fs::write(
+                std::env::var(STARTED_ENV).expect("started marker path"),
+                "started\n",
+            )
+            .expect("write started marker");
+            std::thread::sleep(Duration::from_secs(60));
+            ToolResult::text("finished")
+        }
+    }
+
+    fn register_blocking_tool(registry: &mut ToolRegistry) {
+        registry.register(Box::new(BlockingTool));
+    }
+
+    fn wait_for_path(path: &std::path::Path, timeout: Duration) {
+        let deadline = Instant::now() + timeout;
+        while Instant::now() < deadline {
+            if path.exists() {
+                return;
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        panic!("timed out waiting for {}", path.display());
+    }
+
+    #[test]
+    fn parent_liveness_child() {
+        if std::env::var_os(CHILD_ENV).is_none() {
+            return;
+        }
+        let driver =
+            cua_driver_sdk::CuaDriver::create_for_host(cua_driver_sdk::DriverHostOptions {
+                cursor: cursor_overlay::CursorConfig {
+                    enabled: std::env::var(CURSOR_OVERLAY_ENV).ok().as_deref() == Some("1"),
+                    ..cursor_overlay::CursorConfig::default()
+                },
+                host_owns_permission_ux: true,
+                host_bundle_id: Some("com.trycua.parent-liveness-test".into()),
+                claude_code_compatibility: false,
+                prepare_desktop_environment: false,
+                register_host_tools: Some(register_blocking_tool),
+                authorization_host: None,
+                activity_observer: None,
+            });
+        let socket = std::env::var(SOCKET_ENV).expect("socket path");
+        let pid_file = std::env::var(PID_FILE_ENV).expect("pid file path");
+        run_serve_cmd(driver, &socket, Some(&pid_file));
+    }
+
+    fn run_parent_liveness_test(cursor_overlay: bool) {
+        let directory = tempfile::tempdir().expect("temporary directory");
+        let socket = directory.path().join("driver.sock");
+        let pid_file = directory.path().join("driver.pid");
+        let started = directory.path().join("call-started");
+        let unrelated_socket = directory.path().join("unrelated.sock");
+        let unrelated_state = directory.path().join("unrelated-state");
+        let _unrelated_listener =
+            std::os::unix::net::UnixListener::bind(&unrelated_socket).expect("unrelated socket");
+        std::fs::write(&unrelated_state, "preserve\n").expect("unrelated state");
+
+        let home = directory.path().join("home");
+        std::fs::create_dir_all(&home).expect("test home");
+        let mut child = Command::new(std::env::current_exe().expect("test executable"))
+            .args([
+                "--exact",
+                "serve::parent_liveness_tests::parent_liveness_child",
+                "--nocapture",
+            ])
+            .env(CHILD_ENV, "1")
+            .env(SOCKET_ENV, &socket)
+            .env(PID_FILE_ENV, &pid_file)
+            .env(STARTED_ENV, &started)
+            .env(CURSOR_OVERLAY_ENV, u8::from(cursor_overlay).to_string())
+            .env("HOME", &home)
+            .env("XDG_CACHE_HOME", home.join(".cache"))
+            .env("XDG_CONFIG_HOME", home.join(".config"))
+            .env("XDG_DATA_HOME", home.join(".local/share"))
+            .env(cua_driver_core::EMBEDDED_ENV, "1")
+            .env(cua_driver_core::PARENT_LIVENESS_STDIN_ENV, "1")
+            .env("CUA_DRIVER_RS_TELEMETRY_ENABLED", "0")
+            .env("CUA_DRIVER_RS_UPDATE_CHECK", "0")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("spawn test daemon");
+
+        wait_for_path(&socket, Duration::from_secs(10));
+        wait_for_path(&pid_file, Duration::from_secs(10));
+
+        let socket_for_call = socket.to_string_lossy().into_owned();
+        let call = std::thread::spawn(move || {
+            send_request(
+                &socket_for_call,
+                &DaemonRequest {
+                    method: "call".into(),
+                    name: Some("health_report".into()),
+                    args: Some(serde_json::json!({})),
+                    session_id: None,
+                    observation_origin: None,
+                    client_kind: None,
+                },
+            )
+        });
+        wait_for_path(&started, Duration::from_secs(10));
+
+        drop(child.stderr.take());
+        drop(child.stdin.take());
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let status = loop {
+            if let Some(status) = child.try_wait().expect("poll test daemon") {
+                break status;
+            }
+            if Instant::now() >= deadline {
+                let _ = child.kill();
+                let _ = child.wait();
+                let _ = call.join();
+                panic!("embedded daemon stayed alive after its parent-liveness pipe closed");
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        };
+        let _ = call.join();
+
+        assert!(status.success(), "child test failed: {status}");
+        assert!(!socket.exists(), "owned socket survived parent cleanup");
+        assert!(!pid_file.exists(), "owned pid file survived parent cleanup");
+        assert!(unrelated_socket.exists(), "unrelated socket was removed");
+        assert_eq!(
+            std::fs::read_to_string(unrelated_state).expect("unrelated state"),
+            "preserve\n"
+        );
+    }
+
+    #[test]
+    fn parent_liveness_exits_without_waiting_for_blocked_calls_and_unlinks_only_its_socket() {
+        run_parent_liveness_test(false);
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    #[ignore = "requires a logged-in macOS GUI session"]
+    fn parent_liveness_with_cursor_overlay_exits_after_parent_loss() {
+        run_parent_liveness_test(true);
+    }
+}
