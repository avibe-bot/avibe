+/// A supplemental observation is not a new action surface. In particular,
+/// foreground actions must not gain tokens from observation-only recovery.
+fn observation_can_publish_snapshot(
+    scope: Option<&crate::ax::WindowScope>,
+    diagnostics: Option<&crate::ax::window_resolution::WindowObservationDiagnostics>,
+) -> bool {
+    scope.is_none_or(|scope| scope.is_matched())
+        && !diagnostics
+            .and_then(|d| d.resolution.as_ref())
+            .is_some_and(|r| r.own_window_id.is_some())
+}
+
+pub(super) const DIALOG_MANUAL_GUIDANCE: &str = "This dialog is visible, but Computer Use can't confirm that input would reach only this window. Handle it manually, then continue.";
+
+/// Current-Space visibility is observation evidence, never modal/input proof.
+fn unresolved_observation_guidance(on_current_space: Option<bool>) -> Value {
+    if on_current_space == Some(true) {
+        serde_json::json!({
+            "reason": "current_space_ax_unresolved",
+            "code": "app_dialog_unresolved",
+            "next_action": "manual",
+            "recommended": "manual",
+            "message": DIALOG_MANUAL_GUIDANCE
+        })
+    } else {
+        serde_json::json!({
+            "reason": "off_space_or_ax_unresolved",
+            "code": "off_space_or_ax_unresolved",
+            "next_action": "observe",
+            "recommended": "observe",
+            "message": "Computer Use could not resolve this window's accessibility surface. Bring the requested window into view manually, then observe it again."
+        })
     }
 }
 
