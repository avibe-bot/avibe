+/// Read-only evidence about an AX element-list query. No content is collected.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub struct AxWindowsDiagnostics {
+    pub status: String,
+    pub error: Option<i32>,
+    pub raw_count: usize,
+    pub accepted_count: usize,
