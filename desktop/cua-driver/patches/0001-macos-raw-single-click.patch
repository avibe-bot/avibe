+// Optional WindowServer evidence must not hold an established refusal (or its
+// per-PID lease) behind a slow lookup. No second AX query is needed here.
+const REFUSAL_EVIDENCE_TIMEOUT: std::time::Duration = std::time::Duration::from_millis(100);
+
+/// Finish a decision from acquired facts; the reader provides optional context
+/// only after refusal and can never dispatch or change an Execute decision.
+async fn finish_background_window_decision<F, E>(
+    pid: i32,
+    window_id: u32,
+    facts: &cua_driver_core::background_input::BackgroundTargetFacts,
+    action: cua_driver_core::background_input::BackgroundAction,
+    read_current_space: impl FnOnce() -> F,
+) -> Result<(), cua_driver_core::protocol::ToolResult>
+where
+    F: std::future::Future<Output = Result<Option<bool>, E>>,
+{
+    use cua_driver_core::background_input::{
+        decide_background_input, BackgroundInputDecision, ExactWindowTarget,
+    };
+    match decide_background_input(ExactWindowTarget { pid, window_id }, facts, action) {
         BackgroundInputDecision::Execute { .. } => Ok(()),
-        BackgroundInputDecision::Refuse(refusal) => {
-            Err(background_refusal_result(pid, window_id, &refusal))
+        BackgroundInputDecision::Refuse(mut refusal) => {
+            let mut diagnostics = None;
+            if refusal.code
+                == cua_driver_core::background_input::refusal_codes::OFF_SPACE_OR_AX_UNRESOLVED
+            {
+                let (on_current_space, status) =
+                    match tokio::time::timeout(REFUSAL_EVIDENCE_TIMEOUT, async {
+                        read_current_space().await
+                    })
+                    .await
+                    {
+                        Ok(Ok(Some(current))) => (Some(current), "ok"),
+                        Ok(Ok(None)) => (None, "unknown"),
+                        Ok(Err(_)) => (None, "error"),
+                        Err(_) => (None, "timeout"),
+                    };
+                diagnostics = Some(serde_json::json!({
+                    "source": "initial_admission_facts",
+                    "ax_window_present": facts.ax_window_present,
+                    "on_current_space": on_current_space,
+                    "current_space_source": "window_server",
+                    "current_space_status": status,
+                    "modal_proven": false,
+                }));
+                if on_current_space == Some(true) {
+                    refusal.code = "app_dialog_unresolved";
+                    refusal.reason = get_window_state::DIALOG_MANUAL_GUIDANCE.into();
+                    refusal.advice = None;
+                }
+            }
+            let mut result = background_refusal_result(pid, window_id, &refusal);
+            if let (Some(structured), Some(diagnostics)) =
+                (result.structured_content.as_mut(), diagnostics)
+            {
+                structured["diagnostics"] = diagnostics;
+            }
+            Err(result)
         }
     }
 }
