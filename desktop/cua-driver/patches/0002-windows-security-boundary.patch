+            foreground_hwnd: None,
+        };
+        assert!(normal.action_desktop_is_available());
+        for name in [None, Some("Winlogon"), Some("Disconnect")] {
+            let mut state = normal.clone();
+            state.input_desktop_name = name.map(str::to_owned);
+            assert!(!state.action_desktop_is_available());
+            let mut state = normal.clone();
+            state.thread_desktop_name = name.map(str::to_owned);
+            assert!(!state.action_desktop_is_available());
+        }
+        for session in [None, Some(0)] {
+            let mut state = normal.clone();
+            state.session_id = session;
+            assert!(!state.action_desktop_is_available());
+        }
+        let mut detached = normal;
+        detached.has_process_window_station = false;
+        assert!(!detached.action_desktop_is_available());
+    }
+}
