+#[test]
+fn literal_native_canonicalizes_existing_regular_executable() {
+    let directory = tempfile::tempdir().unwrap();
+    let real = directory.path().join("real");
+    std::fs::create_dir(&real).unwrap();
+    let executable = real.join("probe.exe");
+    std::fs::write(&executable, b"test-owned file, not executed").unwrap();
+    let prepared = prepare(executable.to_str().unwrap()).unwrap();
+    assert_eq!(
+        prepare(real.join("..\\real\\probe.exe").to_str().unwrap())
+            .unwrap()
+            .executable,
+        prepared.executable
+    );
+    // Canonicalization closes its file handle; same-user mutation is not frozen.
+    assert!(std::fs::OpenOptions::new()
+        .write(true)
+        .open(&executable)
+        .is_ok());
+    let junction = directory.path().join("junction");
+    let output = std::process::Command::new("cmd.exe")
+        .args(["/d", "/c", "mklink", "/J"])
+        .arg(&junction)
+        .arg(&real)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "test-owned junction creation failed"
+    );
+    assert_eq!(
+        prepare(junction.join("probe.exe").to_str().unwrap())
+            .unwrap()
+            .executable,
+        prepared.executable
+    );
+    std::fs::remove_dir(&junction).unwrap();
+    assert!(prepare(real.join("missing.exe").to_str().unwrap()).is_err());
+    let not_file = real.join("directory.exe");
+    std::fs::create_dir(&not_file).unwrap();
+    assert!(prepare(not_file.to_str().unwrap()).is_err());
+}
