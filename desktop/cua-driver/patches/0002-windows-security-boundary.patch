@@ -0,0 +1,342 @@
+//! Restricted Windows user-app launch. Apps are not driver helpers: observing
+//! their process never gives this module kill-on-close ownership.
+
+use serde_json::Value;
+
+pub(crate) const PREVIEW_REFUSAL: &str = "Avibe cannot launch this app in the Windows Preview. Ask the owner to open it, then attach to its window.";
+
+/// Public launch options plus the registry's existing session envelope only.
+/// No names, associations, URLs, reuse flags or caller environment/cwd.
+pub(crate) fn request_path(args: &Value) -> Result<&str, &'static str> {
+    let object = args.as_object().ok_or(PREVIEW_REFUSAL)?;
+    if object.keys().any(|key| {
+        !matches!(
+            key.as_str(),
+            "path"
+                | "additional_arguments"
+                | "start_minimized"
+                | "session"
+                | "_session_id"
+                | "_transport_session_id"
+                | "_public_session_label"
+                | "_session_idle_ttl_ms"
+        )
+    }) {
+        return Err(PREVIEW_REFUSAL);
+    }
+    if object.get("additional_arguments").is_some_and(|value| {
+        !value.as_array().is_some_and(|args| {
+            args.iter()
+                .all(|arg| arg.as_str().is_some_and(|arg| !arg.contains('\0')))
+        })
+    }) || object
+        .get("start_minimized")
+        .is_some_and(|value| !value.is_boolean())
+    {
+        return Err(PREVIEW_REFUSAL);
+    }
+    let path = object
+        .get("path")
+        .and_then(Value::as_str)
+        .ok_or(PREVIEW_REFUSAL)?;
+    conventional_path(path).map_err(|_| PREVIEW_REFUSAL)?;
+    Ok(path)
+}
+
+/// Accept a conventional absolute drive-letter executable spelling. Windows
+/// resolves dot components, short names and reparses when opening the file;
+/// only its final spelling is used for creation, without blind case folding.
+fn conventional_path(path: &str) -> Result<String, String> {
+    let path = path.replace('/', "\\");
+    let bytes = path.as_bytes();
+    if bytes.len() < 4
+        || !bytes[0].is_ascii_alphabetic()
+        || bytes[1] != b':'
+        || bytes[2] != b'\\'
+        || path.contains('\0')
+        || path[3..].contains(':')
+        || !path.to_ascii_lowercase().ends_with(".exe")
+    {
+        return Err(PREVIEW_REFUSAL.into());
+    }
+    Ok(path)
+}
+
+#[cfg(target_os = "windows")]
+mod native {
+    use super::*;
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+    use windows::core::{PCWSTR, PWSTR};
+    use windows::Win32::Foundation::HANDLE;
+    use windows::Win32::Security::{TOKEN_DUPLICATE, TOKEN_QUERY};
+    use windows::Win32::Storage::FileSystem::{
+        CreateFileW, GetDriveTypeW, GetFileInformationByHandle, GetFileType,
+        GetFinalPathNameByHandleW, BY_HANDLE_FILE_INFORMATION, FILE_ATTRIBUTE_DIRECTORY,
+        FILE_FLAG_BACKUP_SEMANTICS, FILE_NAME_NORMALIZED, FILE_READ_ATTRIBUTES, FILE_SHARE_DELETE,
+        FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_TYPE_DISK, OPEN_EXISTING,
+    };
+    use windows::Win32::System::Environment::{CreateEnvironmentBlock, DestroyEnvironmentBlock};
+    use windows::Win32::System::Threading::{
+        CreateProcessW, GetCurrentProcess, OpenProcessToken, WaitForSingleObject,
+        CREATE_BREAKAWAY_FROM_JOB, CREATE_UNICODE_ENVIRONMENT, PROCESS_INFORMATION,
+        STARTF_USESHOWWINDOW, STARTUPINFOW,
+    };
+
+    pub(crate) struct LiteralLaunch {
+        executable: String,
+        directory: String,
+    }
+
+    /// Drop closes observation only. Keeping the handle also prevents PID reuse
+    /// while launch_app resolves/minimizes windows of this exact created process.
+    pub(crate) struct CreatedApp {
+        pub(crate) pid: u32,
+        process: std::sync::Arc<OwnedHandle>,
+    }
+
+    impl CreatedApp {
+        pub(crate) fn ownership_handle(&self) -> std::sync::Arc<OwnedHandle> {
+            std::sync::Arc::clone(&self.process)
+        }
+
+        pub(crate) fn running(&self) -> bool {
+            (unsafe { WaitForSingleObject(HANDLE(self.process.as_raw_handle()), 0) })
+                == windows::Win32::Foundation::WAIT_TIMEOUT
+        }
+    }
+
+    fn wide(value: &str) -> Vec<u16> {
+        value.encode_utf16().chain(Some(0)).collect()
+    }
+
+    fn info(handle: &OwnedHandle) -> Result<BY_HANDLE_FILE_INFORMATION, String> {
+        let mut info = BY_HANDLE_FILE_INFORMATION::default();
+        unsafe { GetFileInformationByHandle(HANDLE(handle.as_raw_handle()), &mut info) }
+            .map_err(|_| PREVIEW_REFUSAL.to_owned())?;
+        Ok(info)
+    }
+
+    fn final_path(handle: &OwnedHandle) -> Result<String, String> {
+        let mut buffer = vec![0; 32768];
+        let length = unsafe {
+            GetFinalPathNameByHandleW(
+                HANDLE(handle.as_raw_handle()),
+                &mut buffer,
+                FILE_NAME_NORMALIZED,
+            )
+        } as usize;
+        if length == 0 || length >= buffer.len() {
+            return Err(PREVIEW_REFUSAL.into());
+        }
+        let path = String::from_utf16(&buffer[..length]).map_err(|_| PREVIEW_REFUSAL.to_owned())?;
+        // This is an OS-produced namespace, not acceptance of caller device paths.
+        let path = path
+            .strip_prefix("\\\\?\\")
+            .ok_or_else(|| PREVIEW_REFUSAL.to_owned())?;
+        conventional_path(path)
+    }
+
+    pub(crate) fn prepare(path: &str) -> Result<LiteralLaunch, String> {
+        let path = conventional_path(path)?;
+        let name = wide(&path);
+        // One ordinary open, following OS path resolution. This is not a
+        // same-user file-freeze boundary; do not retain file/ancestor handles.
+        let raw = unsafe {
+            CreateFileW(
+                PCWSTR(name.as_ptr()),
+                FILE_READ_ATTRIBUTES.0,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                None,
+                OPEN_EXISTING,
+                FILE_FLAG_BACKUP_SEMANTICS,
+                None,
+            )
+        }
+        .map_err(|_| PREVIEW_REFUSAL.to_owned())?;
+        let handle = unsafe { OwnedHandle::from_raw_handle(raw.0) };
+        if unsafe { GetFileType(HANDLE(handle.as_raw_handle())) } != FILE_TYPE_DISK
+            || info(&handle)?.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY.0 != 0
+        {
+            return Err(PREVIEW_REFUSAL.into());
+        }
+        let executable = final_path(&handle)?;
+        let root = wide(&executable[..3]);
+        // DRIVE_FIXED only: refuse removable, remote, unknown and other drives.
+        if unsafe { GetDriveTypeW(PCWSTR(root.as_ptr())) } != 3 {
+            return Err(PREVIEW_REFUSAL.into());
+        }
+        drop(handle);
+        let separator = executable
+            .rfind('\\')
+            .ok_or_else(|| PREVIEW_REFUSAL.to_owned())?;
+        let directory = executable[..if separator == 2 { 3 } else { separator }].to_owned();
+        Ok(LiteralLaunch {
+            executable,
+            directory,
+        })
+    }
+
+    /// This allocation stays inside synchronous spawn and is freed on every
+    /// success/error path. The OS copies it before CreateProcessW returns.
+    struct UserEnvironment(*mut std::ffi::c_void);
+
+    impl Drop for UserEnvironment {
+        fn drop(&mut self) {
+            let _ = unsafe { DestroyEnvironmentBlock(self.0) };
+        }
+    }
+
+    fn user_environment() -> Result<UserEnvironment, String> {
+        let refusal = || {
+            "Windows could not create the standard-user environment; no app was started.".to_owned()
+        };
+        let mut token = HANDLE::default();
+        unsafe {
+            OpenProcessToken(
+                GetCurrentProcess(),
+                TOKEN_QUERY | TOKEN_DUPLICATE,
+                &mut token,
+            )
+        }
+        .map_err(|_| refusal())?;
+        let token = unsafe { OwnedHandle::from_raw_handle(token.0) };
+        let mut block = std::ptr::null_mut();
+        unsafe { CreateEnvironmentBlock(&mut block, HANDLE(token.as_raw_handle()), false) }
+            .map_err(|_| refusal())?;
+        if block.is_null() {
+            return Err(refusal());
+        }
+        Ok(UserEnvironment(block))
+    }
+
+    impl LiteralLaunch {
+        /// No shell/association/derived-token fallback. The current ordinary
+        /// primary token is both the environment subject and CreateProcess user.
+        pub(crate) fn spawn(
+            &self,
+            arguments: &[String],
+            n_show: i32,
+        ) -> Result<CreatedApp, String> {
+            crate::security::ensure_driver_token_allowed()?;
+            if arguments.iter().any(|argument| argument.contains('\0')) {
+                return Err(PREVIEW_REFUSAL.into());
+            }
+            let environment = user_environment()?;
+            let executable: Vec<u16> = self.executable.encode_utf16().collect();
+            let arguments: Vec<Vec<u16>> = arguments
+                .iter()
+                .map(|arg| arg.encode_utf16().collect())
+                .collect();
+            let mut command_line =
+                crate::browser_launch_token::windows_command_line(&executable, &arguments)?;
+            command_line.push(0);
+            let application = wide(&self.executable);
+            let directory = wide(&self.directory);
+            let startup = STARTUPINFOW {
+                cb: std::mem::size_of::<STARTUPINFOW>() as u32,
+                dwFlags: STARTF_USESHOWWINDOW,
+                wShowWindow: n_show as u16,
+                ..Default::default()
+            };
+            let mut process = PROCESS_INFORMATION::default();
+            unsafe {
+                CreateProcessW(
+                    PCWSTR(application.as_ptr()),
+                    PWSTR(command_line.as_mut_ptr()),
+                    None,
+                    None,
+                    false,
+                    CREATE_BREAKAWAY_FROM_JOB | CREATE_UNICODE_ENVIRONMENT,
+                    Some(environment.0.cast_const()),
+                    PCWSTR(directory.as_ptr()),
+                    &startup,
+                    &mut process,
+                )
+            }
+            .map_err(|_| PREVIEW_REFUSAL.to_owned())?;
+            drop(unsafe { OwnedHandle::from_raw_handle(process.hThread.0) });
+            Ok(CreatedApp {
+                pid: process.dwProcessId,
+                process: std::sync::Arc::new(unsafe {
+                    OwnedHandle::from_raw_handle(process.hProcess.0)
+                }),
+            })
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        include!("literal_launch_native_tests.rs");
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) use native::prepare;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn only_literal_argv_and_minimized_are_launch_options() {
+        let path = "C:\\Apps\\example.exe";
+        for key in [
+            "name",
+            "bundle_id",
+            "aumid",
+            "launch_path",
+            "urls",
+            "creates_new_application_instance",
+            "env",
+            "cwd",
+            "command",
+            "_unknown",
+        ] {
+            let mut request = json!({"path":path});
+            request[key] = Value::Null;
+            assert_eq!(request_path(&request), Err(PREVIEW_REFUSAL), "{key}");
+        }
+        for request in [
+            json!({}),
+            json!(null),
+            json!({"path":path,"urls":[]}),
+            json!({"path":path,"creates_new_application_instance":true}),
+            json!({"path":path,"additional_arguments":"--flag"}),
+            json!({"path":path,"additional_arguments":[1]}),
+            json!({"path":path,"additional_arguments":["bad\u{0000}"]}),
+            json!({"path":path,"start_minimized":"true"}),
+        ] {
+            assert_eq!(request_path(&request), Err(PREVIEW_REFUSAL), "{request}");
+        }
+        let request = json!({"path":path,"additional_arguments":["a b", "", "&not-a-shell"],
+            "start_minimized":true,"session":"s","_session_id":"s",
+            "_transport_session_id":"t","_public_session_label":"p","_session_idle_ttl_ms":10});
+        assert_eq!(request_path(&request), Ok(path));
+    }
+
+    #[test]
+    fn only_drive_absolute_executable_namespace_is_admitted() {
+        for path in [
+            "app.exe",
+            "C:app.exe",
+            "\\app.exe",
+            "\\\\server\\share\\app.exe",
+            "\\\\?\\C:\\app.exe",
+            "\\\\.\\C:\\app.exe",
+            "C:\\app.exe:stream",
+            "C:\\a\0.exe",
+            "C:\\app.txt",
+        ] {
+            assert!(conventional_path(path).is_err(), "{path:?}");
+        }
+        assert_eq!(
+            conventional_path("c:/Program Files/App.EXE").unwrap(),
+            "c:\\Program Files\\App.EXE"
+        );
+        assert!(conventional_path("C:\\app.exe").is_ok());
+        // Let the OS resolve existing-file spellings; no bespoke ancestor policy.
+        assert!(conventional_path("C:\\apps\\..\\App.EXE").is_ok());
+        assert!(conventional_path("C:\\PROGRA~1\\App.EXE").is_ok());
+    }
+}
