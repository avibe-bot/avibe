+    #[tokio::test]
+    async fn unsupported_routes_refuse_at_actual_launch_tool_before_native_effects() {
+        // A launchable, test-owned executable is essential: a missing path
+        // would make these negatives pass even if request_path were bypassed.
+        let directory = tempfile::tempdir().unwrap();
+        let executable = directory.path().join("launch-probe.exe");
+        let system_cmd =
+            std::path::Path::new(&std::env::var("SystemRoot").unwrap()).join("System32\\cmd.exe");
+        std::fs::copy(system_cmd, &executable).unwrap();
+        let marker = directory.path().join("launch-marker.txt");
+        let valid = json!({
+            "path": executable.to_str().unwrap(),
+            "additional_arguments": ["/d", "/c", "echo created>launch-marker.txt"],
+        });
+        let positive = LaunchAppTool.invoke(valid.clone()).await;
+        assert_ne!(
+            positive.is_error,
+            Some(true),
+            "positive launch: {positive:?}"
+        );
+        assert!(positive.structured_content.as_ref().unwrap()["pid"]
+            .as_u64()
+            .is_some_and(|pid| pid > 0));
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        while !marker.exists() {
+            assert!(
+                std::time::Instant::now() < deadline,
+                "positive launch did not execute"
+            );
+            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        }
+        assert_eq!(std::fs::read_to_string(&marker).unwrap().trim(), "created");
+        drop(positive);
+        std::fs::remove_file(&marker).unwrap();
+
+        for (key, value) in [
+            ("name", json!("notepad")),
+            ("bundle_id", json!("notepad")),
+            ("aumid", json!("unsupported!App")),
+            ("launch_path", json!(executable.to_str().unwrap())),
+            ("urls", json!([])),
+            ("creates_new_application_instance", json!(true)),
+            ("webkit_inspector_port", json!(1234)),
+            ("unexpected_option", json!(null)),
+            ("additional_arguments", json!("not an argv array")),
+            ("start_minimized", json!("true")),
+        ] {
+            let mut args = valid.clone();
+            args[key] = value;
+            let result = LaunchAppTool.invoke(args).await;
+            // Even a regression must clean up only the process it actually
+            // created, using its original retained handle rather than a name.
+            if let Some(process) = result.windows_created_process.as_ref() {
+                use std::os::windows::io::AsRawHandle;
+                let handle = windows::Win32::Foundation::HANDLE(process.as_raw_handle());
+                unsafe {
+                    let _ = windows::Win32::System::Threading::TerminateProcess(handle, 99);
+                    let _ = windows::Win32::System::Threading::WaitForSingleObject(handle, 5000);
+                }
+            }
+            assert_eq!(result.is_error, Some(true), "{key}: {result:?}");
+            assert!(
+                result.windows_created_process.is_none(),
+                "{key}: created a process"
+            );
+            assert!(
+                result
+                    .structured_content
+                    .as_ref()
+                    .and_then(|value| value.get("pid"))
+                    .is_none(),
+                "{key}: returned a PID"
+            );
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+            assert!(!marker.exists(), "{key}: executed despite refusal");
+        }
+    }
+
+    #[tokio::test]
+    async fn owner_only_termination_matches_creation_time() {
+        struct TestChild(std::process::Child);
+        impl Drop for TestChild {
+            fn drop(&mut self) {
+                let _ = self.0.kill();
+                let _ = self.0.wait();
+            }
+        }
+        let executable = std::path::Path::new(&std::env::var("SystemRoot").unwrap())
+            .join("System32\\WindowsPowerShell\\v1.0\\powershell.exe");
+        let mut child = TestChild(
+            std::process::Command::new(executable)
+                .args([
+                    "-NoLogo",
+                    "-NoProfile",
+                    "-NonInteractive",
+                    "-Command",
+                    "Start-Sleep -Seconds 30",
+                ])
+                .spawn()
+                .unwrap(),
+        );
+        let pid = child.0.id();
+        let scope = KillAppTool
+            .protected_resource_scope("process_control", &json!({"pid":pid}))
+            .await
+            .unwrap()
+            .unwrap();
+        let expected = scope["fingerprint"].clone();
+        let mut wrong = expected.clone();
+        wrong["start_time"] = json!(wrong["start_time"].as_u64().unwrap() + 1);
+        let refusal = KillAppTool
+            .invoke(json!({"pid":pid,"_protected_process_fingerprint":wrong}))
+            .await;
+        assert_eq!(refusal.is_error, Some(true));
+        assert!(child.0.try_wait().unwrap().is_none());
+        let killed = KillAppTool
+            .invoke(json!({"pid":pid,"_protected_process_fingerprint":expected}))
+            .await;
+        assert_ne!(killed.is_error, Some(true));
+        child.0.wait().unwrap();
+    }
+
