+//! Windows Computer Use runs only with the daemon's own ordinary-user token.
+//!
+//! Never infer this from the shell, a named-pipe peer, or a linked/derived token.
+//! Read the process token again at every transport admission; no cached verdict.
+
+pub const ADMINISTRATOR_REFUSAL: &str =
+    "Computer Use does not run as administrator; start Avibe normally.";
+const MEDIUM_INTEGRITY_RID: u32 = 0x2000;
+
+#[derive(Debug, Clone, Copy)]
+struct TokenFacts {
+    elevated: bool,
+    ui_access: bool,
+    integrity_rid: u32,
+}
+
+fn admit_driver(facts: Result<TokenFacts, String>) -> Result<(), String> {
+    let facts = facts.map_err(|reason| {
+        format!("{ADMINISTRATOR_REFUSAL} Cannot verify the Computer Use process token: {reason}")
+    })?;
+    if facts.elevated || facts.ui_access || facts.integrity_rid > MEDIUM_INTEGRITY_RID {
+        return Err(ADMINISTRATOR_REFUSAL.to_owned());
+    }
+    Ok(())
+}
+
+/// Called inside the process that owns the action runtime, not its client.
+#[cfg(target_os = "windows")]
+pub fn ensure_driver_token_allowed() -> Result<(), String> {
+    admit_driver(native::current_process_token())
+}
+
+const UNVERIFIED_WINDOW_REFUSAL: &str = "Cannot verify this window; not acting.";
+const HIGHER_INTEGRITY_WINDOW_REFUSAL: &str =
+    "Windows does not allow Computer Use to control this higher-integrity window.";
+pub(crate) const DESKTOP_REFUSAL: &str =
+    "Computer Use cannot act on a locked, secure, or unavailable desktop. Unlock Windows and return to your normal desktop before trying again.";
+const ELEVATED_WINDOW_REFUSAL: &str =
+    "Computer Use cannot control an administrator window. Open the app normally and try again.";
+
+fn admit_window(own: TokenFacts, target: Result<TokenFacts, String>) -> Result<(), String> {
+    let target = target.map_err(|_| UNVERIFIED_WINDOW_REFUSAL.to_owned())?;
+    if target.elevated || target.integrity_rid > MEDIUM_INTEGRITY_RID {
+        return Err(ELEVATED_WINDOW_REFUSAL.to_owned());
+    }
+    if target.integrity_rid > own.integrity_rid {
+        return Err(HIGHER_INTEGRITY_WINDOW_REFUSAL.to_owned());
+    }
+    Ok(())
+}
+
+/// Diagnostic admission for the existing input paths. Unknown HWND/PID/token
+/// is not permission to act. This is not a claim that every other Windows API
+/// has UIPI enforcement; additional paths need their own evidence and review.
+#[cfg(target_os = "windows")]
+pub fn ensure_window_target_allowed(hwnd: u64) -> Result<(), String> {
+    let own = native::current_process_token();
+    admit_driver(own.clone())?;
+    admit_window(own?, native::window_process_token(hwnd))
+}
+
+/// These refusals are terminal for both background and foreground delivery;
+/// do not wrap them in an automatic foreground-retry recommendation.
+pub(crate) fn refusal_code(message: &str) -> Option<&'static str> {
+    if message.starts_with(ADMINISTRATOR_REFUSAL) {
+        Some("administrator_runtime_refused")
+    } else if message == UNVERIFIED_WINDOW_REFUSAL {
+        Some("unverified_window")
+    } else if message == ELEVATED_WINDOW_REFUSAL || message == HIGHER_INTEGRITY_WINDOW_REFUSAL {
+        Some("protected_window")
+    } else if message == DESKTOP_REFUSAL {
+        Some("desktop_unavailable")
+    } else {
+        None
+    }
+}
+
+#[cfg(target_os = "windows")]
+mod native {
+    use super::TokenFacts;
+    use std::mem::size_of;
+    use windows::Win32::Foundation::{CloseHandle, HANDLE, HWND};
+    use windows::Win32::Security::{
+        GetTokenInformation, TokenElevation, TokenIntegrityLevel, TokenUIAccess, TOKEN_ELEVATION,
+        TOKEN_MANDATORY_LABEL, TOKEN_QUERY,
+    };
+    use windows::Win32::System::Threading::{
+        GetCurrentProcess, OpenProcess, OpenProcessToken, PROCESS_QUERY_LIMITED_INFORMATION,
+    };
+    use windows::Win32::UI::WindowsAndMessaging::GetWindowThreadProcessId;
+
+    struct OwnedHandle(HANDLE);
+
+    impl Drop for OwnedHandle {
+        fn drop(&mut self) {
+            let _ = unsafe { CloseHandle(self.0) };
+        }
+    }
+
+    pub(super) fn current_process_token() -> Result<TokenFacts, String> {
+        process_token(unsafe { GetCurrentProcess() })
+    }
+
+    pub(super) fn window_process_token(hwnd: u64) -> Result<TokenFacts, String> {
+        let hwnd = HWND(hwnd as *mut _);
+        let mut pid = 0;
+        let thread = unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)) };
+        if thread == 0 || pid == 0 {
+            return Err("window has no verified owner".to_owned());
+        }
+        let process = OwnedHandle(
+            unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }
+                .map_err(|error| format!("OpenProcess failed: {error}"))?,
+        );
+        let facts = process_token(process.0)?;
+        let mut current_pid = 0;
+        let current_thread = unsafe { GetWindowThreadProcessId(hwnd, Some(&mut current_pid)) };
+        if current_pid != pid || current_thread != thread {
+            return Err("window owner changed while verifying it".to_owned());
+        }
+        Ok(facts)
+    }
+
+    fn process_token(process: HANDLE) -> Result<TokenFacts, String> {
+        let mut token = HANDLE::default();
+        unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) }
+            .map_err(|error| format!("OpenProcessToken failed: {error}"))?;
+        let token = OwnedHandle(token);
+        let mut elevation = TOKEN_ELEVATION::default();
+        let mut returned = 0;
+        unsafe {
+            GetTokenInformation(
+                token.0,
+                TokenElevation,
+                Some(std::ptr::from_mut(&mut elevation).cast()),
+                size_of::<TOKEN_ELEVATION>() as u32,
+                &mut returned,
+            )
+        }
+        .map_err(|error| format!("TokenElevation failed: {error}"))?;
+        if returned as usize != size_of::<TOKEN_ELEVATION>() {
+            return Err("TokenElevation returned an invalid length".to_owned());
+        }
+
+        let mut ui_access = 0u32;
+        unsafe {
+            GetTokenInformation(
+                token.0,
+                TokenUIAccess,
+                Some(std::ptr::from_mut(&mut ui_access).cast()),
+                size_of::<u32>() as u32,
+                &mut returned,
+            )
+        }
+        .map_err(|error| format!("TokenUIAccess failed: {error}"))?;
+        if returned as usize != size_of::<u32>() {
+            return Err("TokenUIAccess returned an invalid length".to_owned());
+        }
+
+        // A mandatory label plus the largest Windows SID (68 bytes). Using
+        // usize storage preserves TOKEN_MANDATORY_LABEL's alignment. Fail
+        // closed if Windows ever returns a larger representation.
+        let mut label = [0usize; 32];
+        unsafe {
+            GetTokenInformation(
+                token.0,
+                TokenIntegrityLevel,
+                Some(label.as_mut_ptr().cast()),
+                size_of_val(&label) as u32,
+                &mut returned,
+            )
+        }
+        .map_err(|error| format!("TokenIntegrityLevel failed: {error}"))?;
+        if (returned as usize) < size_of::<TOKEN_MANDATORY_LABEL>()
+            || returned as usize > size_of_val(&label)
+        {
+            return Err("TokenIntegrityLevel returned an invalid length".to_owned());
+        }
+        let mandatory = unsafe { &*label.as_ptr().cast::<TOKEN_MANDATORY_LABEL>() };
+        let sid = mandatory.Label.Sid.0 as usize;
+        let start = label.as_ptr() as usize;
+        let offset = sid
+            .checked_sub(start)
+            .filter(|offset| *offset >= size_of::<TOKEN_MANDATORY_LABEL>())
+            .ok_or("TokenIntegrityLevel returned an invalid SID pointer")?;
+        let bytes =
+            unsafe { std::slice::from_raw_parts(label.as_ptr().cast::<u8>(), returned as usize) };
+        let sid = bytes
+            .get(offset..)
+            .ok_or("TokenIntegrityLevel returned an invalid SID pointer")?;
+        // Integrity SIDs are S-1-16-RID. Validate the authority and exactly
+        // one subauthority instead of interpreting arbitrary/truncated data.
+        if sid.len() < 12 || sid[..8] != [1, 1, 0, 0, 0, 0, 0, 16] {
+            return Err("TokenIntegrityLevel returned an invalid integrity SID".to_owned());
+        }
+        let integrity_rid = u32::from_le_bytes(sid[8..12].try_into().unwrap());
+        Ok(TokenFacts {
+            elevated: elevation.TokenIsElevated != 0,
+            ui_access: ui_access != 0,
+            integrity_rid,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_verified_unelevated_tokens_at_or_below_medium_are_admitted() {
+        for (elevated, ui_access) in [(false, false), (false, true), (true, false), (true, true)] {
+            for integrity_rid in [0, 0x1000, 0x2000, 0x2001, 0x2100, 0x3000, 0x4000, u32::MAX] {
+                let result = admit_driver(Ok(TokenFacts {
+                    elevated,
+                    ui_access,
+                    integrity_rid,
+                }));
+                assert_eq!(
+                    result.is_ok(),
+                    !elevated && !ui_access && integrity_rid <= 0x2000
+                );
+                if result.is_err() {
+                    assert_eq!(result.unwrap_err(), ADMINISTRATOR_REFUSAL);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn unreadable_token_is_refused_not_assumed_medium() {
+        for reason in [
+            "OpenProcessToken",
+            "TokenElevation",
+            "TokenUIAccess",
+            "TokenIntegrityLevel",
+            "invalid SID",
+        ] {
+            let error = admit_driver(Err(reason.to_owned())).unwrap_err();
+            assert!(error.starts_with(ADMINISTRATOR_REFUSAL));
+            assert!(error.contains("Cannot verify the Computer Use process token"));
+        }
+    }
+
+    #[test]
+    fn windows_with_unknown_or_protected_owners_are_refused() {
+        let own = TokenFacts {
+            elevated: false,
+            ui_access: false,
+            integrity_rid: 0x2000,
+        };
+        assert_eq!(
+            admit_window(own, Err("PID unavailable".to_owned())).unwrap_err(),
+            UNVERIFIED_WINDOW_REFUSAL
+        );
+        assert_eq!(
+            admit_window(own, Err("token unavailable".to_owned())).unwrap_err(),
+            UNVERIFIED_WINDOW_REFUSAL
+        );
+        for (elevated, integrity_rid) in [
+            (true, 0x2000),
+            (false, 0x2001),
+            (false, 0x3000),
+            (false, 0x4000),
+        ] {
+            assert_eq!(
+                admit_window(
+                    own,
+                    Ok(TokenFacts {
+                        elevated,
+                        ui_access: false,
+                        integrity_rid
+                    })
+                )
+                .unwrap_err(),
+                ELEVATED_WINDOW_REFUSAL
+            );
+        }
+        assert!(admit_window(own, Ok(own)).is_ok());
+        assert!(admit_window(
+            TokenFacts {
+                integrity_rid: 0x1000,
+                ..own
+            },
+            Ok(own)
+        )
+        .is_err());
+    }
+
+    #[cfg(target_os = "windows")]
+    #[test]
+    fn native_own_token_is_read_without_desktop_or_shell_access() {
+        let facts = native::current_process_token().expect("query test process token");
+        assert_eq!(
+            ensure_driver_token_allowed().is_ok(),
+            !facts.elevated && !facts.ui_access && facts.integrity_rid <= 0x2000
+        );
+    }
+}
