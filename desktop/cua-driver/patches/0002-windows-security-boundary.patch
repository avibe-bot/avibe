+#[test]
+fn literal_native_profile_environment_and_job_survival() {
+    crate::security::ensure_driver_token_allowed()
+        .expect("run as ordinary profile-loaded test user");
+    let directory = tempfile::tempdir().unwrap();
+    // This ordinary Windows PowerShell application depends on the token user's
+    // real profile directories and TEMP. It creates/reads/removes only unique
+    // test-owned files, not the user's existing profile content.
+    let script = r#"
+param([string]$Report, [long]$ForbiddenHandle, [string]$ForbiddenPath)
+$ErrorActionPreference = 'Stop'
+Add-Type -TypeDefinition @'
+using System;
+using System.Text;
+using System.Runtime.InteropServices;
+public static class LiteralHandleProbe {
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
+    public static extern uint GetFinalPathNameByHandle(IntPtr handle, StringBuilder path, uint length, uint flags);
+}
+'@
+$handlePath = New-Object Text.StringBuilder 32768
+$handleLength = [LiteralHandleProbe]::GetFinalPathNameByHandle([IntPtr]$ForbiddenHandle, $handlePath, 32768, 0)
+if ($handleLength -gt 0 -and $handlePath.ToString() -ieq $ForbiddenPath) { throw 'caller file handle inherited' }
+foreach ($name in @('AVIBE_LITERAL_SENTINEL','CUA_LITERAL_SENTINEL','AVAULT_LITERAL_SENTINEL','CI_LITERAL_SENTINEL')) {
+    if ([Environment]::GetEnvironmentVariable($name, 'Process')) { throw 'caller sentinel inherited' }
+}
+foreach ($name in @('USERPROFILE','APPDATA','LOCALAPPDATA','SystemRoot','TEMP','TMP','PATH')) {
+    if (-not [Environment]::GetEnvironmentVariable($name, 'Process')) { throw "missing profile variable: $name" }
+}
+if ($env:USERPROFILE -ine [Environment]::GetFolderPath('UserProfile')) { throw 'wrong user profile' }
+if ($env:APPDATA -ine [Environment]::GetFolderPath('ApplicationData')) { throw 'wrong AppData' }
+if ($env:LOCALAPPDATA -ine [Environment]::GetFolderPath('LocalApplicationData')) { throw 'wrong LocalAppData' }
+$leaf = 'avibe-literal-test-' + [guid]::NewGuid().ToString('N')
+$profileFile = Join-Path $env:LOCALAPPDATA $leaf
+$tempFile = Join-Path $env:TEMP $leaf
+try {
+    [IO.File]::WriteAllText($profileFile, 'profile-dependent-app')
+    [IO.File]::WriteAllText($tempFile, [IO.File]::ReadAllText($profileFile))
+    if ([IO.File]::ReadAllText($tempFile) -ne 'profile-dependent-app') { throw 'profile roundtrip failed' }
+} finally {
+    Remove-Item -LiteralPath $profileFile,$tempFile -Force -ErrorAction SilentlyContinue
+}
+@{pid=$PID; cwd=[Environment]::CurrentDirectory; profile=$env:USERPROFILE; profileRoundtrip=$true} |
+    ConvertTo-Json -Compress | Set-Content -LiteralPath $Report -Encoding UTF8
+Start-Sleep -Seconds 60
+"#;
+    std::fs::write(directory.path().join("profile.ps1"), script).unwrap();
+    let job = unsafe { CreateJobObjectW(None, PCWSTR::null()) }.unwrap();
+    let job = unsafe { OwnedHandle::from_raw_handle(job.0) };
+    let mut limits = JOBOBJECT_EXTENDED_LIMIT_INFORMATION::default();
+    limits.BasicLimitInformation.LimitFlags =
+        JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE | JOB_OBJECT_LIMIT_BREAKAWAY_OK;
+    unsafe {
+        SetInformationJobObject(
+            HANDLE(job.as_raw_handle()),
+            JobObjectExtendedLimitInformation,
+            &limits as *const _ as *const _,
+            std::mem::size_of_val(&limits) as u32,
+        )
+    }
+    .unwrap();
+
+    // Only test fixture startup builds this synthetic driver environment. The
+    // target still goes through the production user_environment()/spawn().
+    let baseline = user_environment().unwrap();
+    let mut entries = Vec::new();
+    let mut offset = 0usize;
+    loop {
+        let start = offset;
+        while unsafe { *baseline.0.cast::<u16>().add(offset) } != 0 {
+            offset += 1;
+            assert!(offset < 1_048_576);
+        }
+        if offset == start {
+            break;
+        }
+        entries.push(
+            String::from_utf16(unsafe {
+                std::slice::from_raw_parts(baseline.0.cast::<u16>().add(start), offset - start)
+            })
+            .unwrap(),
+        );
+        offset += 1;
+    }
+    for (key, value) in
+        std::iter::once(("AVIBE_LITERAL_TEST_DIR", directory.path().to_str().unwrap())).chain(
+            SENTINELS
+                .iter()
+                .map(|key| (*key, "synthetic-not-a-credential")),
+        )
+    {
+        entries.push(format!("{key}={value}"));
+    }
+    entries.sort_by_key(|entry| entry.to_uppercase());
+    let mut environment: Vec<u16> = entries
+        .iter()
+        .flat_map(|entry| entry.encode_utf16().chain(Some(0)))
+        .collect();
+    environment.push(0);
+    let executable = std::env::current_exe().unwrap();
+    let application = wide(executable.to_str().unwrap());
+    let argv = ["--exact", FIXTURE_TEST, "--ignored", "--nocapture"]
+        .iter()
+        .map(|arg| arg.encode_utf16().collect())
+        .collect::<Vec<Vec<u16>>>();
+    let mut command = crate::browser_launch_token::windows_command_line(
+        &application[..application.len() - 1],
+        &argv,
+    )
+    .unwrap();
+    command.push(0);
+    let startup = STARTUPINFOW {
+        cb: std::mem::size_of::<STARTUPINFOW>() as u32,
+        ..Default::default()
+    };
+    let mut child = PROCESS_INFORMATION::default();
+    unsafe {
+        CreateProcessW(
+            PCWSTR(application.as_ptr()),
+            PWSTR(command.as_mut_ptr()),
+            None,
+            None,
+            false,
+            CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT,
+            Some(environment.as_ptr().cast()),
+            PCWSTR::null(),
+            &startup,
+            &mut child,
+        )
+    }
+    .unwrap();
+    let driver = TestProcess(unsafe { OwnedHandle::from_raw_handle(child.hProcess.0) });
+    let thread = unsafe { OwnedHandle::from_raw_handle(child.hThread.0) };
+    unsafe {
+        AssignProcessToJobObject(
+            HANDLE(job.as_raw_handle()),
+            HANDLE(driver.0.as_raw_handle()),
+        )
+        .unwrap();
+        assert_ne!(ResumeThread(HANDLE(thread.as_raw_handle())), u32::MAX);
+    }
+    let target_pid: u32 = wait_file(&directory.path().join("target-pid"))
+        .trim()
+        .parse()
+        .unwrap();
+    let target = test_process(target_pid);
+    let helper_pid: u32 = wait_file(&directory.path().join("helper-pid"))
+        .trim()
+        .parse()
+        .unwrap();
+    let helper = test_process(helper_pid);
+    let report = wait_file(&directory.path().join("report.json"));
+    let report: Value = serde_json::from_str(report.trim_start_matches('\u{feff}')).unwrap();
+    assert_eq!(report["pid"], target_pid);
+    assert_eq!(report["profileRoundtrip"], true);
+    let prepared = prepare(&powershell()).unwrap();
+    assert!(report["cwd"]
+        .as_str()
+        .unwrap()
+        .eq_ignore_ascii_case(&prepared.directory));
+    assert_ordinary_same_user_session(&target, target_pid);
+    assert!(in_job(
+        HANDLE(driver.0.as_raw_handle()),
+        HANDLE(job.as_raw_handle())
+    ));
+    assert!(in_job(
+        HANDLE(helper.0.as_raw_handle()),
+        HANDLE(job.as_raw_handle())
+    ));
+    assert!(!in_job(
+        HANDLE(target.0.as_raw_handle()),
+        HANDLE(job.as_raw_handle())
+    ));
+    unsafe {
+        TerminateJobObject(HANDLE(job.as_raw_handle()), 77).unwrap();
+        assert_eq!(
+            WaitForSingleObject(HANDLE(driver.0.as_raw_handle()), 5000),
+            WAIT_OBJECT_0
+        );
+        assert_eq!(
+            WaitForSingleObject(HANDLE(helper.0.as_raw_handle()), 5000),
+            WAIT_OBJECT_0
+        );
+        assert_eq!(
+            WaitForSingleObject(HANDLE(target.0.as_raw_handle()), 300),
+            windows::Win32::Foundation::WAIT_TIMEOUT
+        );
+    }
+}
