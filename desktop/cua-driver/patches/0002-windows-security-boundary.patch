+//! Windows-native ownership tests. These exercise the actual registration
+//! helper with controlled attestation results, not process-ID recycling load.
+use super::*;
+use std::collections::BTreeSet;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use windows::core::PCWSTR;
+use windows::Win32::Foundation::{FILETIME, HANDLE};
+use windows::Win32::System::Threading::{
+    CreateEventW, GetCurrentProcess, GetProcessId, GetProcessTimes, OpenProcess,
+    PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_SYNCHRONIZE,
+};
+
+fn process_handle(pid: u32) -> Arc<OwnedHandle> {
+    let handle = unsafe {
+        OpenProcess(
+            PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE,
+            false,
+            pid,
+        )
+    }
+    .unwrap();
+    Arc::new(unsafe { OwnedHandle::from_raw_handle(handle.0) })
+}
+fn result() -> ToolResult {
+    let mut result = ToolResult::text("created").with_structured(serde_json::json!({
+        "pid": std::process::id(), "running": true,
+    }));
+    result.windows_created_process = Some(process_handle(std::process::id()));
+    result
+}
+fn fingerprint(pid: i64) -> crate::browser::ProcessFingerprint {
+    // OS creation time in the existing Windows fingerprint's FILETIME units.
+    let (mut created, mut exited, mut kernel, mut user) = (
+        FILETIME::default(),
+        FILETIME::default(),
+        FILETIME::default(),
+        FILETIME::default(),
+    );
+    unsafe {
+        GetProcessTimes(
+            GetCurrentProcess(),
+            &mut created,
+            &mut exited,
+            &mut kernel,
+            &mut user,
+        )
+    }
+    .unwrap();
+    crate::browser::ProcessFingerprint {
+        pid,
+        start_time: Some(
+            (u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime),
+        ),
+        executable: Some("test-owned-process.exe".into()),
+    }
+}
+
+#[tokio::test]
+async fn missing_wrong_nonprocess_or_exited_evidence_never_registers() {
+    for case in [
+        "missing",
+        "wrong-pid",
+        "event-handle",
+        "running-false",
+        "running-unknown",
+        "error",
+        "preexisting",
+    ] {
+        let mut result = result();
+        let mut before = BTreeSet::new();
+        match case {
+            "missing" => {
+                result.windows_created_process = None;
+                // A JSON hint cannot substitute for internal HANDLE evidence.
+                result.structured_content.as_mut().unwrap()["windows_created_process"] =
+                    serde_json::json!(std::process::id());
+            }
+            "wrong-pid" => {
+                result.structured_content.as_mut().unwrap()["pid"] =
+                    serde_json::json!(u64::from(std::process::id()) + 1)
+            }
+            "event-handle" => {
+                let event = unsafe { CreateEventW(None, true, false, PCWSTR::null()) }.unwrap();
+                result.windows_created_process =
+                    Some(Arc::new(unsafe { OwnedHandle::from_raw_handle(event.0) }));
+            }
+            "running-false" => {
+                result.structured_content.as_mut().unwrap()["running"] = serde_json::json!(false)
+            }
+            "running-unknown" => {
+                result
+                    .structured_content
+                    .as_mut()
+                    .unwrap()
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("running");
+            }
+            "error" => result.is_error = Some(true),
+            "preexisting" => {
+                before.insert(i64::from(std::process::id()));
+            }
+            _ => unreachable!(),
+        }
+        let called = AtomicBool::new(false);
+        let store = crate::consent::ProtectedResourceOwnershipStore::default();
+        let called_ref = &called;
+        record_windows_launch_ownership(
+            &mut result,
+            Some(&before),
+            &store,
+            "test",
+            |pid| async move {
+                called_ref.store(true, Ordering::SeqCst);
+                Some(fingerprint(pid))
+            },
+        )
+        .await;
+        assert!(!called.load(Ordering::SeqCst), "{case}");
+        assert!(
+            !store.is_driver_owned_pid("test", i64::from(std::process::id())),
+            "{case}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn failed_or_incomplete_attestation_never_registers() {
+    for case in [
+        "failure",
+        "wrong-pid",
+        "wrong-start-time",
+        "no-start-time",
+        "no-image",
+    ] {
+        let mut result = result();
+        let store = crate::consent::ProtectedResourceOwnershipStore::default();
+        record_windows_launch_ownership(
+            &mut result,
+            Some(&BTreeSet::new()),
+            &store,
+            "test",
+            |pid| async move {
+                let mut evidence = fingerprint(pid);
+                match case {
+                    "failure" => return None,
+                    "wrong-pid" => evidence.pid += 1,
+                    "wrong-start-time" => {
+                        evidence.start_time = evidence.start_time.map(|time| time + 1)
+                    }
+                    "no-start-time" => evidence.start_time = None,
+                    "no-image" => evidence.executable = None,
+                    _ => unreachable!(),
+                }
+                Some(evidence)
+            },
+        )
+        .await;
+        assert!(
+            !store.is_driver_owned_pid("test", i64::from(std::process::id())),
+            "{case}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn original_handle_lives_across_attestation_and_later_reuse_is_refused() {
+    let mut result = result();
+    let weak = Arc::downgrade(result.windows_created_process.as_ref().unwrap());
+    let store = crate::consent::ProtectedResourceOwnershipStore::default();
+    let weak_ref = &weak;
+    record_windows_launch_ownership(
+        &mut result,
+        Some(&BTreeSet::new()),
+        &store,
+        "test",
+        |pid| async move {
+            tokio::task::yield_now().await;
+            let original = weak_ref
+                .upgrade()
+                .expect("registration must retain original handle across await");
+            assert_eq!(
+                unsafe { GetProcessId(HANDLE(original.as_raw_handle())) } as i64,
+                pid
+            );
+            Some(fingerprint(pid))
+        },
+    )
+    .await;
+    assert!(
+        weak.upgrade().is_none(),
+        "guard released only after registration completes"
+    );
+    let pid = i64::from(std::process::id());
+    assert!(store.reprove_driver_owned_process("test", &fingerprint(pid)));
+    let mut reused = fingerprint(pid);
+    reused.start_time = reused.start_time.map(|time| time + 1);
+    assert!(!store.reprove_driver_owned_process("test", &reused));
+    assert!(!store.is_driver_owned_pid("test", pid));
+}
+
+#[tokio::test]
+async fn retained_exited_process_is_not_registered_as_running() {
+    let mut child = std::process::Command::new("cmd.exe")
+        .args(["/d", "/c", "exit", "0"])
+        .spawn()
+        .unwrap();
+    let pid = child.id();
+    let original = process_handle(pid);
+    child.wait().unwrap();
+    drop(child);
+    assert_eq!(
+        unsafe { GetProcessId(HANDLE(original.as_raw_handle())) },
+        pid
+    );
+    let mut result =
+        ToolResult::text("exited").with_structured(serde_json::json!({"pid":pid,"running":true}));
+    result.windows_created_process = Some(original);
+    let store = crate::consent::ProtectedResourceOwnershipStore::default();
+    record_windows_launch_ownership(
+        &mut result,
+        Some(&BTreeSet::new()),
+        &store,
+        "test",
+        |_| async {
+            panic!(
+                "stale running=true cannot override the original process handle's signaled state"
+            );
+        },
+    )
+    .await;
+    assert!(!store.is_driver_owned_pid("test", i64::from(pid)));
+}
+
+#[test]
+fn original_handle_evidence_never_serializes() {
+    let result = result();
+    let wire = serde_json::to_value(&result).unwrap();
+    assert!(wire.get("windows_created_process").is_none());
+    assert_eq!(
+        wire["structuredContent"],
+        serde_json::json!({"pid":std::process::id(),"running":true})
+    );
+}
+
+#[test]
+fn registration_future_is_send() {
+    fn assert_send<T: Send>(_: T) {}
+    let mut result = result();
+    let before = BTreeSet::new();
+    let store = crate::consent::ProtectedResourceOwnershipStore::default();
+    assert_send(record_windows_launch_ownership(
+        &mut result,
+        Some(&before),
+        &store,
+        "test",
+        |pid| async move { Some(fingerprint(pid)) },
+    ));
+}
