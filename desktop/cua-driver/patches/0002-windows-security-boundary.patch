     /// the MCP result envelope or its legacy structured payload.
     #[serde(skip)]
     pub action_record: Option<crate::action_record::ActionExecutionRecord>,
+    /// Windows-only in-process proof from the original CreateProcessW result.
+    /// Never serialized, accepted from JSON, or replaced by a PID/name hint.
+    /// Registry ownership registration retains it through OS attestation and
+    /// ledger insertion so the process ID cannot name a recycled process.
+    #[cfg(target_os = "windows")]
