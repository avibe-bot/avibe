@@ -0,0 +1,457 @@
+// Native acceptance: run these tests as a disposable ordinary Windows user
+// with its profile loaded. No early-return/skip on missing APIs or profile.
+use super::*;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+use windows::Win32::Foundation::{BOOL, WAIT_OBJECT_0};
+use windows::Win32::Security::{
+    EqualSid, GetSidSubAuthority, GetSidSubAuthorityCount, GetTokenInformation, TokenElevation,
+    TokenIntegrityLevel, TokenUIAccess, TokenUser, TOKEN_ELEVATION, TOKEN_MANDATORY_LABEL,
+    TOKEN_USER,
+};
+use windows::Win32::System::JobObjects::{
+    AssignProcessToJobObject, CreateJobObjectW, IsProcessInJob, JobObjectExtendedLimitInformation,
+    SetInformationJobObject, TerminateJobObject, JOBOBJECT_EXTENDED_LIMIT_INFORMATION,
+    JOB_OBJECT_LIMIT_BREAKAWAY_OK, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+};
+use windows::Win32::System::RemoteDesktop::ProcessIdToSessionId;
+use windows::Win32::System::Threading::{
+    OpenProcess, ResumeThread, TerminateProcess, CREATE_SUSPENDED,
+    PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_SYNCHRONIZE, PROCESS_TERMINATE,
+};
+
+const FIXTURE_TEST: &str = "literal_launch::native::tests::literal_driver_fixture";
+const SENTINELS: [&str; 4] = [
+    "AVIBE_LITERAL_SENTINEL",
+    "CUA_LITERAL_SENTINEL",
+    "AVAULT_LITERAL_SENTINEL",
+    "CI_LITERAL_SENTINEL",
+];
+
+fn powershell() -> String {
+    let mut buffer = vec![0u16; 32768];
+    let count = unsafe {
+        windows::Win32::System::SystemInformation::GetSystemWindowsDirectoryW(Some(&mut buffer))
+    } as usize;
+    assert!(count > 0 && count < buffer.len());
+    format!(
+        "{}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
+        String::from_utf16(&buffer[..count]).unwrap()
+    )
+}
+
+fn wait_file(path: &Path) -> String {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        if let Ok(text) = std::fs::read_to_string(path) {
+            if !text.is_empty() {
+                return text;
+            }
+        }
+        assert!(
+            Instant::now() < deadline,
+            "timed out waiting for {}",
+            path.display()
+        );
+        std::thread::sleep(Duration::from_millis(50));
+    }
+}
+
+struct TestProcess(OwnedHandle);
+impl Drop for TestProcess {
+    fn drop(&mut self) {
+        // Test-owned PID captured from creation, never a name/process sweep.
+        unsafe {
+            let _ = TerminateProcess(HANDLE(self.0.as_raw_handle()), 99);
+            let _ = WaitForSingleObject(HANDLE(self.0.as_raw_handle()), 5000);
+        }
+    }
+}
+fn test_process(pid: u32) -> TestProcess {
+    let handle = unsafe {
+        OpenProcess(
+            PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE | PROCESS_TERMINATE,
+            false,
+            pid,
+        )
+    }
+    .unwrap();
+    TestProcess(unsafe { OwnedHandle::from_raw_handle(handle.0) })
+}
+fn in_job(process: HANDLE, job: HANDLE) -> bool {
+    let mut result = BOOL::default();
+    unsafe { IsProcessInJob(process, job, &mut result) }.unwrap();
+    result.as_bool()
+}
+fn token(process: HANDLE) -> OwnedHandle {
+    let mut token = HANDLE::default();
+    unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) }.unwrap();
+    unsafe { OwnedHandle::from_raw_handle(token.0) }
+}
+fn token_data(
+    token: &OwnedHandle,
+    class: windows::Win32::Security::TOKEN_INFORMATION_CLASS,
+) -> Vec<usize> {
+    let mut required = 0;
+    let _ = unsafe {
+        GetTokenInformation(HANDLE(token.as_raw_handle()), class, None, 0, &mut required)
+    };
+    assert!(required > 0);
+    let mut data = vec![0usize; (required as usize).div_ceil(std::mem::size_of::<usize>())];
+    unsafe {
+        GetTokenInformation(
+            HANDLE(token.as_raw_handle()),
+            class,
+            Some(data.as_mut_ptr().cast()),
+            required,
+            &mut required,
+        )
+    }
+    .unwrap();
+    data
+}
+fn assert_ordinary_same_user_session(target: &TestProcess, pid: u32) {
+    let own = token(unsafe { GetCurrentProcess() });
+    let target_token = token(HANDLE(target.0.as_raw_handle()));
+    let own_user = token_data(&own, TokenUser);
+    let target_user = token_data(&target_token, TokenUser);
+    unsafe {
+        EqualSid(
+            (*(own_user.as_ptr().cast::<TOKEN_USER>())).User.Sid,
+            (*(target_user.as_ptr().cast::<TOKEN_USER>())).User.Sid,
+        )
+        .unwrap();
+    }
+    let elevation = token_data(&target_token, TokenElevation);
+    assert_eq!(
+        unsafe { (*(elevation.as_ptr().cast::<TOKEN_ELEVATION>())).TokenIsElevated },
+        0
+    );
+    let uiaccess = token_data(&target_token, TokenUIAccess);
+    assert_eq!(unsafe { *uiaccess.as_ptr().cast::<u32>() }, 0);
+    let integrity = token_data(&target_token, TokenIntegrityLevel);
+    let sid = unsafe {
+        (*(integrity.as_ptr().cast::<TOKEN_MANDATORY_LABEL>()))
+            .Label
+            .Sid
+    };
+    let rid = unsafe { *GetSidSubAuthority(sid, (*GetSidSubAuthorityCount(sid) - 1) as u32) };
+    assert!(rid <= 0x2000);
+    let (mut own_session, mut target_session) = (0, 0);
+    unsafe {
+        ProcessIdToSessionId(std::process::id(), &mut own_session).unwrap();
+        ProcessIdToSessionId(pid, &mut target_session).unwrap();
+    }
+    assert_eq!(own_session, target_session);
+}
