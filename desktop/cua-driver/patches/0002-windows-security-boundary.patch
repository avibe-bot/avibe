@@ -0,0 +1,167 @@
+#![cfg(target_os = "windows")]
+
+//! Native startup regression, without interacting with any desktop or app.
+//! Run explicitly from an elevated Windows test account. This proves refusal
+//! at the real process boundary, not that UIPI blocks a particular GUI action.
+//! Ordinary-vs-elevated Notepad and locked-desktop acceptance are separate.
+
+use std::io::Read;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+use windows::Win32::Foundation::{CloseHandle, HANDLE};
+use windows::Win32::Security::{GetTokenInformation, TokenElevation, TOKEN_ELEVATION, TOKEN_QUERY};
+use windows::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+fn require_elevated_test_account() {
+    let mut token = HANDLE::default();
+    unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) }.unwrap();
+    let mut elevation = TOKEN_ELEVATION::default();
+    let mut returned = 0;
+    let result = unsafe {
+        GetTokenInformation(
+            token,
+            TokenElevation,
+            Some(std::ptr::from_mut(&mut elevation).cast()),
+            std::mem::size_of::<TOKEN_ELEVATION>() as u32,
+            &mut returned,
+        )
+    };
+    unsafe { CloseHandle(token) }.unwrap();
+    result.unwrap();
+    assert_ne!(elevation.TokenIsElevated, 0, "this test requires an elevated Windows test account; it is not a skip/pass on an ordinary account");
+}
+
+fn isolated_command(state: &tempfile::TempDir) -> Command {
+    let mut command = Command::new(env!("CARGO_BIN_EXE_cua-driver"));
+    // Neither metadata inspection nor startup-refusal testing needs host
+    // app discovery. Redirect Windows history/cache as well as driver state.
+    for variable in [
+        "HOME",
+        "USERPROFILE",
+        "APPDATA",
+        "LOCALAPPDATA",
+        "CUA_DRIVER_RS_HOME",
+        "CUA_DRIVER_TELEMETRY_HOME",
+        "XDG_CONFIG_HOME",
+        "XDG_STATE_HOME",
+        "XDG_CACHE_HOME",
+    ] {
+        command.env(variable, state.path());
+    }
+    command
+        .env("CUA_DRIVER_RS_TELEMETRY_ENABLED", "false")
+        .env("CUA_DRIVER_RS_UPDATE_CHECK", "false")
+        .env("CUA_DRIVER_PERMISSION_MODE", "standard")
+        .env_remove("CUA_DRIVER_POLICY_FILE")
+        .env_remove("CUA_DRIVER_MANAGED_POLICY_FILE")
+        .env_remove("CUA_DRIVER_CAPABILITY_MANIFEST_FILE")
+        .env_remove("CUA_DRIVER_CAPABILITY_MANIFEST_APPROVED")
+        .env_remove("CUA_DRIVER_SESSION_POLICY_FILE")
+        .env_remove("CUA_DRIVER_SESSION_POLICY_APPROVED")
+        .env_remove("CUA_DRIVER_RS_MCP_HTTP_PORT");
+    command
+}
+
+#[test]
+fn windows_tool_description_does_not_teach_a_privileged_fallback() {
+    let state = tempfile::tempdir().unwrap();
+    let output = isolated_command(&state)
+        .args(["dump-docs", "--type", "mcp"])
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let docs: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+    let hotkey = docs["tools"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|tool| tool["name"] == "hotkey")
+        .unwrap();
+    let description = hotkey["description"].as_str().unwrap();
+    assert!(
+        description.contains("Computer Use does not run as administrator; start Avibe normally.")
+    );
+    assert!(!description.contains("auto-prefers"));
+    assert!(!description.contains("cua-driver-uia.exe"));
+}
+
+#[test]
+#[ignore = "requires an explicitly provisioned elevated Windows test account; no GUI actions"]
+fn elevated_process_refuses_service_embedded_and_direct_mcp_before_binding() {
+    require_elevated_test_account();
+    for (mode, embedded, envelopes) in [
+        ("serve", false, false),
+        ("serve", true, false),
+        ("mcp", false, false),
+        ("mcp", false, true),
+    ] {
+        let state = tempfile::tempdir().unwrap();
+        let socket = format!(
+            r"\\.\pipe\avibe-token-refusal-{}-{}",
+            std::process::id(),
+            uuid::Uuid::new_v4()
+        );
+        let pid = state.path().join("driver.pid");
+        let mut command = isolated_command(&state);
+        command.arg(mode);
+        if mode == "serve" {
+            command.args(["--socket", &socket, "--pid-file"]);
+            command.arg(&pid).arg("--no-permissions-gate");
+        } else {
+            command.arg("--direct");
+        }
+        command.arg("--no-overlay");
+        command
+            .env("CUA_DRIVER_EMBEDDED", if embedded { "1" } else { "0" })
+            .env(
+                "CUA_DRIVER_MCP_ENVELOPES",
+                if envelopes { "1" } else { "0" },
+            )
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::piped());
+        let mut child = cua_driver_testkit::spawn_in_job(&mut command).unwrap();
+        let stderr = child.stderr.take().unwrap();
+        let diagnostic = std::thread::spawn(move || {
+            let mut bytes = Vec::new();
+            stderr.take(128 * 1024).read_to_end(&mut bytes).unwrap();
+            String::from_utf8_lossy(&bytes).into_owned()
+        });
+        // Keep stdin open so an unpatched daemon cannot pass by observing EOF.
+        let deadline = Instant::now() + Duration::from_secs(15);
+        let status = loop {
+            if let Some(status) = child.try_wait().unwrap() {
+                break status;
+            }
+            if Instant::now() >= deadline {
+                let _ = child.kill();
+                let _ = child.wait();
+                panic!("elevated {mode} embedded={embedded} envelopes={envelopes} did not refuse startup");
+            }
+            std::thread::sleep(Duration::from_millis(25));
+        };
+        drop(child.stdin.take());
+        let stderr = diagnostic.join().unwrap();
+        assert!(
+            !status.success(),
+            "elevated runtime exited successfully: {stderr}"
+        );
+        assert!(
+            stderr.contains("Computer Use does not run as administrator; start Avibe normally."),
+            "wrong refusal for {mode} embedded={embedded} envelopes={envelopes}: {stderr}"
+        );
+        assert!(
+            !stderr.contains("daemon listening"),
+            "bound an action endpoint: {stderr}"
+        );
+        assert!(
+            !pid.exists(),
+            "published a daemon PID before rejecting its token"
+        );
+    }
+}
